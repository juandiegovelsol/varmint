+    const tpl = findSpritePowerTemplate();
+    if (!tpl) throw new Error('no template renders the sprite power sections');
+    return quiet(() =>
+        Handlebars.compile(tpl.src)({
+            itemType: { sprite_power: items },
+            system: {},
+            data: {},
+            bindings: { skip: '', card: '' },
+        }),
+    );
+}
+
+/** The three section headers, resolved from a render, in {general, enabled, disabled} form.
+ *  Sections are identified by the localisation key each header renders, falling back to
+ *  document order (general, enabled, disabled) if those keys were renamed. */
