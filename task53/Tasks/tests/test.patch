+#!/usr/bin/env node
+/**
+ * Behavioural verifier for the sprite actor sheet's "Sprite Powers" tab.
+ *
+ * The tab has three list sections (general, Optional/Enabled, Optional/Disabled) that all
+ * share the SAME underlying item type ('sprite_power') and are distinguished only by each
+ * item's `system.optional` value. Every assertion below is made against observable app
+ * behaviour on BOTH halves of that round trip:
+ *
+ *   1. WRITE side — the candidate's own Handlebars templates are compiled and RENDERED with
+ *      the candidate's own registered helpers, and the real `.list-header` elements that come
+ *      out are scraped. Whatever discriminator the candidate chose to put on those headers
+ *      (a `data-*` attribute of any name, a css class, anything) is carried forward verbatim.
+ *      Those REAL rendered headers are then handed to the sheet's stable, pre-existing public
+ *      entry point `_onItemCreate(event)` — always the single-argument form real Foundry binds
+ *      (`html.find('.item-create').on('click', this._onItemCreate…)`), never a hand-rolled call
+ *      into a helper method a particular fix happens to add. Scoring is read off the actual
+ *      item data the (fake) `createEmbeddedDocuments` call receives.
+ *   2. READ side — the same template is rendered again, this time WITH sprite power items in
+ *      the sheet's own pre-existing `itemType.sprite_power` data, and the rows that come out
+ *      are located by item name. Which section a row landed under, and which controls its
+ *      markup offers, are read straight off that render.
+ *   3. TOGGLE side — the sheet's other stable, pre-existing entry point
+ *      `_onListItemToggleEnabled(event)` is driven against item fixtures, and the resulting
+ *      item state is computed by applying whatever update the sheet actually issued (flat
+ *      `system.x` keys, a nested `system` object, `actor.updateEmbeddedDocuments` or
+ *      `item.update` — all are accepted) onto the fixture.
+ *
+ * The candidate source is NEVER grepped and no new-in-a-fix helper name, attribute name or
+ * file location is required to exist. Class names / data keys that ARE relied on
+ * (`list-header`, `list-item`, `item-create`, `item-enable-toggle`, `data-item-id`,
+ * `itemType.sprite_power`) are all pre-existing base contracts the sheet's own
+ * `activateListeners` already binds — none of them is invented by any fix.
+ */
+import { readFileSync, writeFileSync, mkdirSync, existsSync, readdirSync, statSync } from 'fs';
+import { createRequire } from 'module';
+import path from 'path';
+
+const require = createRequire(import.meta.url);
+
+// ── Paths ─────────────────────────────────────────────────────────────────────
+const DEFAULT_APP = '/app';
+const APP = existsSync(DEFAULT_APP) ? DEFAULT_APP : (process.env.SR5_APP_ROOT || DEFAULT_APP);
+const DEFAULT_REPORT_DIR = '/logs/verifier';
+const REPORT_DIR = existsSync(DEFAULT_APP)
+    ? DEFAULT_REPORT_DIR
+    : (process.env.SR5_REPORT_DIR || DEFAULT_REPORT_DIR);
+const REPORT = path.join(REPORT_DIR, 'report.xml');
+const SUITE = 'sprite_power_section_tagging';
+
+const CASE_NAMES = [
+    // f2p
+    'sprite_power_enabled_section_create_tags_new_item_enabled_option',
+    'sprite_power_disabled_section_create_tags_new_item_disabled_option',
+    'sprite_power_sections_bucket_independently_not_all_into_general',
+    'sprite_power_sections_all_create_sprite_power_typed_items',
+    'sprite_power_rows_render_under_the_section_matching_their_optional_state',
+    'sprite_power_enable_toggle_offered_only_for_optional_powers',
+    'sprite_power_enable_toggle_swaps_section_and_enabled_state_together',
+    // p2p
+    'actor_sheet_generic_item_create_unaffected_by_sprite_specific_data',
+    'sprite_sheet_non_sprite_power_item_create_stays_unaffected',
+    'item_create_still_unhides_its_inventory_section',
+    'item_create_still_adds_to_selected_non_default_inventory',
+    'sprite_power_section_headers_still_carry_an_item_type_id',
+    'enable_toggle_still_ignores_standard_powers_and_non_power_items',
+];
+
+const results = [];
+function record(name, passed, msg = '') {
+    results.push({ name, passed, msg });
+}
+async function safeAsync(name, fn) {
+    try {
+        await fn();
+    } catch (e) {
+        record(name, false, `unexpected error: ${e && e.stack ? e.stack : e}`);
+    }
+}
+
+// ── Generic auto-stub for modules we do not model ─────────────────────────────
+function autoStub(label) {
+    const cache = new Map();
+    const fn = function () {};
+    return new Proxy(fn, {
+        get(_t, prop) {
+            if (prop === '__esModule') return true;
+            if (prop === Symbol.toPrimitive) return () => `[stub ${label}]`;
+            if (prop === 'toString') return () => `[stub ${label}]`;
+            if (prop === 'then') return undefined;
+            if (typeof prop === 'symbol') return undefined;
+            if (!cache.has(prop)) cache.set(prop, autoStub(`${label}.${String(prop)}`));
+            return cache.get(prop);
+        },
+        set() {
+            return true;
+        },
+        has() {
+            return true;
+        },
+        apply() {
+            return undefined;
+        },
+        construct() {
+            return {};
+        },
+    });
+}
+
+// ── FoundryVTT globals the sources reach for ─────────────────────────────────
+globalThis.foundry = {
+    utils: { mergeObject: (a, b) => ({ ...a, ...b }), deepClone: (v) => JSON.parse(JSON.stringify(v)) },
+    applications: { ux: { TextEditor: { implementation: { enrichHTML: async (v) => (v ?? '') } } } },
+    appv1: { sheets: {} },
+};
+globalThis.CONFIG = {
+    Item: { typeLabels: { sprite_power: 'Sprite Power', critter_power: 'Critter Power', gear: 'Gear', weapon: 'Weapon' } },
+};
+globalThis.game = {
+    i18n: { lang: 'en', localize: (k) => String(k), format: (k) => String(k), has: () => false },
+    settings: { get: () => false },
+};
+globalThis.canvas = {};
+globalThis.ui = { notifications: { info() {}, warn() {}, error() {} } };
+globalThis.Hooks = { on() {}, once() {}, call() {}, callAll() {} };
+globalThis.Shadowrun = {};
+globalThis.CONST = { ACTIVE_EFFECT_MODES: { CUSTOM: 0, MULTIPLY: 1, ADD: 2, DOWNGRADE: 3, UPGRADE: 4, OVERRIDE: 5 } };
+
+// ── Minimal stand-in for FoundryVTT's (bare-global, pre-appv1-namespacing at this
+// repo's base commit) ActorSheet class. Real Foundry's Application constructor sets
+// `this.object`; `actor`/`document` are read-only getters computed off it. We never assign
+// `.actor` directly (only `.object`), so there is no accessor conflict with the real
+// SR5BaseActorSheet/SR5SpriteActorSheet subclasses.
+class FakeActorSheet {
+    static get defaultOptions() {
+        return {};
+    }
+    constructor(object, options) {
+        this.object = object;
+        this.options = options || {};
+    }
+    get document() {
+        return this.object;
+    }
+    get actor() {
+        return this.object;
+    }
+    activateListeners() {}
+}
+globalThis.ActorSheet = FakeActorSheet;
+
+// ── Dependencies from the image ──────────────────────────────────────────────
+function requireFirst(candidates, what) {
+    for (const candidate of candidates) {
+        try {
+            return require(candidate);
+        } catch {
+            /* keep looking */
+        }
+    }
+    fatal(`cannot require ${what} — expected it in the image node_modules`);
+}
+
+const ts = requireFirst(
+    [path.join(APP, 'node_modules/typescript'), 'typescript', '/usr/local/lib/node_modules/typescript'],
+    'typescript',
+);
+const Handlebars = requireFirst(
+    [path.join(APP, 'node_modules/handlebars'), 'handlebars', '/usr/local/lib/node_modules/handlebars'],
+    'handlebars',
+);
+// The repo's helper module registers onto the bare global, exactly as it does under Foundry.
+globalThis.Handlebars = Handlebars;
+
+// ── TypeScript loading of the real modules ───────────────────────────────────
+/**
+ * Two tiers, so that neither an alternative file layout nor the repo's heavyweight
+ * pre-existing infrastructure can decide the score:
+ *
+ *   TIER 1 (`MUST_LOAD_PREFIXES`) — the directories the sheet + helper entry points live in.
+ *     A load failure here is fatal, because it means the code under test is broken.
+ *   TIER 2 (every other real `.ts` under `src/`) — loaded FOR REAL on a best-effort basis and
+ *     only auto-stubbed if it actually throws. This is what lets a fix put its new logic in
+ *     ANY source directory it likes (`src/module/utils/`, `src/module/item/`, a brand-new
+ *     folder, …) instead of only in the directories one particular patch happened to use.
+ */
+const MUST_LOAD_PREFIXES = ['src/module/actor/sheets/', 'src/module/handlebars/'];
+function isMustLoad(relPath) {
+    return MUST_LOAD_PREFIXES.some((p) => relPath.startsWith(p));
+}
+
+const TRANSPILED = new Map();
+function transpile(absPath) {
+    if (TRANSPILED.has(absPath)) return TRANSPILED.get(absPath);
+    const source = readFileSync(absPath, 'utf8');
+    const out = ts.transpileModule(source, {
+        fileName: path.basename(absPath),
+        reportDiagnostics: true,
+        compilerOptions: {
+            module: ts.ModuleKind.CommonJS,
+            target: ts.ScriptTarget.ES2022,
+            useDefineForClassFields: false,
+            experimentalDecorators: false,
+            isolatedModules: true,
+        },
+    });
+    const errors = (out.diagnostics ?? []).filter((d) => d.category === 1);
+    if (errors.length) {
+        throw new Error(
+            `${path.basename(absPath)} does not compile: ` +
+                errors.map((d) => ts.flattenDiagnosticMessageText(d.messageText, ' ')).join(' | '),
+        );
+    }
+    TRANSPILED.set(absPath, out.outputText);
+    return out.outputText;
+}
+
+const LOAD_ERRORS = [];
+const cache = new Map();
+function load(absPath) {
+    if (cache.has(absPath)) return cache.get(absPath);
+    const code = transpile(absPath);
+    const mod = { exports: {} };
+    cache.set(absPath, mod.exports);
+    const dir = path.dirname(absPath);
+    const req = (specifier) => {
+        const spec = String(specifier);
+
+        let resolved = null;
+        if (spec.startsWith('.')) resolved = path.resolve(dir, spec);
+        else if (spec.startsWith('@/')) resolved = path.join(APP, 'src', spec.slice(2));
+        else if (spec.startsWith('src/')) resolved = path.join(APP, spec);
+
+        if (resolved) {
+            for (const candidate of [resolved + '.ts', path.join(resolved, 'index.ts')]) {
+                if (!existsSync(candidate)) continue;
+                const rel = path.relative(APP, candidate).split(path.sep).join('/');
+                try {
+                    return load(candidate);
+                } catch (e) {
+                    // Tier 1 failures are real breakage; tier 2 failures are just infrastructure
+                    // we do not model, and degrade to a stub exactly as before.
+                    if (isMustLoad(rel)) LOAD_ERRORS.push(`${rel}: ${e.message}`);
+                    return autoStub(spec);
+                }
+            }
+        }
+        return autoStub(spec);
+    };
+    const factory = new Function('require', 'exports', 'module', '__filename', '__dirname', code);
+    factory(req, mod.exports, mod, absPath, dir);
+    cache.set(absPath, mod.exports);
+    return mod.exports;
+}
+const requireReal = (relPath) => load(path.join(APP, relPath));
+
+function quiet(fn) {
+    const saved = { log: console.log, info: console.info, debug: console.debug, warn: console.warn, error: console.error };
+    console.log = console.info = console.debug = console.warn = console.error = () => {};
+    try {
+        return fn();
+    } finally {
+        Object.assign(console, saved);
+    }
+}
+async function quietAsync(fn) {
+    const saved = { log: console.log, info: console.info, debug: console.debug, warn: console.warn, error: console.error };
+    console.log = console.info = console.debug = console.warn = console.error = () => {};
+    try {
+        return await fn();
+    } finally {
+        Object.assign(console, saved);
+    }
+}
+
+// ── Load the real classes ─────────────────────────────────────────────────────
+let Ctor;
+try {
+    Ctor = quiet(() => ({
+        SR5BaseActorSheet: requireReal('src/module/actor/sheets/SR5BaseActorSheet.ts').SR5BaseActorSheet,
+        SR5SpriteActorSheet: requireReal('src/module/actor/sheets/SR5SpriteActorSheet.ts').SR5SpriteActorSheet,
+    }));
+} catch (e) {
+    fatal(`could not load the repo's own sheet modules: ${e && e.stack ? e.stack : e}`);
+}
+if (LOAD_ERRORS.length) fatal(`module load errors: ${LOAD_ERRORS.join(' || ')}`);
+
+// ══════════════════════════════════════════════════════════════════════════
+// Render the candidate's OWN templates and scrape the real elements.
+// ══════════════════════════════════════════════════════════════════════════
+
+const TEMPLATE_ROOT = path.join(APP, 'src/templates');
+const FOUNDRY_TEMPLATE_PREFIX = 'systems/shadowrun5e/dist/templates/';
+
+function walk(dir, ext, out = []) {
+    for (const entry of readdirSync(dir)) {
+        const abs = path.join(dir, entry);
+        if (statSync(abs).isDirectory()) walk(abs, ext, out);
+        else if (abs.endsWith(ext)) out.push(abs);
+    }
+    return out;
+}
+
+const TEMPLATE_FILES = existsSync(TEMPLATE_ROOT) ? walk(TEMPLATE_ROOT, '.html') : [];
+
+/** Register every repo template under both its Foundry path and its repo-relative path. */
+function registerPartials() {
+    for (const abs of TEMPLATE_FILES) {
+        const rel = path.relative(TEMPLATE_ROOT, abs).split(path.sep).join('/');
+        const source = readFileSync(abs, 'utf8');
+        Handlebars.registerPartial(FOUNDRY_TEMPLATE_PREFIX + rel, source);
+        Handlebars.registerPartial(rel, source);
+    }
+}
+
+/**
+ * Every module that could register a Handlebars helper: everything under the repo's
+ * handlebars directory, plus ANY other module under `src/module/` whose source calls
+ * `Handlebars.registerHelper`. A fix is therefore free to register its helper from a
+ * brand-new file, in a brand-new directory, under a name of its own choosing -- the harness
+ * finds it by what it does, not by where any particular patch happened to put it.
+ */
+function collectHelperRegistrars() {
+    const files = [];
+    const seen = new Set();
+    const push = (abs) => {
+        const key = abs.toLowerCase();
+        if (!seen.has(key)) {
+            seen.add(key);
+            files.push(abs);
+        }
+    };
+    const hbRoot = path.join(APP, 'src/module/handlebars');
+    if (existsSync(hbRoot)) walk(hbRoot, '.ts').forEach(push);
+    const moduleRoot = path.join(APP, 'src/module');
+    if (existsSync(moduleRoot)) {
+        for (const abs of walk(moduleRoot, '.ts')) {
+            try {
+                if (/Handlebars\s*\.\s*registerHelper/.test(readFileSync(abs, 'utf8'))) push(abs);
+            } catch {
+                /* unreadable -- nothing to register */
+            }
+        }
+    }
+    return files;
+}
+
+/** Load every such module and call each of its exported `register*` functions. */
+function registerAllHelpers() {
+    for (const abs of collectHelperRegistrars()) {
+        let mod;
+        try {
+            mod = quiet(() => load(abs));
+        } catch {
+            continue;
+        }
+        for (const [name, value] of Object.entries(mod || {})) {
+            if (typeof value !== 'function' || !/^register/i.test(name)) continue;
+            try {
+                quiet(() => value());
+            } catch {
+                /* a registrar we do not have the globals for -- irrelevant to this suite */
+            }
+        }
+    }
+}
+
+/** Foundry-provided helpers the repo's own templates lean on. Only filled in where the
+ *  candidate's own code has not already registered something under that name. */
+const FOUNDRY_HELPER_FALLBACKS = {
+    localize: (k) => String(k),
+    eq: (a, b) => a === b,
+    ne: (a, b) => a !== b,
+    lt: (a, b) => a < b,
+    gt: (a, b) => a > b,
+    not: (v) => !v,
+    or: (...a) => a.slice(0, -1).some(Boolean),
+    and: (...a) => a.slice(0, -1).every(Boolean),
+    isDefined: (v) => v !== undefined && v !== null,
+    concatStrings: (...a) => a.slice(0, -1).join(''),
+    numberFormat: (v) => String(v ?? ''),
+};
+
+/** Wrap every helper so that infrastructure we do not model cannot abort the render.
+ *  A throwing helper contributes nothing to the output instead of killing the page — the
+ *  behaviour under test lives in the elements themselves, not in a helper's return. */
+function guardHelpers() {
+    for (const name of Object.keys(Handlebars.helpers)) {
+        const orig = Handlebars.helpers[name];
+        if (typeof orig !== 'function' || orig.__sr5Guarded) continue;
+        const wrapped = function (...args) {
+            try {
+                return orig.apply(this, args);
+            } catch {
+                return '';
+            }
+        };
+        wrapped.__sr5Guarded = true;
+        Handlebars.registerHelper(name, wrapped);
+    }
+}
+
+/** Locate the template that renders the sprite power sections, by CONTENT rather than by
+ *  path, so a fix is free to move or rename it. */
+function findSpritePowerTemplate() {
+    const scored = [];
+    for (const abs of TEMPLATE_FILES) {
+        const src = readFileSync(abs, 'utf8');
+        if (!/sprite_power/.test(src)) continue;
+        if (!/ListHeader\.html/.test(src)) continue;
+        const headers = (src.match(/ListHeader\.html/g) || []).length;
+        scored.push({ abs, src, headers });
+    }
+    scored.sort((a, b) => b.headers - a.headers);
+    return scored[0] ?? null;
+}
+
+const ATTR_RE = /([a-zA-Z_:][-a-zA-Z0-9_:.]*)\s*=\s*"([^"]*)"/g;
+function parseAttrs(chunk) {
+    const attrs = {};
+    ATTR_RE.lastIndex = 0;
+    let m;
+    while ((m = ATTR_RE.exec(chunk))) attrs[m[1]] = m[2];
+    return attrs;
+}
+
+const kebabToCamel = (s) => s.replace(/-([a-z0-9])/g, (_, c) => c.toUpperCase());
+
+/** Every rendered element that IS a list block -- i.e. whose own class list contains exactly
+ *  the `list-header` or `list-item` token the sheet's own listeners bind against -- in
+ *  document order, each paired with the slice of markup that belongs to it (everything up to
+ *  the next block). Inner wrappers such as `list-item-content` / `list-item-description` are
+ *  deliberately NOT blocks: token equality, not substring matching. */
+function extractBlocks(html) {
+    const found = [];
+    const tagRe = /<(div|a|section|li|header)\b([^>]*)>/gi;
+    let m;
+    while ((m = tagRe.exec(html))) {
+        const attrs = parseAttrs(m[2]);
+        const classes = (attrs['class'] || '').split(/\s+/).filter(Boolean);
+        const kind = classes.includes('list-header') ? 'header' : classes.includes('list-item') ? 'item' : null;
+        if (!kind) continue;
+        found.push({ kind, attrs, start: m.index });
+    }
+    return found.map((b, i) => ({
+        ...b,
+        text: html.slice(b.start, i + 1 < found.length ? found[i + 1].start : html.length),
+    }));
+}
+
+/** The rendered `.item-create` icon inside a header's own slice of markup, if any -- the
+ *  template spreads `icon.data` onto this exact element (see ListItem.html), so a fix is
+ *  free to put its discriminator here instead of on the header container. Returns {} when
+ *  there is no rendered icon to scrape (e.g. the hand-built p2p fixtures below). */
+function extractIconAttrs(headerHtml) {
+    if (!headerHtml) return {};
+    const tagRe = /<a\b([^>]*)>/gi;
+    let m;
+    while ((m = tagRe.exec(headerHtml))) {
+        const attrs = parseAttrs(m[1]);
+        if (/(^|\s)item-create(\s|$)/.test(attrs['class'] || '')) return attrs;
+    }
+    return {};
+}
+
+/** Turn scraped attributes into a DOM-ish element: `dataset`, `className`, `classList` and
+ *  `getAttribute` are all populated from the REAL render, so a fix is free to signal the
+ *  section through any of them -- the header container OR the `.item-create` icon inside it
+ *  (`iconAttrs`, carried along so `makeClickEvent` can build a click target from the real
+ *  icon markup rather than assuming the header is the only place a fix could write to). */
