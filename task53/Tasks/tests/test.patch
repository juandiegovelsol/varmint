+    const headers = blocks.filter((b) => b.kind === 'header');
+    if (headers.length < 3) {
+        throw new Error(`expected 3 sprite power section headers in the render, found ${headers.length}`);
+    }
+    const enabled = headers.find((h) => /EnabledOption/i.test(h.text));
+    const disabled = headers.find((h) => /DisabledOption/i.test(h.text));
+    const general = headers.find((h) => h !== enabled && h !== disabled);
+    return general && enabled && disabled
+        ? { general, enabled, disabled }
+        : { general: headers[0], enabled: headers[1], disabled: headers[2] };
+}
+
+let SECTIONS = null;
+let SECTION_BLOCKS = null;
+let SECTION_ERROR = null;
+try {
+    registerPartials();
+    registerAllHelpers();
+    for (const [name, fn] of Object.entries(FOUNDRY_HELPER_FALLBACKS)) {
+        if (!Handlebars.helpers[name]) Handlebars.registerHelper(name, fn);
+    }
+    guardHelpers();
+    if (LOAD_ERRORS.length) throw new Error(`module load errors: ${LOAD_ERRORS.join(' || ')}`);
