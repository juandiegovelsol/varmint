+    const dataset = {};
+    for (const [k, v] of Object.entries(attrs)) {
+        if (k.toLowerCase().startsWith('data-')) dataset[kebabToCamel(k.slice(5).toLowerCase())] = v;
+    }
+    const className = attrs['class'] || '';
+    const classes = className.split(/\s+/).filter(Boolean);
+    const el = {
+        dataset,
+        className,
+        classList: { value: className, contains: (c) => classes.includes(c) },
+        getAttribute: (n) => (n in attrs ? attrs[n] : null),
+        hasAttribute: (n) => n in attrs,
+        attributes: attrs,
+        iconAttrs,
+    };
+    el.closest = (sel) => (sel === '.list-header' || classes.some((c) => sel === `.${c}`) ? el : null);
+    return el;
+}
+
+/**
+ * Render the sprite power section template through the candidate's own partials + helpers.
+ *
+ * `items` are handed over in the sheet's own pre-existing data shape (`itemType.sprite_power`,
+ * the contract this template has read since long before this bug report and which nothing in
+ * the report asks anyone to change).
+ */
