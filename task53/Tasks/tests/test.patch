+        general: headerElement(resolved.general.attrs, extractIconAttrs(resolved.general.text)),
+        enabled: headerElement(resolved.enabled.attrs, extractIconAttrs(resolved.enabled.text)),
+        disabled: headerElement(resolved.disabled.attrs, extractIconAttrs(resolved.disabled.text)),
+    };
+} catch (e) {
+    SECTION_ERROR = e && e.message ? e.message : String(e);
+}
+
+// Diagnostic for graders: what the candidate's own render actually put on the three headers.
+if (SECTIONS) {
+    console.log(
+        `[headers] general=${JSON.stringify(SECTIONS.general.dataset)} ` +
+            `enabled=${JSON.stringify(SECTIONS.enabled.dataset)} ` +
+            `disabled=${JSON.stringify(SECTIONS.disabled.dataset)}`,
+    );
+} else {
+    console.log(`[headers] NOT RENDERED — ${SECTION_ERROR}`);
+}
+
+// ── The three optional states, rendered as real rows ──────────────────────────
+/** One sprite power per optional state. Names are unique nonsense tokens so a row can be
+ *  located in the render without assuming anything about the markup around it. */
+const ROW_FIXTURES = [
+    { key: 'standard', name: 'HarnessRowAlphaStandard', optional: 'standard', enabled: true },
+    { key: 'enabled_option', name: 'HarnessRowBetaEnabled', optional: 'enabled_option', enabled: true },
+    { key: 'disabled_option', name: 'HarnessRowGammaDisabled', optional: 'disabled_option', enabled: false },
+];
+
+function rowItem({ key, name, optional, enabled }) {
+    return {
+        _id: `harness-row-${key}`,
+        name,
+        img: '',
+        type: 'sprite_power',
+        description: { value: '' },
+        system: {
+            optional,
+            enabled,
+            description: { value: '' },
+            importFlags: { isFreshImport: false },
+        },
+    };
+}
+
+let ROWS = null;
+let ROWS_ERROR = null;
+try {
+    if (SECTION_ERROR) throw new Error(SECTION_ERROR);
+    const html = renderSpritePowerTab(ROW_FIXTURES.map(rowItem));
+    const blocks = extractBlocks(html);
+    const sections = resolveSections(blocks);
+    const sectionName = new Map([
+        [sections.general, 'general'],
+        [sections.enabled, 'enabled'],
+        [sections.disabled, 'disabled'],
+    ]);
+
+    ROWS = { html, blocks, byKey: {} };
+    for (const fixture of ROW_FIXTURES) {
+        // How many rows carry this power's name at all, and which section header is the
+        // closest one above the row that does.
+        const hits = blocks.filter((b) => b.kind === 'item' && b.text.includes(fixture.name));
+        let section = null;
+        if (hits.length) {
+            const idx = blocks.indexOf(hits[0]);
+            for (let i = idx - 1; i >= 0; i--) {
+                if (blocks[i].kind !== 'header') continue;
+                section = sectionName.get(blocks[i]) ?? 'unknown';
+                break;
+            }
+        }
+        ROWS.byKey[fixture.key] = {
+            fixture,
+            count: hits.length,
+            section,
+            // The pre-existing control class the sheet's own activateListeners binds the
+            // enable/disable toggle to: `html.find('.item-enable-toggle')`.
+            hasEnableToggle: hits.some((b) => b.text.includes('item-enable-toggle')),
+        };
+    }
+} catch (e) {
+    ROWS_ERROR = e && e.message ? e.message : String(e);
+}
+
+if (ROWS) {
+    console.log(
+        `[rows] ` +
+            ROW_FIXTURES.map((f) => {
+                const r = ROWS.byKey[f.key];
+                return `${f.key}={section:${r.section},count:${r.count},toggle:${r.hasEnableToggle}}`;
+            }).join(' '),
+    );
+} else {
+    console.log(`[rows] NOT RENDERED — ${ROWS_ERROR}`);
+}
+
+// ── Fixtures ───────────────────────────────────────────────────────────────────
+
+/** A minimal Actor stand-in carrying just what _onItemCreate touches. */
+function makeActor({ defaultInventoryName = 'default' } = {}) {
+    const created = [];
+    const addItemsCalls = [];
+    return {
+        name: 'Test Sprite',
+        defaultInventory: { name: defaultInventoryName, label: 'Default' },
+        created,
+        addItemsCalls,
+        async createEmbeddedDocuments(_docType, dataArr) {
+            const items = dataArr.map((d) => ({ ...d }));
+            created.push(...items);
+            return items;
+        },
+        inventory: {
+            async addItems(invName, items) {
+                addItemsCalls.push({ invName, items });
+            },
+        },
+    };
+}
+
+/** A synthetic click on the `.item-create` control inside the given header element, shaped
+ *  the way the real DOM delivers it. The target's `dataset`/`getAttribute` come from the
+ *  REAL rendered icon (`headerEl.iconAttrs`, scraped by `extractIconAttrs`) rather than a
+ *  hardcoded empty object, so a fix that signals its section on the clicked icon itself --
+ *  exactly how the real app binds this listener, see the header comment above -- is read
+ *  the same way a fix that signals on the header container would be. */
+function makeClickEvent(headerEl) {
+    const iconAttrs = headerEl.iconAttrs || {};
+    const dataset = {};
+    for (const [k, v] of Object.entries(iconAttrs)) {
+        if (k.toLowerCase().startsWith('data-')) dataset[kebabToCamel(k.slice(5).toLowerCase())] = v;
+    }
+    const className = iconAttrs['class'] || 'item-create';
+    const classes = className.split(/\s+/).filter(Boolean);
+    const target = {
+        dataset,
+        className,
+        classList: { value: className, contains: (c) => classes.includes(c) },
+        getAttribute: (n) => (n in iconAttrs ? iconAttrs[n] : null),
+        hasAttribute: (n) => n in iconAttrs,
+        closest: (sel) => (sel === '.item-create' ? target : headerEl.closest(sel)),
+    };
+    return {
+        preventDefault() {},
+        stopPropagation() {},
+        currentTarget: target,
+        target,
+    };
+}
+
+/** A header element built from a hand-written attribute map. Used only by the p2p regression
+ *  guards, which are about the generic base method rather than the sprite sections. */
+const syntheticHeader = (attrs) => headerElement({ class: 'list-header item-section', ...attrs });
+
+/** `Object.create(prototype)` bypass -- avoids the real constructor / defaultOptions chain. */
+function makeFakeSheet(Ctor_, actor, { selectedInventory } = {}) {
+    const fakeThis = Object.create(Ctor_.prototype);
+    fakeThis.object = actor;
+    fakeThis._inventoryOpenClose = {};
+    fakeThis.selectedInventory = selectedInventory ?? actor.defaultInventory.name;
+    return fakeThis;
+}
+
+/** Fire a single `.item-create` click through the given sheet class's real, unmodified
+ *  `_onItemCreate(event)` -- ALWAYS the single-argument public entry point, exactly as the
+ *  real DOM listener invokes it. */
+async function createItem(Ctor_, headerEl, { actorOpts, sheetOpts } = {}) {
+    const actor = makeActor(actorOpts);
+    const fakeThis = makeFakeSheet(Ctor_, actor, sheetOpts);
+    await quietAsync(() => fakeThis._onItemCreate(makeClickEvent(headerEl)));
+    return { actor, fakeThis, item: actor.created[0] };
+}
+
+/** Which of the rendered sections would this created item actually show up under, applying
+ *  the exact predicate the shipped read-path template uses (general: no optional value, or
+ *  'standard'). */
+function bucket(item) {
+    const opt = item?.system?.optional;
+    if (opt === undefined || opt === null || opt === '' || opt === 'standard') return 'standard';
+    return String(opt);
+}
+
+function requireSections() {
+    if (!SECTIONS) throw new Error(`could not render the sprite power section headers: ${SECTION_ERROR}`);
+    return SECTIONS;
+}
+function requireRows() {
+    if (!ROWS) throw new Error(`could not render the sprite power rows: ${ROWS_ERROR}`);
+    return ROWS;
+}
+
+// ── Enable/disable toggle fixtures ────────────────────────────────────────────
+
+/** An item stand-in for the toggle entry point. `update` is recorded too, so a fix (or a
+ *  rewrite) that goes through the document instead of the actor is read the same way. */
+function makeToggleItem({ type = 'sprite_power', optional = 'enabled_option', enabled = true } = {}) {
+    const updates = [];
+    return {
+        _id: 'toggle-fixture',
+        id: 'toggle-fixture',
+        type,
+        name: 'ToggleFixture',
+        isCritterPower: type === 'critter_power',
+        isSpritePower: type === 'sprite_power',
+        system: { optional, enabled },
+        updates,
+        async update(data) {
+            updates.push(data);
+        },
+    };
+}
+
+/** An Actor stand-in for the toggle entry point. `items.get` answers with the fixture for any
+ *  id, so the suite never depends on how the sheet derives the clicked row's id. */
+function makeToggleActor(item) {
+    const updates = item.updates;
+    return {
+        name: 'Test Sprite',
+        items: {
+            get: () => item,
+            find: () => item,
+        },
+        async updateEmbeddedDocuments(_docType, dataArr) {
+            for (const d of dataArr || []) updates.push(d);
+            return dataArr;
+        },
+        render() {},
+    };
+}
+
+/** A synthetic click on a row's enable/disable control. `closest` answers with the row for
+ *  every selector, so whichever ancestor the sheet reaches for, it finds the row. */
+function makeToggleEvent(itemId = 'toggle-fixture') {
+    const attrs = { class: 'list-item', 'data-item-id': itemId };
+    const el = headerElement(attrs);
+    el.closest = () => el;
+    return { preventDefault() {}, stopPropagation() {}, currentTarget: el, target: el };
+}
+
+/** Apply one recorded update payload onto a plain `system` object. Accepts flat dotted keys
+ *  (`'system.optional'`, `'optional'`) and a nested `system` object alike, so the assertion
+ *  is about the resulting item state rather than about the shape of the call. */
+function applyUpdate(system, payload) {
+    if (!payload || typeof payload !== 'object') return;
+    for (const [key, value] of Object.entries(payload)) {
+        if (key === '_id') continue;
+        if (key === 'system' && value && typeof value === 'object') {
+            for (const [k, v] of Object.entries(value)) system[k] = v;
+            continue;
+        }
+        if (key.startsWith('system.')) {
+            system[key.slice('system.'.length)] = value;
+            continue;
+        }
+        if (key === 'optional' || key === 'enabled') system[key] = value;
+    }
+}
+
+/** Drive the sheet's real `_onListItemToggleEnabled(event)` once and report the item state
+ *  it leaves behind, plus how many updates it issued at all. */
+async function toggleEnabled(Ctor_, itemOpts) {
+    const item = makeToggleItem(itemOpts);
+    const actor = makeToggleActor(item);
+    const fakeThis = Object.create(Ctor_.prototype);
+    fakeThis.object = actor;
+    await quietAsync(() => fakeThis._onListItemToggleEnabled(makeToggleEvent()));
+    const after = { ...item.system };
+    for (const payload of item.updates) applyUpdate(after, payload);
+    return { item, after, updateCount: item.updates.length };
+}
+
+// ══════════════════════════════════════════════════════════════════════════
+// f2p — fail on the shipped state, pass once every reported defect is fixed.
+// ══════════════════════════════════════════════════════════════════════════
+
+// [f2p] Adding from the "Optional / Enabled" header must file the new power in ITS OWN
+// section. 'enabled_option' is the value the item's own data model already uses for it.
+await safeAsync(CASE_NAMES[0], async () => {
+    const { enabled } = requireSections();
+    const { item } = await createItem(Ctor.SR5SpriteActorSheet, enabled);
+    const got = item?.system?.optional;
+    if (got === 'enabled_option') record(CASE_NAMES[0], true);
+    else record(CASE_NAMES[0], false, `expected the new item's system.optional to be 'enabled_option', got ${JSON.stringify(got)}`);
+});
+
+// [f2p] Same defect, the "Optional / Disabled" header.
+await safeAsync(CASE_NAMES[1], async () => {
+    const { disabled } = requireSections();
+    const { item } = await createItem(Ctor.SR5SpriteActorSheet, disabled);
+    const got = item?.system?.optional;
+    if (got === 'disabled_option') record(CASE_NAMES[1], true);
+    else record(CASE_NAMES[1], false, `expected the new item's system.optional to be 'disabled_option', got ${JSON.stringify(got)}`);
+});
+
+// [f2p] The general section must keep filing into the general list, and the three headers must
+// resolve to three DISTINCT sections. Deliberately value-agnostic beyond the general case, so
+// it gates independence rather than repeating the two cases above.
+await safeAsync(CASE_NAMES[2], async () => {
+    const { general, enabled, disabled } = requireSections();
+    const g = bucket((await createItem(Ctor.SR5SpriteActorSheet, general)).item);
+    const e = bucket((await createItem(Ctor.SR5SpriteActorSheet, enabled)).item);
+    const d = bucket((await createItem(Ctor.SR5SpriteActorSheet, disabled)).item);
+
+    const problems = [];
+    if (g !== 'standard') problems.push(`the general section files into '${g}' instead of the general list`);
+    if (new Set([g, e, d]).size !== 3)
+        problems.push(
+            `the three headers file into ${JSON.stringify([g, e, d])} -- they must land in three different sections`,
+        );
+    if (problems.length === 0) record(CASE_NAMES[2], true);
+    else record(CASE_NAMES[2], false, problems.join(' || '));
+});
+
+// [f2p] Whichever of the three headers is clicked, what gets created has to be a sprite power
+// -- a section of the Sprite Powers tab that creates some other kind of item creates nothing
+// the tab can ever show.
+await safeAsync(CASE_NAMES[3], async () => {
+    const sections = requireSections();
+    const problems = [];
+    for (const key of ['general', 'enabled', 'disabled']) {
+        const { item } = await createItem(Ctor.SR5SpriteActorSheet, sections[key]);
+        if (item?.type !== 'sprite_power') {
+            problems.push(`the ${key} section creates an item of type ${JSON.stringify(item?.type)}`);
+        }
+    }
+    if (problems.length === 0) record(CASE_NAMES[3], true);
+    else record(CASE_NAMES[3], false, problems.join(' || '));
+});
+
+// [f2p] Read side: a power already carrying each optional value must be listed under the
+// matching section, exactly once. Nothing here cares HOW the template selects its rows.
+await safeAsync(CASE_NAMES[4], async () => {
+    const rows = requireRows();
+    const expected = { standard: 'general', enabled_option: 'enabled', disabled_option: 'disabled' };
+    const problems = [];
+    for (const [key, wantSection] of Object.entries(expected)) {
+        const row = rows.byKey[key];
+        if (!row || row.count === 0) {
+            problems.push(`a sprite power with system.optional '${key}' renders no row at all`);
+            continue;
+        }
+        if (row.count !== 1) problems.push(`the '${key}' power renders ${row.count} rows, expected exactly 1`);
+        if (row.section !== wantSection)
+            problems.push(`the '${key}' power is listed under the '${row.section}' section, expected '${wantSection}'`);
+    }
+    if (problems.length === 0) record(CASE_NAMES[4], true);
+    else record(CASE_NAMES[4], false, problems.join(' || '));
+});
+
+// [f2p] Read side: the enable/disable control belongs to the powers that CAN be enabled or
+// disabled -- the two optional ones -- and to no others. Offering it on a non-optional power,
+// or withholding it from an optional one, is the same defect seen from two sides.
+await safeAsync(CASE_NAMES[5], async () => {
+    const rows = requireRows();
+    const expected = { standard: false, enabled_option: true, disabled_option: true };
+    const problems = [];
+    for (const [key, want] of Object.entries(expected)) {
+        const row = rows.byKey[key];
+        if (!row || row.count === 0) {
+            problems.push(`a sprite power with system.optional '${key}' renders no row at all`);
+            continue;
+        }
+        if (row.hasEnableToggle !== want) {
+            problems.push(
+                want
+                    ? `the '${key}' power's row offers no enable/disable control`
+                    : `the '${key}' power's row offers an enable/disable control it should not have`,
+            );
+        }
+    }
+    if (problems.length === 0) record(CASE_NAMES[5], true);
+    else record(CASE_NAMES[5], false, problems.join(' || '));
+});
+
+// [f2p] Toggle side: flipping an optional power moves it to the other optional section AND
+// leaves it in the enabled state that section means. The two halves must agree -- a power
+// sitting under "Disabled" that reports itself as enabled is the same bug either way round.
+await safeAsync(CASE_NAMES[6], async () => {
+    const problems = [];
+
+    const off = await toggleEnabled(Ctor.SR5SpriteActorSheet, { optional: 'enabled_option', enabled: true });
+    if (off.updateCount === 0) problems.push('toggling an enabled optional power updated nothing');
+    if (off.after.optional !== 'disabled_option')
+        problems.push(`toggling an enabled optional power left system.optional as ${JSON.stringify(off.after.optional)}`);
+    if (off.after.enabled !== false)
+        problems.push(`after toggling OFF, system.enabled is ${JSON.stringify(off.after.enabled)}, expected false`);
+
+    const on = await toggleEnabled(Ctor.SR5SpriteActorSheet, { optional: 'disabled_option', enabled: false });
+    if (on.updateCount === 0) problems.push('toggling a disabled optional power updated nothing');
+    if (on.after.optional !== 'enabled_option')
+        problems.push(`toggling a disabled optional power left system.optional as ${JSON.stringify(on.after.optional)}`);
+    if (on.after.enabled !== true)
+        problems.push(`after toggling ON, system.enabled is ${JSON.stringify(on.after.enabled)}, expected true`);
+
+    if (problems.length === 0) record(CASE_NAMES[6], true);
+    else record(CASE_NAMES[6], false, problems.join(' || '));
+});
+
+// ══════════════════════════════════════════════════════════════════════════
+// p2p — must pass on BOTH the shipped tree and the fixed tree.
+// ══════════════════════════════════════════════════════════════════════════
+
+// [p2p] Every OTHER actor sheet in the game must keep creating untagged items -- no
+// sprite-specific section handling may leak into the shared base behaviour.
+await safeAsync(CASE_NAMES[7], async () => {
+    const { item } = await createItem(Ctor.SR5BaseActorSheet, syntheticHeader({ 'data-item-id': 'gear' }));
+    const problems = [];
+    if (item?.type !== 'gear') problems.push(`type is ${JSON.stringify(item?.type)}`);
+    if (item?.system?.optional !== undefined) problems.push(`system.optional unexpectedly set to ${JSON.stringify(item.system.optional)}`);
+    if (problems.length === 0) record(CASE_NAMES[7], true);
+    else record(CASE_NAMES[7], false, problems.join(' || '));
+});
+
+// [p2p] On the sprite sheet itself, item types OTHER than 'sprite_power' (whose headers carry
+// no section discriminator either way) must stay exactly as before.
+await safeAsync(CASE_NAMES[8], async () => {
+    const { item } = await createItem(Ctor.SR5SpriteActorSheet, syntheticHeader({ 'data-item-id': 'gear' }));
+    const problems = [];
+    if (item?.type !== 'gear') problems.push(`type is ${JSON.stringify(item?.type)}`);
+    if (item?.system?.optional !== undefined) problems.push(`system.optional unexpectedly set to ${JSON.stringify(item.system.optional)}`);
+    if (problems.length === 0) record(CASE_NAMES[8], true);
+    else record(CASE_NAMES[8], false, problems.join(' || '));
+});
+
+// [p2p] Creating an item still unhides that item type's inventory section.
+await safeAsync(CASE_NAMES[9], async () => {
+    const actor = makeActor();
+    const fakeThis = makeFakeSheet(Ctor.SR5BaseActorSheet, actor);
+    await quietAsync(() => fakeThis._onItemCreate(makeClickEvent(syntheticHeader({ 'data-item-id': 'weapon' }))));
+    if (fakeThis._inventoryOpenClose.weapon === true) record(CASE_NAMES[9], true);
+    else record(CASE_NAMES[9], false, `_inventoryOpenClose.weapon is ${JSON.stringify(fakeThis._inventoryOpenClose.weapon)}`);
+});
+
+// [p2p] Creating an item while a non-default inventory is selected still files the new item
+// into that inventory.
+await safeAsync(CASE_NAMES[10], async () => {
+    const actor = makeActor({ defaultInventoryName: 'default' });
+    const fakeThis = makeFakeSheet(Ctor.SR5BaseActorSheet, actor, { selectedInventory: 'custom-pouch' });
+    await quietAsync(() => fakeThis._onItemCreate(makeClickEvent(syntheticHeader({ 'data-item-id': 'weapon' }))));
+    const calls = actor.addItemsCalls;
+    const ok = calls.length === 1 && calls[0].invName === 'custom-pouch' && calls[0].items.length === 1 && calls[0].items[0] === actor.created[0];
+    if (ok) record(CASE_NAMES[10], true);
+    else record(CASE_NAMES[10], false, `addItems calls: ${JSON.stringify(calls.map((c) => ({ invName: c.invName, n: c.items.length })))}`);
+});
+
+// [p2p] Every rendered section header still identifies the item type its own +Add creates --
+// the generic `data-item-id` contract the base sheet reads. A rewrite of the shared list
+// markup could easily drop it.
+await safeAsync(CASE_NAMES[11], async () => {
+    const sections = requireSections();
+    const problems = [];
+    for (const key of ['general', 'enabled', 'disabled']) {
+        const el = sections[key];
+        const id = el.dataset.itemId ?? el.iconAttrs?.['data-item-id'];
+        if (!id) problems.push(`the ${key} section header renders no item type id`);
+    }
+    if (problems.length === 0) record(CASE_NAMES[11], true);
+    else record(CASE_NAMES[11], false, problems.join(' || '));
+});
+
+// [p2p] The toggle entry point still declines what it never handled: a non-optional power has
+// nothing to flip, and a non-power item is none of its business.
+await safeAsync(CASE_NAMES[12], async () => {
+    const problems = [];
+
+    const standard = await toggleEnabled(Ctor.SR5SpriteActorSheet, { optional: 'standard', enabled: true });
+    if (standard.updateCount !== 0) problems.push(`toggling a non-optional power issued ${standard.updateCount} update(s)`);
+
+    const gear = await toggleEnabled(Ctor.SR5SpriteActorSheet, { type: 'gear', optional: 'enabled_option', enabled: true });
+    if (gear.updateCount !== 0) problems.push(`toggling a non-power item issued ${gear.updateCount} update(s)`);
+
+    if (problems.length === 0) record(CASE_NAMES[12], true);
+    else record(CASE_NAMES[12], false, problems.join(' || '));
+});
+
+// ── Report ───────────────────────────────────────────────────────────────────
+
+writeReport(results);
+for (const r of results) {
+    console.log(`${r.passed ? 'PASS' : 'FAIL'} ${r.name}${r.passed ? '' : ` — ${r.msg}`}`);
+}
+const failed = results.filter((r) => !r.passed);
+process.exit(failed.length ? 1 : 0);
+
+// ── Utilities ────────────────────────────────────────────────────────────────
+
+function writeReport(cases) {
+    const failures = cases.filter((c) => !c.passed).length;
+    const rows = cases.map((c) => {
+        const inner = c.passed ? '' : `\n    <failure message="${esc(c.msg)}">${esc(c.msg)}</failure>`;
+        return `  <testcase classname="${SUITE}" name="${esc(c.name)}" time="0">` + inner + `\n  </testcase>`;
+    });
+    const xml =
+        `<?xml version="1.0" encoding="utf-8"?>\n` +
+        `<testsuite name="${SUITE}" tests="${cases.length}" ` +
+        `failures="${failures}" errors="0" time="1">\n` +
+        rows.join('\n') +
+        '\n</testsuite>\n';
+    mkdirSync(REPORT_DIR, { recursive: true });
+    writeFileSync(REPORT, xml, 'utf8');
+}
+
+function esc(s) {
+    return String(s ?? '')
+        .replace(/&/g, '&amp;')
+        .replace(/</g, '&lt;')
+        .replace(/>/g, '&gt;')
+        .replace(/"/g, '&quot;');
+}
+
+function fatal(msg) {
+    const rows = CASE_NAMES.map(
+        (name) =>
+            `  <testcase classname="${SUITE}" name="${esc(name)}" time="0">\n` +
+            `    <error message="${esc(msg)}">${esc(msg)}</error>\n` +
+            `  </testcase>`,
+    );
+    const xml =
+        `<?xml version="1.0" encoding="utf-8"?>\n` +
+        `<testsuite name="${SUITE}" tests="${CASE_NAMES.length}" ` +
+        `failures="${CASE_NAMES.length}" errors="${CASE_NAMES.length}" time="0">\n` +
+        rows.join('\n') +
+        '\n</testsuite>\n';
+    mkdirSync(REPORT_DIR, { recursive: true });
+    writeFileSync(REPORT, xml, 'utf8');
+    console.error('FATAL:', msg);
+    process.exit(2);
+}
