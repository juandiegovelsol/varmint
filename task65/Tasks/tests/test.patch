+/**
+ * Copyright IBM Corp. 2026
+ *
+ * This source code is licensed under the Apache-2.0 license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+ * Behavioural checks for the date & time formatters' documented conventions:
+ * what a call WITHOUT explicit options must produce, and that every path
+ * honours the requested locale. Expected values are always derived from the
+ * Intl APIs directly, never hardcoded, so any correct implementation passes
+ * regardless of how it is written.
+ */
+
+import * as relative from './relative';
+import * as absolute from './absolute';
+
+const locale = 'en-US';
+const ts = Date.UTC(2016, 3, 28, 19, 12, 47); // 2016-04-28T19:12:47Z
+const tsEnd = Date.UTC(2018, 6, 1, 9, 0, 2); // 2018-07-01T09:00:02Z
+const timeZone = 'UTC';
+
+describe('relative.format conventions', () => {
+  test('moments under a minute old render as the current moment', () => {
+    const expected = new Intl.RelativeTimeFormat(locale, {
+      numeric: 'auto',
+      style: 'long',
+    }).format(0, 'seconds');
+    const actual = relative.format(Date.now() - 1000 * 50, { locale });
+    expect(actual).toBe(expected);
+  });
+
+  test('default style is long', () => {
+    const expected = new Intl.RelativeTimeFormat(locale, {
+      style: 'long',
+    }).format(-1, 'hours');
+    const actual = relative.format(Date.now() - 1000 * 60 * 60, { locale });
+    expect(actual).toBe(expected);
+  });
+
+  test('sub-minute moments honour the requested locale', () => {
+    const expected = new Intl.RelativeTimeFormat('de-DE', {
+      numeric: 'auto',
+      style: 'long',
+    }).format(0, 'seconds');
+    const actual = relative.format(Date.now() - 1000 * 30, {
+      locale: 'de-DE',
+    });
+    expect(actual).toBe(expected);
+  });
+});
+
+describe('absolute conventions', () => {
+  test('formatTime defaults to the short time style', () => {
+    const expected = new Intl.DateTimeFormat(locale, {
+      timeStyle: 'short',
+      timeZone,
+    }).format(ts);
+    const actual = absolute.formatTime(ts, { locale, timeZone });
+    expect(actual).toBe(expected);
+  });
+
+  test('formatDate defaults to the medium date style', () => {
+    const expected = new Intl.DateTimeFormat(locale, {
+      dateStyle: 'medium',
+      timeZone,
+    }).format(ts);
+    const actual = absolute.formatDate(ts, { locale, timeZone });
+    expect(actual).toBe(expected);
+  });
+
+  test('format defaults to medium date with short time', () => {
+    const expected = new Intl.DateTimeFormat(locale, {
+      dateStyle: 'medium',
+      timeStyle: 'short',
+      timeZone,
+    }).format(ts);
+    const actual = absolute.format(ts, { locale, timeZone });
+    expect(actual).toBe(expected);
+  });
+
+  test('formatRange defaults to medium date with short time', () => {
+    const expected = new Intl.DateTimeFormat(locale, {
+      dateStyle: 'medium',
+      timeStyle: 'short',
+      timeZone,
+    }).formatRange(ts, tsEnd);
+    const actual = absolute.formatRange(ts, tsEnd, { locale, timeZone });
+    expect(actual).toBe(expected);
+  });
+
+  test('formatRange honours the requested locale', () => {
+    const expected = new Intl.DateTimeFormat('de-DE', {
+      dateStyle: 'medium',
+      timeStyle: 'short',
+      timeZone,
+    }).formatRange(ts, tsEnd);
+    const actual = absolute.formatRange(ts, tsEnd, {
+      locale: 'de-DE',
+      dateStyle: 'medium',
+      timeStyle: 'short',
+      timeZone,
+    });
+    expect(actual).toBe(expected);
+  });
+});
