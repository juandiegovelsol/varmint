+    /**
+     * The AP field accepts fractional values (e.g. the Elemental Body adept power).
+     * Fractions must combine with every other modifier before the total is rounded, the
+     * total must always round up (never down), and deriving a total must not mutate the source.
+     */
+    describe('Fractional Armor Penetration', () => {
+        it('Should keep a fractional base value on the source AP field', () => {
+            const damage = DataDefaults.createData('damage', { ap: { base: -2.5 } });
+            assert.equal(damage.ap.base, -2.5);
+        });
+
+        it('Should round the total up, never down', () => {
+            const positive = DataDefaults.createData('damage', { ap: { base: 2.5 } }).ap;
+            assert.equal(ModifiableValue.calcTotal(positive), 3);
+
+            // -2.5 rounds up (towards zero) to -2, not down to -3.
+            const negative = DataDefaults.createData('damage', { ap: { base: -2.5 } }).ap;
+            assert.equal(ModifiableValue.calcTotal(negative), -2);
+
+            const whole = DataDefaults.createData('damage', { ap: { base: -3 } }).ap;
+            assert.equal(ModifiableValue.calcTotal(whole), -3);
+        });
+
+        it('Should combine fractional base with modifiers before rounding once', () => {
+            const ap = DataDefaults.createData('damage', { ap: { base: -2.5 } }).ap;
+            // Rounding once at the end: -2.5 + 1 = -1.5 -> -1.
+            // Rounding the base first would give -3 + 1 = -2, which is wrong.
+            ModifiableValue.add(ap, 'SR5.TestMod', 1);
+            assert.equal(ModifiableValue.calcTotal(ap), -1);
+        });
+
+        it('Should respect modifier order when a fractional value is present', () => {
+            const ap = DataDefaults.createData('damage', { ap: { base: -1.5 } }).ap;
+            // A higher priority OVERRIDE must mask the lower priority additions regardless of the fraction.
+            ModifiableValue.add(ap, 'SR5.Low', 2, CONST.ACTIVE_EFFECT_MODES.ADD, 10);
+            ModifiableValue.add(ap, 'SR5.Override', -4, CONST.ACTIVE_EFFECT_MODES.OVERRIDE, 50);
+            assert.equal(ModifiableValue.calcTotal(ap), -4);
+        });
+
+        it('Should not alter the source AP when deriving a total from it', async () => {
+            const actor = await factory.createActor({ type: 'character' });
+            const damage = DataDefaults.createData('damage', { ap: { base: 2.5 } });
+
+            const derived = ActionFlow.calcDamageData(damage, actor);
+
+            // The derived copy is resolved and rounded up...
+            assert.equal(derived.ap.value, 3);
+            // ...while the original it came from is untouched (still fractional, no changes added).
+            assert.equal(damage.ap.base, 2.5);
+            assert.equal(damage.ap.changes.length, 0);
+        });
+    });
+
     describe('Damage on armor', () => {
