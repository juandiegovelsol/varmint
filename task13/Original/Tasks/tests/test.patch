+#!/usr/bin/env node
+/**
+ * tests/scrollbar-corner-test.js — Behavioral pixel tests for the scrollbar-corner fix.
+ *
+ * Observable signal: In Chromium (headful via Xvfb), custom `::-webkit-scrollbar` CSS
+ * forces traditional (non-overlay) scrollbars, causing a visible corner widget at the
+ * intersection of both scrollbars.  Without the fix, that corner widget renders white
+ * (#FFFFFF).  After the fix suppresses the native widget, the scroll container's own
+ * background shows through instead.
+ *
+ * Why headful (not headless)?  Headless Chrome 112+ uses overlay scrollbars regardless
+ * of `::-webkit-scrollbar` CSS, so the corner widget never appears — no signal to test.
+ * Headful Chrome via Xvfb respects the CSS and renders traditional scrollbars with a
+ * visible corner.  test.sh starts Xvfb and exports DISPLAY before running this script.
+ *
+ * ── Test inventory ───────────────────────────────────────────────────────────────
+ *   f2p  scrollbar_corner::test_corner_not_white
+ *          The original signal: on a dark container the corner must not be white.
+ *
+ *   f2p  scrollbar_corner_edge::test_corner_matches_container_background
+ *          Edge case.  Renders two containers with DISTINCTIVE, non-theme backgrounds
+ *          (magenta, teal) and requires the corner of each to match its OWN container
+ *          background, with zero white pixels anywhere in the corner square.
+ *          This rejects two classes of shallow fix that the test above accepts:
+ *            (a) painting the corner a hard-coded theme colour (e.g. background:#1a1a1a),
+ *                which is wrong for any differently-coloured scroll container;
+ *            (b) partial suppression that leaves white edge/inset pixels behind, since
+ *                every pixel of the corner is inspected rather than just the centre.
+ *
+ *   p2p  scrollbar_chrome::test_custom_scrollbar_metrics_and_thumb_preserved
+ *          Regression guard for the behaviour ADJACENT to the corner: the repo's custom
+ *          scrollbar sizing and its custom thumb colour.  A fix that suppresses the
+ *          corner by weakening or removing the surrounding `::-webkit-scrollbar` /
+ *          `::-webkit-scrollbar-thumb` rules (or by nuking the stylesheet wholesale)
+ *          makes the f2p tests pass while destroying the game's scrollbar styling.
+ *          This test holds on the base commit AND after the fix.
+ *
+ * ── Implementation-agnostic by construction ──────────────────────────────────────
+ * No test greps, matches, or inspects the candidate's source for CSS text, selectors,
+ * property names, or keywords.  The stylesheet is handed to a real browser and every
+ * assertion reads back either rendered pixels or geometry measured from the live DOM.
+ * Any fix that produces the correct rendering passes, however it is written.
+ *
+ * JUnit XML is written to /logs/verifier/report.xml for verifier.py to parse.
+ */
+'use strict';
+
+const { chromium } = require('playwright');
+const { PNG } = require('pngjs');
+const fs = require('fs');
+const path = require('path');
+
+const LOG_DIR    = '/logs/verifier';
+const REPORT     = path.join(LOG_DIR, 'report.xml');
+const SCREENSHOT = path.join(LOG_DIR, 'corner-screenshot.png');
+const CSS_FILE   = '/app/public/stylesheets/styles.css';
+
+// If every channel >= this, the corner is the native white widget (bug present).
+const WHITE_THRESHOLD = 200;
+// Per-channel tolerance when comparing a rendered pixel to an expected colour.
+const COLOR_TOLERANCE = 10;
+// The repo's custom thumb colour is `grey` == rgb(128,128,128).
+const THUMB_GREY = [128, 128, 128];
+const THUMB_TOLERANCE = 24;
+// The repo sets `::-webkit-scrollbar { width: 1.6rem }` with `html { font-size: 62.5% }`,
+// i.e. 1.6 x 10px = 16px.  Expected width is derived from the live root font-size rather
+// than hard-coded, so the assertion follows the app's own CSS instead of a magic number.
+const SB_WIDTH_REM = 1.6;
+
+// Every test that must appear in the report, so a crash cannot leave a test silently
+// "missing" (which verifier.py would otherwise not count as a failure).
+const ALL_TESTS = [
+  ['scrollbar_corner',      'test_corner_not_white'],
+  ['scrollbar_corner_edge', 'test_corner_matches_container_background'],
+  ['scrollbar_chrome',      'test_custom_scrollbar_metrics_and_thumb_preserved'],
+];
+
+// Scroll containers rendered on the test page.  Distinctive backgrounds are deliberate:
+// they must not coincide with the game theme, so a hard-coded colour cannot satisfy them.
+const BOXES = [
+  { id: 'dark',    bg: '#1a1a1a', rgb: [26, 26, 26],   top: 20  },
+  { id: 'magenta', bg: '#ff00ff', rgb: [255, 0, 255],  top: 250 },
+  { id: 'teal',    bg: '#00807f', rgb: [0, 128, 127],  top: 480 },
+];
+
+function esc(s) {
+  return String(s).replace(/]]>/g, ']]]]><![CDATA[>');
+}
+
+/** Write one JUnit report containing every result. */
+function writeReport(results) {
+  fs.mkdirSync(LOG_DIR, { recursive: true });
+  const failures = results.filter(r => r.status === 'fail').length;
+  const errors   = results.filter(r => r.status === 'error').length;
+  const suites = results.map(r => {
+    let body = '';
+    if (r.status === 'fail') {
+      body = `\n      <failure message="assertion failed"><![CDATA[${esc(r.message)}]]></failure>\n    `;
+    } else if (r.status === 'error') {
+      body = `\n      <error message="test crashed"><![CDATA[${esc(r.message)}]]></error>\n    `;
+    }
+    return `  <testsuite name="${r.classname}" tests="1" failures="${r.status === 'fail' ? 1 : 0}" errors="${r.status === 'error' ? 1 : 0}" time="0">
+    <testcase classname="${r.classname}" name="${r.name}" time="0">${body}</testcase>
+  </testsuite>`;
+  }).join('\n');
+  fs.writeFileSync(REPORT,
+`<?xml version="1.0" encoding="UTF-8"?>
+<testsuites name="scrollbar" tests="${results.length}" failures="${failures}" errors="${errors}" time="0">
+${suites}
+</testsuites>
+`);
+}
+
+/** Mark every test as errored — used when the page/browser never produced pixels. */
+function writeErrorReport(err) {
+  writeReport(ALL_TESTS.map(([classname, name]) => ({
+    classname, name, status: 'error', message: `Test crashed: ${String(err)}`,
+  })));
+}
+
+const near = (actual, expected, tol) =>
+  actual.every((c, i) => Math.abs(c - expected[i]) <= tol);
+const isWhite = ([r, g, b]) =>
+  r >= WHITE_THRESHOLD && g >= WHITE_THRESHOLD && b >= WHITE_THRESHOLD;
+const fmt = ([r, g, b]) => `rgb(${r},${g},${b})`;
+
+async function main() {
+  fs.mkdirSync(LOG_DIR, { recursive: true });
+
+  // Read the game's stylesheet so Playwright can inject it into the test page.
+  // This is purely behavioral: the CSS is rendered in a real browser and only pixels
+  // and measured geometry are asserted on.  The text is never searched.
+  const css = fs.readFileSync(CSS_FILE, 'utf8');
+
+  const browser = await chromium.launch({
+    headless: false,
+    args: [
+      '--no-sandbox',
+      '--disable-setuid-sandbox',
+      '--disable-dev-shm-usage',
+      '--force-color-profile=srgb',
+      '--window-size=900,760',
+    ],
+  });
+
+  const results = [];
+  try {
+    const page = await browser.newPage({ viewport: { width: 900, height: 760 } });
+
+    // Each container is 300x200 with 600x400 content, so both scrollbars always appear.
+    //
+    // IMPORTANT: the game's global CSS includes `html { scrollbar-color: grey transparent }`.
+    // In Chrome 121+, a transparent track makes the corner transparent even on the base
+    // commit, which would make the tests non-discriminating.  `scrollbar-color: initial`
+    // resets to the platform default so the native white corner renders on base; the fix
+    // then overrides that widget back to transparent, restoring discrimination.
+    const html = `<!DOCTYPE html>
+<html>
+<head>
+  <style>
+    html, body { margin: 0; padding: 0; background: #444444; }
+    .sb {
+      position: absolute;
+      left: 40px;
+      width: 300px; height: 200px;
+      overflow: scroll;
+      scrollbar-color: initial !important;
+    }
+    .inner { width: 600px; height: 400px; }
+  </style>
+</head>
+<body>
+${BOXES.map(b => `  <div class="sb" id="${b.id}" style="top:${b.top}px;background:${b.bg}">` +
+  `<div class="inner" style="background:${b.bg}"></div></div>`).join('\n')}
+</body>
+</html>`;
+
+    await page.setContent(html, { waitUntil: 'domcontentloaded' });
+    // Inject the game's CSS — its ::-webkit-scrollbar rules force traditional scrollbars
+    // so that a corner widget exists at all.
+    await page.addStyleTag({ content: css });
+    await page.waitForTimeout(800);   // let layout + Xvfb composite settle
+
+    const measured = await page.evaluate(() => {
+      const out = {
+        rootFontSizePx: parseFloat(getComputedStyle(document.documentElement).fontSize),
+        boxes: {},
+      };
+      for (const el of document.querySelectorAll('.sb')) {
+        const r = el.getBoundingClientRect();
+        out.boxes[el.id] = {
+          x: r.x, y: r.y, w: r.width, h: r.height,
+          sbW: el.offsetWidth - el.clientWidth,
+          sbH: el.offsetHeight - el.clientHeight,
+        };
+      }
+      return out;
+    });
+    console.log('Measured geometry:', JSON.stringify(measured));
+
+    // ── Hard guard: no scrollbars means no signal ────────────────────────────────
+    // If the browser rendered overlay (zero-width) scrollbars there is no corner
+    // widget to observe, so every result would be a meaningless pass.  Fail loudly
+    // instead of silently scoring the suite as if the fix were present.
+    const noSignal = Object.entries(measured.boxes)
+      .filter(([, g]) => !(g.sbW > 0 && g.sbH > 0))
+      .map(([id, g]) => `${id}(sbW=${g.sbW},sbH=${g.sbH})`);
+    if (noSignal.length) {
+      throw new Error(
+        `No traditional scrollbars rendered for: ${noSignal.join(', ')}. ` +
+        `Overlay or zero-width scrollbars mean the corner widget does not exist, so ` +
+        `these tests cannot discriminate.  Check that Chromium ran headful under Xvfb.`);
+    }
+
+    const buf = await page.screenshot({ path: SCREENSHOT });
+    const png = PNG.sync.read(buf);
+    const px = (x, y) => {
+      const i = (Math.round(y) * png.width + Math.round(x)) * 4;
+      return [png.data[i], png.data[i + 1], png.data[i + 2]];
+    };
+    // Every pixel of a container's corner square.
+    const cornerPixels = (g) => {
+      const out = [];
+      for (let dy = 0; dy < g.sbH; dy++)
+        for (let dx = 0; dx < g.sbW; dx++)
+          out.push(px(g.x + g.w - g.sbW + dx, g.y + g.h - g.sbH + dy));
+      return out;
+    };
+    const cornerCenter = (g) =>
+      px(g.x + g.w - g.sbW / 2, g.y + g.h - g.sbH / 2);
+
+    // ── f2p 1: the original signal, on a dark container ─────────────────────────
+    {
+      const g = measured.boxes.dark;
+      const c = cornerCenter(g);
+      const pass = !isWhite(c);
+      results.push({
+        classname: 'scrollbar_corner', name: 'test_corner_not_white',
+        status: pass ? 'pass' : 'fail',
+        message: pass
+          ? `corner pixel ${fmt(c)} is not white`
+          : `corner pixel ${fmt(c)} is white — the native corner widget is still rendered`,
+      });
+      console.log(`[f2p] dark corner ${fmt(c)} -> ${pass ? 'PASS' : 'FAIL'}`);
+    }
+
+    // ── f2p 2 (new): corner must show each container's OWN background ────────────
+    {
+      const problems = [];
+      for (const b of BOXES.filter(b => b.id !== 'dark')) {
+        const g   = measured.boxes[b.id];
+        const c   = cornerCenter(g);
+        const all = cornerPixels(g);
+        const whites = all.filter(isWhite).length;
+        if (whites > 0) {
+          problems.push(`${b.id}: ${whites}/${all.length} corner pixels are white ` +
+                        `(centre ${fmt(c)}) — corner widget not fully suppressed`);
+        } else if (!near(c, b.rgb, COLOR_TOLERANCE)) {
+          problems.push(`${b.id}: corner is ${fmt(c)} but the container background is ` +
+                        `${fmt(b.rgb)} — corner does not adopt its container's background ` +
+                        `(a hard-coded corner colour does not fix differently-coloured containers)`);
+        }
+      }
+      const pass = problems.length === 0;
+      results.push({
+        classname: 'scrollbar_corner_edge',
+        name: 'test_corner_matches_container_background',
+        status: pass ? 'pass' : 'fail',
+        message: pass
+          ? 'corner adopts each container background with no white pixels'
+          : problems.join('\n'),
+      });
+      console.log(`[f2p] corner-vs-background -> ${pass ? 'PASS' : 'FAIL'}` +
+                  (pass ? '' : `\n  ${problems.join('\n  ')}`));
+    }
+
+    // ── p2p (new): adjacent scrollbar chrome must be unchanged ───────────────────
+    {
+      const problems = [];
+      const expectedW = Math.round(SB_WIDTH_REM * measured.rootFontSizePx);
+      for (const b of BOXES) {
+        const g = measured.boxes[b.id];
+        // Custom scrollbar sizing still in effect (a removed/overridden width rule
+        // falls back to the narrower native scrollbar).
+        if (g.sbW !== expectedW) {
+          problems.push(`${b.id}: vertical scrollbar is ${g.sbW}px wide, expected ` +
+                        `${expectedW}px from the stylesheet's own sizing ` +
+                        `(${SB_WIDTH_REM}rem at root ${measured.rootFontSizePx}px)`);
+        }
+        // Custom thumb colour still painted.  Sample down the upper part of the track,
+        // which the thumb occupies while scrolled to the top, staying clear of its
+        // transparent border inset.
+        const xs = g.x + g.w - g.sbW / 2;
+        const samples = [8, 20, 32, 44, 56, 68].map(dy => px(xs, g.y + dy));
+        const greyish = samples.filter(s => near(s, THUMB_GREY, THUMB_TOLERANCE)).length;
+        if (greyish < samples.length - 1) {
+          problems.push(`${b.id}: thumb samples ${samples.map(fmt).join(' ')} — only ` +
+                        `${greyish}/${samples.length} match the custom thumb colour ` +
+                        `${fmt(THUMB_GREY)}; the custom thumb styling was lost`);
+        }
+      }
+      const pass = problems.length === 0;
+      results.push({
+        classname: 'scrollbar_chrome',
+        name: 'test_custom_scrollbar_metrics_and_thumb_preserved',
+        status: pass ? 'pass' : 'fail',
+        message: pass
+          ? 'custom scrollbar width and thumb colour preserved on every container'
+          : problems.join('\n'),
+      });
+      console.log(`[p2p] scrollbar chrome -> ${pass ? 'PASS' : 'FAIL'}` +
+                  (pass ? '' : `\n  ${problems.join('\n  ')}`));
+    }
+
+  } finally {
+    await browser.close();
+  }
+
+  writeReport(results);
+  const failed = results.filter(r => r.status !== 'pass');
+  console.log(`${results.length - failed.length}/${results.length} tests passed`);
+  process.exit(failed.length ? 1 : 0);
+}
+
+main().catch(err => {
+  console.error('Uncaught error:', err);
+  writeErrorReport(err);
+  process.exit(1);
+});
