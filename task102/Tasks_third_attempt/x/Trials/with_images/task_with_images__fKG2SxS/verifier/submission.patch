new file mode 100644
index 0000000..bd38582
--- /dev/null
+++ b/apps/ai-dial-admin/src/components/Runs/grid-headers.ts
@@ -0,0 +1,24 @@
+import { ColDef, ColGroupDef } from 'ag-grid-community';
+
+import EllipsisHeader from '@/src/components/Grid/HeaderComponents/EllipsisHeader';
+import EllipsisHeaderGroup from '@/src/components/Grid/HeaderComponents/EllipsisHeaderGroup';
+
+export const ELLIPSIS_HEADER_PARAMS = { innerHeaderComponent: EllipsisHeader };
+
+export const RIGHT_ALIGNED_ELLIPSIS_HEADER_PARAMS = {
+  innerHeaderComponent: EllipsisHeader,
+  innerHeaderComponentParams: { isRightAligned: true },
+};
+
+/**
+ * Header defaults shared by the run results grids. Grid-level, so a label renders the same whether its
+ * column definition names a header renderer or not — including groups the columns panel rebuilds.
+ * Group rows keep the grid's header height, so every header row is spaced the same.
+ */
+export const RESULT_GRID_DEFAULT_COL_DEF: Pick<ColDef, 'headerComponentParams'> = {
+  headerComponentParams: ELLIPSIS_HEADER_PARAMS,
+};
+
+export const RESULT_GRID_DEFAULT_COL_GROUP_DEF: Pick<ColGroupDef, 'headerGroupComponent'> = {
+  headerGroupComponent: EllipsisHeaderGroup,
+};
