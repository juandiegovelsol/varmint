+import {LexicalComposer} from '@lexical/react/LexicalComposer';
+import {useLexicalComposerContext} from '@lexical/react/LexicalComposerContext';
+import {ContentEditable} from '@lexical/react/LexicalContentEditable';
+import {createBinding} from '@lexical/yjs';
+import {
+  $createParagraphNode,
+  $createTextNode,
+  $getRoot,
+  $getSelection,
+  $isElementNode,
+  $isRangeSelection,
+  $isTextNode,
+  LexicalEditor,
+  ParagraphNode,
+  TextNode,
+} from 'lexical';
+import * as React from 'react';
+import {act, useEffect, useMemo, useState} from 'react';
+import {createRoot, type Root} from 'react-dom/client';
+import {afterEach, describe, expect, it} from 'vitest';
+import * as Y from 'yjs';
+
+import {
+  useYjsCollaboration,
+  useYjsFocusTracking,
+} from '../../shared/useYjsCollaboration';
+
+/**
+ * ===========================================================================
+ * What this file tests
+ * ===========================================================================
+ * Two or more people editing the same document at the same time. Besides the
+ * text itself, each participant sees where the others are: their caret and the
+ * range they have selected. This file drives that end to end -- real editors,
+ * real document replication, a real cross-client presence channel -- and asserts
+ * only on what one participant can observe about the others.
+ *
+ * Everything here is deliberately observational. No assertion names a source
+ * file, a function, an event, a hook or a subscription: any implementation that
+ * puts the right participant state on screen at the right time passes, and any
+ * implementation that does not, does not.
+ *
+ * ---------------------------------------------------------------------------
+ * jsdom capability shims
+ * ---------------------------------------------------------------------------
+ * The two shims below exist only because jsdom ships no CSS layout engine. They
+ * are unrelated to the behaviour under test and apply identically to every
+ * candidate:
+ *
+ *  1. `HTMLElement.offsetParent` is hardcoded to `null` for every element in
+ *     jsdom, where a real browser returns the nearest positioned ancestor.
+ *     Collaboration cursor rendering reads a `null` offsetParent as "this editor
+ *     is not on screen", so without this shim NO participant state would be
+ *     resolved in this environment -- on a broken and on a correct build alike.
+ *  2. `Range.prototype.getClientRects` / `getBoundingClientRect` do not exist in
+ *     jsdom at all, and `Element.prototype.scrollIntoView` is missing. They are
+ *     stubbed to report no rectangles / an empty rect / nothing, which is the
+ *     honest answer where there is no layout. The tests therefore assert on
+ *     resolved positions (document offsets and node identity) and never on pixel
+ *     geometry, so nothing below depends on invented coordinates.
+ */
+Object.defineProperty(HTMLElement.prototype, 'offsetParent', {
+  configurable: true,
+  get(this: HTMLElement): Element | null {
+    const {body} = this.ownerDocument;
+    return this === body ? null : body;
+  },
+});
+if (
+  typeof (Range.prototype as {getClientRects?: unknown}).getClientRects !==
+  'function'
+) {
+  (
+    Range.prototype as unknown as {getClientRects: () => DOMRect[]}
+  ).getClientRects = () => [];
+}
+if (
+  typeof (Range.prototype as {getBoundingClientRect?: unknown})
+    .getBoundingClientRect !== 'function'
+) {
+  (
+    Range.prototype as unknown as {getBoundingClientRect: () => DOMRect}
+  ).getBoundingClientRect = () => new DOMRect(0, 0, 0, 0);
+}
+if (typeof Element.prototype.scrollIntoView !== 'function') {
+  Element.prototype.scrollIntoView = () => undefined;
+}
+
+/**
+ * The two collaboration types this file needs, derived from the public factory
+ * rather than imported by name, so the tests do not depend on which type names a
+ * candidate's implementation happens to export.
+ */
+type Binding = ReturnType<typeof createBinding>;
+type ProviderLike = Parameters<typeof createBinding>[1];
+
+/** Whatever the collaboration layer chooses to publish about a participant. */
+type EphemeralState = Record<string, unknown>;
+
+/**
+ * A working cross-client presence channel.
+ *
+ * The presence half of a collaboration session is not part of the replicated
+ * document: it is short-lived per-participant state (who is here and where their
+ * caret is) that every client publishes and every other client is notified
+ * about. This is a faithful, minimal implementation of
+ * exactly that and nothing more: publishing local state synchronously notifies
+ * every OTHER linked client's subscribers, with no payload, so subscribers
+ * always re-read the full participant map -- as the real protocol behaves.
+ *
+ * The suite brings its own rather than reusing the one in `./utils.tsx`, whose
+ * presence object is a deliberate stub (subscribe/unsubscribe are no-ops and it
+ * reports a single hardcoded participant id that the cursor layer treats as "not
+ * a real participant"). That stub is fine for tests that only care about
+ * document text, and it is intentionally NOT edited here: a candidate must not be
+ * able to change the harness by editing shared test infrastructure, so this file
+ * is self-contained apart from the product code under test.
+ */
+class FakeAwareness {
+  peers: FakeAwareness[] = [];
+  private localState: EphemeralState | null = null;
+  private listeners = new Set<() => void>();
+
+  constructor(readonly id: number) {}
+
+  getLocalState = (): EphemeralState | null => this.localState;
+
+  getStates = (): Map<number, EphemeralState> => {
+    const states = new Map<number, EphemeralState>();
+    for (const peer of this.peers) {
+      if (peer !== this && peer.localState !== null) {
+        states.set(peer.id, peer.localState);
+      }
+    }
+    return states;
+  };
+
+  setLocalState = (state: EphemeralState): void => {
+    this.localState = state;
+    this.broadcast();
+  };
+
+  setLocalStateField = (field: string, value: unknown): void => {
+    this.setLocalState({
+      ...(this.localState as EphemeralState),
+      [field]: value,
+    });
+  };
+
+  /**
+   * The participant's presence disappears entirely -- they closed the tab, or
+   * the session dropped them -- with no document mutation of any kind.
+   */
+  clearLocalState(): void {
+    this.localState = null;
+    this.broadcast();
+  }
+
+  on = (type: string, cb: () => void): void => {
+    // Checked at run time, not only through a TypeScript parameter type, so a
+    // candidate that subscribes to some other event name genuinely receives no
+    // callbacks -- exactly as it would against the real protocol.
+    if (type === 'update') {
+      this.listeners.add(cb);
+    }
+  };
+
+  off = (type: string, cb: () => void): void => {
+    if (type === 'update') {
+      this.listeners.delete(cb);
+    }
+  };
+
+  private broadcast(): void {
+    for (const peer of this.peers) {
+      if (peer !== this) {
+        // Snapshot before iterating: a subscriber reacting to this publication
+        // may add or remove another subscriber as a side effect.
+        Array.from(peer.listeners).forEach((cb) => cb());
+      }
+    }
+  }
+}
+
+/**
+ * The transport: a set of clients replicating one document to each other, each
+ * with its own replica, buffering updates for clients that are offline. Same
+ * shape as the connection the other collaboration tests use, inlined so this
+ * file's harness cannot be altered from outside the file.
+ */
+class TestConnection {
+  clients: TestClient[] = [];
+
+  createClient(): TestClient {
+    const client = new TestClient(this);
+    this.clients.push(client);
+    return client;
+  }
+}
+
+class TestClient {
+  readonly doc: Y.Doc = new Y.Doc({gc: false});
+  readonly awareness: FakeAwareness;
+  connected = false;
+  private buffered: Uint8Array[] = [];
+  private listeners = new Map<string, Set<(data: never) => void>>();
+
+  constructor(private connection: TestConnection) {
+    // A real presence protocol identifies a participant by the same id their
+    // document replica uses, so this does too.
+    this.awareness = new FakeAwareness(this.doc.clientID);
+    this.doc.on('update', (update: Uint8Array, origin: unknown) => {
+      if (origin !== this.connection && this.connected) {
+        this.send(update);
+      }
+    });
+  }
+
+  connect(): void {
+    if (this.connected) {
+      return;
+    }
+    this.connected = true;
+    const state = Y.encodeStateAsUpdate(this.doc);
+    if (this.buffered.length > 0) {
+      Y.applyUpdate(this.doc, Y.mergeUpdates(this.buffered), this.connection);
+      this.buffered = [];
+    }
+    this.send(state);
+    this.dispatch('sync', true);
+  }
+
+  disconnect(): void {
+    this.connected = false;
+  }
+
+  on(type: string, cb: (data: never) => void): void {
+    let set = this.listeners.get(type);
+    if (set === undefined) {
+      set = new Set();
+      this.listeners.set(type, set);
+    }
+    set.add(cb);
+  }
+
+  off(type: string, cb: (data: never) => void): void {
+    const set = this.listeners.get(type);
+    if (set !== undefined) {
+      set.delete(cb);
+    }
+  }
+
+  documentJSON(): unknown {
+    return this.doc.toJSON();
+  }
+
+  private send(update: Uint8Array): void {
+    for (const client of this.connection.clients) {
+      if (client === this) {
+        continue;
+      }
+      if (client.connected) {
+        Y.applyUpdate(client.doc, update, this.connection);
+      } else {
+        client.buffered.push(update);
+      }
+    }
+  }
+
+  private dispatch(type: string, data: unknown): void {
+    const set = this.listeners.get(type);
+    if (set !== undefined) {
+      set.forEach((cb) => (cb as (arg: unknown) => void)(data));
+    }
+  }
+}
+
+async function waitForReact(cb: () => void): Promise<void> {
+  await act(async () => {
+    cb();
+    await Promise.resolve().then();
+  });
+}
+
+/** Let every queued reaction to an edit run before anything is asserted. */
+async function settle(): Promise<void> {
+  await act(async () => {
+    await new Promise((resolve) => setTimeout(resolve, 0));
+  });
+}
+
+/**
+ * One participant's editor, assembled from the same public collaboration hooks
+ * the shipped collaboration plugin composes. They are called directly rather
+ * than through the plugin because the plugin never hands out the collaboration
+ * binding it builds internally, and that binding is where the state a
+ * participant can see about the others is resolved.
+ */
+function CollaborativeEditor({
+  id,
+  provider,
+  doc,
+  name,
+  color,
+  onReady,
+}: {
+  id: string;
+  provider: ProviderLike;
+  doc: Y.Doc;
+  name: string;
+  color: string;
+  onReady: (editor: LexicalEditor, binding: Binding) => void;
+}): React.JSX.Element {
+  const [editor] = useLexicalComposerContext();
+  const [, setDoc] = useState<Y.Doc | undefined>(doc);
+  const docMap = useMemo(() => new Map([[id, doc]]), [id, doc]);
+  const binding = useMemo(
+    () => createBinding(editor, provider, id, doc, docMap),
+    [editor, provider, id, doc, docMap],
+  );
+
+  useEffect(() => {
+    onReady(editor, binding);
+    // onReady is a fresh closure each render by design (it captures per-test
+    // state); only re-fire when the editor/binding identity actually changes.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [editor, binding]);
+
+  const cursors = useYjsCollaboration(
+    editor,
+    id,
+    provider,
+    docMap,
+    name,
+    color,
+    true,
+    binding,
+    setDoc,
+  );
+  useYjsFocusTracking(editor, provider, name, color);
+
+  return (
+    <>
+      <ContentEditable />
+      {cursors}
+    </>
+  );
+}
+
+/**
+ * How one participant currently sees another. `visible: false` means the other
+ * participant is known to be in the session but has nothing to show right now --
+ * for instance because they are not working in their editor.
+ */
+/** A position in the document, independent of how the editor represents it. */
+type Place =
+  | {paragraph: number; characters: number}
+  | {paragraph: number; place: 'invalid'}
+  | {place: 'unknown'};
+
+type ParticipantView =
+  | {inSession: false}
+  | {inSession: true; label: string; visible: false}
+  | {
+      inSession: true;
+      label: string;
+      visible: true;
+      anchorOffset: number;
+      focusOffset: number;
+      anchorOnParagraphText: boolean;
+      focusOnParagraphText: boolean;
+    };
+
+/** One simulated participant: a real editor plus a real replica and presence. */
+class Peer {
+  readonly client: TestClient;
+  readonly name: string;
+  readonly color: string;
+  editor: LexicalEditor | null = null;
+  binding: Binding | null = null;
+  private container: HTMLDivElement;
+  private root: Root;
+
+  constructor(client: TestClient, index: number) {
+    this.client = client;
+    this.name = `user-${index}`;
+    this.color = `#00000${index}`;
+    this.container = document.createElement('div');
+    document.body.appendChild(this.container);
+    this.root = createRoot(this.container);
+  }
+
+  get awareness(): FakeAwareness {
+    return this.client.awareness;
+  }
+
+  async start(): Promise<void> {
+    const provider = this.client as unknown as ProviderLike;
+    await act(async () => {
+      this.root.render(
+        <LexicalComposer
+          initialConfig={{
+            editorState: null,
+            namespace: this.name,
+            onError: (e) => {
+              throw e;
+            },
+          }}>
+          <CollaborativeEditor
+            id="main"
+            provider={provider}
+            doc={this.client.doc}
+            name={this.name}
+            color={this.color}
+            onReady={(editor, binding) => {
+              this.editor = editor;
+              this.binding = binding;
+            }}
+          />
+        </LexicalComposer>,
+      );
+      await Promise.resolve().then();
+    });
+  }
+
+  stop(): void {
+    act(() => {
+      this.root.unmount();
+    });
+    this.container.parentNode?.removeChild(this.container);
+  }
+
+  /** The text of the single shared paragraph this suite works with. */
+  paragraphText(): string | null {
+    return this.editor!.getEditorState().read(() => {
+      const paragraph = $getRoot().getFirstChild<ParagraphNode>();
+      const text = paragraph ? paragraph.getFirstChild<TextNode>() : null;
+      return text ? text.getTextContent() : null;
+    });
+  }
+
+  /** Identity of that paragraph's text node in THIS participant's editor. */
+  paragraphTextKey(): string | null {
+    return this.editor!.getEditorState().read(() => {
+      const paragraph = $getRoot().getFirstChild<ParagraphNode>();
+      const text = paragraph ? paragraph.getFirstChild<TextNode>() : null;
+      return text ? text.getKey() : null;
+    });
+  }
+
+  /** A fingerprint of the replicated document, for "nothing was edited" checks. */
+  documentFingerprint(): string {
+    return JSON.stringify(this.client.documentJSON());
+  }
+
+  /** What this participant can currently see of `other`. */
+  view(other: Peer): ParticipantView {
+    const cursor = this.binding!.cursors.get(other.awareness.id);
+    if (cursor === undefined) {
+      return {inSession: false};
+    }
+    const selection = cursor.selection;
+    if (selection === null) {
+      return {inSession: true, label: cursor.name, visible: false};
+    }
+    const textKey = this.paragraphTextKey();
+    return {
+      anchorOffset: selection.anchor.offset,
+      anchorOnParagraphText: selection.anchor.key === textKey,
+      focusOffset: selection.focus.offset,
+      focusOnParagraphText: selection.focus.key === textKey,
+      inSession: true,
+      label: cursor.name,
+      visible: true,
+    };
+  }
+
+  /** Which other participants this participant is currently tracking. */
+  trackedParticipants(): number[] {
+    return Array.from(this.binding!.cursors.keys()).sort((a, b) => a - b);
+  }
+
+  /** The participant puts their caret somewhere / selects a range. */
+  async select(anchorOffset: number, focusOffset: number): Promise<void> {
+    await waitForReact(() => {
+      this.editor!.update(() => {
+        const paragraph = $getRoot().getFirstChild<ParagraphNode>()!;
+        const text = paragraph.getFirstChild<TextNode>()!;
+        text.select(anchorOffset, focusOffset);
+      });
+    });
+  }
+
+  /** The participant starts working in their editor. */
+  async focusEditor(): Promise<void> {
+    await waitForReact(() => {
+      this.editor!.getRootElement()!.dispatchEvent(new FocusEvent('focus'));
+    });
+  }
+
+  /**
+   * The participant's editor really is the one the browser is in -- their editor
+   * holds the document focus, not just a focus notification. Only one editor per
+   * document can be in this state, which is why the tests that need it give it to
+   * the one participant whose own selection they observe.
+   */
+  async takeDocumentFocus(): Promise<void> {
+    await waitForReact(() => {
+      this.editor!.getRootElement()!.focus();
+    });
+  }
+
+  /** Where this participant's own caret / selection currently is. */
+  ownSelection(): null | {
+    anchorOffset: number;
+    focusOffset: number;
+    onParagraphText: boolean;
+  } {
+    const textKey = this.paragraphTextKey();
+    return this.editor!.getEditorState().read(() => {
+      const selection = $getSelection();
+      if (!$isRangeSelection(selection)) {
+        return null;
+      }
+      return {
+        anchorOffset: selection.anchor.offset,
+        focusOffset: selection.focus.offset,
+        onParagraphText:
+          selection.anchor.key === textKey && selection.focus.key === textKey,
+      };
+    });
+  }
+
+  /**
+   * The participant puts their caret / selects a range, committed immediately --
+   * the same thing a keystroke or a click does before the next event is handled.
+   */
+  async place(anchorOffset: number, focusOffset: number): Promise<void> {
+    await waitForReact(() => {
+      this.editor!.update(
+        () => {
+          const paragraph = $getRoot().getFirstChild<ParagraphNode>()!;
+          const text = paragraph.getFirstChild<TextNode>()!;
+          text.select(anchorOffset, focusOffset);
+        },
+        {discrete: true},
+      );
+    });
+    await settle();
+  }
+
+  /**
+   * Where a position sits in the document, said in a way that does not depend on
+   * how the editor happens to represent it. A caret at the end of "hello" is the
+   * same place whether it is held as "5 characters into that text" or as "after
+   * the first child of that paragraph", so both are reported the same way here.
+   * A position that its paragraph cannot actually hold is reported as `invalid`,
+   * because that is what it is -- not a place in the document.
+   */
+  placeOf(key: string, offset: number): Place {
+    return this.editor!.getEditorState().read(() => {
+      const paragraphs = $getRoot().getChildren();
+      for (let i = 0; i < paragraphs.length; i++) {
+        const paragraph = paragraphs[i];
+        if (paragraph.getKey() === key) {
+          if (!$isElementNode(paragraph)) {
+            return {paragraph: i, place: 'invalid'} as Place;
+          }
+          const children = paragraph.getChildren();
+          if (offset > children.length) {
+            return {paragraph: i, place: 'invalid'} as Place;
+          }
+          let characters = 0;
+          for (let c = 0; c < offset; c++) {
+            characters += children[c].getTextContentSize();
+          }
+          return {characters, paragraph: i} as Place;
+        }
+        if ($isElementNode(paragraph)) {
+          const children = paragraph.getChildren();
+          for (let c = 0; c < children.length; c++) {
+            const child = children[c];
+            if (child.getKey() === key) {
+              if (!$isTextNode(child) || offset > child.getTextContentSize()) {
+                return {paragraph: i, place: 'invalid'} as Place;
+              }
+              let characters = offset;
+              for (let b = 0; b < c; b++) {
+                characters += children[b].getTextContentSize();
+              }
+              return {characters, paragraph: i} as Place;
+            }
+          }
+        }
+      }
+      return {place: 'unknown'} as Place;
+    });
+  }
+
+  /** Where this participant can see the two ends of `other`'s selection. */
+  seenEnds(other: Peer): {anchor: Place; focus: Place} | 'not shown' {
+    const cursor = this.binding!.cursors.get(other.awareness.id);
+    if (cursor === undefined || cursor.selection === null) {
+      return 'not shown';
+    }
+    const {anchor, focus} = cursor.selection;
+    return {
+      anchor: this.placeOf(anchor.key, anchor.offset),
+      focus: this.placeOf(focus.key, focus.offset),
+    };
+  }
+
+  /** Replace the document with one paragraph per entry ('' makes an empty one). */
+  async writeParagraphs(texts: string[]): Promise<void> {
+    await waitForReact(() => {
+      this.editor!.update(
+        () => {
+          const root = $getRoot();
+          root.clear();
+          for (const text of texts) {
+            const paragraph = $createParagraphNode();
+            if (text.length > 0) {
+              paragraph.append($createTextNode(text));
+            }
+            root.append(paragraph);
+          }
+        },
+        {discrete: true},
+      );
+    });
+    await settle();
+  }
+
+  /** The paragraph texts this participant currently sees. */
+  paragraphTexts(): string[] {
+    return this.editor!.getEditorState().read(() =>
+      $getRoot()
+        .getChildren()
+        .map((paragraph) => paragraph.getTextContent()),
+    );
+  }
+
+  /** The participant puts their caret / selection wherever `place` says. */
+  async placeSelection(place: () => void): Promise<void> {
+    await waitForReact(() => {
+      this.editor!.update(place, {discrete: true});
+    });
+    await settle();
+  }
+
+  /** The participant edits the paragraph text (any edit, anywhere in it). */
+  async rewriteText(next: (current: string) => string): Promise<void> {
+    await waitForReact(() => {
+      this.editor!.update(
+        () => {
+          const paragraph = $getRoot().getFirstChild<ParagraphNode>()!;
+          const text = paragraph.getFirstChild<TextNode>()!;
+          text.setTextContent(next(text.getTextContent()));
+        },
+        {discrete: true},
+      );
+    });
+    await settle();
+  }
+
+  /** The participant types at the end of the paragraph. */
+  async appendText(suffix: string): Promise<void> {
+    await waitForReact(() => {
+      this.editor!.update(() => {
+        const paragraph = $getRoot().getFirstChild<ParagraphNode>()!;
+        const text = paragraph.getFirstChild<TextNode>()!;
+        text.setTextContent(text.getTextContent() + suffix);
+      });
+    });
+  }
+}
+
+describe('Collaboration: remote participant caret and selection state', () => {
+  let peers: Peer[] = [];
+
+  afterEach(() => {
+    for (const p of peers) {
+      p.stop();
+    }
+    peers = [];
+  });
+
+  async function makePeers(count: number): Promise<Peer[]> {
+    const connection = new TestConnection();
+    const made: Peer[] = [];
+    for (let i = 0; i < count; i++) {
+      made.push(new Peer(connection.createClient(), i));
+    }
+    const awarenesses = made.map((p) => p.awareness);
+    for (const a of awarenesses) {
+      a.peers = awarenesses;
+    }
+    for (const p of made) {
+      await p.start();
+    }
+    await waitForReact(() => {
+      for (const p of made) {
+        p.client.connect();
+      }
+    });
+    peers = made;
+    return made;
+  }
+
+  /** Seed the shared paragraph from `peer`; everyone must receive it. */
+  async function seedText(peer: Peer, text: string): Promise<void> {
+    await waitForReact(() => {
+      peer.editor!.update(() => {
+        const paragraph = $getRoot().getFirstChild<ParagraphNode>()!;
+        paragraph.append($createTextNode(text));
+      });
+    });
+    for (const p of peers) {
+      expect(p.paragraphText()).toBe(text);
+    }
+  }
+
+  function visible(
+    label: string,
+    anchorOffset: number,
