+// Harbor verifier vitest config (synthetic, added by test.patch).
+//
+// The opencti-front app cannot be booted wholesale in jsdom: the production entry graph pulls in
+// react-relay, generated __generated__/*.graphql artifacts, @mui/styles, ramda, moment-timezone,
+// rxjs, react-router-dom ... none of which are present in the offline verifier image.
+//
+// So we load the REAL modules that make up the feature under test -- DraftRoot (the draft page
+// that owns the call site), ConnectorWorkLine (the shared work line that owns the field labels),
+// ConnectorWorks (the OTHER, generic call site on the connectors page), plus the real Label,
+// TaskStatus, Tag and useApiMutation -- and substitute small stand-ins only for the LEAF modules
+// around them.
+//
+// Substitution is done with a resolveId plugin keyed on the RESOLVED path suffix rather than on
+// the literal import specifier, so it keeps working whether a module is imported as
+// '../../../../components/i18n', '@components/data/connectors/...' or '@common/button/Button',
+// and it survives the alias plugin rewriting the specifier to an absolute path.
+//
+// NOTE on the aliases: opencti-front's tsconfig maps @components/* to src/PRIVATE/components/*
+// (not src/components/*) and @common/* to src/components/common/*.
+import { defineConfig } from 'vitest/config';
+import react from '@vitejs/plugin-react';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const root = path.resolve(here, '..');
+const stub = (f: string) => path.join(here, 'stubs', f);
+
+// Bare package specifiers that are simply absent from the offline image.
+const BARE_STUBS: Record<string, string> = {
+  'react-relay': stub('reactRelay.jsx'),
+  'relay-runtime': stub('relayRuntime.js'),
+  'react-router-dom': stub('reactRouterDom.jsx'),
+  rxjs: stub('rxjs.js'),
+  ramda: stub('ramda.js'),
+  dompurify: stub('dompurify.js'),
+  'js-base64': stub('jsBase64.js'),
+  'mdi-material-ui': stub('mdiMaterialUi.jsx'),
+  '@mui/icons-material': stub('muiIcons.jsx'),
+  '@mui/styles': stub('muiStyles.js'),
+  '@mui/styles/makeStyles': stub('makeStyles.js'),
+};
+
+// First-party modules replaced by stand-ins, keyed on their path under opencti-front/src.
+//
+// NOTE what is NOT in this map and therefore runs for real:
+//   private/components/drafts/DraftRoot                    <- call site the fix touches
+//   private/components/data/connectors/ConnectorWorkLine   <- component the fix touches
+//   private/components/data/connectors/ConnectorWorks      <- the OTHER call site (p2p anchor)
+//   components/common/label/Label                          <- renders every field label
+//   components/TaskStatus + components/common/tag/Tag      <- renders the status value
+//   utils/hooks/useApiMutation, utils/String, utils/tabUtils
+const SRC_STUBS: Record<string, string> = {
+  'components/i18n': stub('i18n.jsx'),
+  'components/Loader': stub('loader.jsx'),
+  'components/ErrorNotFound': stub('noopComponent.jsx'),
+  'components/Breadcrumbs': stub('noopComponent.jsx'),
+  'components/common/button/Button': stub('Button.jsx'),
+  'components/common/card/Card': stub('Card.jsx'),
+  'components/common/card/CardTitle': stub('CardTitle.jsx'),
+  'private/components/common/drawer/Drawer': stub('Drawer.jsx'),
+  'private/components/data/connectors/ConnectorWorksErrorLine': stub('noopComponent.jsx'),
+  'private/components/data/connectors/parseWorkErrors': stub('parseWorkErrors.js'),
+  'private/components/data/import/ImportFilesContent': stub('noopComponent.jsx'),
+  'private/components/drafts/DraftEntities': stub('noopComponent.jsx'),
+  'private/components/drafts/DraftRelationships': stub('noopComponent.jsx'),
+  'private/components/drafts/DraftSightings': stub('noopComponent.jsx'),
+  'private/components/drafts/DraftReview': stub('noopComponent.jsx'),
+  'private/components/drafts/DraftOverview': stub('noopComponent.jsx'),
+  'private/components/drafts/useSwitchDraft': stub('useSwitchDraft.js'),
+  'relay/environment': stub('relayEnvironment.js'),
+  'utils/Security': stub('security.jsx'),
+  'utils/Time': stub('time.js'),
+  'utils/hooks/useGranted': stub('useGranted.js'),
+  'utils/hooks/useDraftContext': stub('useDraftContext.js'),
+  'utils/hooks/useHelper': stub('useHelper.js'),
+};
+
+const srcDir = path.join(root, 'src');
+
+function harborStubs() {
+  return {
+    name: 'harbor-stubs',
+    enforce: 'pre' as const,
+    resolveId(source: string, importer?: string) {
+      if (Object.prototype.hasOwnProperty.call(BARE_STUBS, source)) return BARE_STUBS[source];
+      let abs: string | null = null;
+      if (path.isAbsolute(source)) abs = source;
+      else if (source.startsWith('@common/')) abs = path.join(srcDir, 'components/common', source.slice('@common/'.length));
+      else if (source.startsWith('@components/')) abs = path.join(srcDir, 'private/components', source.slice('@components/'.length));
+      else if (source.startsWith('src/')) abs = path.join(root, source);
+      else if (source.startsWith('.') && importer) abs = path.resolve(path.dirname(importer), source);
+      if (!abs) return null;
+      const rel = path.relative(srcDir, abs).replace(/\\/g, '/').replace(/\.(jsx?|tsx?)$/, '');
+      return Object.prototype.hasOwnProperty.call(SRC_STUBS, rel) ? SRC_STUBS[rel] : null;
+    },
+  };
+}
+
+export default defineConfig({
+  root,
+  plugins: [harborStubs(), react()],
+  resolve: {
+    alias: [
+      { find: /^@common\//, replacement: path.join(srcDir, 'components/common/') },
+      { find: /^@components\//, replacement: path.join(srcDir, 'private/components/') },
+    ],
+  },
+  test: {
+    environment: 'jsdom',
+    globals: false,
+    include: ['harbor_tests/**/*.test.jsx'],
+    setupFiles: [path.join(here, 'setup.js')],
+    css: false,
+    testTimeout: 30000,
+  },
+});
