+// Stand-in for private/components/common/drawer/Drawer (the real one needs @mui/styles, useAuth
+// and relay-backed avatars). Renders its children only when open; the specs never open it.
+import React from 'react';
+const Drawer = ({ title, open, onClose, children }) => {
+  if (!open) return null;
+  return (
+    <div role="dialog" aria-label={typeof title === 'string' ? title : undefined}>
+      <div>{title}</div>
+      <button type="button" aria-label="Close drawer" onClick={onClose}>x</button>
+      <div>{typeof children === 'function' ? children({ onClose }) : children}</div>
+    </div>
+  );
+};
+export const DrawerVariant = { create: 'create', update: 'update' };
+export default Drawer;
