+// @mui/styles (legacy, deprecated in the app itself) is not installed in the offline image.
+// The real Label and the real TaskStatus read colours off this theme, so it must expose the
+// same shape: palette.text.light / palette.severity.*.
+export const useTheme = () => ({
+  spacing: (n = 1) => `${n * 8}px`,
+  palette: {
+    mode: 'dark',
+    text: { primary: '#ffffff', secondary: '#b0b0b0', light: '#8a8a8a', disabled: '#6f6f6f' },
+    background: { default: '#0a0a0a', paper: '#141414', nav: '#1a1a1a', accent: '#01478d' },
+    primary: { main: '#0fbcff' },
+    secondary: { main: '#00f1bd' },
+    severity: { critical: '#d4181e', high: '#f57c00', medium: '#ffc107', low: '#4caf50', info: '#2196f3', default: '#004C66' },
+  },
+});
+export const makeStyles = () => () => new Proxy({}, { get: (_t, k) => (typeof k === 'string' ? `mk-${k}` : undefined) });
+export const createStyles = (s) => s;
+export const withStyles = () => (c) => c;
+export default { useTheme, makeStyles, createStyles, withStyles };
