+// Stand-in for components/i18n (the real one boots an intl provider over the app's language
+// files). t_i18n is the identity so the spec observes the *source* label the component chose,
+// not a translation of it.
+export const useFormatter = () => ({
+  t_i18n: (s) => s,
+  t: (s) => s,
+  n: (v) => v,
+  b: (v) => v,
+  fld: (v) => v,
+  fd: (v) => v,
+  fsd: (v) => v,
+  nsd: (v) => v,
+  nsdt: (v) => v,
+  fndt: (v) => v,
+});
+export const useIntl = () => ({ formatMessage: ({ id }) => id });
+export const isNone = (v) => v === null || v === undefined || v === '';
+export default { useFormatter };
