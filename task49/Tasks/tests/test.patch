+++ b/opencti-platform/opencti-front/harbor_tests/draftValidationWorkLabel.test.jsx
@@ -0,0 +1,283 @@
+/*
+ * Harbor synthetic spec for OpenCTI-Platform__opencti-16540-mm.
+ *
+ * WHAT IT DRIVES
+ *   - the REAL DraftRoot page (private/components/drafts/DraftRoot.tsx), fed a draft fixture
+ *     through the relay boundary, which renders
+ *   - the REAL ConnectorWorkLine (private/components/data/connectors/ConnectorWorkLine.tsx) for
+ *     the draft's validation work, through the REAL Label / TaskStatus / Tag components, and
+ *   - the REAL ConnectorWorks list (the OTHER, generic call site of the very same work line, the
+ *     one used by the connectors screen) as the reference context.
+ *
+ * HOW IT ASSERTS
+ *   Never by looking for a string copied out of the fix. A work line is read back as a set of
+ *   {label, value} pairs; the status field is located by its VALUE (the work state that the line
+ *   is displaying) and the assertion is then made on that field's LABEL. The contract checked is
+ *   the observable mapping "which context am I in -> which wording labels the state field":
+ *   the draft page must label it with its own validation wording, the generic connectors page
+ *   must keep the platform's generic wording, and the two must not collapse onto one text.
+ *   The set of work states is read live out of the GraphQL schema's `enum State`, so the spec
+ *   follows the platform if a state is ever added or removed.
+ */
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import React from 'react';
+import { describe, it, expect, afterEach } from 'vitest';
+import { render, cleanup } from '@testing-library/react';
+import DraftRoot from '../src/private/components/drafts/DraftRoot';
+import ConnectorWorks from '../src/private/components/data/connectors/ConnectorWorks';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+
+/* ------------------------------------------------------------------ work states, read live */
+
+const readWorkStates = () => {
+  const schemaPath = path.resolve(here, '../../opencti-graphql/config/schema/opencti.graphql');
+  const schema = fs.readFileSync(schemaPath, 'utf-8');
+  const block = schema.match(/\benum\s+State\s*\{([^}]*)\}/);
+  if (!block) throw new Error(`could not read "enum State" from ${schemaPath}`);
+  return block[1].split('\n').map((l) => l.trim()).filter((l) => l && !l.startsWith('#'));
+};
+
+const WORK_STATES = readWorkStates();
+
+/* ----------------------------------------------------------------------------- DOM reading */
+
+// Every field of a work line is a Label (an <h6>) followed by the field value. Walk up from the
+// heading to the smallest ancestor that carries more text than the label itself: that node is
+// the field. Returns [{ label, value }] in document order.
+const fieldsIn = (root) => Array.from(root.querySelectorAll('h6')).map((heading) => {
+  const label = (heading.textContent || '').trim();
+  let node = heading;
+  for (let hop = 0; hop < 3; hop += 1) {
+    const parent = node.parentElement;
+    if (!parent || parent === root) break;
+    // Stop as soon as the parent carries more text than the label: that parent is the field.
+    if ((parent.textContent || '').trim() !== label) break;
+    node = parent;
+  }
+  const container = node.parentElement || node;
+  const text = (container.textContent || '').trim();
+  return { label, value: text.startsWith(label) ? text.slice(label.length).trim() : text };
+});
+
+const labelsIn = (root) => fieldsIn(root).map((f) => f.label);
+
+// The state field is the one whose displayed VALUE is the work state; its label is what the
+// spec is about.
+const stateFieldIn = (root, state) => {
+  const field = fieldsIn(root).find((f) => f.value === state);
+  if (!field) {
+    throw new Error(`no field displays the work state "${state}"; fields were ${JSON.stringify(fieldsIn(root))}`);
+  }
+  return field;
+};
+
+/* -------------------------------------------------------------------------------- fixtures */
+
+const makeWork = (state, overrides = {}) => ({
+  id: 'work-1',
+  name: 'Draft validation bundle',
+  received_time: '2026-02-03T10:11:12.000Z',
+  processed_time: '2026-02-03T10:12:00.000Z',
+  completed_time: '2026-02-03T10:13:30.000Z',
+  status: state,
+  tracking: { import_expected_number: 40, import_processed_number: 12 },
+  errors: [],
+  ...overrides,
+});
+
+const makeDraft = (work, overrides = {}) => ({
+  id: 'draft-1',
+  name: 'Q1 threat report draft',
+  entity_type: 'DraftWorkspace',
+  description: 'A draft under validation',
+  created_at: '2026-02-03T09:00:00.000Z',
+  objectAssignee: [],
+  objectParticipant: [],
+  createdBy: null,
+  objectsCount: {
+    containersCount: 1,
+    entitiesCount: 2,
+    observablesCount: 3,
+    relationshipsCount: 4,
+    sightingsCount: 5,
+    reviewsCount: 6,
+    totalCount: 21,
+  },
+  draft_status: 'validated', // anything but 'open' => the read-only, post-approval overview
+  currentUserAccessRight: 'admin',
+  authorizedMembers: [],
+  validationWork: work,
+  ...overrides,
+});
+
+/* --------------------------------------------------------------------------- render helpers */
+
+// Renders the REAL draft overview page and hands the caller its DOM.
+const inDraftPage = (work, draftOverrides, fn) => {
+  const draft = makeDraft(work, draftOverrides);
+  globalThis.__HARBOR_PARAMS__ = { draftId: draft.id };
+  globalThis.__HARBOR_PATHNAME__ = `/dashboard/data/import/draft/${draft.id}/entities`;
+  globalThis.__HARBOR_PRELOADED__ = { draftWorkspace: draft };
+  globalThis.__HARBOR_DRAFT_CONTEXT__ = null;
+  globalThis.__HARBOR_FEATURES__ = ['DRAFT_WORKFLOW'];
+  const { container, unmount } = render(<DraftRoot />);
+  try {
+    return fn(container);
+  } finally {
+    unmount();
+  }
+};
+
+// Renders the REAL connectors-screen list of works, i.e. the generic use of the same work line.
+const inConnectorsPage = (works, fn) => {
+  const data = { works: { edges: works.map((node) => ({ node })) } };
+  const { container, unmount } = render(
+    <ConnectorWorks data={data} options={[]} relay={{ refetch: () => {} }} inProgress />,
+  );
+  try {
+    return fn(container);
+  } finally {
+    unmount();
+  }
+};
+
+const draftStateLabel = (state, workOverrides = {}, draftOverrides = {}) => inDraftPage(
+  makeWork(state, workOverrides),
+  draftOverrides,
+  (root) => stateFieldIn(root, state).label,
+);
+
+const connectorStateLabel = (state, workOverrides = {}) => inConnectorsPage(
+  [makeWork(state, workOverrides)],
+  (root) => stateFieldIn(root, state).label,
+);
+
+afterEach(() => {
+  cleanup();
+  delete globalThis.__HARBOR_PRELOADED__;
+  delete globalThis.__HARBOR_PARAMS__;
+  delete globalThis.__HARBOR_PATHNAME__;
+});
+
+/* ------------------------------------------------------------------------------------ f2p */
+
+describe('Draft validation work status', () => {
+  it('labels the validation work state of a draft differently from a plain connector work', () => {
+    const collapsed = [];
+    for (const state of WORK_STATES) {
+      const inDraft = draftStateLabel(state);
+      const generic = connectorStateLabel(state);
+      expect(inDraft.length).toBeGreaterThan(0);
+      if (inDraft === generic) collapsed.push({ state, label: inDraft });
+    }
+    expect(collapsed).toEqual([]);
+  });
+
+  it('uses one and the same label for the validation work state whatever the state is', () => {
+    const seen = WORK_STATES.map((state) => draftStateLabel(state));
+    // A single wording, so the label describes the field and not the value inside it ...
+    expect(Array.from(new Set(seen))).toHaveLength(1);
+    // ... and that wording is the draft-specific one, not the generic connector one.
+    expect(seen[0]).not.toBe(connectorStateLabel(WORK_STATES[0]));
+  });
+
+  it('names the validation work state after the validation it reports on', () => {
+    const label = draftStateLabel('complete');
+    expect(label.toLowerCase()).toMatch(/validation/);
+    expect(label.trim().toLowerCase()).not.toBe('status');
+  });
+
+  it('labels the validation work state the same way for an unrelated draft', () => {
+    // Second, disjoint data set: nothing about the wording may be tied to the values of the
+    // draft or of the work that the report happened to show.
+    const otherWork = {
+      id: 'work-77',
+      name: 'Bundle 4321 - partner feed',
+      received_time: '2025-11-30T23:45:00.000Z',
+      processed_time: '2025-12-01T00:02:00.000Z',
+      completed_time: '',
+      tracking: { import_expected_number: 9, import_processed_number: 9 },
+      errors: [{ timestamp: '2025-12-01T00:01:00.000Z', message: 'boom', sequence: 1, source: 'x' }],
+    };
+    const otherDraft = {
+      id: 'draft-99',
+      name: 'Partner ingestion draft',
+      draft_status: 'closed',
+      objectsCount: {
+        containersCount: 11,
+        entitiesCount: 12,
+        observablesCount: 13,
+        relationshipsCount: 14,
+        sightingsCount: 15,
+        reviewsCount: 16,
+        totalCount: 81,
+      },
+    };
+    const label = draftStateLabel('progress', otherWork, otherDraft);
+    expect(label).toBe(draftStateLabel('complete'));
+    expect(label).not.toBe(connectorStateLabel('progress', otherWork));
+  });
+});
+
+/* ------------------------------------------------------------------------------------ p2p */
+
+describe('Draft validation work status (p2p guards)', () => {
+  it('reads at least the wait, progress and complete work states from the platform schema', () => {
+    // Guard for the specs that loop over whatever the schema declares.
+    expect(WORK_STATES.length).toBeGreaterThanOrEqual(3);
+    expect(WORK_STATES).toContain('complete');
+  });
+
+  it('keeps the generic connector work line labelled with the platform status wording', () => {
+    for (const state of WORK_STATES) {
+      expect(connectorStateLabel(state)).toBe('Status');
+    }
+  });
+
+  it('leaves every other field label of the work line untouched in the draft context', () => {
+    const state = 'complete';
+    const draftLabels = inDraftPage(makeWork(state), {}, (root) => labelsIn(root));
+    const genericLabels = inConnectorsPage([makeWork(state)], (root) => labelsIn(root));
+    const draftStatus = draftStateLabel(state);
+    const genericStatus = connectorStateLabel(state);
+    expect(draftLabels.filter((l) => l !== draftStatus))
+      .toEqual(genericLabels.filter((l) => l !== genericStatus));
+    // The work line is more than its state field: name, timings, counters and progress.
+    expect(genericLabels.length).toBeGreaterThanOrEqual(6);
+  });
+
+  it('still shows the work state itself in both contexts', () => {
+    for (const state of WORK_STATES) {
+      expect(inDraftPage(makeWork(state), {}, (root) => stateFieldIn(root, state).value)).toBe(state);
+      expect(inConnectorsPage([makeWork(state)], (root) => stateFieldIn(root, state).value)).toBe(state);
+    }
+  });
+
+  it('still shows the name, timings and counters of the draft validation work', () => {
+    const work = makeWork('complete');
+    const byLabel = inDraftPage(work, {}, (root) => Object.fromEntries(fieldsIn(root).map((f) => [f.label, f.value])));
+    expect(byLabel.Name).toBe(work.name);
+    expect(byLabel['Work start time']).toBe(work.received_time);
+    expect(byLabel['Work end time']).toBe(work.completed_time);
+    // Which of the two tracking counters feeds which counter field is a separate (pre-existing)
+    // question, so assert on the pair rather than on the individual assignment.
+    expect([byLabel['Operations completed'], byLabel['Total number of operations']].sort())
+      .toEqual([String(work.tracking.import_expected_number), String(work.tracking.import_processed_number)].sort());
+  });
+
+  it('renders one generic work line per work of the connectors screen', () => {
+    const works = WORK_STATES.map((state, i) => makeWork(state, { id: `work-${i}`, name: `Bundle ${i}` }));
+    inConnectorsPage(works, (root) => {
+      const cards = Array.from(root.querySelectorAll('[data-harbor="card"]'));
+      expect(cards).toHaveLength(works.length);
+      cards.forEach((card, i) => {
+        const field = stateFieldIn(card, works[i].status);
+        expect(field.label).toBe('Status');
+        expect(fieldsIn(card).find((f) => f.label === 'Name').value).toBe(works[i].name);
+      });
+    });
+  });
+});
