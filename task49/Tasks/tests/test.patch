@@ -0,0 +1,28 @@
+// Minimal stand-in for the handful of ramda helpers reached from utils/String and utils/utils.
+// ramda is not installed in the offline verifier image.
+export const isNil = (v) => v === null || v === undefined;
+export const isEmpty = (v) => {
+  if (v === null || v === undefined) return false;
+  if (typeof v === 'string' || Array.isArray(v)) return v.length === 0;
+  if (v instanceof Map || v instanceof Set) return v.size === 0;
+  if (typeof v === 'object') return Object.keys(v).length === 0;
+  return false;
+};
+export const uniq = (list) => Array.from(new Set(list || []));
+export const last = (list) => (list && list.length ? list[list.length - 1] : undefined);
+export const head = (list) => (list && list.length ? list[0] : undefined);
+export const map = (fn, list) => (list === undefined ? (l) => (l || []).map(fn) : (list || []).map(fn));
+export const filter = (fn, list) => (list === undefined ? (l) => (l || []).filter(fn) : (list || []).filter(fn));
+export const includes = (needle, list) => (list === undefined ? (l) => (l || []).includes(needle) : (list || []).includes(needle));
+export const mergeAll = (list) => Object.assign({}, ...(list || []));
+export const pipe = (...fns) => (x) => fns.reduce((acc, fn) => fn(acc), x);
+export const join = (sep, list) => (list === undefined ? (l) => (l || []).join(sep) : (list || []).join(sep));
+export const split = (sep, s) => (s === undefined ? (v) => String(v).split(sep) : String(s).split(sep));
+export const toPairs = (o) => Object.entries(o || {});
+export const fromPairs = (p) => Object.fromEntries(p || []);
+export const assoc = (k, v, o) => ({ ...(o || {}), [k]: v });
+export const dissoc = (k, o) => { const c = { ...(o || {}) }; delete c[k]; return c; };
+export const uniqBy = (fn, list) => {
+  const seen = new Set();
+  return (list || []).filter((x) => { const k = fn(x); if (seen.has(k)) return false; seen.add(k); return true; });
+};
