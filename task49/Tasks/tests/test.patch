+// Stand-in for `react-relay`: there is no relay runtime and no GraphQL server in the offline
+// verifier image.
+//
+// usePreloadedQuery hands back the fixture the spec published on globalThis, so the REAL
+// DraftRoot runs its own real fragment/branching logic over it. useFragment is the identity,
+// which is exactly what relay does once the data is masked. createRefetchContainer is the
+// identity too, so the REAL ConnectorWorks component (the generic connectors-page usage of
+// ConnectorWorkLine) can be rendered directly.
+export const graphql = (strings, ...exprs) => ({
+  kind: 'Request',
+  __harborGraphQL: String.raw({ raw: strings }, ...exprs),
+});
+
+export const useFragment = (_node, data) => data;
+export const usePreloadedQuery = () => (globalThis.__HARBOR_PRELOADED__ ?? {});
+
+const HARBOR_QUERY_REF = { __harborQueryRef: true };
+export const useQueryLoader = () => [HARBOR_QUERY_REF, () => {}, () => {}];
+
+export const useMutation = () => {
+  if (!globalThis.__HARBOR_MUTATIONS__) globalThis.__HARBOR_MUTATIONS__ = [];
+  const commit = (args) => {
+    globalThis.__HARBOR_MUTATIONS__.push(args);
+    if (typeof args?.onCompleted === 'function') args.onCompleted({}, null);
+  };
+  return [commit, false];
+};
+
+export const createFragmentContainer = (c) => c;
+export const createRefetchContainer = (c) => c;
+export const createPaginationContainer = (c) => c;
+export const useLazyLoadQuery = () => (globalThis.__HARBOR_PRELOADED__ ?? {});
+export const QueryRenderer = () => null;
+export const RelayEnvironmentProvider = ({ children }) => children;
+export default { graphql, useFragment, usePreloadedQuery, useQueryLoader, useMutation };
