+    payload = page.payload()
+    page.add_row(payload, slot, 'new114', '8', 'Immaculate')
+
+    assert page.submit(payload).status_code == 302
+
+    assert page.stored()[_SIDE_CATEGORY].get('Immaculate') == 8.0
+
+
+def test_emptying_both_halves_of_a_saved_row_removes_it(page):
+    _slot, _key, number, label = page.row_for('Perhaps')
+    payload = page.payload()
