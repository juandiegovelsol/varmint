+# ===========================================================================
+# Adjacent behaviour that must survive any repair.
+# ===========================================================================
+
+
+def test_every_stored_score_is_offered_on_the_page(page):
+    payload = page.payload()
+    shown = {}
+    for slot, rows in page.slots().items():
+        for _key, number, label in rows:
+            shown.setdefault(slot, {})[payload.get(label)] = float(payload.get(number))
+
+    expected = {label: float(number) for number, label in _MAIN_SCORES}
+    side = {label: float(number) for number, label in _SIDE_SCORES}
+    assert expected in shown.values()
+    assert side in shown.values()
+
+
+def test_editing_a_saved_row_completely_is_stored(page):
+    slot, _key, number, label = page.row_for('Nope')
+    payload = page.payload()
+    payload.setlist(number, ['6'])
+    payload.setlist(label, ['Reconsidered'])
+
+    assert page.submit(payload).status_code == 302
+
+    stored = page.stored()[_MAIN_CATEGORY]
+    assert stored.get('Reconsidered') == 6.0
+    assert 'Nope' not in stored
+
+
+def test_adding_a_complete_row_stores_it(page):
