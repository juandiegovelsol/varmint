diff --git a/src/client/tile.cpp b/src/client/tile.cpp
index b13d390..f7df9ec 100644
--- a/src/client/tile.cpp
+++ b/src/client/tile.cpp
@@ -21,11 +21,14 @@ void TileLayer::applyMaterialOptions(video::SMaterial &material, int layer) cons
 	/*
 	 * The second layer is for overlays, but uses the same vertex positions
 	 * as the first, which easily leads to Z-fighting.
-	 * To fix this we can offset the polygons in the direction of the camera.
-	 * This only affects the depth buffer and leads to no visual gaps in geometry.
+	 * To fix this we offset the base layer (of tiles that have an overlay)
+	 * away from the camera. This only affects the depth buffer and leads to
+	 * no visual gaps in geometry. The overlay itself is kept at its real depth,
+	 * so it never hides things placed right in front of the surface
+	 * (e.g. rails, selection boxes).
 	 */
-	if (layer == 1) {
-		material.PolygonOffsetSlopeScale = -1;
-		material.PolygonOffsetDepthBias = -1;
+	if (layer == 0 && (material_flags & MATERIAL_FLAG_HAS_OVERLAY)) {
+		material.PolygonOffsetSlopeScale = 1;
+		material.PolygonOffsetDepthBias = 1;
 	}
 }
