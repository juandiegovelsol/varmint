--- a/src/client/tile.cpp
+++ b/src/client/tile.cpp
@@ -19,13 +19,16 @@ void TileLayer::applyMaterialOptions(video::SMaterial &material, int layer) cons
 	}
 
 	/*
-	 * The second layer is for overlays, but uses the same vertex positions
-	 * as the first, which easily leads to Z-fighting.
-	 * To fix this we can offset the polygons in the direction of the camera.
-	 * This only affects the depth buffer and leads to no visual gaps in geometry.
+	 * The second layer is for overlays and uses exactly the same vertex
+	 * positions as the first, so its depth values are identical.
+	 * Instead of offsetting the overlay towards the camera (which makes it
+	 * poke through anything resting on the surface, e.g. rails on grass or
+	 * the selection box), rely on a less-or-equal depth test: the overlay is
+	 * drawn after the base layer and passes exactly where the base did.
 	 */
 	if (layer == 1) {
-		material.PolygonOffsetSlopeScale = -1;
-		material.PolygonOffsetDepthBias = -1;
+		material.ZBuffer = video::ECFN_LESSEQUAL;
+		material.PolygonOffsetSlopeScale = 0;
+		material.PolygonOffsetDepthBias = 0;
 	}
 }
