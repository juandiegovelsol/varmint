diff --git a/src/client/meshgen/collector.cpp b/src/client/meshgen/collector.cpp
index 5a4fb84..008bef4 100644
--- a/src/client/meshgen/collector.cpp
+++ b/src/client/meshgen/collector.cpp
@@ -10,10 +10,18 @@
 void MeshCollector::append(const TileSpec &tile, const video::S3DVertex *vertices,
 		u32 numVertices, const u16 *indices, u32 numIndices)
 {
+	const bool has_overlay = tile.layers[1].texture_id != 0;
 	for (int layernum = 0; layernum < MAX_TILE_LAYERS; layernum++) {
 		const TileLayer *layer = &tile.layers[layernum];
 		if (layer->texture_id == 0)
 			continue;
+		TileLayer base_layer;
+		if (layernum == 0 && has_overlay) {
+			// mark the base layer so it can be kept behind its overlay
+			base_layer = *layer;
+			base_layer.material_flags |= MATERIAL_FLAG_HAS_OVERLAY;
+			layer = &base_layer;
+		}
 		append(*layer, vertices, numVertices, indices, numIndices, layernum,
 				tile.world_aligned);
 	}
