+
+	// some actions to avoid collision with the pad at start with a margin
+	// (needed for both orbital and surface stations, otherwise the ship
+	// is pressed into the pad on the first physics step and gets damaged)
+	auto pPos = GetPosition();
+	SetPosition(pPos + GetOrient().VectorY() * 0.01);
+	auto tangent = from->GetAngVelocity().Cross(pPos);
+	// on a surface station gravity would immediately push the ship back
+	// onto the pad, so start right away with the desired takeoff speed
+	auto radial = GetOrient().VectorY() * (from->IsGroundStation() ? wantSpeed : 0.05);
+	SetVelocity(tangent + radial);
