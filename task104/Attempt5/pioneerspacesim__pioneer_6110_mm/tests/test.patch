+// Copyright © 2008-2026 Pioneer Developers. See AUTHORS.txt for details
+// Licensed under the terms of the GPL v3. See licenses/GPL-3.txt
+
+// Regression tests for https://github.com/pioneerspacesim/pioneer/issues/6110
+//
+// A Skipjack docked at a ground station (Cydonia, a "new_ground" starport)
+// takes hull damage and stalls the instant it lifts off its pad, as if it
+// struck something. These tests replay that liftoff headlessly (dummy
+// renderer, same pattern as src/modelcompiler.cpp: no GL context, no display)
+// with the engine's own code wherever it can run without a game:
+//
+//  - models come from the engine's model cache (Pi::FindModel), the ship as a
+//    per-body instance the way ModelBody::SetModel takes it;
+//  - the station's docking bays come from the engine's own SpaceStationType
+//    built from data/stations/new_ground.json (GetStageTransform for the
+//    DOCKED stage is what SpaceStation::GetBayTransform uses);
+//  - the ship is seated on a bay with SpaceStation::PositionDockedShip's rule
+//    (bay transform lowered by the ship's landing offset, which Ship::Init
+//    reads from the model's "tag_landing" marker);
+//  - ship and station collision geometry are then collided with
+//    Geom::Collide, at rest and while climbing straight up off the pad.
+//
+// Any contact reported there is a contact the running game turns into the
+// hull damage and climb stall shown in the bug report.
+
+#include "CollMesh.h"
+#include "FileSystem.h"
+#include "ModManager.h"
+#include "ModelCache.h"
+#include "Pi.h"
+#include "SpaceStationType.h"
+#include "collider/CollisionContact.h"
+#include "collider/Geom.h"
+#include "doctest.h"
+#include "graphics/Graphics.h"
+#include "graphics/dummy/RendererDummy.h"
+#include "matrix4x4.h"
+#include "scenegraph/CollisionGeometry.h"
+#include "scenegraph/Model.h"
+#include "scenegraph/Tag.h"
+#include "versioningInfo.h"
+
+#include <memory>
+#include <vector>
+
+namespace {
+	void InitHeadlessEngine()
+	{
+		// Just enough of the engine to load models: a filesystem rooted at the
+		// repository's data/ directory, a dummy renderer that performs no real
+		// GL calls (as modelcompiler.cpp's SetupRenderer() does), and the
+		// model cache Pi::FindModel serves models from.
+		static bool s_initialised = false;
+		if (s_initialised) return;
+		s_initialised = true;
+
+		// Using Pi (for its model cache) links in the GUI application code,
+		// which needs OutputVersioningInfo() from libpioneer-lib; calling it
+		// here (it only logs library versions) keeps it in the unittest link.
+		OutputVersioningInfo();
+
+		FileSystem::Init();
+		FileSystem::userFiles.MakeDirectory("");
+		ModManager::Init();
+
+		Graphics::RendererDummy::RegisterRenderer();
+
+		Graphics::Settings videoSettings = {};
+		videoSettings.rendererType = Graphics::RENDERER_DUMMY;
+		videoSettings.width = 800;
+		videoSettings.height = 600;
+		videoSettings.fullscreen = false;
+		videoSettings.hidden = true;
+		videoSettings.vsync = false;
+		videoSettings.useTextureCompression = false;
+		videoSettings.useAnisotropicFiltering = false;
+		videoSettings.iconFile = "";
+		videoSettings.title = "unittest";
+
+		Graphics::Renderer *renderer = Graphics::Init(videoSettings);
+		REQUIRE(renderer != nullptr);
+		if (!Pi::modelCache)
+			Pi::modelCache = new ModelCache(renderer);
+	}
+
+	// A per-body instance of a model, as ModelBody::SetModel creates it.
+	std::unique_ptr<SceneGraph::Model> ModelInstance(const char *modelName)
+	{
+		InitHeadlessEngine();
+		SceneGraph::Model *model = Pi::FindModel(modelName, false);
+		REQUIRE(model != nullptr);
+		return std::unique_ptr<SceneGraph::Model>(model->MakeInstance());
+	}
+
+	// The engine's surface station type used by Cydonia.
+	const SpaceStationType &CydoniaStationType()
+	{
+		InitHeadlessEngine();
+		static std::unique_ptr<SpaceStationType> s_type(new SpaceStationType("new_ground", "stations/new_ground.json"));
+		REQUIRE(s_type->IsSurfaceStation());
+		return *s_type;
+	}
+
+	// Ship::Init's landing offset: the local Y of the model's "tag_landing"
+	// marker, or zero when the model has none.
+	double LandingOffset(const SceneGraph::Model *ship)
+	{
+		const SceneGraph::Tag *tag = ship->FindTagByName("tag_landing");
+		return tag ? tag->GetGlobalTransform().GetTranslate().y : 0.0;
+	}
+
+	// Ship transform in station space when it is docked on `bay`, `lift`
+	// metres above its docked position along the pad's up axis
+	// (SpaceStation::PositionDockedShip with the station at the origin and
+	// the ship centred on the pad).
+	matrix4x4d ShipOnBay(const SpaceStationType &type, int bay, double landingOffset, double lift)
+	{
+		matrix4x4d padTrans = matrix4x4d(type.GetStageTransform(bay, DockStage::DOCKED));
+		padTrans.Translate(0.0, -landingOffset, 0.0);
+		return padTrans * matrix4x4d::Translation(0.0, lift, 0.0);
+	}
+
+	struct LiftoffScene {
+		const SpaceStationType &type = CydoniaStationType();
+		std::unique_ptr<SceneGraph::Model> ship = ModelInstance("skipjack");
+		std::unique_ptr<SceneGraph::Model> station = ModelInstance("new_ground");
+		double landingOffset = LandingOffset(ship.get());
+
+		int NumBays() const { return int(type.NumDockingPorts()); }
+
+		std::vector<CollisionContact> Collide(int bay, double lift) const
+		{
+			RefCountedPtr<CollMesh> shipMesh = ship->GetCollisionMesh();
+			RefCountedPtr<CollMesh> stationMesh = station->GetCollisionMesh();
+			REQUIRE(shipMesh);
+			REQUIRE(stationMesh);
+			REQUIRE(shipMesh->GetGeomTree() != nullptr);
+			REQUIRE(stationMesh->GetGeomTree() != nullptr);
+
+			const matrix4x4d shipTrans = ShipOnBay(type, bay, landingOffset, lift);
+			Geom shipGeom(shipMesh->GetGeomTree(), shipTrans, shipTrans.GetTranslate(), ship.get());
+			Geom stationGeom(stationMesh->GetGeomTree(), matrix4x4d::Identity(), vector3d(0.0), station.get());
+			return shipGeom.Collide(&stationGeom);
+		}
+	};
+} // namespace
+
+TEST_CASE("Skipjack resting on a Cydonia landing pad does not touch the pad")
+{
+	LiftoffScene scene;
+	REQUIRE(scene.NumBays() == 6);
+	for (int bay = 0; bay < scene.NumBays(); bay++) {
+		const std::vector<CollisionContact> contacts = scene.Collide(bay, 0.0);
+		INFO("bay ", bay + 1, ": ", contacts.size(), " contact(s) at rest");
+		CHECK(contacts.empty());
+	}
+}
+
+TEST_CASE("Skipjack climbing off a Cydonia landing pad never touches the pad")
+{
+	LiftoffScene scene;
+	REQUIRE(scene.NumBays() == 6);
+	for (int bay = 0; bay < scene.NumBays(); bay++) {
+		int firstHitCm = -1;
+		// climb straight up from 2 cm to 10 m above the docked position
+		for (int cm = 2; cm <= 1000; cm += 2) {
+			if (!scene.Collide(bay, cm * 0.01).empty()) {
+				firstHitCm = cm;
+				break;
+			}
+		}
+		INFO("bay ", bay + 1, ": first contact ", firstHitCm, " cm above the docked position (-1 = none)");
+		CHECK(firstHitCm == -1);
+	}
+}
+
+TEST_CASE("Skipjack collision mesh keeps its shape outside the lowest point")
+{
+	// Neighbouring regression guard: a clean liftoff must not come from
+	// gutting the hull's collision geometry (collapsing or deleting large
+	// parts of the mesh, or rescaling the whole ship). These bounds are well
+	// inside the base commit's own measurements (top of hull at local Y ~2.9,
+	// overall radius ~22.3, ~100 collision triangles).
+	std::unique_ptr<SceneGraph::Model> model = ModelInstance("skipjack");
+	RefCountedPtr<CollMesh> collMesh = model->GetCollisionMesh();
+	REQUIRE(collMesh);
+	const Aabb &aabb = collMesh->GetAabb();
+	CHECK(aabb.max.y > 2.0);
+	CHECK(aabb.GetRadius() > 15.0);
+	CHECK(collMesh->GetGeomTreeNumTris() > 50);
+}
+
+TEST_CASE("Cydonia landing pads still catch a Skipjack that sinks into them")
+{
+	// Neighbouring regression guard: a clean liftoff must not come from the
+	// pads (or the ship's underside) losing their collision geometry. A
+	// Skipjack pushed a metre below its docked position must still register a
+	// contact with the pad's docking surface on every pad.
+	LiftoffScene scene;
+	REQUIRE(scene.NumBays() == 6);
+	for (int bay = 0; bay < scene.NumBays(); bay++) {
+		const std::vector<CollisionContact> contacts = scene.Collide(bay, -1.0);
+		bool touchesDockingSurface = false;
+		for (const CollisionContact &c : contacts)
+			touchesDockingSurface |= (c.geomFlag & SceneGraph::CollisionGeometry::DOCKING) != 0;
+		INFO("bay ", bay + 1, ": ", contacts.size(), " contact(s) one metre below the docked position");
+		CHECK(touchesDockingSurface);
+	}
+}
