@@ -0,0 +1,263 @@
+-- World mod for the sprite probe tests (luanti sprite / upright_sprite entities).
+--
+-- Places the player at a fixed position high above any terrain, floating
+-- (gravity disabled), and spawns a fixed set of probe entities around it:
+--
+-- View A (looking +Z):
+--  - testentities:upright_animated (an animated "upright_sprite") and
+--    sprite_probe:ref_sprite (a camera-facing "sprite" with the same animated
+--    texture and timing), side by side
+--  - a camera-facing sprite and two upright sprites whose texture has four
+--    differently coloured quadrants; the upright ones are turned so that one
+--    shows its front and the other its back to the camera
+--  - an animated camera-facing sprite and an animated upright sprite, each
+--    attached to another object
+--  - an upright sprite whose frame is changed by this mod with set_sprite()
+--    once per second
+-- View B (looking -Z) and view C (looking +X):
+--  - four camera-facing sprites using select_x_by_camera with a 6-column sheet
+--    (one solid colour per column), each turned to a different yaw
+--
+-- Everything about the scene (position, look direction, lighting, timing) is
+-- fixed, so the external test driver can sample fixed screen regions. The
+-- driver asks for a view by writing its letter to <world>/view_request; the
+-- mod turns the player and then creates <world>/view_<letter>_ready.
+
+local worldpath = core.get_worldpath()
+
+local function touch(path)
+	local f = io.open(path, "w")
+	if f then
+		f:write("ok\n")
+		f:close()
+	end
+end
+
+-- Full daylight, time frozen, no weather/clouds to keep lighting constant.
+core.set_timeofday(0.5)
+
+local PLAYER_POS = {x = 0, y = 200, z = 0}
+local EYE_HEIGHT = 1.5
+local ENTITY_DISTANCE = 3
+local ROW = 1.3
+local FAR = 6
+
+local function animated(self)
+	self.object:set_sprite({x = 0, y = 0}, 4, 1.0, false)
+end
+
+core.register_entity("sprite_probe:ref_sprite", {
+	initial_properties = {
+		visual = "sprite",
+		textures = {"testnodes_anim.png"},
+		visual_size = {x = 1, y = 1},
+		spritediv = {x = 1, y = 4},
+	},
+	on_activate = animated,
+})
+
+core.register_entity("sprite_probe:attached_sprite", {
+	initial_properties = {
+		visual = "sprite",
+		textures = {"testnodes_anim.png"},
+		visual_size = {x = 1, y = 1},
+		spritediv = {x = 1, y = 4},
+		pointable = false,
+	},
+	on_activate = animated,
+})
+
+-- A small carrier that spawns its own animated child and attaches it. The child is created and
+-- attached from the carrier's on_activate, i.e. while the carrier is a live object, instead of from
+-- references returned by core.add_entity() during setup: those can go stale before set_attach()
+-- takes effect, which leaves the child unattached and animating like any free sprite.
+local function carrier_of(child_name, offset)
+	return {
+		initial_properties = {
+			visual = "sprite",
+			textures = {"sprite_probe_quads.png"},
+			visual_size = {x = 0.4, y = 0.4},
+		},
+		on_activate = function(self)
+			local child = core.add_entity(self.object:get_pos(), child_name)
+			if child then
+				child:set_attach(self.object, "", offset, {x = 0, y = 0, z = 0})
+			end
+		end,
+	}
+end
+core.register_entity("sprite_probe:carrier_sprite",
+	carrier_of("sprite_probe:attached_sprite", {x = -21, y = 0, z = 0}))
+core.register_entity("sprite_probe:carrier_upright",
+	carrier_of("sprite_probe:attached_upright", {x = 0, y = 13, z = 0}))
+
+core.register_entity("sprite_probe:quads_sprite", {
+	initial_properties = {
+		visual = "sprite",
+		textures = {"sprite_probe_quads.png"},
+		visual_size = {x = 1, y = 1},
+	},
+})
+
+core.register_entity("sprite_probe:quads_upright", {
+	initial_properties = {
+		visual = "upright_sprite",
+		textures = {"sprite_probe_quads.png"},
+		visual_size = {x = 1, y = 1},
+	},
+})
+
+core.register_entity("sprite_probe:attached_upright", {
+	initial_properties = {
+		visual = "upright_sprite",
+		textures = {"testnodes_anim.png"},
+		visual_size = {x = 1, y = 1},
+		spritediv = {x = 1, y = 4},
+		pointable = false,
+	},
+	on_activate = animated,
+})
+
+-- The live object of the stepped sprite. It is (re)assigned in on_activate rather than from the
+-- return value of add_entity(): that reference can go stale (get_pos() == nil) when the entity is
+-- activated again, and a stale reference silently stops the set_sprite() calls below.
+local stepped
+
+-- one frame at a time; the mod moves it to the next row of the sheet every second
+core.register_entity("sprite_probe:stepped_upright", {
+	initial_properties = {
+		visual = "upright_sprite",
+		textures = {"testnodes_anim.png"},
+		visual_size = {x = 1, y = 1},
+		spritediv = {x = 1, y = 4},
+	},
+	on_activate = function(self)
+		stepped = self.object
+		self.object:set_sprite({x = 0, y = 0}, 1, 1.0, false)
+	end,
+})
+
+core.register_entity("sprite_probe:views", {
+	initial_properties = {
+		visual = "sprite",
+		textures = {"sprite_probe_views.png"},
+		visual_size = {x = 1, y = 1},
+		spritediv = {x = 6, y = 1},
+	},
+	on_activate = function(self)
+		self.object:set_sprite({x = 0, y = 0}, 1, 1.0, true)
+	end,
+})
+
+local VIEW_YAW = {A = 0, B = math.pi, C = -math.pi / 2}
+
+local probe_done = false
+local spawned = {}
+
+local function add(pos, name, yaw)
+	local obj = core.add_entity(pos, name)
+	if obj and yaw then
+		obj:set_yaw(yaw)
+	end
+	spawned[#spawned + 1] = obj or false
+	return obj
+end
+
+local function setup(player)
+	if probe_done then
+		return
+	end
+	probe_done = true
+
+	player:set_physics_override({speed = 0, jump = 0, gravity = 0})
+	player:set_pos(PLAYER_POS)
+	player:set_look_horizontal(VIEW_YAW.A)   -- yaw 0 -> facing +Z (core.yaw_to_dir(0) == (0,0,1))
+	player:set_look_vertical(0)     -- level
+	-- nothing of the HUD (hotbar, hearts, wielded item) in front of the probes
+	player:hud_set_flags({hotbar = false, healthbar = false, crosshair = false,
+		wielditem = false, breathbar = false, minimap = false, minimap_radar = false})
+
+	local eye_y = PLAYER_POS.y + EYE_HEIGHT
+	local base_z = PLAYER_POS.z + ENTITY_DISTANCE
+	local x0 = PLAYER_POS.x
+
+	-- view A, middle row
+	local upright = add({x = x0 - 1.5, y = eye_y, z = base_z}, "testentities:upright_animated")
+	local ref = add({x = x0 + 1.5, y = eye_y, z = base_z}, "sprite_probe:ref_sprite")
+	-- view A, top row: upright sprite showing its back (yaw 0 faces +Z, away from the
+	-- player), camera-facing sprite
+	add({x = x0 - 1.5, y = eye_y + ROW, z = base_z}, "sprite_probe:quads_upright", 0)
+	add({x = x0 + 1.5, y = eye_y + ROW, z = base_z}, "sprite_probe:quads_sprite")
+	-- view A, bottom row: upright sprite showing its front, sprite attached to a carrier
+	add({x = x0 - 1.5, y = eye_y - ROW, z = base_z}, "sprite_probe:quads_upright", math.pi)
+	add({x = x0 + 3.6, y = eye_y - ROW, z = base_z}, "sprite_probe:carrier_sprite")
+	-- view A, left edge: upright sprite attached to a carrier below it
+	add({x = x0 - 3.3, y = eye_y - ROW, z = base_z}, "sprite_probe:carrier_upright")
+	-- view A, right edge: upright sprite stepped through its frames by set_sprite()
+	add({x = x0 + 3.3, y = eye_y, z = base_z}, "sprite_probe:stepped_upright")
+
+	-- views B and C: one direction-selecting sprite per yaw (0, 90, 180, 270 degrees)
+	for i = 0, 3 do
+		local off = -1.8 + 1.2 * i
+		add({x = x0 + off, y = eye_y, z = PLAYER_POS.z - FAR}, "sprite_probe:views", i * math.pi / 2)
+		add({x = x0 + FAR, y = eye_y, z = PLAYER_POS.z + off}, "sprite_probe:views", i * math.pi / 2)
+	end
+
+	core.log("action", "[sprite_probe] upright=" .. tostring(upright))
+	core.log("action", "[sprite_probe] ref=" .. tostring(ref))
+	core.log("action", "[sprite_probe] player yaw=" .. tostring(player:get_look_horizontal()))
+
+	for _, obj in ipairs(spawned) do
+		if not obj then
+			touch(worldpath .. "/probe_error")
+			return
+		end
+	end
+
+	-- Give the client a moment to receive the AddActiveObject messages and
+	-- render the first frame before the driver starts sampling.
+	core.after(0.3, function()
+		touch(worldpath .. "/probe_ready")
+	end)
+end
+
+core.register_on_joinplayer(function(player)
+	setup(player)
+end)
+
+local current_view = "A"
+local poll = 0
+local step_timer, step_row = 0, 0
+core.register_globalstep(function(dtime)
+	if stepped and stepped:get_pos() then
+		step_timer = step_timer + dtime
+		if step_timer >= 1.0 then
+			step_timer = step_timer - 1.0
+			step_row = (step_row + 1) % 4
+			stepped:set_sprite({x = 0, y = step_row}, 1, 1.0, false)
+		end
+	end
+	poll = poll + dtime
+	if poll < 0.1 or not probe_done then
+		return
+	end
+	poll = 0
+	local f = io.open(worldpath .. "/view_request", "r")
+	if not f then
+		return
+	end
+	local want = (f:read("*l") or ""):match("^%s*(%a)")
+	f:close()
+	if not want or want == current_view or not VIEW_YAW[want] then
+		return
+	end
+	current_view = want
+	for _, player in ipairs(core.get_connected_players()) do
+		player:set_pos(PLAYER_POS)
+		player:set_look_horizontal(VIEW_YAW[want])
+		player:set_look_vertical(0)
+	end
+	core.after(0.5, function()
+		touch(worldpath .. "/view_" .. want .. "_ready")
+	end)
+end)
