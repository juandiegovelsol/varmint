diff --git a/core/src/com/agateau/pixelwheels/bonus/Missile.java b/core/src/com/agateau/pixelwheels/bonus/Missile.java
index e6a94a5..8561bbb 100644
--- a/core/src/com/agateau/pixelwheels/bonus/Missile.java
+++ b/core/src/com/agateau/pixelwheels/bonus/Missile.java
@@ -137,7 +137,7 @@ public class Missile extends GameObjectAdapter
         Vehicle vehicle = shooter.getVehicle();
         object.mShooter = shooter;
         object.mBodyDef.position.set(vehicle.getX(), vehicle.getY());
-        object.mBodyDef.angle = AgcMathUtils.normalizeAnglePiRad(vehicle.getAngle());
+        object.mBodyDef.angle = AgcMathUtils.normalizeAnglePiRad(vehicle.getBody().getAngle());
 
         object.mBody = gameWorld.getBox2DWorld().createBody(object.mBodyDef);
         object.mBody.createFixture(object.mShape, WAITING_DENSITY);
@@ -258,14 +258,29 @@ public class Missile extends GameObjectAdapter
 
     @Override
     public void draw(Batch batch, ZLevel zLevel, Rectangle viewBounds) {
+        if (mStatus == Status.WAITING) {
+            // While carried, the missile must be drawn at the same level as its vehicle, so that
+            // it is hidden by whatever hides the vehicle (bridges, ...). The shadow is drawn at
+            // this level too so that it is drawn *over* its vehicle.
+            Vehicle vehicle = mShooter.getVehicle();
+            ZLevel vehicleZLevel = vehicle.isFlying() ? ZLevel.FLYING : ZLevel.VEHICLES;
+            if (zLevel == vehicleZLevel) {
+                batch.setColor(mShooter.getVehicleRenderer().getBatchColor());
+                drawShadow(batch);
+                drawMissile(batch);
+                batch.setColor(Color.WHITE);
+            }
+            if (zLevel == ZLevel.FLYING) {
+                drawTarget(batch);
+            }
+            return;
+        }
         if (zLevel == ZLevel.FLYING) {
             // Draw the shadow at Z_FLYING so that the shadow is drawn *over* its vehicle
             drawShadow(batch);
             drawMissile(batch);
             drawTarget(batch);
-            if (mStatus != Status.WAITING) {
-                drawReactorFire(batch);
-            }
+            drawReactorFire(batch);
         }
     }
 
