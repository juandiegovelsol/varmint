+
+bool SpaceStation::IsDepartingShip(const Ship *s) const
+{
+	for (const auto &d : m_departingShips)
+		if (d.ship == s) return true;
+	return false;
+}
+
+void SpaceStation::UpdateDepartingShips()
+{
+	m_departingShips.erase(std::remove_if(m_departingShips.begin(), m_departingShips.end(),
+		[this](const departingShip_t &d) {
+			// docking again, landed, jumped away etc.
+			if (d.ship->GetFlightState() != Ship::FLYING) return true;
+			if (d.ship->GetFrame() != GetFrame()) return true;
+			// the ship is considered clear of its pad once it is further from
+			// the pad than the ship's own size plus the pad size
+			const SpaceStationType::SPort *port = m_type->FindPortByBay(d.bay);
+			const double padSize = port ? double(port->maxShipSize) : 0.0;
+			const double clearDist = d.ship->GetPhysRadius() + padSize;
+			const vector3d padPos = GetBayTransform(d.bay).GetTranslate();
+			return (d.ship->GetPosition() - padPos).LengthSqr() > clearDist * clearDist;
+		}), m_departingShips.end());
 }
 
