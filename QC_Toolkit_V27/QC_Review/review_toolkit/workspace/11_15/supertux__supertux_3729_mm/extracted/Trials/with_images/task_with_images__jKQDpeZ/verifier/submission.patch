 void
 HeavyCoin::update(float dt_sec)
 {
   update_visibility();
+  if (!is_valid())
+    return;
+
+  // Inside water, coins sink slowly: weaker gravity and a capped sinking speed,
+  // applied from the very first frame the coin is in the water.
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  m_physic.set_gravity_modifier(in_water ? WATER_GRAVITY_MODIFIER : 1.0f);
 
   // Enable physics.
-  m_col.set_movement(m_physic.get_movement(dt_sec));
+  Vector movement = m_physic.get_movement(dt_sec);
+  if (in_water && m_physic.get_velocity_y() > WATER_MAX_SINK_SPEED)
+  {
+    m_physic.set_velocity_y(WATER_MAX_SINK_SPEED);
+    movement.y = WATER_MAX_SINK_SPEED * dt_sec;
+  }
+  m_col.set_movement(movement);
 }
 
 void
 HeavyCoin::update_visibility()
 {
-  if (get_bbox().get_top() > Sector::get().get_camera().get_rect().get_bottom())
+  // Only remove coins that fell out of the sector, not ones that are merely
+  // off-screen, so the player can come back and collect them.
+  if (get_bbox().get_top() > Sector::get().get_height())
     remove_me();
 }
 
