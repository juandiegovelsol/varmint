+#!/usr/bin/env python3
+"""Headless behavioral tests for hazards and what they do to Tux and the creatures.
+
+Drives the real game binary (no window needed: --renderer null) through tiny fixture levels
+(tests/fixtures/hazards/<scenario>.stl). Each level is a flat floor (solid tiles at y=320) with,
+depending on the scenario, a floor-spike tile at x in [320, 352), a creature, a bomb creature or an
+icicle. The level's own init-script sets the scene with the game's public scripting calls
+(Tux.set_pos, Tux.set_bonus, Tux.make_invincible, <named badguy>.kill) and prints Tux's position at
+fixed times with the engine's print(); a creature reports its own death through its dead-script.
+
+Outcomes are read only from that output:
+  - "small" / "big": Tux is standing on the floor at that time (his y is the resting y of a small
+    or of a big Tux, within a few pixels), i.e. he is alive and has that size;
+  - "down": Tux is not standing on the floor any more -- a knocked-out Tux is launched upward and
+    then falls through everything, so he is far from both resting heights;
+  - "dead" / "alive": the creature's dead-script did / did not print during the run.
+
+Usage:
+  run_hazard_test.py SUPERTUX_BINARY FIXTURE_DIR JUNIT_OUT [TEST_IDS...]
+"""
+import re
+import subprocess
+import sys
+import time
+import xml.etree.ElementTree as ET
+
+CLASSNAME = "HazardBehaviour"
+REST_Y = {"small": 289.2, "big": 257.2}   # top of Tux's box when standing on the floor
+Y_TOLERANCE = 6.0
+
+SCENARIOS = [
+    ("marginal_graze_is_not_lethal", [["small", 1.0]]),
+    ("graze_from_the_other_side_is_not_lethal", [["small", 1.0]]),
+    ("full_overlap_still_hurts", [["down", 1.0]]),
+    ("no_overlap_is_safe", [["small", 1.0]]),
+    ("creature_beside_spikes_survives", [["alive", "jumpy"], ["small", 2.5]]),
+    ("creature_on_spikes_dies", [["dead", "jumpy"], ["small", 2.5]]),
+    ("creature_walking_into_tux_hurts_him", [["down", 1.0], ["alive", "snowball"]]),
+    ("landing_on_creature_flattens_it", [["dead", "snowball"], ["small", 1.5]]),
+    ("powered_up_tux_loses_one_step_per_hit", [["big", 1.0], ["small", 2.6]]),
+    ("big_tux_shrinks_when_hit", [["small", 1.0]]),
+    ("invincible_tux_is_not_hurt_by_spikes", [["small", 1.0]]),
+    ("blast_reaches_left_neighbour", [["down", 1.0]]),
+    ("blast_reaches_right_neighbour", [["down", 1.0]]),
+    ("blast_reaches_tux_just_above", [["down", 1.0]]),
+    ("blast_spares_distant_tux", [["small", 1.0]]),
+    ("icicle_ignores_tux_far_to_its_right", [["alive", "icicle"], ["small", 3.0]]),
+    ("icicle_ignores_tux_far_to_its_left", [["alive", "icicle"], ["small", 3.0]]),
+    ("icicle_reacts_to_tux_just_right_of_it", [["dead", "icicle"], ["small", 3.0]]),
+    ("icicle_reacts_to_tux_just_left_of_it", [["dead", "icicle"], ["small", 3.0]]),
+    ("icicle_falls_on_tux_below", [["dead", "icicle"], ["down", 3.0]]),
+]
+
+
+def run_level(binary, level_path, timeout=90):
+    cmd = [binary, "--renderer", "null", "--disable-sound", "--disable-music", level_path]
+    try:
+        proc = subprocess.run(cmd, capture_output=True, timeout=timeout)
+        return (proc.stdout + proc.stderr).decode("utf-8", "replace")
+    except subprocess.TimeoutExpired as e:
+        out = (e.stdout or b"") + (e.stderr or b"")
+        return out.decode("utf-8", "replace") + "\n[TIMED OUT]"
+
+
+def parse(log):
+    pos = {}
+    for m in re.finditer(r"POS (-?[\d.]+) (-?[\d.]+) (-?[\d.]+)", log):
+        pos[float(m.group(1))] = (float(m.group(2)), float(m.group(3)))
+    dead = set(re.findall(r"DEAD (\w+)", log))
+    return pos, dead
+
+
+def check(kind, arg, pos, dead):
+    if kind in ("dead", "alive"):
+        died = arg in dead
+        ok = died if kind == "dead" else not died
+        return ok, f"creature '{arg}' {'died' if died else 'stayed alive'} (expected {kind})"
+    t = float(arg)
+    if t not in pos:
+        return False, f"no position reported at t={t}"
+    y = pos[t][1]
+    near = {k: abs(y - v) <= Y_TOLERANCE for k, v in REST_Y.items()}
+    if kind == "down":
+        ok = not any(near.values())
+    else:
+        ok = near[kind]
+    state = next((k for k, v in near.items() if v), "down")
+    return ok, f"t={t}: Tux y={y} reads as '{state}' (expected '{kind}')"
+
+
+def main():
+    binary, fixture_dir, junit_out = sys.argv[1], sys.argv[2], sys.argv[3]
+    requested = set(sys.argv[4:]) or None
+
+    suite = ET.Element("testsuite", name=CLASSNAME)
+    start = time.time()
+    written = failures = errors = 0
+    for name, checks in SCENARIOS:
+        if requested and name not in requested and f"{CLASSNAME}.{name}" not in requested:
+            continue
+        written += 1
+        tc = ET.SubElement(suite, "testcase", classname=CLASSNAME, name=name, time="0")
+        t0 = time.time()
+        log = run_level(binary, f"{fixture_dir}/{name}.stl")
+        tc.set("time", "%.2f" % (time.time() - t0))
+        pos, dead = parse(log)
+        if not pos:
+            errors += 1
+            err = ET.SubElement(tc, "error", message="no position reported for this scenario")
+            err.text = log[-4000:]
+            continue
+        bad = []
+        for kind, arg in checks:
+            ok, msg = check(kind, arg, pos, dead)
+            if not ok:
+                bad.append(msg)
+        if bad:
+            failures += 1
+            fail = ET.SubElement(tc, "failure", message="; ".join(bad))
+            fail.text = log[-4000:]
+
+    suite.set("tests", str(written))
+    suite.set("failures", str(failures))
+    suite.set("errors", str(errors))
+    suite.set("time", "%.2f" % (time.time() - start))
+    ET.ElementTree(suite).write(junit_out, encoding="utf-8", xml_declaration=True)
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
