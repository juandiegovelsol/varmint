+    n=$((n+1))
+    say "  attempt $n: reward=${r:-<none>}   ($(dirname "$f" | sed "s|^$d/||"))"
+    case "$r" in 1|1.0|1.00) solved=$((solved+1));; esac
+  done < <(find "$d" -name result.json 2>/dev/null | sort)
+  if [ "$n" -eq 0 ]; then say "  no result.json found under $d"; return 0; fi
+  say "pass@$n: $solved/$n attempt(s) scored 1.0"
+  # #14 is a judgement call once k>1: one solve in seven still shows the model CAN do it, but
+  # where the line sits is the reviewer's call, so the distribution is reported, not a verdict.
+  [ "$solved" -gt 0 ] && say "  NOTE: at least one attempt solved it - weigh against v2 #14 (Not Hard Enough)."
+  return 0
+}
