+void ScenarioListBox::ActionListPressRight( Maps::FileInfo & info, const fheroes2::Point & mousePos, int32_t itemOffsetX, int32_t /*itemOffsetY*/ )
+{
+    // The map name occupies the horizontal space between the "map type" icon column and the "victory condition" icon column
+    // (see RedrawItem for the exact layout). Only a right-click on the name should open the location / map-type popup.
+    // Right-clicks on the icon columns are intentionally left to the caller so that each icon keeps its own help popup.
+    const int32_t nameAreaStart = itemOffsetX + 47; // right edge of the "map type" icon column
+    const int32_t nameAreaEnd = itemOffsetX + 213; // left edge of the "victory condition" icon column
+
+    if ( mousePos.x < nameAreaStart || mousePos.x >= nameAreaEnd )
+        return;
+
+    ActionListPressRight( info );
+}
