+// -----------------------------------------------------------------------
+void StringReplace(std::string & str, const char * from, const std::string & to)
+{
+    size_t pos = 0;
+    while ((pos = str.find(from, pos)) != std::string::npos) {
+        str.replace(pos, strlen(from), to);
+        pos += to.length();
+    }
+}
