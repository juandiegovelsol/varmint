+
+// BEHAVIORAL, integration-level: drives the real Dialog::SelectScenario() through exactly
+// one frame with a simulated right-click over an icon column, using the same call path
+// (QueueEventProcessing -> ActionListPressRight, plus the dialog's own right-click
+// dispatch) the real game uses. Deliberately NOT a bare, isolated ScenarioListBox: a
+// correct fix may need per-column geometry that only Dialog::SelectScenario's own setup
+// provides (e.g. state populated on the listbox before its event loop starts), and calling
+// ActionListPressRight directly on an unconfigured instance would then unfairly reject
+// that (perfectly valid) design.
+TEST(ScenarioListBox, IconAreaRightClickDoesNotShowPopup)
+{
+    g_showMessageCallCount = 0;
+
+    MapsFileInfoList maps;
+    maps.push_back( makeStandardMap( "TestMap" ) );
+
+    // Display is 640x480 and the panel background sprite is 0x0 in this harness, so
+    // Dialog::SelectScenario's panel rect (rt) is deterministically (320, 240) here. The
+    // size-icon column sits at rt.x+64 .. rt.x+83 per the dialog's own layout; aim for its
+    // center, comfortably clear of the columns on either side.
+    g_fakeMouseX = 390;
+    g_fakeMouseY = 300;
+    g_fakeRightPressed = true;
+    g_fakeEventsRemaining = 1;
+
+    Dialog::SelectScenario( maps, 0 );
+
+    EXPECT_EQ(g_showMessageCallCount, 0)
+        << "Right-clicking in the icon area triggered fheroes2::showMessage "
+        << g_showMessageCallCount << " time(s). It must not show the map-info popup.";
+}
+
+// BEHAVIORAL: calls the real ScenarioListBox::RedrawBackground() -- the renderer for the
+// details panel below the list -- and checks where it draws the "Map difficulty:" label
+// relative to the panel's own origin. The label is always the second text draw once a map
+// is selected (map name, then difficulty label, then difficulty value), regardless of how
+// the fix is implemented internally.
+TEST(ScenarioListBox, DifficultyLabelAlignsWithPanelEdge)
+{
+    ScenarioListBox listbox( fheroes2::Point( 0, 0 ) );
+    listbox.SetAreaMaxItems( 1 );
+
+    MapsFileInfoList maps;
+    maps.push_back( makeStandardMap( "TestMap" ) );
+    listbox.SetListContent( maps );
+    listbox.SetCurrent( 0 );
+
+    for ( const int32_t dstx : { 100, 250 } ) {
+        g_textBlitCalls.clear();
+        listbox.RedrawBackground( fheroes2::Point( dstx, 50 ) );
+
+        ASSERT_GE( g_textBlitCalls.size(), 2u )
+            << "Expected at least the map-name and difficulty-label draws once a map is selected (dst.x=" << dstx << ").";
+
+        const int32_t expectedX = dstx + 210;
+        EXPECT_EQ( g_textBlitCalls[1].first, expectedX )
+            << "The \"Map difficulty:\" label is not aligned with the panel edge (dst.x=" << dstx << ").";
+    }
+}
+
+int main(int argc, char ** argv)
+{
+    ::testing::InitGoogleTest(&argc, argv);
+    return RUN_ALL_TESTS();
+}
