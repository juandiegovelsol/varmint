+// -----------------------------------------------------------------------
+// LocalEvent — scriptable single-click driver.
+//
+// A test that wants to exercise a real, integrated right-click (rather than calling
+// ScenarioListBox::ActionListPressRight directly on a bare, unconfigured instance) sets
+// g_fakeMouseX/Y and g_fakeRightPressed, sets g_fakeEventsRemaining = 1, then calls the
+// real Dialog::SelectScenario(). HandleEvents() reports the fake cursor position and lets
+// the loop body run for exactly that many iterations. This is what makes it fair to ANY
+// correct fix: the real setup code runs (whatever geometry/state it wires up), and the
+// real dispatch chain (QueueEventProcessing -> ActionListPressRight, and the main loop's
+// own right-click checks) decides the outcome -- nothing here is specific to one
+// implementation's internal structure.
+//
+// IMPORTANT: the real Dialog::Message / fheroes2::showMessage, when called with no
+// buttons (as every popup in this dialog is), run their own loop that blocks until the
+// right mouse button is RELEASED -- see dialog_message.cpp / ui_dialog.cpp upstream:
+// `while (... ) { if (!buttons && !le.MousePressRight()) break; ... }`. So by the time any
+// such popup returns, a right-click has necessarily been consumed: a later check in the
+// same frame (e.g. a second, redundant right-click test further down the dispatch chain)
+// will correctly see the button as no longer pressed. The Dialog::Message/showMessage
+// stubs below clear g_fakeRightPressed for exactly this reason -- without it, a fix that
+// relies on this real ordering (show the correct popup first, then let a later redundant
+// check no-op because the click is already consumed) would be unfairly rejected here.
+// -----------------------------------------------------------------------
+LocalEvent::LocalEvent() {}
+LocalEvent & LocalEvent::Get() { static LocalEvent le; return le; }
+
+bool LocalEvent::HandleEvents(bool, bool)
+{
+    mouse_cu = fheroes2::Point(g_fakeMouseX, g_fakeMouseY);
+    if (g_fakeEventsRemaining > 0) {
+        --g_fakeEventsRemaining;
+        return true;
+    }
+    return false;
+}
