diff --git a/Content.Server/Doors/Systems/FirelockSystem.cs b/Content.Server/Doors/Systems/FirelockSystem.cs
index 16ebaca..e9b6ec0 100644
--- a/Content.Server/Doors/Systems/FirelockSystem.cs
+++ b/Content.Server/Doors/Systems/FirelockSystem.cs
@@ -189,8 +189,13 @@ private void OnAtmosAlarm(EntityUid uid, FirelockComponent component, AtmosAlarm
                     var p = gas.Pressure;
                     minPressure = Math.Min(minPressure, p);
                     maxPressure = Math.Max(maxPressure, p);
-                    minTemperature = Math.Min(minTemperature, gas.Temperature);
-                    maxTemperature = Math.Max(maxTemperature, gas.Temperature);
+
+                    // A vacuum has no heat to hold back, so its temperature is irrelevant.
+                    if (gas.TotalMoles > Atmospherics.GasMinMoles)
+                    {
+                        minTemperature = Math.Min(minTemperature, gas.Temperature);
+                        maxTemperature = Math.Max(maxTemperature, gas.Temperature);
+                    }
                 }
 
                 holdingPressure |= maxPressure - minPressure > firelock.PressureThreshold;
@@ -209,15 +214,18 @@ private void OnAtmosAlarm(EntityUid uid, FirelockComponent component, AtmosAlarm
                 var p = local.Pressure;
                 minPressure = Math.Min(minPressure, p);
                 maxPressure = Math.Max(maxPressure, p);
-                minTemperature = Math.Min(minTemperature, local.Temperature);
-                maxTemperature = Math.Max(maxTemperature, local.Temperature);
+
+                if (local.TotalMoles > Atmospherics.GasMinMoles)
+                {
+                    minTemperature = Math.Min(minTemperature, local.Temperature);
+                    maxTemperature = Math.Max(maxTemperature, local.Temperature);
+                }
             }
             else
             {
+                // No tile atmosphere: treat as vacuum (no pressure, no heat).
                 minPressure = Math.Min(minPressure, 0);
                 maxPressure = Math.Max(maxPressure, 0);
-                minTemperature = Math.Min(minTemperature, 0);
-                maxTemperature = Math.Max(maxTemperature, 0);
             }
 
             holdingPressure |= maxPressure - minPressure > firelock.PressureThreshold;
