+        protected override void OnDoorStateChanged(Entity<FirelockComponent> ent, ref DoorStateChangedEvent args)
+        {
+            // Warnings only apply to a shut door; clear them as soon as it stops being shut.
+            if (args.State is not (DoorState.Closed or DoorState.Welded or DoorState.Denying))
+            {
+                if (ent.Comp.Pressure || ent.Comp.Temperature)
+                {
+                    ent.Comp.Pressure = false;
+                    ent.Comp.Temperature = false;
+                    Dirty(ent);
+                }
+
+                if (_pointLightQuery.TryComp(ent, out var pointLight))
+                    _pointLight.SetEnabled(ent, false, pointLight);
+            }
+
+            base.OnDoorStateChanged(ent, ref args);
+        }
