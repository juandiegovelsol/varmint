diff --git a/Content.Client/Doors/FirelockSystem.cs b/Content.Client/Doors/FirelockSystem.cs
index 911d40b..5b90856 100644
--- a/Content.Client/Doors/FirelockSystem.cs
+++ b/Content.Client/Doors/FirelockSystem.cs
@@ -85,5 +85,16 @@ private void OnAppearanceChange(Entity<FirelockComponent> ent, ref AppearanceCha
 
         if (_sprite.LayerMapTryGet((ent, args.Sprite), DoorVisualLayers.BaseBolted, out var boltedLayer, logMissing: false))
             _sprite.LayerSetVisible((ent, args.Sprite), boltedLayer, boltedVisible);
+
+        // The pressure/temperature warnings only show while the door is shut.
+        var shut = state is DoorState.Closed or DoorState.Welded or DoorState.Denying;
+        var pressureVisible = shut && args.TryGetData<bool>(FirelockVisuals.PressureWarning, out var pressure) && pressure;
+        var temperatureVisible = shut && args.TryGetData<bool>(FirelockVisuals.TemperatureWarning, out var temperature) && temperature;
+
+        if (_sprite.LayerMapTryGet((ent, args.Sprite), FirelockVisualLayersPressure.Base, out var pressureLayer, logMissing: false))
+            _sprite.LayerSetVisible((ent, args.Sprite), pressureLayer, pressureVisible);
+
+        if (_sprite.LayerMapTryGet((ent, args.Sprite), FirelockVisualLayersTemperature.Base, out var temperatureLayer, logMissing: false))
+            _sprite.LayerSetVisible((ent, args.Sprite), temperatureLayer, temperatureVisible);
     }
 }
