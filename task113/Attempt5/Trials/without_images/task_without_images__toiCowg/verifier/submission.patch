@@ -112,6 +113,38 @@ protected virtual void OnComponentStartup(Entity<FirelockComponent> ent, ref Com
 
     private void UpdateVisuals(EntityUid uid, FirelockComponent component, EntityEventArgs args) => UpdateVisuals(uid, component);
 
+    private void OnDoorStateChanged(EntityUid uid, FirelockComponent component, DoorStateChangedEvent args)
+    {
+        // A firelock that is not shut is not holding anything back, so drop any active warnings.
+        if (args.State != DoorState.Closed
+            && args.State != DoorState.Welded
+            && args.State != DoorState.Denying)
+        {
+            ClearWarnings((uid, component));
+        }
+
+        UpdateVisuals(uid, component);
+    }
+
+    /// <summary>
+    /// Clears the pressure and temperature warnings of a firelock.
+    /// </summary>
+    protected virtual void ClearWarnings(Entity<FirelockComponent> ent)
+    {
+        if (ent.Comp.Pressure || ent.Comp.Temperature)
+        {
+            ent.Comp.Pressure = false;
+            ent.Comp.Temperature = false;
+            Dirty(ent);
+        }
+
+        if (!TryComp<AppearanceComponent>(ent, out var appearance))
+            return;
+
+        _appearance.SetData(ent, FirelockVisuals.PressureWarning, false, appearance);
+        _appearance.SetData(ent, FirelockVisuals.TemperatureWarning, false, appearance);
+    }
