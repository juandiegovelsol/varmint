new file mode 100644
--- /dev/null
+++ b/src/shapes/Text/f2p_additions.spec.ts
@@ -0,0 +1,253 @@
+import { describe, expect, it } from 'vitest';
+import { FabricText } from './Text';
+
+/**
+ * Behavioural probes for the configurable decoration line-weight feature.
+ *
+ * These tests deliberately assume NOTHING about:
+ *   - what the new public property is called,
+ *   - what CSS declaration / SVG attribute carries it,
+ *   - what unit or numeric scale it is expressed in,
+ *   - whether it is emitted as `name: value` or `name="value"`.
+ *
+ * The control is *discovered* at runtime: we look for a serialisable numeric
+ * property that, when scaled, makes some numeric value in the emitted SVG
+ * scale by the same factor. Any behaviourally correct implementation is found
+ * by that probe; an unfixed library is not.
+ */
+
+/** Numeric properties an unfixed text object already serialises. */
+const PRE_EXISTING_NUMERIC_PROPS = [
+  'left',
+  'top',
+  'width',
+  'height',
+  'scaleX',
+  'scaleY',
+  'angle',
+  'opacity',
+  'strokeWidth',
+  'strokeMiterLimit',
+  'strokeDashOffset',
+  'skewX',
+  'skewY',
+  'fontSize',
+  'fontWeight',
+  'lineHeight',
+  'charSpacing',
+  'deltaY',
+  'pathStartOffset',
+  'padding',
+  'minScaleLimit',
+  'cornerSize',
+  'touchCornerSize',
+  'borderScaleFactor',
+  'rotatingPointOffset',
+  'borderOpacityWhenMoving',
+  'CACHE_FONT_SIZE',
+  'MIN_TEXT_WIDTH',
+];
+
+const LOW = 100;
+const HIGH = 300;
+const RATIO = HIGH / LOW;
+
+/**
+ * Every `name: 12.5` CSS declaration and every `name="12.5"` XML attribute in
+ * the SVG, collected as { declarationName: [numbers, in document order] }.
+ * Trailing units (%, px, em, ...) are ignored, so the unit is never pinned.
+ */
+function numericDeclarations(svg) {
+  const out = Object.create(null);
+  const push = (name, raw) => {
+    const value = parseFloat(raw);
+    if (!isFinite(value)) {
+      return;
+    }
+    if (!out[name]) {
+      out[name] = [];
+    }
+    out[name].push(value);
+  };
+
+  const cssRe = /([a-zA-Z][\w-]*)\s*:\s*(-?\d*\.?\d+)/g;
+  let m;
+  while ((m = cssRe.exec(svg)) !== null) {
+    push(m[1], m[2]);
+  }
+
+  const attrRe = /([a-zA-Z][\w-]*)\s*=\s*"(-?\d*\.?\d+)[^"]*"/g;
+  while ((m = attrRe.exec(svg)) !== null) {
+    push(m[1], m[2]);
+  }
+
+  return out;
+}
+
+/** Numeric properties on a text object that the unfixed library did not have. */
+function candidateProps() {
+  const serialized = new FabricText('X', { underline: true }).toObject();
+  return Object.keys(serialized).filter(
+    (key) =>
+      typeof serialized[key] === 'number' &&
+      key.charAt(0) !== '_' &&
+      PRE_EXISTING_NUMERIC_PROPS.indexOf(key) === -1,
+  );
+}
+
+function closeEnough(actual, expected) {
+  return Math.abs(actual - expected) <= Math.max(0.02, Math.abs(expected) * 0.02);
+}
+
+/**
+ * Find { prop, decl }: a public property `prop` whose value is reported in the
+ * emitted SVG through declaration `decl`, proportionally.
+ * Returns null when no such control exists (i.e. on an unfixed library).
+ */
+function discoverKnob() {
+  const props = candidateProps();
+  for (let p = 0; p < props.length; p++) {
+    const prop = props[p];
+    const lowSvg = new FabricText('X', {
+      underline: true,
+      [prop]: LOW,
+    }).toSVG();
+    const highSvg = new FabricText('X', {
+      underline: true,
+      [prop]: HIGH,
+    }).toSVG();
+    if (lowSvg === highSvg) {
+      continue;
+    }
+    const low = numericDeclarations(lowSvg);
+    const high = numericDeclarations(highSvg);
+    const names = Object.keys(low);
+    for (let n = 0; n < names.length; n++) {
+      const decl = names[n];
+      const lowVals = low[decl];
+      const highVals = high[decl];
+      if (!highVals || highVals.length !== lowVals.length) {
+        continue;
+      }
+      let scales = false;
+      let consistent = true;
+      for (let i = 0; i < lowVals.length; i++) {
+        const l = lowVals[i];
+        const h = highVals[i];
+        if (l !== 0 && closeEnough(h, l * RATIO)) {
+          scales = true;
+        } else if (l !== h) {
+          consistent = false;
+          break;
+        }
+      }
+      if (scales && consistent) {
+        return { prop: prop, decl: decl };
+      }
+    }
+  }
+  return null;
+}
+
+function valuesOf(svg, decl) {
+  return numericDeclarations(svg)[decl] || [];
+}
+
+function distinctCount(values) {
+  const seen = {};
+  let n = 0;
+  for (let i = 0; i < values.length; i++) {
+    const k = String(values[i]);
+    if (!seen[k]) {
+      seen[k] = true;
+      n++;
+    }
+  }
+  return n;
+}
+
+describe('text decoration line weight', () => {
+  it('decoration weight is configurable and scales the emitted SVG', () => {
+    const knob = discoverKnob();
+    expect(
+      knob,
+      'no public property makes the decoration weight in the emitted SVG scale with it',
+    ).not.toBeNull();
+  });
+
+  it('decoration weight applies to underline, overline and linethrough', () => {
+    const knob = discoverKnob();
+    expect(knob).not.toBeNull();
+
+    const text = new FabricText('abc', {
+      styles: {
+        0: {
+          0: { underline: true, [knob.prop]: 40 },
+          1: { overline: true, [knob.prop]: 160 },
+          2: { linethrough: true, [knob.prop]: 280 },
+        },
+      },
+    });
+
+    // One distinct reported weight per decoration type.
+    expect(distinctCount(valuesOf(text.toSVG(), knob.decl))).toBeGreaterThanOrEqual(3);
+  });
+
+  it('decoration weight varies per character inside one text object', () => {
+    const knob = discoverKnob();
+    expect(knob).not.toBeNull();
+
+    const text = new FabricText('AB', {
+      underline: true,
+      styles: {
+        0: {
+          0: { [knob.prop]: 50 },
+          1: { [knob.prop]: 400 },
+        },
+      },
+    });
+
+    const values = valuesOf(text.toSVG(), knob.decl);
+    expect(values.length).toBeGreaterThanOrEqual(2);
+    expect(distinctCount(values)).toBeGreaterThanOrEqual(2);
+  });
+
+  it('decoration weight survives object round-trip serialization', async () => {
+    const knob = discoverKnob();
+    expect(knob).not.toBeNull();
+
+    const original = new FabricText('AB', {
+      underline: true,
+      [knob.prop]: 220,
+      styles: {
+        0: {
+          1: { [knob.prop]: 40 },
+        },
+      },
+    });
+
+    const restored = await FabricText.fromObject(original.toObject());
+    expect(restored.toSVG()).toBe(original.toSVG());
+  });
+
+  it('default decoration weight is exposed and left unchanged', () => {
+    const knob = discoverKnob();
+    expect(knob).not.toBeNull();
+
+    const stock = new FabricText('X', { underline: true });
+    const stockSvg = stock.toSVG();
+
+    const values = valuesOf(stockSvg, knob.decl);
+    expect(values.length).toBeGreaterThanOrEqual(1);
+    expect(values.every((v) => v > 0)).toBe(true);
+
+    // Opting in with the serialised default must be a no-op for existing users.
+    const defaultValue = stock.toObject()[knob.prop];
+    expect(typeof defaultValue).toBe('number');
+    const explicit = new FabricText('X', {
+      underline: true,
+      [knob.prop]: defaultValue,
+    });
+    expect(explicit.toSVG()).toBe(stockSvg);
+  });
+});
