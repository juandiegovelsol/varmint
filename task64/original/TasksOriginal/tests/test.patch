diff --git a/packages/tldraw/src/test/ui/FollowingIndicatorLayering.test.tsx b/packages/tldraw/src/test/ui/FollowingIndicatorLayering.test.tsx
new file mode 100644
index 0000000..f08f10b
--- /dev/null
+++ b/packages/tldraw/src/test/ui/FollowingIndicatorLayering.test.tsx
@@ -0,0 +1,141 @@
+import { act, screen } from '@testing-library/react'
+import { Tldraw } from '../../lib/Tldraw'
+import { renderTldrawComponent, renderTldrawComponentWithEditor } from '../testutils/renderTldrawComponent'
+
+// Regression coverage for issue #8821: the following-indicator border (DefaultFollowingIndicator)
+// used to be rendered inside TldrawUiInFrontOfTheCanvas(), which mounts inside the canvas's own
+// `.tl-canvas__in-front` overlay (stacking context z-index 250). The main UI layout
+// (`.tlui-layout`, menus/toolbar/style panel/minimap) sits in a *separate*, *higher* stacking
+// context (z-index 300) that is a sibling of the canvas, not a descendant of it. Because CSS
+// z-index only resolves relative to the nearest stacking context, no z-index the border could be
+// given inside `.tl-canvas__in-front` can ever place it above `.tlui-layout`'s own descendants -
+// so every UI panel visually cut the border wherever it touched the edge of the viewport.
+//
+// The fix moves the FollowingIndicator slot out of TldrawUiInFrontOfTheCanvas() and renders it
+// directly inside TldrawUiContent()'s own `.tlui-layout` element instead (after the top/bottom
+// panel groups, before Toasts/Dialogs), so it shares the UI layer's own, higher stacking context
+// and paints on top of every panel by ordinary DOM paint order.
+//
+// jsdom has no layout/paint engine, so these tests can't check actual pixels or resolved z-index
+// (this repo's own vitest setup stubs window.getComputedStyle to a fixed set of properties that
+// never reflects real stylesheet rules - see packages/tldraw/setupVitest.js). What IS observable,
+// and what the fix is actually made of, is the React/DOM tree: which stacking-context container
+// the indicator's element lands in, and where among that container's children it lands. Both
+// component slots are exercised through the public `components` override prop (the same
+// mechanism packages/editor/src/lib/test/InFrontOfTheCanvas.test.tsx already uses to swap in a
+// test double for a slot), not by reaching into implementation details.
+
+function Marker({ testId }: { testId: string }) {
+	return <div data-testid={testId} />
+}
+
+async function renderWithMarkers() {
+	return renderTldrawComponent(
+		<Tldraw
+			components={{
+				FollowingIndicator: () => <Marker testId="following-indicator-marker" />,
+				RichTextToolbar: () => <Marker testId="rich-text-toolbar-marker" />,
+				ImageToolbar: () => <Marker testId="image-toolbar-marker" />,
+				VideoToolbar: () => <Marker testId="video-toolbar-marker" />,
+				CursorChatBubble: () => <Marker testId="cursor-chat-bubble-marker" />,
+			}}
+		/>,
+		{ waitForPatterns: true }
+	)
+}
+
+describe('FollowingIndicator layering (issue #8821)', () => {
+	it('places the following indicator inside the UI layout, not the canvas-in-front overlay', async () => {
+		await renderWithMarkers()
+		const marker = await screen.findByTestId('following-indicator-marker')
+
+		expect(marker.closest('.tlui-layout')).not.toBeNull()
+		expect(marker.closest('.tl-canvas__in-front')).toBeNull()
+	})
+
+	it('renders the following indicator after the toolbar and menu panels in the UI layout', async () => {
+		await renderWithMarkers()
+		const marker = await screen.findByTestId('following-indicator-marker')
+
+		const layout = marker.closest('.tlui-layout')
+		expect(layout).not.toBeNull()
+
+		// The panel groups (menu/style/toolbar/navigation) live inside .tlui-layout__top and
+		// .tlui-layout__bottom. Neither of those wrappers - nor the panels inside them - declares
+		// its own z-index, so within .tlui-layout's single stacking context, plain DOM order
+		// decides paint order: a later sibling paints on top of an earlier one. The indicator must
+		// come AFTER the panel groups to sit visually in front of them; putting it first (e.g. right
+		// after SkipToMainContent, before the panels) would silently reintroduce the same bug one
+		// level down, inside .tlui-layout itself.
+		const bottomPanelGroup = layout!.querySelector('.tlui-layout__bottom')
+		expect(bottomPanelGroup).not.toBeNull()
+
+		const position = marker.compareDocumentPosition(bottomPanelGroup!)
+		// DOCUMENT_POSITION_PRECEDING (0x02): bottomPanelGroup comes BEFORE marker in the tree.
+		// eslint-disable-next-line no-bitwise
+		expect(position & Node.DOCUMENT_POSITION_PRECEDING).toBe(Node.DOCUMENT_POSITION_PRECEDING)
+	})
+
+	it('still places the following indicator inside the UI layout while in focus mode', async () => {
+		// Focus mode swaps TldrawUiContent's normal top/bottom panel groups for a single
+		// "exit focus mode" button (see the isFocusMode ternary in TldrawUi.tsx), but the
+		// follow border has nothing to do with that toolbar chrome - it must keep rendering
+		// regardless. A fix that only inserts the indicator inside the *non-focus-mode* branch
+		// of that ternary (instead of after it, unconditionally) would pass every other test
+		// here and still silently drop the border the moment focus mode is active.
+		const { editor } = await renderTldrawComponentWithEditor(
+			(onMount) => (
+				<Tldraw
+					onMount={onMount}
+					components={{ FollowingIndicator: () => <Marker testId="following-indicator-marker" /> }}
+				/>
+			),
+			{ waitForPatterns: true }
+		)
+
+		await act(async () => {
+			editor.updateInstanceState({ isFocusMode: true })
+		})
+
+		const marker = await screen.findByTestId('following-indicator-marker')
+		expect(marker.closest('.tlui-layout')).not.toBeNull()
+		expect(marker.closest('.tl-canvas__in-front')).toBeNull()
+	})
+
+	it('still renders the rich text toolbar inside the canvas-in-front overlay', async () => {
+		await renderWithMarkers()
+		const marker = await screen.findByTestId('rich-text-toolbar-marker')
+		expect(marker.closest('.tl-canvas__in-front')).not.toBeNull()
+	})
+
+	it('still renders the image toolbar inside the canvas-in-front overlay', async () => {
+		await renderWithMarkers()
+		const marker = await screen.findByTestId('image-toolbar-marker')
+		expect(marker.closest('.tl-canvas__in-front')).not.toBeNull()
+	})
+
+	it('still renders the video toolbar inside the canvas-in-front overlay', async () => {
+		await renderWithMarkers()
+		const marker = await screen.findByTestId('video-toolbar-marker')
+		expect(marker.closest('.tl-canvas__in-front')).not.toBeNull()
+	})
+
+	it('still renders the cursor chat bubble inside the canvas-in-front overlay', async () => {
+		await renderWithMarkers()
+		const marker = await screen.findByTestId('cursor-chat-bubble-marker')
+		expect(marker.closest('.tl-canvas__in-front')).not.toBeNull()
+	})
+
+	it('renders no following indicator when no override is supplied and nobody is being followed', async () => {
+		await renderTldrawComponent(<Tldraw />, { waitForPatterns: true })
+		// The real DefaultFollowingIndicator renders null until editor.getInstanceState().followingUserId
+		// is set, so no `.tlui-following-indicator` element should exist at all.
+		expect(document.querySelector('.tlui-following-indicator')).toBeNull()
+	})
+
+	it('renders the following indicator override exactly once', async () => {
+		await renderWithMarkers()
+		const markers = await screen.findAllByTestId('following-indicator-marker')
+		expect(markers.length).toBe(1)
+	})
+})
