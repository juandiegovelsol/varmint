+import {
+  buildEditorFromExtensions,
+  DecoratorTextExtension,
+  DecoratorTextNode,
+} from '@lexical/extension';
+import {RichTextExtension} from '@lexical/rich-text';
+import {
+  $create,
+  $createNodeSelection,
+  $createParagraphNode,
+  $createTextNode,
+  $getRoot,
+  $isParagraphNode,
+  $selectAll,
+  $setSelection,
+  FORMAT_TEXT_COMMAND,
+  TEXT_TYPE_TO_FORMAT,
+} from 'lexical';
+import {assert, describe, expect, test} from 'vitest';
+
+const BOLD = TEXT_TYPE_TO_FORMAT.bold;
+
+describe('DecoratorTextExtension FORMAT_TEXT_COMMAND', () => {
+  test('aligns DecoratorTextNode to not-bold when TextNode is bold', () => {
+    // Regression: before the fix, DecoratorTextExtension would blindly toggle
+    // the decorator independently of the TextNode alignment, producing opposite
+    // format states across the two nodes.
+    using editor = buildEditorFromExtensions({
+      $initialEditorState: () => {
+        const paragraph = $createParagraphNode();
+        $getRoot().append(paragraph);
+
+        const decorator = $create(DecoratorTextNode);
+        // decorator starts not-bold (format = 0)
+        const text = $createTextNode('hello');
+        text.setFormat(BOLD); // TextNode starts bold
+        paragraph.append(decorator, text);
+
+        $selectAll();
+      },
+      dependencies: [DecoratorTextExtension, RichTextExtension],
+      name: 'test',
+    });
+
+    editor.dispatchCommand(FORMAT_TEXT_COMMAND, 'bold');
+
+    editor.read(() => {
+      const paragraph = $getRoot().getFirstChildOrThrow();
+      assert($isParagraphNode(paragraph));
+      const children = paragraph.getChildren();
+      const decorator = children[0] as DecoratorTextNode;
+      const text = children[children.length - 1] as unknown as {
+        getFormat(): number;
+      };
+      // TextNode (bold=1) drives firstNextFormat → bold=0.
+      // DecoratorTextNode must align to bold=0 (not toggle independently to bold=1).
+      expect(decorator.getFormat()).toBe(0);
+      expect(text.getFormat()).toBe(0);
+    });
+  });
+
+  test('aligns DecoratorTextNode to bold when TextNode is not-bold', () => {
+    using editor = buildEditorFromExtensions({
+      $initialEditorState: () => {
+        const paragraph = $createParagraphNode();
+        $getRoot().append(paragraph);
+
+        const decorator = $create(DecoratorTextNode);
+        decorator.setFormat(BOLD); // DecoratorTextNode starts bold
+        const text = $createTextNode('hello');
+        // TextNode starts not-bold (format = 0)
+        paragraph.append(decorator, text);
+
+        $selectAll();
+      },
+      dependencies: [DecoratorTextExtension, RichTextExtension],
+      name: 'test',
+    });
+
+    editor.dispatchCommand(FORMAT_TEXT_COMMAND, 'bold');
+
+    editor.read(() => {
+      const paragraph = $getRoot().getFirstChildOrThrow();
+      assert($isParagraphNode(paragraph));
+      const children = paragraph.getChildren();
+      const decorator = children[0] as DecoratorTextNode;
+      const text = children[children.length - 1] as unknown as {
+        getFormat(): number;
+      };
+      // TextNode (bold=0) drives firstNextFormat → bold=1.
+      // DecoratorTextNode must align to bold=1 (not toggle independently to bold=0).
+      expect(decorator.getFormat()).toBe(BOLD);
+      expect(text.getFormat()).toBe(BOLD);
+    });
+  });
+
+  test('removes bold from all nodes when every node in selection is already bold', () => {
+    // Not actually distinguishing: both nodes start in the SAME format, so an
+    // independent per-node toggle (the pre-fix behavior) coincidentally lands on
+    // the same result as an aligned toggle. Kept as a p2p regression guard, not
+    // a base-repro case (verified empirically: passes unmodified on base too).
+    using editor = buildEditorFromExtensions({
+      $initialEditorState: () => {
+        const paragraph = $createParagraphNode();
+        $getRoot().append(paragraph);
+
+        const decorator = $create(DecoratorTextNode);
+        decorator.setFormat(BOLD);
+        const text = $createTextNode('hello');
+        text.setFormat(BOLD);
+        paragraph.append(decorator, text);
+
+        $selectAll();
+      },
+      dependencies: [DecoratorTextExtension, RichTextExtension],
+      name: 'test',
+    });
+
+    editor.dispatchCommand(FORMAT_TEXT_COMMAND, 'bold');
+
+    editor.read(() => {
+      const paragraph = $getRoot().getFirstChildOrThrow();
+      assert($isParagraphNode(paragraph));
+      const children = paragraph.getChildren();
+      const decorator = children[0] as DecoratorTextNode;
+      const text = children[children.length - 1] as unknown as {
+        getFormat(): number;
+      };
+      expect(decorator.getFormat()).toBe(0);
+      expect(text.getFormat()).toBe(0);
+    });
+  });
+
+  test('a NodeSelection over DecoratorTextNodes only (no TextNode) still toggles independently', () => {
+    // Regression guard: when there is no TextNode in the selection to use as an
+    // alignment reference (a pure NodeSelection over decorators), both the old
+    // DecoratorTextExtension handler and the new $formatText NodeSelection branch
+    // toggle each decorator independently (alignWithFormat=null) -- unaffected by
+    // the fix, since the fix's alignment logic only kicks in when a TextNode is
+    // present. Verified empirically to pass unmodified on base as well.
+    using editor = buildEditorFromExtensions({
+      $initialEditorState: () => {
+        const paragraph = $createParagraphNode();
+        $getRoot().append(paragraph);
+
+        const decoratorA = $create(DecoratorTextNode);
+        decoratorA.setFormat(BOLD);
+        const decoratorB = $create(DecoratorTextNode);
+        // decoratorB starts not-bold (format = 0)
+        paragraph.append(decoratorA, decoratorB);
+      },
+      dependencies: [DecoratorTextExtension, RichTextExtension],
+      name: 'test',
+    });
+
+    editor.update(
+      () => {
+        const paragraph = $getRoot().getFirstChildOrThrow();
+        assert($isParagraphNode(paragraph));
+        const [decoratorA, decoratorB] = paragraph.getChildren();
+        const nodeSelection = $createNodeSelection();
+        nodeSelection.add(decoratorA.getKey());
+        nodeSelection.add(decoratorB.getKey());
+        $setSelection(nodeSelection);
+      },
+      {discrete: true},
+    );
+
+    editor.dispatchCommand(FORMAT_TEXT_COMMAND, 'bold');
+
+    editor.read(() => {
+      const paragraph = $getRoot().getFirstChildOrThrow();
+      assert($isParagraphNode(paragraph));
+      const [decoratorA, decoratorB] = paragraph.getChildren() as DecoratorTextNode[];
+      // Each decorator toggles independently: A was bold -> not-bold, B was
+      // not-bold -> bold. If they were instead aligned to a single target
+      // format (which would be a regression for the no-TextNode case), they'd
+      // end up equal to each other.
+      expect(decoratorA.getFormat()).toBe(0);
+      expect(decoratorB.getFormat()).toBe(BOLD);
+    });
+  });
+
+  test('a RangeSelection over TextNodes only (no decorator) formats normally', () => {
+    // Regression guard for the refactor itself: RangeSelection.formatText's logic
+    // was extracted into the new $formatText helper. A selection spanning two
+    // plain TextNodes with different starting formats must still align to the
+    // first TextNode's next format exactly as it did before the refactor.
+    using editor = buildEditorFromExtensions({
+      $initialEditorState: () => {
+        const paragraph = $createParagraphNode();
+        $getRoot().append(paragraph);
+
+        const textA = $createTextNode('hello');
+        // textA starts not-bold (format = 0)
+        const textB = $createTextNode('world');
+        textB.setFormat(BOLD); // textB starts bold
+        paragraph.append(textA, textB);
+
+        $selectAll();
+      },
+      dependencies: [DecoratorTextExtension, RichTextExtension],
+      name: 'test',
+    });
+
+    editor.dispatchCommand(FORMAT_TEXT_COMMAND, 'bold');
+
+    editor.read(() => {
+      const paragraph = $getRoot().getFirstChildOrThrow();
+      assert($isParagraphNode(paragraph));
+      // textA (first node, bold=0) drives firstNextFormat -> bold=1; textB aligns
+      // to it. Assert merge-tolerantly: reconciliation may coalesce the two
+      // TextNodes into one once they share the same resulting format, so check
+      // the combined text content and every remaining child's format rather than
+      // assuming exactly two sibling nodes survive.
+      const children = paragraph.getChildren() as unknown as {
+        getFormat(): number;
+      }[];
+      expect(paragraph.getTextContent()).toBe('helloworld');
+      expect(children.length).toBeGreaterThan(0);
+      for (const child of children) {
+        expect(child.getFormat()).toBe(BOLD);
+      }
+    });
+  });
+});
