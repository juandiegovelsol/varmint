@@ -0,0 +1,113 @@
+// Behavioural tests for the reported UI-theme inconsistency.
+//
+// Every assertion is about what a player sees or can click for a given game
+// state. No test names a component, file, CSS class, prop or data field that a
+// fix is expected to introduce, so any implementation producing the required
+// on-screen behaviour passes and any implementation that does not, fails.
+
+import { mount } from "@vue/test-utils";
+
+import ClassicAntimatterDimensionsTab from "@/components/tabs/antimatter-dimensions/ClassicAntimatterDimensionsTab";
+import ModernAntimatterDimensionsTab from "@/components/tabs/antimatter-dimensions/ModernAntimatterDimensionsTab";
+import HeaderCenterContainer from "@/components/ui-modes/prestige-header/HeaderCenterContainer";
+
+import {
+  installGameGlobals,
+  installPrototypeHelpers,
+  renderedText,
+  runGameLoop,
+  setGameGlobal,
+  TICKSPEED_MULT_PER_UPGRADE,
+  TICKSPEED_PER_SECOND,
+} from "./game-stubs";
+
+installPrototypeHelpers();
+
+// The state both screenshots were taken in: a save that has just been started.
+const FRESH_SAVE = { realityUnlocked: false, tickspeedUnlocked: false };
+
+async function renderHeader(opts) {
+  installGameGlobals(opts);
+  const wrapper = mount(HeaderCenterContainer);
+  await runGameLoop(wrapper);
+  const text = renderedText(wrapper);
+  wrapper.destroy();
+  return text;
+}
+
+// Press every button the tab offers and report how many there were.
+async function pressEveryButton(wrapper) {
+  const buttons = wrapper.findAll("button").wrappers;
+
+  // jsdom compiles inline `onclick="..."` attributes inside its own realm,
+  // where the stubbed game globals are not reachable. Detach them and run the
+  // very same source here instead, which is where the globals live.
+  const inlineHandlers = [];
+  for (const button of buttons) {
+    const source = button.element.getAttribute("onclick");
+    if (source === null) continue;
+    button.element.removeAttribute("onclick");
+    inlineHandlers.push(source);
+  }
+
+  for (const button of buttons) {
+    // eslint-disable-next-line no-await-in-loop
+    await button.trigger("click");
+  }
+  for (const source of inlineHandlers) {
+    // eslint-disable-next-line no-new-func
+    new Function(source)();
+  }
+
+  return buttons.length;
+}
+
+async function countTickspeedPurchases(TabComponent) {
+  installGameGlobals({ newUI: TabComponent !== ClassicAntimatterDimensionsTab,
+    realityUnlocked: false,
+    tickspeedUnlocked: true });
+  const buyTickSpeed = setGameGlobal("buyTickSpeed", vi.fn(() => true));
+
+  // Mount the header alongside the tab, exactly as the real app composes
+  // them, so this does not assume which of the two regions the purchase
+  // control ends up living in - only that a player looking at both can
+  // reach it.
+  const Screen = {
+    name: "TickspeedPurchaseScreen",
+    components: { HeaderCenterContainer, Tab: TabComponent },
+    template: "<div><HeaderCenterContainer /><Tab /></div>",
+  };
+
+  const wrapper = mount(Screen);
+  await runGameLoop(wrapper);
+  const pressed = await pressEveryButton(wrapper);
+  wrapper.destroy();
+
+  expect(pressed).toBeGreaterThan(0);
+  return buyTickSpeed.mock.calls.length;
+}
+
+describe("tickspeed-visibility", () => {
+  it("both UI themes show the same header information on a fresh save", async () => {
+    const modern = await renderHeader({ ...FRESH_SAVE, newUI: true });
+    const classic = await renderHeader({ ...FRESH_SAVE, newUI: false });
+
+    // Guard against agreeing by showing nothing: the reading has to keep
+    // reporting the live Tickspeed figures.
+    expect(modern).toMatch(/tickspeed/iu);
+    expect(modern).toContain(String(TICKSPEED_PER_SECOND));
+    expect(modern).toContain(String(TICKSPEED_MULT_PER_UPGRADE));
+
+    // Both screenshots frame the same region of the screen, so it has to read
+    // the same whichever theme is selected.
+    expect(classic).toBe(modern);
+  });
+
+  it("Classic players can buy Tickspeed before Reality is unlocked", async () => {
+    expect(await countTickspeedPurchases(ClassicAntimatterDimensionsTab)).toBeGreaterThan(0);
+  });
+
+  it("Modern players can buy Tickspeed before Reality is unlocked", async () => {
+    expect(await countTickspeedPurchases(ModernAntimatterDimensionsTab)).toBeGreaterThan(0);
+  });
+});
