+// Minimal, deterministic stand-in for the running game.
+//
+// The real game exposes its state as globals (`player`, `Tickspeed`, `format`,
+// ...) and drives every component by calling its `update()` once per frame.
+// These helpers reproduce just enough of that so a component can be mounted and
+// asked what it renders for a given game state. They say nothing about how any
+// component is implemented.
+import Vue from "vue";
+
+const d = v => new Decimal(v);
+
+const num = v => (v && typeof v.toNumber === "function" ? v.toNumber() : Number(v));
+
+// Number formatters mirroring the shapes the game's own helpers produce, so
+// rendered text is readable and stable.
+const format = (v, places = 0, placesUnder1000 = 0) => num(v).toFixed(Math.max(places, placesUnder1000));
+const formatInt = v => String(Math.round(num(v)));
+const formatFloat = (v, places = 0) => num(v).toFixed(places);
+const formatX = (v, places = 0, placesUnder1000 = 0) => `×${format(v, places, placesUnder1000)}`;
+const formatPercents = (v, places = 0) => `${(num(v) * 100).toFixed(places)}%`;
+const formatPow = (v, places = 0, placesUnder1000 = 0) => `^${format(v, places, placesUnder1000)}`;
+const pluralize = (word, amount, plural) => (num(amount) === 1 ? word : plural ?? `${word}s`);
+const quantify = (word, amount, places = 0) => `${format(amount, places)} ${pluralize(word, amount)}`;
+const quantifyInt = (word, amount) => `${formatInt(amount)} ${pluralize(word, amount)}`;
+
+// Distinctive readings so assertions can tell "the component was fed real game
+// state" apart from "the component rendered its zeroed defaults".
+export const TICKSPEED_PER_SECOND = 7;
+export const TICKSPEED_MULT_PER_UPGRADE = 8;
+
+/**
+ * Publish a whole game state as globals.
+ *
+ * @param {object} opts
+ * @param {boolean} opts.newUI            true = Modern UI theme, false = Classic
+ * @param {boolean} opts.realityUnlocked  has the player unlocked Reality yet
+ * @param {boolean} opts.tickspeedUnlocked has Tickspeed become relevant yet
+ */
+export function installGameGlobals(opts = {}) {
+  const {
+    newUI = false,
+    realityUnlocked = false,
+    tickspeedUnlocked = false,
+  } = opts;
+
+  const antimatter = d(10);
+  antimatter.value = d(10);
+  antimatter.productionPerSecond = d(0);
+
+  const eternityChallenge = () => ({ isRunning: false, completions: 0, isFullyCompleted: true });
+  eternityChallenge.isRunning = false;
+
+  const dimension = tier => ({
+    tier,
+    displayName: `Dim${tier}`,
+    shortDisplayName: `D${tier}`,
+    amount: d(0),
+    bought: 0,
+    boughtBefore10: 0,
+    isUnlocked: false,
+    isAvailableForPurchase: false,
+    multiplier: d(1),
+    rateOfChange: d(0),
+    cost: d(10),
+    isAffordable: false,
+    isAffordableUntil10: false,
+    continuumValue: 0,
+    productionForDiplay: d(0),
+  });
+
+  const globals = {
+    format,
+    formatInt,
+    formatFloat,
+    formatX,
+    formatPercents,
+    formatPow,
+    pluralize,
+    quantify,
+    quantifyInt,
+
+    player: {
+      options: { newUI },
+      galaxies: 0,
+      totalTickBought: 0,
+      dimensionBoosts: 0,
+      buyUntil10: true,
+      dilation: { active: false, lastEP: d(0) },
+      records: { totalAntimatter: d(10) },
+    },
+    Player: {
+      isInAntimatterChallenge: false,
+      antimatterChallenge: { isQuickResettable: false, goal: d(100) },
+      eternityGoal: d(100),
+    },
+    PlayerProgress: { realityUnlocked: () => realityUnlocked },
+    TimeStudy: { reality: { isBought: false } },
+    Currency: { antimatter, infinityPoints: { value: d(0) } },
+    Pelle: { isDoomed: false },
+
+    Tickspeed: {
+      isUnlocked: tickspeedUnlocked,
+      multiplier: d(1 / TICKSPEED_MULT_PER_UPGRADE),
+      perSecond: d(TICKSPEED_PER_SECOND),
+      cost: d(1000),
+      continuumValue: 0,
+    },
+    FreeTickspeed: { amount: 0 },
+    Laitela: { continuumActive: false, continuumUnlocked: false, isRunning: false },
+    Tutorial: { isActive: () => false, turnOffEffect: () => undefined },
+    TUTORIAL_STATE: { TICKSPEED: 1, DIMBOOST: 2, GALAXY: 3 },
+
+    InfinityChallenge: () => ({ isRunning: false }),
+    EternityChallenge: eternityChallenge,
+    AntimatterDimension: dimension,
+    AntimatterDimensions: { buyTenMultiplier: d(2), all: [1, 2, 3, 4, 5, 6, 7, 8].map(dimension) },
+    DimBoost: {
+      requirement: { tier: 1, amount: 20, isSatisfied: false },
+      canBeBought: false,
+      purchasedBoosts: 0,
+      imaginaryBoosts: 0,
+      lockText: null,
+      unlockedByBoost: "",
+      bulkRequirement: () => ({ tier: 1, amount: 20 }),
+    },
+    Galaxy: {
+      requirement: { tier: 8, amount: 80 },
+      canBeBought: false,
+      remoteStart: 800,
+      lockText: null,
+      nextType: () => "Antimatter Galaxy",
+    },
+    Sacrifice: {
+      isVisible: false,
+      canSacrifice: false,
+      totalBoost: d(1),
+      nextBoost: d(1),
+      disabledCondition: "",
+    },
+    Enslaved: { isStoringRealTime: false, canRelease: () => false },
+    GameEnd: { creditsClosed: false, endState: 0 },
+    Perk: { studyECBulk: { isBought: false } },
+    RealityUpgrade: () => ({ isBought: false, canBeApplied: false }),
+    GALAXY_TYPE: { NORMAL: 0, DISTANT: 1, REMOTE: 2 },
+    SHOP_BUY_TYPE: {},
+
+    getGameSpeedupFactor: () => 1,
+    getGameSpeedupForDisplay: () => 1,
+    getTachyonReq: () => d(100),
+    canAfford: () => true,
+    buyTickSpeed: () => true,
+    buyMaxTickSpeed: () => true,
+    buyOneDimension: () => true,
+    buyManyDimension: () => true,
+    buyAsManyAsYouCanBuy: () => true,
+    buyMaxDimension: () => true,
+    infinityUnlocked: () => false,
+    maxAll: () => undefined,
+    softReset: () => undefined,
+    sacrificeBtnClick: () => undefined,
+    requestDimensionBoost: () => undefined,
+    requestGalaxyReset: () => undefined,
+  };
+
+  for (const [key, value] of Object.entries(globals)) {
+    globalThis[key] = value;
+    // Inline `onclick="..."` attributes are evaluated in the document's own
+    // scope, which is not always the same object as globalThis.
+    if (typeof window !== "undefined") window[key] = value;
+    // Vue 2 templates resolve bare identifiers against the component instance,
+    // so the same names have to be reachable from the prototype chain too.
+    Vue.prototype[key] = value;
+  }
+
+  return globals;
+}
+
+/** Publish (or replace) a single game global everywhere a component can see it. */
+export function setGameGlobal(name, value) {
+  globalThis[name] = value;
+  if (typeof window !== "undefined") window[name] = value;
+  Vue.prototype[name] = value;
+  return value;
+}
+
+// A handful of prototype helpers the game installs at boot and some components
+// reach for while rendering.
+export function installPrototypeHelpers() {
+  if (!Math.clampMax) Math.clampMax = (value, max) => Math.min(value, max);
+  if (!Math.clampMin) Math.clampMin = (value, min) => Math.max(value, min);
+  if (!Math.clamp) Math.clamp = (value, min, max) => Math.min(Math.max(value, min), max);
+  if (!Array.prototype.sum) {
+    // eslint-disable-next-line no-extend-native
+    Object.defineProperty(Array.prototype, "sum", {
+      value() { return this.reduce((a, b) => a + b, 0); },
+      enumerable: false,
+    });
+  }
+  if (!Decimal.prototype.pLog10) {
+    Decimal.prototype.pLog10 = function pLog10() { return Math.max(this.log10(), 0); };
+  }
+}
+
+/**
+ * Run one frame of the game loop over a mounted tree: every component that
+ * exposes an `update()` gets it called, parents first, then the DOM is flushed.
+ * Peripheral components that the stubbed state cannot fully satisfy are allowed
+ * to bail out — anything the test actually asserts on has to render anyway.
+ */
+export async function runGameLoop(wrapper, frames = 2) {
+  for (let frame = 0; frame < frames; frame++) {
+    const visit = vm => {
+      if (typeof vm.update === "function") {
+        try {
+          vm.update();
+        } catch (e) {
+          // peripheral component, not under test
+        }
+      }
+      vm.$children.forEach(visit);
+    };
+    visit(wrapper.vm);
+    // eslint-disable-next-line no-await-in-loop
+    await wrapper.vm.$nextTick();
+  }
+}
+
+/** Rendered text of a mounted tree, whitespace-normalised. */
+export function renderedText(wrapper) {
+  return wrapper.text().replace(/\s+/gu, " ").trim();
+}
