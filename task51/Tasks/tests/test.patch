@@ -0,0 +1,21 @@
+// Runs BEFORE any test module is imported, so `Decimal` exists by the time a
+// component module executes its top-level `new Decimal(...)` calls.
+import Decimal from "break_infinity.js";
+import Vue from "vue";
+
+globalThis.Decimal = Decimal;
+
+// The game patches this onto Decimal at boot (javascripts/core/extensions.js).
+if (!Decimal.prototype.copyFrom) {
+  Decimal.prototype.copyFrom = function copyFrom(other) {
+    this.mantissa = other.mantissa;
+    this.exponent = other.exponent;
+    return this;
+  };
+}
+
+Vue.config.productionTip = false;
+Vue.config.devtools = false;
+
+// The app registers v-tooltip globally at boot; a no-op keeps mounts quiet.
+Vue.directive("tooltip", {});
diff --git a/src/__tests__/tickspeed-visibility.test.js b/src/__tests__/tickspeed-visibility.test.js
