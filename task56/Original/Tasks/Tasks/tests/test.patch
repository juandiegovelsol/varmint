+
+import { expect, fixture, html, oneEvent } from '@open-wc/testing';
+import { sendKeys } from '@web/test-runner-commands';
+import '@carbon/web-components/es/components/tabs/index.js';
+
+describe('cds-tabs manual selection mode', function () {
+  it('should move focus without changing selection or emitting cds-tabs-selected during arrow-key navigation', async () => {
+    const el = await fixture(html`
+      <cds-tabs value="all" selection-mode="manual">
+        <cds-tab id="tab-all" target="panel-all" value="all">
+          Dashboard
+        </cds-tab>
+        <cds-tab
+          id="tab-cloudFoundry"
+          target="panel-cloudFoundry"
+          value="cloudFoundry">
+          Monitoring
+        </cds-tab>
+        <cds-tab id="tab-staging" target="panel-staging" value="staging">
+          Activity
+        </cds-tab>
+      </cds-tabs>
+    `);
+
+    await el.updateComplete;
+
+    const tabs = el.querySelectorAll('cds-tab');
+    const firstLink = tabs[0].shadowRoot.querySelector('a');
+    firstLink.focus();
+
+    let eventCount = 0;
+    const onSelected = () => {
+      eventCount++;
+    };
+
+    el.addEventListener('cds-tabs-selected', onSelected);
+
+    await sendKeys({ press: 'ArrowRight' });
+    await el.updateComplete;
+    await tabs[1].updateComplete;
+
+    expect(document.activeElement).to.equal(tabs[1]);
+    expect(tabs[1].shadowRoot.activeElement).to.equal(
+      tabs[1].shadowRoot.querySelector('a')
+    );
+    expect(el.value).to.equal('all');
+    expect(eventCount).to.equal(0);
+
+    await sendKeys({ press: 'ArrowLeft' });
+    await el.updateComplete;
+    await tabs[0].updateComplete;
+
+    expect(document.activeElement).to.equal(tabs[0]);
+    expect(tabs[0].shadowRoot.activeElement).to.equal(
+      tabs[0].shadowRoot.querySelector('a')
+    );
+    expect(el.value).to.equal('all');
+    expect(eventCount).to.equal(0);
+
+    el.removeEventListener('cds-tabs-selected', onSelected);
+  });
+
+  it('should emit cds-tabs-selected when the focused tab is explicitly selected with the keyboard', async () => {
+    for (const key of ['Enter', ' ']) {
+      const el = await fixture(html`
+        <cds-tabs value="all" selection-mode="manual">
+          <cds-tab id="tab-all" target="panel-all" value="all">
+            Dashboard
+          </cds-tab>
+          <cds-tab
+            id="tab-cloudFoundry"
+            target="panel-cloudFoundry"
+            value="cloudFoundry">
+            Monitoring
+          </cds-tab>
+          <cds-tab id="tab-staging" target="panel-staging" value="staging">
+            Activity
+          </cds-tab>
+        </cds-tabs>
+      `);
+
+      await el.updateComplete;
+
+      const tabs = el.querySelectorAll('cds-tab');
+      tabs[0].shadowRoot.querySelector('a').focus();
+
+      await sendKeys({ press: 'ArrowRight' });
+      await el.updateComplete;
+      await tabs[1].updateComplete;
+
+      expect(el.value).to.equal('all');
+
+      const eventPromise = oneEvent(el, 'cds-tabs-selected');
+      await sendKeys({ press: key });
+      const { detail } = await eventPromise;
+
+      expect(detail.item).to.equal(tabs[1]);
+      expect(detail.item.getAttribute('value')).to.equal('cloudFoundry');
+      expect(el.value).to.equal('cloudFoundry');
+    }
+  });
+});
