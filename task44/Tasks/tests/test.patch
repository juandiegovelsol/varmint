+"""Behavioural contract for the attendee-badge PDF export.
+
+The export offers a set of *rendering options*: one badge per sheet, or several
+badges tiled onto a single sheet.  Whatever option is chosen, the printed result
+must be the same badge -- its artwork and its printed text together -- simply
+placed into its slot on the sheet.
+
+Everything asserted here is measured from the *rendered pixels* of the produced
+PDF (poppler raster) and every expectation is recomputed at run time from the
+fixture itself: from the artwork colours that were uploaded, from the sheet size
+that came back, and from what the very same badge looks like when it is printed
+one-per-sheet.  No symbol, key, helper name, module name or magic constant of
+any implementation appears in an assertion.
+
+Two independent, fully disjoint fixture palettes are used ("harbourfog" and
+"nordkap"): different artwork colours, different text colours, different badge
+orientation, different badge counts and different rendering options.
+"""
+
+import glob
+import json
+import math
+import os
+import re
+import subprocess
+import tempfile
+from datetime import timedelta
+from decimal import Decimal
+from io import BytesIO
+
+import numpy as np
+import pytest
+from django.core.files.base import ContentFile
+from django.utils.timezone import now
+from django_scopes import scopes_disabled
+from PIL import Image
+from pypdf import PdfReader, PdfWriter
+from reportlab.lib.units import mm
+from reportlab.pdfgen import canvas as rl_canvas
+
+from eventyay.base.models import Event, Order, OrderPosition, Organizer, Product
+from eventyay.base.services.orders import OrderError
+from eventyay.plugins.badges.exporters import BadgeExporter
+from eventyay.plugins.badges.models import BadgeProduct
+
+# ---------------------------------------------------------------------------
+# Paper geometry.  These are the ISO paper sizes in PostScript points, i.e. a
+# property of the paper, not of the application.
+# ---------------------------------------------------------------------------
+A4_SHORT = 595.2755905511812
+A4_LONG = 841.8897637795277
+A4_PORTRAIT = (A4_SHORT, A4_LONG)
+A4_LANDSCAPE = (A4_LONG, A4_SHORT)
+# Exactly half an A4 sheet in each direction -- "A6" as the rendering options use it.
+HALF_A4_PORTRAIT = (A4_SHORT / 2, A4_LONG / 2)
+HALF_A4_LANDSCAPE = (A4_LONG / 2, A4_SHORT / 2)
+
+DPI = 150
+PT_PER_INCH = 72.0
+COLOUR_TOL = 25  # L1 distance; solid fills come back exact, this only absorbs rounding
+MIN_MARK_PX = 1200  # a printed text mark is ~15k px at full size, ~3.8k at half size
+ART_MIN_FRAC = 0.02  # an artwork really printed on a sheet covers far more than 2% of it
+
+# ---------------------------------------------------------------------------
+# Palette "harbourfog": four landscape badges, four-up on a landscape sheet.
+# Palette "nordkap": six portrait badges, four-up and eight-up on A4 sheets.
+# The two colour sets are disjoint; inside a set every colour is at least
+# L1-distance 100 from every other one, from white, and from every blend of any
+# two painted colours -- so an anti-aliased edge can never be misread as a
+# different badge's colour.
+# ---------------------------------------------------------------------------
+HARBOURFOG_ART = [(230, 0, 0), (0, 230, 0), (0, 0, 230), (230, 230, 0)]
+HARBOURFOG_INK = [(120, 0, 0), (0, 120, 0), (0, 0, 120), (120, 60, 180)]
+
+NORDKAP_ART = [
+    (200, 40, 140),
+    (40, 200, 140),
+    (140, 40, 200),
+    (200, 140, 40),
+    (40, 140, 200),
+    (140, 200, 40),
+]
+NORDKAP_INK = [
+    (100, 0, 50),
+    (0, 100, 50),
+    (50, 0, 100),
+    (100, 50, 0),
+    (0, 50, 100),
+    (50, 100, 0),
+]
+
+# Names taken verbatim from the vocabulary a fix is likely to introduce, planted
+# in the fixture so that they already exist on an unfixed tree.  A suite that had
+# accidentally been keyed to such names instead of to the rendered result would
+# pass before the fix and be caught here.
+CANARY_WORDS = [
+    'render_nup',
+    'merge_foreground_buffer',
+    'correct_page_media_box',
+    'badge_default_a6l',
+    'ReportLab Generated PDF',
+    'empty.pdf',
+]
+
+
+@pytest.fixture(autouse=True)
+def _no_scopes():
+    with scopes_disabled():
+        yield
+
+
+# ---------------------------------------------------------------------------
+# Fixture artwork
+# ---------------------------------------------------------------------------
+def _artwork_pdf(rgb, size_pt):
+    """A single-page badge artwork: a solid colour field with a white text panel.
+
+    The file is deliberately a substantial, fully formed document (tens of kB of
+    metadata) so that it is plainly real artwork and not a stand-in.
+    """
+    width, height = size_pt
+    buf = BytesIO()
+    c = rl_canvas.Canvas(buf, pagesize=(width, height))
+    c.setFillColorRGB(rgb[0] / 255.0, rgb[1] / 255.0, rgb[2] / 255.0)
+    c.rect(0, 0, width, height, stroke=0, fill=1)
+    panel_w = min(width * 0.86, 230.0)
+    panel_h = 92.0
+    c.setFillColorRGB(1, 1, 1)
+    c.rect((width - panel_w) / 2, height / 2 - panel_h / 2, panel_w, panel_h, stroke=0, fill=1)
+    c.showPage()
+    c.save()
+    buf.seek(0)
+    reader = PdfReader(buf)
+    writer = PdfWriter()
+    writer.add_page(reader.pages[0])
+    writer.add_metadata({'/Title': 'Badge artwork', '/Subject': 'artwork ' * 6000})
+    out = BytesIO()
+    writer.write(out)
+    return out.getvalue()
+
+
+def _layout_json(ink, art, size_pt, canary):
+    """A badge layout with one big text mark centred on the artwork's white panel."""
+    width, height = size_pt
+    width_mm = width / mm
+    height_mm = height / mm
+    return json.dumps(
+        [
+            {
+                'type': 'textarea',
+                'left': '4',
+                'bottom': '%.3f' % (height_mm / 2 - 6.0),
+                'fontsize': '54',
+                'color': [ink[0], ink[1], ink[2], 1],
+                'fontfamily': 'Open Sans',
+                'bold': True,
+                'italic': False,
+                'width': '%.3f' % (width_mm - 8),
+                'content': 'other',
+                'text': 'HHH',
+                'align': 'center',
+            },
+            {
+                # deliberately invisible: same colour as the artwork behind it.
+                'type': 'textarea',
+                'left': '1',
+                'bottom': '1',
+                'fontsize': '3',
+                'color': [art[0], art[1], art[2], 1],
+                'fontfamily': 'Open Sans',
+                'bold': False,
+                'italic': False,
+                'width': '%.3f' % (width_mm - 2),
+                'content': 'other',
+                'text': canary,
+                'align': 'left',
+            },
+        ]
+    )
+
+
+class Sheet:
+    """A rendered export, as pixels."""
+
+    def __init__(self, pdf_bytes):
+        self.pdf_bytes = pdf_bytes
+        reader = PdfReader(BytesIO(pdf_bytes))
+        self.page_sizes = [
+            (float(p.mediabox.width), float(p.mediabox.height)) for p in reader.pages
+        ]
+        self.pages = _rasterise(pdf_bytes)
+        assert len(self.pages) == len(self.page_sizes)
+
+    def __len__(self):
+        return len(self.pages)
+
+
+def _rasterise(pdf_bytes):
+    with tempfile.TemporaryDirectory() as d:
+        src = os.path.join(d, 'sheet.pdf')
+        with open(src, 'wb') as fh:
+            fh.write(pdf_bytes)
+        subprocess.run(
+            ['pdftoppm', '-r', str(DPI), '-png', src, os.path.join(d, 'page')],
+            check=True,
+            capture_output=True,
+        )
+        files = glob.glob(os.path.join(d, 'page-*.png'))
+        files.sort(key=lambda p: int(re.search(r'page-(\d+)\.png$', p).group(1)))
+        return [np.asarray(Image.open(p).convert('RGB'), dtype=np.int16) for p in files]
+
+
+def _region(page, rgb):
+    """Where a given ink/artwork colour landed on one rendered page."""
+    dist = np.abs(page - np.array(rgb, dtype=np.int16)).sum(axis=2)
+    mask = dist <= COLOUR_TOL
+    count = int(mask.sum())
+    if count == 0:
+        return None
+    ys, xs = np.nonzero(mask)
+    return {
+        'count': count,
+        'x0': int(xs.min()),
+        'y0': int(ys.min()),
+        'x1': int(xs.max()) + 1,
+        'y1': int(ys.max()) + 1,
+    }
+
+
+def _box(region):
+    return (region['x0'], region['y0'], region['x1'], region['y1'])
+
+
+def _area(box):
+    return max(0, box[2] - box[0]) * max(0, box[3] - box[1])
+
+
+def _intersection(a, b):
+    return (max(a[0], b[0]), max(a[1], b[1]), min(a[2], b[2]), min(a[3], b[3]))
+
+
+def _centre(region):
+    return ((region['x0'] + region['x1']) / 2.0, (region['y0'] + region['y1']) / 2.0)
+
+
+def _find_all(sheet, colours, min_count=0, min_frac=0.0):
+    """colour index -> (page index, region), for every colour that really printed."""
+    found = {}
+    for i, rgb in enumerate(colours):
+        for page_no, page in enumerate(sheet.pages):
+            page_px = page.shape[0] * page.shape[1]
+            floor = max(min_count, min_frac * page_px)
+            region = _region(page, rgb)
+            if region is not None and region['count'] >= floor:
+                assert i not in found, (
+                    'artwork/ink colour %s printed on more than one sheet page' % (rgb,)
+                )
+                found[i] = (page_no, region)
+    return found
+
+
+# ---------------------------------------------------------------------------
+# Event fixtures
+# ---------------------------------------------------------------------------
+def _build_event(slug, badge_size_pt, art_colours, ink_colours):
+    organizer = Organizer.objects.create(name='Harbor %s' % slug, slug=slug)
+    event = Event.objects.create(
+        organizer=organizer,
+        name='Badge print %s' % slug,
+        slug=slug,
+        date_from=now() + timedelta(days=90),
+        live=True,
+    )
+    products = []
+    for i, (art, ink) in enumerate(zip(art_colours, ink_colours)):
+        canary = CANARY_WORDS[i % len(CANARY_WORDS)]
+        product = Product.objects.create(
+            event=event,
+            name='%s ticket %d' % (canary, i),
+            default_price=Decimal('10.00'),
+            admission=True,
+        )
+        layout = event.badge_layouts.create(
+            name='%s %d' % (canary, i),
+            default=(i == 0),
+            layout=_layout_json(ink, art, badge_size_pt, canary),
+        )
+        layout.background.save('artwork-%d.pdf' % i, ContentFile(_artwork_pdf(art, badge_size_pt)))
+        BadgeProduct.objects.create(product=product, layout=layout)
+        products.append(product)
+
+    order = Order.objects.create(
+        code='NUPXY%d' % len(products),
+        event=event,
+        email='badges@example.org',
+        status=Order.STATUS_PAID,
+        datetime=now(),
+        expires=now() + timedelta(days=10),
+        total=Decimal('10.00') * len(products),
+    )
+    for i, product in enumerate(products):
+        OrderPosition.objects.create(
+            order=order,
+            product=product,
+            price=Decimal('10.00'),
+            attendee_name_parts={'_legacy': '%s %d' % (CANARY_WORDS[i % len(CANARY_WORDS)], i)},
+            secret='harborsecret%02d' % i,
+            positionid=i + 1,
+        )
+    return event, products
+
+
+def _export(event, products, rendering):
+    fname, ftype, payload = BadgeExporter(event).render(
+        {
+            'products': [p.pk for p in products],
+            'rendering': rendering,
+            'include_pending': True,
+        }
+    )
+    return fname, ftype, payload
+
+
+@pytest.fixture
+def harbourfog():
