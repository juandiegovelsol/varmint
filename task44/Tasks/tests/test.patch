+def _assert_lone_badge_pages(env):
+    """One badge per sheet: every badge gets a sheet of its own, artwork and all."""
+    sheet = Sheet(_export(env['event'], env['products'], 'one')[2])
+    n = len(env['products'])
+    assert len(sheet) == n, 'expected one sheet per badge (%d), got %d' % (n, len(sheet))
+    art = _find_all(sheet, env['art'], min_frac=ART_MIN_FRAC)
+    ink = _find_all(sheet, env['ink'], min_count=MIN_MARK_PX)
+    for i in range(n):
+        assert i in art, 'badge %d has no artwork on its own sheet' % i
+        assert i in ink, 'badge %d has no printed text on its own sheet' % i
+        page_no, region = art[i]
+        page = sheet.pages[page_no]
+        page_px = page.shape[0] * page.shape[1]
+        assert region['count'] > 0.5 * page_px, (
+            'badge %d covers only %.1f%% of its own sheet'
+            % (i, 100.0 * region['count'] / page_px)
+        )
+        assert ink[i][0] == page_no
+        others = [j for j in art if j != i and art[j][0] == page_no]
+        assert not others, 'sheet %d carries the artwork of badges %s as well' % (page_no, others)
+        want = env['badge_size']
+        size = sheet.page_sizes[page_no]
+        assert abs(size[0] - want[0]) < 2.0 and abs(size[1] - want[1]) < 2.0, (
+            'a one-badge-per-page sheet is %s, not the badge size %s' % (size, want)
+        )
