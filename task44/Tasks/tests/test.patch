+# ---------------------------------------------------------------------------
+# Shared assertions
+# ---------------------------------------------------------------------------
+def _assert_every_artwork_printed(env):
+    sheet = Sheet(_export(env['event'], env['products'], env['four_up'])[2])
+    n = len(env['products'])
+    slot_share = 1.0 / 4.0  # four badges to a sheet
+    found = _find_all(sheet, env['art'], min_frac=ART_MIN_FRAC)
+    missing = [i for i in range(n) if i not in found]
+    assert not missing, (
+        'the artwork of badge(s) %s never reached the printed sheet; only %d of %d '
+        'badge artworks printed at all' % (missing, len(found), n)
+    )
+    for i, (page_no, region) in sorted(found.items()):
+        page_px = sheet.pages[page_no].shape[0] * sheet.pages[page_no].shape[1]
+        share = region['count'] / float(page_px)
+        assert share > slot_share * 0.6, (
+            'badge %d covers only %.1f%% of its sheet; a badge printed four to a '
+            'sheet must fill about %.0f%% of it' % (i, 100 * share, 100 * slot_share)
+        )
+
+
+def _assert_artworks_do_not_overlap(env):
+    sheet = Sheet(_export(env['event'], env['products'], env['four_up'])[2])
+    n = len(env['products'])
+    per_page = []
+    for page_no, page in enumerate(sheet.pages):
+        page_px = page.shape[0] * page.shape[1]
+        present = []
+        for i, rgb in enumerate(env['art']):
+            region = _region(page, rgb)
+            if region is not None and region['count'] >= 0.05 * page_px:
+                present.append((i, region))
+        per_page.append(present)
+        for a in range(len(present)):
+            for b in range(a + 1, len(present)):
+                box_a, box_b = _box(present[a][1]), _box(present[b][1])
+                inter = _area(_intersection(box_a, box_b))
+                smaller = min(_area(box_a), _area(box_b))
+                assert inter <= 0.03 * smaller, (
+                    'badge %d and badge %d overlap on sheet page %d (%.0f%% of a badge)'
+                    % (present[a][0], present[b][0], page_no, 100.0 * inter / smaller)
+                )
+
+    # A four-up sheet may not carry more than four badge artworks on a page, and
+    # every badge's artwork must reach the sheet somewhere. The exact split
+    # across pages is deliberately NOT pinned: any tiling the export chooses is
+    # accepted so long as no page is overfilled and no artwork is lost.
+    counts = sorted(len(p) for p in per_page)
+    overfull = [c for c in counts if c > 4]
+    assert not overfull, (
+        'a four-up sheet page carries %s badge artworks; no page may carry more '
+        'than four (printed %s)' % (overfull, counts)
+    )
+    printed = sum(counts)
+    assert printed == n, (
+        'expected all %d badge artworks somewhere on the sheet, printed %d '
+        '(per page: %s)' % (n, printed, counts)
+    )
+
+
+def _assert_mark_sits_on_its_own_artwork(env):
+    sheet = Sheet(_export(env['event'], env['products'], env['four_up'])[2])
+    art = _find_all(sheet, env['art'], min_frac=ART_MIN_FRAC)
+    ink = _find_all(sheet, env['ink'], min_count=MIN_MARK_PX)
+    for i in range(len(env['products'])):
+        assert i in ink, 'the printed text of badge %d is missing from the sheet' % i
+        assert i in art, 'the artwork of badge %d is missing from the sheet' % i
+        assert ink[i][0] == art[i][0], (
+            'badge %d printed its text on sheet page %d but its artwork on page %d'
+            % (i, ink[i][0], art[i][0])
+        )
+        text_box = _box(ink[i][1])
+        art_box = _box(art[i][1])
+        grown = (art_box[0] - 3, art_box[1] - 3, art_box[2] + 3, art_box[3] + 3)
+        assert _area(_intersection(text_box, grown)) >= 0.98 * _area(text_box), (
+            'the text of badge %d (%s) is not printed on its own artwork (%s)'
+            % (i, text_box, art_box)
+        )
+
+
+def _assert_sheet_badge_matches_lone_badge(env):
+    """A badge on a shared sheet must be the same badge it is on its own sheet."""
+    lone = Sheet(_export(env['event'], env['products'], 'one')[2])
+    lone_art = _find_all(lone, env['art'], min_frac=ART_MIN_FRAC)
+    lone_ink = _find_all(lone, env['ink'], min_count=MIN_MARK_PX)
+    assert len(lone_art) == len(env['products'])
+    assert len(lone_ink) == len(env['products'])
+
+    sheet = Sheet(_export(env['event'], env['products'], env['four_up'])[2])
+    sheet_art = _find_all(sheet, env['art'], min_frac=ART_MIN_FRAC)
+    sheet_ink = _find_all(sheet, env['ink'], min_count=MIN_MARK_PX)
+
+    for i in range(len(env['products'])):
+        assert i in sheet_art, 'badge %d lost its artwork on the shared sheet' % i
+        assert i in sheet_ink, 'badge %d lost its printed text on the shared sheet' % i
+
+        lp, lr = lone_art[i]
+        lone_page = lone.pages[lp]
+        lone_h, lone_w = lone_page.shape[0], lone_page.shape[1]
+        lone_ink_box = _box(lone_ink[i][1])
+        # where the text sits inside the badge, as a fraction of the badge
+        want = (
+            (lone_ink_box[0] + lone_ink_box[2]) / 2.0 / lone_w,
+            (lone_ink_box[1] + lone_ink_box[3]) / 2.0 / lone_h,
+        )
+        lone_fill = lr['count'] / float(lone_w * lone_h)
+
+        sp, sr = sheet_art[i]
+        slot = _box(sr)
+        slot_w = float(slot[2] - slot[0])
+        slot_h = float(slot[3] - slot[1])
+        ink_box = _box(sheet_ink[i][1])
+        got = (
+            ((ink_box[0] + ink_box[2]) / 2.0 - slot[0]) / slot_w,
+            ((ink_box[1] + ink_box[3]) / 2.0 - slot[1]) / slot_h,
+        )
+        assert abs(got[0] - want[0]) < 0.05 and abs(got[1] - want[1]) < 0.05, (
+            'badge %d prints its text at %s of its slot on the shared sheet but at '
+            '%s of the sheet when printed on its own' % (i, got, want)
+        )
+        sheet_fill = sr['count'] / (slot_w * slot_h)
+        assert abs(sheet_fill - lone_fill) < 0.06, (
+            'badge %d covers %.1f%% of its slot on the shared sheet but %.1f%% of '
+            'its own sheet' % (i, 100 * sheet_fill, 100 * lone_fill)
+        )
+
+
+def _assert_layout_is_a_regular_grid(env, rendering, grid):
+    """Badges must be laid out on the grid the rendering option describes."""
+    cols, rows = grid
+    sheet = Sheet(_export(env['event'], env['products'], rendering)[2])
+    per_page = cols * rows
+    n = len(env['products'])
+
+    marks = _find_all(sheet, env['ink'], min_count=MIN_MARK_PX)
+    missing = [i for i in range(n) if i not in marks]
+    assert not missing, (
+        'badge(s) %s printed nothing readable on the %d-up sheet -- their content '
+        'fell outside the printable area' % (missing, per_page)
+    )
+
+    by_page = {}
+    for i, (page_no, region) in marks.items():
+        by_page.setdefault(page_no, []).append((i, _centre(region)))
+
+    for page_no, entries in by_page.items():
+        page = sheet.pages[page_no]
+        height_px, width_px = page.shape[0], page.shape[1]
+        cell_w = width_px / float(cols)
+        cell_h = height_px / float(rows)
+        tol = 0.04 * min(cell_w, cell_h)
+        ref = entries[0][1]
+        for i, centre in entries[1:]:
+            for axis, pitch, name in ((0, cell_w, 'across'), (1, cell_h, 'down')):
+                delta = centre[axis] - ref[axis]
+                steps = round(delta / pitch)
+                assert abs(delta - steps * pitch) <= tol, (
+                    'badge %d sits %.1f px %s from badge %d on sheet page %d, which '
+                    'is not a whole number of %.1f px slots'
+                    % (i, delta, name, entries[0][0], page_no, pitch)
+                )
+        occupied = set()
+        for i, centre in entries:
+            col = int(centre[0] // cell_w)
+            row = int(centre[1] // cell_h)
+            assert (row, col) not in occupied, (
+                'two badges share slot %s on sheet page %d' % ((row, col), page_no)
+            )
+            occupied.add((row, col))
+        assert len(entries) <= per_page
+
+
