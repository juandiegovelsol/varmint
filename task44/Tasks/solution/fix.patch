+def render_nup(input_files: List[str], num_pages: int, output_file: BinaryIO, opt: dict):
+    badges_per_page = opt['cols'] * opt['rows']
+    max_nup_pages = 20
+    nup_pdf_files = []
+    temp_dir = None
+    if num_pages > badges_per_page * max_nup_pages:
+        try:
