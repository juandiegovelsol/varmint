@@ -0,0 +1,293 @@
+"""
+The leader's den paints a small tile for every neighbouring Clan: a symbol, the
+Clan's name, its two temperament words and how the Clan stands towards it. The
+tile presents visible feedback while the mouse is on it.
+
+These tests paint that row through the game's own UI manager and check what a
+player would actually be able to read. They hard-code no coordinate, offset,
+font, theme id, element key, or solution technique. Writing is located by what
+it says, and obstruction is measured from rendered pixels with and
+without a mouse-motion event over each tile.
+"""
+
+import unittest
+
+import i18n
+
+from . import _support as den
+
+
+TWO_LINE_TEMPERAMENT = ("bloodthirsty", "methodical")
+OTHER_TWO_LINE_TEMPERAMENT = ("bloodthirsty", "welcoming")
+SHORT_TEMPERAMENT = ("proud", "eager")
+OTHER_SHORT_TEMPERAMENT = ("mellow", "decisive")
+
+SHORT_NAME = "Reed"
+OTHER_SHORT_NAME = "Sky"
+TWO_LINE_NAME = "Windywillowbrooke"
+OTHER_TWO_LINE_NAME = "Rainshadowvalley"
+
+
+def temperament_writing(tile, temperament):
+    """The piece of writing that carries both temperament words, if any."""
+    words = [den.squash(i18n.t("screens.leader_den." + w)) for w in temperament]
+    return den.writing_that_says(tile, *words)
+
+
+class AStandingThatTheHoverBorderCannotReach(unittest.TestCase):
+    """
+    Whatever else is written in a tile, the standing has to stay readable.
+    """
+
+    def assert_standing_is_inside_the_tile(self, tile):
+        self.assertIsNotNone(
+            tile["standing"],
+            "the tile paints no standing at all: " + repr(tile["writing"]),
+        )
+        self.assertTrue(
+            tile.rect.contains(tile.label_rect("standing")),
+            "the standing %r sits at %s, which runs outside its tile %s"
+            % (tile["standing"]["says"], tile["standing"]["rect"], tile["rect"]),
+        )
+
+    def assert_the_border_leaves_the_standing_alone(self, tile):
+        self.assertIsNotNone(
+            tile["standing"],
+            "the tile paints no standing at all: " + repr(tile["writing"]),
+        )
+        self.assertGreater(
+            tile["standing"]["ink"],
+            0,
+            "nothing of the standing %r is painted inside the tile at all"
+            % (tile["standing"]["says"],),
+        )
+        self.assertGreater(
+            tile["pixels_changed_by_hover"],
+            0,
+            "the tile does not change when the mouse is on it, so this test "
+            "cannot tell whether the border would cover anything",
+        )
+        self.assertEqual(
+            tile["standing"]["covered_when_hovered"],
+            0,
+            "%d of the %d pixels of the standing %r are painted over when the "
+            "mouse is on the tile"
+            % (
+                tile["standing"]["covered_when_hovered"],
+                tile["standing"]["ink"],
+                tile["standing"]["says"],
+            ),
+        )
+
+    def assert_the_temperament_needs_two_lines(self, tile, temperament):
+        """
+        Recomputed at run time: the awkward temperament must paint taller than
+        the same tile's short temperament, otherwise the fixture has drifted and
+        the test would be checking nothing.
+        """
+        control = den.only_tile([(SHORT_NAME, SHORT_TEMPERAMENT, 12)])
+        short = temperament_writing(control, SHORT_TEMPERAMENT)
+        tall = temperament_writing(tile, temperament)
+        self.assertEqual(len(short), 1, "control tile lost its temperament")
+        self.assertEqual(len(tall), 1, "tile lost its temperament")
+        self.assertGreater(
+            tall[0]["rect"][3],
+            short[0]["rect"][3],
+            "fixture drift: %r no longer needs more than one line" % (temperament,),
+        )
+
+    def test_a_neighbour_whose_temperament_needs_two_lines_keeps_its_standing_inside_the_tile(
+        self,
+    ):
+        tile = den.only_tile([(SHORT_NAME, TWO_LINE_TEMPERAMENT, 12)])
+        self.assert_the_temperament_needs_two_lines(tile, TWO_LINE_TEMPERAMENT)
+        self.assert_standing_is_inside_the_tile(tile)
+
+    def test_a_neighbour_whose_temperament_needs_two_lines_keeps_its_standing_out_from_under_the_border(
+        self,
+    ):
+        tile = den.only_tile([(OTHER_SHORT_NAME, OTHER_TWO_LINE_TEMPERAMENT, 25)])
+        self.assert_the_temperament_needs_two_lines(tile, OTHER_TWO_LINE_TEMPERAMENT)
+        self.assert_the_border_leaves_the_standing_alone(tile)
+
+    def test_a_neighbour_whose_name_needs_two_lines_keeps_its_standing_inside_the_tile(
+        self,
+    ):
+        control = den.only_tile([(SHORT_NAME, SHORT_TEMPERAMENT, 12)])
+        tile = den.only_tile([(TWO_LINE_NAME, SHORT_TEMPERAMENT, 3)])
+        short_name = den.writing_that_says(control, SHORT_NAME)
+        long_name = den.writing_that_says(tile, TWO_LINE_NAME)
+        self.assertEqual(len(short_name), 1)
+        self.assertEqual(len(long_name), 1)
+        self.assertGreater(
+            long_name[0]["rect"][3],
+            short_name[0]["rect"][3],
+            "fixture drift: %r no longer needs more than one line" % (TWO_LINE_NAME,),
+        )
+        self.assert_standing_is_inside_the_tile(tile)
+
+    def test_a_neighbour_whose_name_needs_two_lines_keeps_its_standing_out_from_under_the_border(
+        self,
+    ):
+        tile = den.only_tile([(OTHER_TWO_LINE_NAME, OTHER_SHORT_TEMPERAMENT, 20)])
+        self.assert_the_border_leaves_the_standing_alone(tile)
+
+    def test_a_whole_row_of_awkward_neighbours_stays_readable(self):
+        tiles = den.observe(
+            [
+                (SHORT_NAME, TWO_LINE_TEMPERAMENT, 25),
+                (OTHER_SHORT_NAME, OTHER_TWO_LINE_TEMPERAMENT, 3),
+                (TWO_LINE_NAME, SHORT_TEMPERAMENT, 12),
+                (OTHER_TWO_LINE_NAME, OTHER_SHORT_TEMPERAMENT, 20),
+            ]
+        )
+        self.assertEqual(len(tiles), 4)
+        for tile in tiles:
+            self.assert_standing_is_inside_the_tile(tile)
+            self.assert_the_border_leaves_the_standing_alone(tile)
+
+
+class ATemperamentThatIsReadInTheOrderTheGameRecordedIt(unittest.TestCase):
+    """
+    A neighbour's temperament is a pair of words. Whatever order the game
+    recorded them in, the tile has to read them out in that same order.
+    """
+
+    def test_the_first_recorded_temperament_word_is_read_before_the_second(self):
+        tile = den.only_tile([(SHORT_NAME, SHORT_TEMPERAMENT, 12)])
+        words = temperament_writing(tile, SHORT_TEMPERAMENT)
+        self.assertEqual(len(words), 1, "tile lost its temperament")
+        text = words[0]["says"]
+        first_word = den.squash(i18n.t("screens.leader_den." + SHORT_TEMPERAMENT[0]))
+        second_word = den.squash(i18n.t("screens.leader_den." + SHORT_TEMPERAMENT[1]))
+        self.assertLess(
+            text.index(first_word),
+            text.index(second_word),
+            "the temperament is read out of the order the game recorded it in: %r"
+            % (text,),
+        )
+
+    def test_a_different_pairs_first_word_is_still_read_before_its_second(self):
+        tile = den.only_tile([(OTHER_SHORT_NAME, OTHER_SHORT_TEMPERAMENT, 12)])
+        words = temperament_writing(tile, OTHER_SHORT_TEMPERAMENT)
+        self.assertEqual(len(words), 1, "tile lost its temperament")
+        text = words[0]["says"]
+        first_word = den.squash(
+            i18n.t("screens.leader_den." + OTHER_SHORT_TEMPERAMENT[0])
+        )
+        second_word = den.squash(
+            i18n.t("screens.leader_den." + OTHER_SHORT_TEMPERAMENT[1])
+        )
+        self.assertLess(
+            text.index(first_word),
+            text.index(second_word),
+            "the temperament is read out of the order the game recorded it in: %r"
+            % (text,),
+        )
+
+
+class AStandingThatMatchesHowFriendlyTheClanActuallyIs(unittest.TestCase):
+    """
+    The standing word painted in the tile has to reflect the neighbour's
+    actual relations score, at every score the game accepts as neutral.
+    """
+
+    def test_the_lowest_relations_score_that_still_counts_as_neutral_reads_neutral(
+        self,
+    ):
+        tile = den.only_tile([(SHORT_NAME, SHORT_TEMPERAMENT, 7)])
+        self.assertIsNotNone(
+            tile["standing"],
+            "the tile paints no standing at all: " + repr(tile["writing"]),
+        )
+        self.assertEqual(
+            tile["standing"]["word"],
+            "neutral",
+            "a relations score of 7 should read neutral, but the tile painted %r"
+            % (tile["standing"]["says"],),
+        )
+
+    def test_the_highest_relations_score_that_still_counts_as_neutral_reads_neutral(
+        self,
+    ):
+        tile = den.only_tile([(OTHER_SHORT_NAME, OTHER_SHORT_TEMPERAMENT, 17)])
+        self.assertIsNotNone(
+            tile["standing"],
+            "the tile paints no standing at all: " + repr(tile["writing"]),
+        )
+        self.assertEqual(
+            tile["standing"]["word"],
+            "neutral",
+            "a relations score of 17 should read neutral, but the tile painted %r"
+            % (tile["standing"]["says"],),
+        )
+
+
+class AClanNameThatReadsTheWayEveryOtherClanNameDoes(unittest.TestCase):
+    """
+    Every Clan in this game is named with the word "Clan" as a suffix
+    (SkyClan, ShadowClan, ...), never as a prefix.
+    """
+
+    def test_the_clan_name_is_the_neighbours_name_followed_by_the_word_clan(self):
+        tile = den.only_tile([(SHORT_NAME, SHORT_TEMPERAMENT, 12)])
+        name = den.writing_that_says(tile, SHORT_NAME)
+        self.assertEqual(len(name), 1, "no single piece of writing names the Clan")
+        self.assertEqual(
+            name[0]["says"],
+            den.squash(f"{SHORT_NAME}Clan"),
+            "the tile painted %r, which does not read as %r followed by 'Clan'"
+            % (name[0]["says"], SHORT_NAME),
+        )
+
+
+class TheRestOfTheNeighbourRowIsUntouched(unittest.TestCase):
+    """
+    Everything the row already got right has to survive.
+    """
+
+    ROW = [
+        (SHORT_NAME, SHORT_TEMPERAMENT, 25),
+        (OTHER_SHORT_NAME, OTHER_SHORT_TEMPERAMENT, 3),
+        ("Moss", ("gracious", "steadfast"), 12),
+        ("Fern", ("cunning", "observant"), 8),
+    ]
+
+    def test_every_neighbour_tile_names_its_clan_and_both_temperament_words(self):
+        tiles = den.observe(self.ROW)
+        self.assertEqual(len(tiles), len(self.ROW))
+        for (name, temperament, _relations), tile in zip(self.ROW, tiles):
+            self.assertEqual(
