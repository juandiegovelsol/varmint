+"""
+Head-less observation of the row of neighbouring-Clan tiles in the leader's den.
+
+Nothing here knows any coordinate, offset, font size, theme id or element key used
+by the screen.  Everything the tests assert is measured at run time from what the
+game actually paints:
+
+  * a tile is discovered from its rendered text-bearing container rather than
+    from a dictionary key or theme identifier;
+  * the three pieces of writing in a tile are identified by what they SAY
+    (the neighbour's name, its two temperament words, one of the standings the
+    game's own ``OtherClan.interaction_dict`` knows about), never by their order
+    in a dict or by a theme id;
+  * "is the writing covered by the box border?" is answered by painting the row
+    twice, once with the mouse away from the tiles and once with it over them,
+    and comparing only the pixels the standing itself contributes.
+
+The row is painted into an off-screen surface through the game's own UI manager,
+so the answers are exactly what a player would see.
+"""
+
+import os
+import re
+import sys
+
+os.environ.setdefault("SDL_VIDEODRIVER", "dummy")
+os.environ.setdefault("SDL_AUDIODRIVER", "dummy")
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+os.chdir(REPO_ROOT)
+if REPO_ROOT not in sys.path:
+    sys.path.insert(0, REPO_ROOT)
+
+import init  # noqa: E402,F401  builds the pygame_gui manager under the dummy drivers
+
+import random  # noqa: E402
+
+import i18n  # noqa: E402
+import pygame  # noqa: E402
+import pygame_gui  # noqa: E402
+
+from scripts.game_structure import game  # noqa: E402
+from scripts.game_structure.screen_settings import MANAGER  # noqa: E402
+from scripts.cat.sprites.load_sprites import sprites  # noqa: E402
+from scripts.clan import Clan, OtherClan  # noqa: E402
+from scripts.screens.LeaderDenScreen import LeaderDenScreen  # noqa: E402
+
+PLAYER_CLAN = "Home"
+SEED = 4978
+
+_STATE = {}
+
+
+class _Silent:
+    """Stands in for the audio mixer and the rich-presence client."""
+
+    def __getattr__(self, _name):
+        return lambda *a, **k: None
+
+
+def squash(text) -> str:
+    """
+    Normalise a painted string for comparison.
+
+    pygame_gui inserts hyphens of its own when it word-wraps, and line breaks
+    become whitespace, so whitespace and hyphens are squashed on both sides of
+    every comparison.
+    """
+    if text is None:
+        return ""
+    return re.sub(r"[-\s‐-―−]+", " ", str(text)).strip().lower()
+
+
+def boot():
+    """Bring the game up far enough to paint a screen.  Idempotent."""
+    if _STATE.get("ready"):
+        return
+    game.audio = _Silent()
+    game.rpc = _Silent()
+    sprites.load_all()
+    game.clan = Clan(name=PLAYER_CLAN)
+    # Sprite sheets are loaded, but a symbol is still chosen explicitly so no
+    # observation ever depends on random.choice over the symbol pool.
+    _STATE["symbol"] = sprites.clan_symbols[0]
+    _STATE["ready"] = True
+
+
+def standing_spellings():
+    """
+    Every accepted spelling of every standing the game itself knows about.
+
+    The standings come from the game's own ``OtherClan.interaction_dict`` table,
+    not from a list written here, and each one is accepted either as the bare
+    word, as the screen's translation key, or as that key's shipped translation.
+    """
+    out = {}
+    for word in OtherClan.interaction_dict:
+        key = "screens.leader_den." + word
+        out[word] = {squash(word), squash(key), squash(i18n.t(key))}
+    return out
+
+
+def _painted(element) -> str:
+    """The string the element actually paints, after translation."""
+    shape = getattr(element, "drawable_shape", None)
+    if shape is not None:
+        theming = getattr(shape, "theming", None) or {}
+        if theming.get("text") is not None:
+            return theming["text"]
+    return getattr(element, "text", "") or ""
+
+
+def _walk(container):
+    for child in list(getattr(container, "elements", []) or []):
+        yield child
+        yield from _walk(child)
+
+
+def _live_elements():
+    return list(_walk(MANAGER.get_root_container()))
+
+
+def _rect_tuple(rect):
+    return (rect.left, rect.top, rect.width, rect.height)
+
+
+def _settle():
+    for _ in range(3):
+        MANAGER.update(0.05)
+
+
+def _paint():
+    """Paint everything the manager currently holds onto a fresh surface."""
+    surface = pygame.Surface(MANAGER.window_resolution, pygame.SRCALPHA)
+    surface.fill((255, 0, 255, 255))
+    MANAGER.update(0.02)
+    MANAGER.draw_ui(surface)
+    return surface
+
+
+def _pixels(surface, rect):
+    clip = pygame.Rect(rect).clip(surface.get_rect())
+    crop = pygame.Surface((clip.width, clip.height), pygame.SRCALPHA)
+    crop.fill((0, 0, 0, 0))
+    crop.blit(surface, (0, 0), clip)
+    to_bytes = getattr(pygame.image, "tobytes", None) or pygame.image.tostring
+    return clip, to_bytes(crop, "RGBA")
+
+
+def _differing(rect, a, b):
+    """Absolute coordinates of the pixels inside ``rect`` where a and b differ."""
+    clip, pa = _pixels(a, rect)
+    _, pb = _pixels(b, rect)
+    out = set()
+    width = clip.width
+    for index in range(0, len(pa), 4):
+        if pa[index:index + 4] != pb[index:index + 4]:
+            offset = index // 4
+            out.add((clip.left + offset % width, clip.top + offset // width))
+    return out
+
+
+def _purge():
+    """Kill everything left over from an earlier observation."""
+    for element in _live_elements():
+        try:
+            element.kill()
+        except Exception:
+            pass
+    _settle()
+
+
+def _is_tile(element):
+    """
+    A neighbour tile is a compact container carrying the three pieces of text
+    presented to the player. The test does not require a particular interactive
+    child or an exact child rectangle.
+    """
+    children = list(getattr(element, "elements", []) or [])
+    if not children:
+        return False
+    labels = [c for c in children if squash(_painted(c))]
+    return len(labels) >= 3
+
+
+class Tile(dict):
+    """Plain data about one neighbour tile; no live UI objects."""
+
+    @property
+    def rect(self):
+        return pygame.Rect(self["rect"])
+
+    def label_rect(self, key):
+        return pygame.Rect(self[key]["rect"])
+
+
+def observe(neighbours):
+    """
+    Build the leader's den row for ``neighbours`` and report what it paints.
+
+    ``neighbours`` is a list of ``(name, (first_temper, second_temper), relations)``.
+    Returns one ``Tile`` per painted tile, left to right.
+    """
+    boot()
+    random.seed(SEED)
+    _purge()
+
+    spellings = standing_spellings()
+    clans = []
+    for name, temperament, relations in neighbours:
+        # relations=0 is silently randomised by the constructor, so it is always
+        # assigned afterwards.
+        neighbour = OtherClan(
+            name=name,
+            relations=10,
+            temperament=tuple(temperament),
+            chosen_symbol=_STATE["symbol"],
+        )
+        neighbour.relations = relations
+        clans.append(neighbour)
+    game.clan.all_other_clans = clans
+
+    screen = LeaderDenScreen.__new__(LeaderDenScreen)
+    screen.other_clan_selection_container = None
+    screen.other_clan_selection_elements = {}
+    screen.create_other_clan_selection_box()
+    _settle()
+
+    elements = _live_elements()
+    tiles = sorted(
+        (e for e in elements if _is_tile(e)),
+        key=lambda e: (e.get_abs_rect().left, e.get_abs_rect().top),
+    )
+
+    # --- work out what each tile says -------------------------------------
+    described = []
+    for tile in tiles:
+        children = list(tile.elements)
+        labels = sorted(
+            (c for c in children if squash(_painted(c))),
+            key=lambda c: c.get_abs_rect().top,
+        )
+        standing = None
+        standing_word = None
+        for label in labels:
+            said = squash(_painted(label))
+            for word, accepted in spellings.items():
+                if said in accepted:
+                    standing, standing_word = label, word
+                    break
+            if standing is not None:
+                break
+        described.append((tile, children, labels, standing, standing_word))
+
+    # --- paint: normal, standings hidden, and each tile hovered -----------
+    normal = _paint()
+
+    for _t, _c, _l, standing, _w in described:
+        if standing is not None:
+            standing.hide()
+    _settle()
+    without_standings = _paint()
+    for _t, _c, _l, standing, _w in described:
+        if standing is not None:
+            standing.show()
+    _settle()
+
+    hovered_tiles = []
+    for tile, _children, _labels, standing, _word in described:
+        # pygame_gui determines hover during manager.update() by polling the
+        # current pointer position. Override that input at the pygame boundary
+        # so the normal hover machinery runs deterministically under SDL's
+        # headless dummy driver, where moving a real pointer is unavailable.
+        real_get_pos = pygame.mouse.get_pos
+        pygame.mouse.get_pos = lambda: tile.get_abs_rect().center
+        try:
+            _settle()
+            hovered = _paint()
+            if standing is not None:
+                standing.hide()
+                _settle()
+            hovered_without_standing = _paint()
+            if standing is not None:
+                standing.show()
+                _settle()
+        finally:
+            pygame.mouse.get_pos = real_get_pos
+        hovered_tiles.append((hovered, hovered_without_standing))
+    real_get_pos = pygame.mouse.get_pos
+    pygame.mouse.get_pos = lambda: (-1, -1)
+    try:
+        _settle()
+    finally:
+        pygame.mouse.get_pos = real_get_pos
+
+    # --- assemble the report ----------------------------------------------
+    report = []
+    for (
+        tile,
+        _children,
+        labels,
+        standing,
+        standing_word,
+    ), (hovered, hovered_without_standing) in zip(
+        described, hovered_tiles
+    ):
+        rect = tile.get_abs_rect()
+        touched_by_hover = _differing(rect, normal, hovered)
+        ink = set()
+        covered_count = 0
+        if standing is not None:
+            ink = _differing(rect, normal, without_standings)
+            hover_ink = _differing(rect, hovered, hovered_without_standing)
+            # Compare how much of the line contributes to the rendered tile in
+            # each state. This permits hover-specific colours or repainting and
+            # reports only ink that disappears while hovered.
+            covered_count = max(0, len(ink) - len(hover_ink))
+        entry = Tile(
+            rect=_rect_tuple(rect),
+            writing=[
+                {"says": squash(_painted(l)), "rect": _rect_tuple(l.get_abs_rect())}
+                for l in labels
+            ],
+            standing=(
+                None
+                if standing is None
+                else {
+                    "word": standing_word,
+                    "says": squash(_painted(standing)),
+                    "rect": _rect_tuple(standing.get_abs_rect()),
+                    "ink": len(ink),
+                    "covered_when_hovered": covered_count,
+                }
+            ),
+            pixels_changed_by_hover=len(touched_by_hover),
+        )
+        report.append(entry)
+
+    _purge()
+    return report
+
+
+def only_tile(neighbours):
+    tiles = observe(neighbours)
+    assert len(tiles) == 1, f"expected one tile, painted {len(tiles)}"
+    return tiles[0]
+
+
+def says_all_of(tile, *fragments):
+    """True when some single piece of writing in the tile carries every fragment."""
+    wanted = [squash(f) for f in fragments]
+    return any(
+        all(f in piece["says"] for f in wanted) for piece in tile["writing"]
+    )
+
+
+def writing_that_says(tile, *fragments):
+    wanted = [squash(f) for f in fragments]
+    hits = [p for p in tile["writing"] if all(f in p["says"] for f in wanted)]
+    return hits
