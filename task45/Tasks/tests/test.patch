+      const displaced = parseTspans(
+        curvedText({ 0: { 2: { deltaY: -20 } } }).toSVG(),
+      );
+
+      expect(plain.length).toBeGreaterThan(1);
+      expect(zeroed).toHaveLength(plain.length);
+      expect(displaced).toHaveLength(plain.length);
+
+      const samePlace = (a: ParsedTspan, b: ParsedTspan) => {
+        const from = totalPosition(a);
+        const to = totalPosition(b);
+        expect(Math.abs(to.x - from.x)).toBeLessThan(PATH_TOLERANCE);
+        expect(Math.abs(to.y - from.y)).toBeLessThan(PATH_TOLERANCE);
+      };
+
+      plain.forEach((tspan, index) => {
