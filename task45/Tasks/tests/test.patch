+
+    const numberFrom = (source: string, re: RegExp) => {
+      const match = source.match(re);
+      return match ? parseFloat(match[1]) : 0;
+    };
+
+    /**
+     * Pull every tspan out of an exported SVG string, keeping the geometry
+     * attributes, the raw style attribute and the inner text.
+     */
+    const parseTspans = (svg: string): ParsedTspan[] => {
+      const tspans: ParsedTspan[] = [];
+      const tspanRe = /<tspan\b([^>]*)>([\s\S]*?)<\/tspan>/g;
+      let match: RegExpExecArray | null;
+      while ((match = tspanRe.exec(svg)) !== null) {
+        const attributes = match[1];
+        const styleMatch = attributes.match(/style="([^"]*)"/);
+        const style = styleMatch ? styleMatch[1] : '';
+        const geometry = attributes.replace(/style="[^"]*"/, '');
+        tspans.push({
+          x: numberFrom(geometry, /\bx="(-?[\d.]+)"/),
+          y: numberFrom(geometry, /\by="(-?[\d.]+)"/),
+          dy: numberFrom(geometry, /\bdy="(-?[\d.]+)"/),
+          dx: numberFrom(geometry, /\bdx="(-?[\d.]+)"/),
+          rotate: numberFrom(geometry, /\brotate="(-?[\d.]+)"/),
+          baselineShift: numberFrom(style, /baseline-shift:\s*(-?[\d.]+)/),
+          style,
+          text: match[2],
+        });
+      }
+      return tspans;
+    };
+
+    /**
+     * Net downward displacement of a tspan relative to the line it sits on.
+     * Whichever single mechanism the implementation keeps, the visible result
+     * is the same number, so tests can compare this instead of an attribute.
+     */
+    const effectiveDrop = (tspan: ParsedTspan) =>
+      tspan.y + tspan.dy - tspan.baselineShift;
+
+    const tspanWithText = (tspans: ParsedTspan[], text: string) => {
+      const found = tspans.find((tspan) => tspan.text === text);
+      expect(found).toBeDefined();
+      return found!;
+    };
+
+    const TOLERANCE = 1e-6;
