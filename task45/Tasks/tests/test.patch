+    it('a displaced character on a path is offset along its own rotated baseline', () => {
+      const deltaY = -20;
+      const plain = parseTspans(curvedText({}).toSVG());
+      const displaced = parseTspans(curvedText({ 0: { 2: { deltaY } } }).toSVG());
+
+      const before = tspanWithText(plain, 'c');
+      const after = tspanWithText(displaced, 'c');
+      const from = totalPosition(before);
+      const to = totalPosition(after);
+      const moved = { x: to.x - from.x, y: to.y - from.y };
+
+      // The character is turned to face along the curve, so its own offset has to
+      // travel along that turned axis, not straight down the page.
+      const theta = (before.rotate * Math.PI) / 180;
+      const expected = {
+        x: -Math.sin(theta) * deltaY,
+        y: Math.cos(theta) * deltaY,
+      };
+
+      expect(before.rotate).not.toBe(0);
+      expect(
+        Math.abs(Math.hypot(moved.x, moved.y) - Math.abs(deltaY)),
