+      const reference = tspanWithText(tspans, 'a');
+      const raised = tspanWithText(tspans, 'b');
+      const lowered = tspanWithText(tspans, 'd');
+
+      expect(raised.y).toBe(reference.y);
+      expect(lowered.y).toBe(reference.y);
+      expect(
+        Math.abs(effectiveDrop(raised) - effectiveDrop(reference) - raisedBy),
+      ).toBeLessThan(TOLERANCE);
+      expect(
+        Math.abs(effectiveDrop(lowered) - effectiveDrop(reference) - loweredBy),
+      ).toBeLessThan(TOLERANCE);
+    });
+
+    it('a displaced character on a later line keeps its displacement', () => {
+      const deltaY = -14;
+      const text = new FabricText('ab\ncde', {
+        styles: { 1: { 1: { deltaY } } },
+      });
+      const tspans = parseTspans(text.toSVG());
+      const raised = tspanWithText(tspans, 'd');
