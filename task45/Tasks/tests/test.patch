+      const tspans = parseTspans(text.toSVG());
+      const raised = tspanWithText(tspans, 'b');
+      const reference = tspanWithText(tspans, 'a');
+
+      expect(raised.y).toBe(reference.y);
+      expect(
+        Math.abs(effectiveDrop(raised) - effectiveDrop(reference) - deltaY),
+      ).toBeLessThan(TOLERANCE);
+    });
+
+    it('a lowered character is displaced by its own offset and not by twice it', () => {
+      const deltaY = 11;
+      const text = new FabricText('abc', { styles: { 0: { 1: { deltaY } } } });
+      const tspans = parseTspans(text.toSVG());
+      const lowered = tspanWithText(tspans, 'b');
+      const reference = tspanWithText(tspans, 'a');
+
+      expect(lowered.y).toBe(reference.y);
+      expect(
+        Math.abs(effectiveDrop(lowered) - effectiveDrop(reference) - deltaY),
+      ).toBeLessThan(TOLERANCE);
+    });
+
+    it('characters raised and lowered on the same line each keep their own displacement', () => {
+      const raisedBy = -14;
