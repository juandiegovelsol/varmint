{
    "job_name": "Trials",
    "jobs_dir": "/home/sandbox",
    "agent_timeout_multiplier": 6.0,
    "environment": {
        "type": "docker",
        "extra_docker_compose": [
            "/home/sandbox/.claude/skills/mmswe-runner/tarfix.yaml"
        ]
    },
    "agents": [
        {
            "name": "claude-code",
            "model_name": "anthropic/claude-opus-4-8",
            "kwargs": {
                "disallowed_tools": "WebSearch,WebFetch,EnterPlanMode"
            },
            "env": {
                "ANTHROPIC_BASE_URL": "http://localhost:8091",
                "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
                "API_FORCE_IDLE_TIMEOUT": "0",
                "CLAUDE_ENABLE_STREAM_WATCHDOG": "0",
                "CLAUDE_ENABLE_BYTE_WATCHDOG": "0",
                "CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS": "5400000"
            }
        }
    ],
    "tasks": [
        {
            "path": "/home/sandbox/Tasks"
        }
    ]
}