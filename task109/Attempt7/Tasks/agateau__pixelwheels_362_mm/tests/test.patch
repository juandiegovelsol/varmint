diff --git a/core-tests/src/com/agateau/pixelwheels/bonus/RocketTest.java b/core-tests/src/com/agateau/pixelwheels/bonus/RocketTest.java
new file mode 100755
index 0000000..a41fed2
--- /dev/null
+++ b/core-tests/src/com/agateau/pixelwheels/bonus/RocketTest.java
@@ -0,0 +1,282 @@
+/*
+ * Behavior of the rocket bonus as the player sees it: a rocket picked up by a car rides on the car
+ * pointing the same way, flies straight ahead of the car when fired, trails its exhaust behind it
+ * and casts a shadow shaped (and turned) like itself.
+ *
+ * The rocket is created through its public factory for a real Box2D car body, stepped with the
+ * game's fixed time step, and drawn through a Batch that records every textured quad (see
+ * DrawRecorder), so the checks are about what ends up on screen, not about how it is computed.
+ */
+package com.agateau.pixelwheels.bonus;
+
+import static com.agateau.pixelwheels.GameWorld.BOX2D_TIME_STEP;
+import static com.agateau.pixelwheels.GameWorld.POSITION_ITERATIONS;
+import static com.agateau.pixelwheels.GameWorld.VELOCITY_ITERATIONS;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import com.agateau.pixelwheels.Assets;
+import com.agateau.pixelwheels.GameWorld;
+import com.agateau.pixelwheels.ZLevel;
+import com.agateau.pixelwheels.racer.Racer;
+import com.agateau.pixelwheels.racer.Vehicle;
+import com.agateau.pixelwheels.racer.VehicleRenderer;
+import com.agateau.pixelwheels.sound.AudioManager;
+import com.agateau.pixelwheels.testutils.DrawRecorder;
+import com.badlogic.gdx.graphics.Texture;
+import com.badlogic.gdx.graphics.g2d.Animation;
+import com.badlogic.gdx.graphics.g2d.TextureRegion;
+import com.badlogic.gdx.math.MathUtils;
+import com.badlogic.gdx.math.Rectangle;
+import com.badlogic.gdx.math.Vector2;
+import com.badlogic.gdx.physics.box2d.Body;
+import com.badlogic.gdx.physics.box2d.BodyDef;
+import com.badlogic.gdx.physics.box2d.Filter;
+import com.badlogic.gdx.physics.box2d.Fixture;
+import com.badlogic.gdx.physics.box2d.PolygonShape;
+import com.badlogic.gdx.physics.box2d.World;
+import com.badlogic.gdx.utils.Array;
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.junit.runners.JUnit4;
+
+@RunWith(JUnit4.class)
+public class RocketTest {
+    // Car headings (degrees, counter-clockwise from +X) the scenarios are played with.
+    private static final float[] HEADINGS = {30, 90, 135, 200, 290};
+    private static final float ANGLE_TOLERANCE = 5;
+    private static final Rectangle VIEW = new Rectangle(-1000, -1000, 3000, 3000);
+
+    private static class Scene {
+        World world;
+        Body carBody;
+        Texture rocketTexture;
+        Texture flameTexture;
+        Missile missile;
+
+        void step(int count) {
+            for (int i = 0; i < count; ++i) {
+                world.step(BOX2D_TIME_STEP, VELOCITY_ITERATIONS, POSITION_ITERATIONS);
+                missile.act(BOX2D_TIME_STEP);
+            }
+        }
+
+        DrawRecorder draw() {
+            DrawRecorder batch = new DrawRecorder();
+            for (ZLevel zLevel : ZLevel.values()) {
+                missile.draw(batch, zLevel, VIEW);
+            }
+            return batch;
+        }
+
+        /** The rocket sprite itself: the untinted quad(s) using the rocket image. */
+        DrawRecorder.Quad rocketSprite(DrawRecorder batch) {
+            List<DrawRecorder.Quad> list = new ArrayList<>();
+            for (DrawRecorder.Quad quad : batch.quadsOf(rocketTexture)) {
+                if (!quad.isShadowLike()) {
+                    list.add(quad);
+                }
+            }
+            assertFalse("the rocket should be drawn", list.isEmpty());
+            DrawRecorder.Quad first = list.get(0);
+            for (DrawRecorder.Quad other : list) {
+                assertTrue(
+                        "the rocket is drawn several times, at different places: " + list,
+                        other.center().dst(first.center()) < 0.05f
+                                && angleBetween(other.imageXAxis(), first.imageXAxis()) < 1);
+            }
+            return first;
+        }
+    }
+
+    private static Texture texture() {
+        Texture texture = mock(Texture.class);
+        when(texture.getWidth()).thenReturn(64);
+        when(texture.getHeight()).thenReturn(64);
+        return texture;
+    }
+
+    private static Scene createScene(float headingDeg) throws Exception {
+        Scene scene = new Scene();
+        scene.world = new World(new Vector2(0, 0), true);
+
+        BodyDef bodyDef = new BodyDef();
+        bodyDef.type = BodyDef.BodyType.DynamicBody;
+        bodyDef.position.set(20, 20);
+        bodyDef.angle = headingDeg * MathUtils.degRad;
+        Body carBody = scene.world.createBody(bodyDef);
+        PolygonShape shape = new PolygonShape();
+        shape.setAsBox(1.4f, 0.75f);
+        Fixture fixture = carBody.createFixture(shape, 1f);
+        shape.dispose();
+        // The car body only carries the rocket here: keep it out of any collision.
+        Filter filter = new Filter();
+        filter.categoryBits = 0x4000;
+        filter.maskBits = 0;
+        fixture.setFilterData(filter);
+        scene.carBody = carBody;
+
+        Vehicle vehicle = mock(Vehicle.class);
+        when(vehicle.getBody()).thenReturn(carBody);
+        when(vehicle.getX()).thenAnswer(i -> carBody.getPosition().x);
+        when(vehicle.getY()).thenAnswer(i -> carBody.getPosition().y);
+        when(vehicle.getPosition()).thenAnswer(i -> carBody.getPosition());
+        when(vehicle.getAngle())
+                .thenAnswer(i -> ((carBody.getAngle() * MathUtils.radDeg) % 360 + 360) % 360);
+        Racer racer = mock(Racer.class);
+        when(racer.getVehicle()).thenReturn(vehicle);
+        when(racer.getPosition()).thenAnswer(i -> carBody.getPosition());
+        carBody.setUserData(racer);
+
+        GameWorld gameWorld = mock(GameWorld.class);
+        when(gameWorld.getBox2DWorld()).thenReturn(scene.world);
+
+        scene.rocketTexture = texture();
+        scene.flameTexture = texture();
+        Array<TextureRegion> flameFrames = new Array<>();
+        flameFrames.add(new TextureRegion(scene.flameTexture, 0, 0, 7, 14));
+        flameFrames.add(new TextureRegion(scene.flameTexture, 8, 0, 7, 14));
+        Assets assets = mock(Assets.class);
+        setField(assets, "missile", new TextureRegion(scene.rocketTexture, 0, 0, 44, 13));
+        setField(assets, "target", new TextureRegion(texture(), 0, 0, 16, 16));
+        setField(assets, "turboFlame", new Animation<>(0.1f, flameFrames));
+        // A real Racer always has a VehicleRenderer; code drawing what it carries may use it.
+        when(racer.getVehicleRenderer()).thenReturn(new VehicleRenderer(assets, vehicle));
+
+        scene.missile = Missile.create(assets, gameWorld, mock(AudioManager.class), racer);
+        return scene;
+    }
+
+    private static void setField(Object target, String name, Object value) throws Exception {
+        Field field = Assets.class.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(target, value);
+    }
+
+    /** Absolute difference between two angles in degrees, in [0, 180]. */
+    private static float angleBetween(Vector2 direction, float angleDeg) {
+        float delta = (direction.angleDeg() - angleDeg) % 360;
+        if (delta < -180) {
+            delta += 360;
+        } else if (delta > 180) {
+            delta -= 360;
+        }
+        return Math.abs(delta);
+    }
+
+    private static float angleBetween(Vector2 a, Vector2 b) {
+        return angleBetween(a, b.angleDeg());
+    }
+
+    @Test
+    public void carriedRocketPointsWhereTheCarPoints() throws Exception {
+        for (float heading : HEADINGS) {
+            Scene scene = createScene(heading);
+            scene.step(20);
+            DrawRecorder.Quad rocket = scene.rocketSprite(scene.draw());
+            Vector2 nose = rocket.imageXAxis();
+            assertTrue(
+                    "car heading " + heading + "°: the rocket it carries is drawn pointing "
+                            + nose.angleDeg() + "°",
+                    angleBetween(nose, heading) < ANGLE_TOLERANCE);
+        }
+    }
+
+    @Test
+    public void firedRocketFliesWhereTheCarPoints() throws Exception {
+        for (float heading : HEADINGS) {
+            Scene scene = createScene(heading);
+            scene.step(10);
+            scene.missile.shoot();
+            Vector2 start = new Vector2(scene.missile.getX(), scene.missile.getY());
+            scene.step(30);
+            Vector2 travel =
+                    new Vector2(scene.missile.getX(), scene.missile.getY()).sub(start);
+            assertTrue(
+                    "car heading " + heading + "°: the fired rocket barely moved (" + travel + ")",
+                    travel.len() > 5);
+            assertTrue(
+                    "car heading " + heading + "°: the fired rocket flew towards "
+                            + travel.angleDeg() + "°",
+                    angleBetween(travel, heading) < ANGLE_TOLERANCE);
+            Vector2 nose = scene.rocketSprite(scene.draw()).imageXAxis();
+            assertTrue(
+                    "car heading " + heading + "°: the flying rocket is drawn pointing "
+                            + nose.angleDeg() + "° while flying towards " + travel.angleDeg() + "°",
+                    angleBetween(nose, travel) < ANGLE_TOLERANCE);
+        }
+    }
+
+    @Test
+    public void rocketExhaustComesOutOfItsTail() throws Exception {
+        for (float heading : HEADINGS) {
+            Scene scene = createScene(heading);
+            scene.step(10);
+            scene.missile.shoot();
+            scene.step(3);
+            DrawRecorder batch = scene.draw();
+            DrawRecorder.Quad rocket = scene.rocketSprite(batch);
+            List<DrawRecorder.Quad> flames = batch.quadsOf(scene.flameTexture);
+            assertFalse(
+                    "car heading " + heading + "°: a fired rocket should show its exhaust",
+                    flames.isEmpty());
+
+            Vector2 axis = rocket.imageXAxis();
+            float length = rocket.imageWidth();
+            for (DrawRecorder.Quad flame : flames) {
+                Vector2 offset = flame.center().sub(rocket.center());
+                float along = offset.dot(axis);
+                float aside = Math.abs(offset.crs(axis));
+                assertTrue(
+                        "car heading " + heading + "°: the exhaust should be behind the rocket's"
+                                + " tail, it is " + along + " along the rocket axis (rocket"
+                                + " length " + length + ")",
+                        along < -0.45f * length);
+                assertTrue(
+                        "car heading " + heading + "°: the exhaust should be in line with the"
+                                + " rocket, it is " + aside + " to the side (rocket length "
+                                + length + ")",
+                        aside < 0.15f * length);
+            }
+        }
+    }
+
+    @Test
+    public void rocketShadowHasTheRocketsOrientation() throws Exception {
+        for (float heading : HEADINGS) {
+            for (boolean fired : new boolean[] {false, true}) {
+                Scene scene = createScene(heading);
+                scene.step(10);
+                if (fired) {
+                    scene.missile.shoot();
+                    scene.step(5);
+                }
+                DrawRecorder batch = scene.draw();
+                DrawRecorder.Quad rocket = scene.rocketSprite(batch);
+                List<DrawRecorder.Quad> shadows = new ArrayList<>();
+                for (DrawRecorder.Quad quad : batch.quadsOf(scene.rocketTexture)) {
+                    if (quad.isShadowLike()) {
+                        shadows.add(quad);
+                    }
+                }
+                String what = "car heading " + heading + "°, " + (fired ? "fired" : "carried");
+                assertFalse(what + ": the rocket should cast a shadow", shadows.isEmpty());
+                for (DrawRecorder.Quad shadow : shadows) {
+                    assertTrue(
+                            what + ": rocket drawn at " + rocket.imageXAxis().angleDeg()
+                                    + "° but its shadow at " + shadow.imageXAxis().angleDeg()
+                                    + "°",
+                            angleBetween(shadow.imageXAxis(), rocket.imageXAxis()) < 2);
+                    assertTrue(
+                            what + ": the shadow should stay right under the rocket",
+                            shadow.center().dst(rocket.center()) < 0.5f * rocket.imageWidth());
+                }
+            }
+        }
+    }
+}
diff --git a/core-tests/src/com/agateau/pixelwheels/racer/VehicleShadowTest.java b/core-tests/src/com/agateau/pixelwheels/racer/VehicleShadowTest.java
