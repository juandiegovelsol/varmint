+/*
+ * Test helper: runs a piece of test code inside a real (hidden, off-screen) desktop OpenGL
+ * context, the same way the game itself renders on desktop. Needed by code that allocates GPU
+ * resources in its constructor (frame buffers, shape renderers...).
+ */
+package com.agateau.pixelwheels.testutils;
+
+import com.badlogic.gdx.ApplicationAdapter;
+import com.badlogic.gdx.Gdx;
+import com.badlogic.gdx.backends.lwjgl3.Lwjgl3Application;
+import com.badlogic.gdx.backends.lwjgl3.Lwjgl3ApplicationConfiguration;
+
+public class GlContext {
+    public interface Body {
+        void run() throws Throwable;
+    }
+
+    /** Runs body with a current GL context; rethrows whatever body throws. */
+    public static void run(Body body) {
+        Throwable[] failure = new Throwable[1];
+        Lwjgl3ApplicationConfiguration config = new Lwjgl3ApplicationConfiguration();
+        config.setWindowedMode(64, 64);
+        config.setInitialVisible(false);
+        config.disableAudio(true);
+        new Lwjgl3Application(
+                new ApplicationAdapter() {
+                    @Override
+                    public void create() {
+                        try {
+                            body.run();
+                        } catch (Throwable t) {
+                            failure[0] = t;
+                        } finally {
+                            Gdx.app.exit();
+                        }
+                    }
+                },
+                config);
+        if (failure[0] instanceof AssertionError) {
+            throw (AssertionError) failure[0];
+        }
+        if (failure[0] != null) {
+            throw new AssertionError("Scenario failed: " + failure[0], failure[0]);
+        }
+    }
+}
