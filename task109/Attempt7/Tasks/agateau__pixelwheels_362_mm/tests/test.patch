+++ b/core-tests/src/com/agateau/pixelwheels/racescreen/MissileZOrderTest.java
@@ -0,0 +1,397 @@
+/*
+ * Tests for https://github.com/agateau/pixelwheels/issues/362 ("the rocket weapon on the vehicles
+ * is shown on top of the race map elements": footbridges, bridge sides, tree clusters, huts).
+ *
+ * They drive the real GameRenderer rendering loop with a real (but code-built, not loaded from an
+ * asset file) track made of one background layer and one foreground layer, and real game objects,
+ * through a Batch that records every textured quad in the order it is drawn. What is checked is
+ * the painter's-algorithm order the player sees: drawn earlier means drawn underneath.
+ *
+ * GameRenderer eagerly creates a ShapeRenderer and a CellFrameBufferManager (which allocates a
+ * real FrameBuffer) in its constructor, so these tests run inside a real, hidden desktop GL
+ * context (see GlContext).
+ */
+package com.agateau.pixelwheels.racescreen;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.ArgumentMatchers.anyFloat;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import com.agateau.pixelwheels.Assets;
+import com.agateau.pixelwheels.GamePlay;
+import com.agateau.pixelwheels.GameWorld;
+import com.agateau.pixelwheels.ZLevel;
+import com.agateau.pixelwheels.bonus.Missile;
+import com.agateau.pixelwheels.gameobject.CellFrameBufferManager;
+import com.agateau.pixelwheels.gameobject.CellFrameBufferUser;
+import com.agateau.pixelwheels.gameobject.GameObject;
+import com.agateau.pixelwheels.gameobject.GameObjectAdapter;
+import com.agateau.pixelwheels.map.Track;
+import com.agateau.pixelwheels.racer.Racer;
+import com.agateau.pixelwheels.racer.Vehicle;
+import com.agateau.pixelwheels.racer.VehicleRenderer;
+import com.agateau.pixelwheels.sound.AudioManager;
+import com.agateau.pixelwheels.testutils.DrawRecorder;
+import com.agateau.pixelwheels.testutils.GlContext;
+import com.badlogic.gdx.graphics.Texture;
+import com.badlogic.gdx.graphics.g2d.Batch;
+import com.badlogic.gdx.graphics.g2d.TextureRegion;
+import com.badlogic.gdx.graphics.glutils.FrameBuffer;
+import com.badlogic.gdx.maps.tiled.TiledMap;
+import com.badlogic.gdx.maps.tiled.TiledMapTileLayer;
+import com.badlogic.gdx.maps.tiled.tiles.StaticTiledMapTile;
+import com.badlogic.gdx.math.MathUtils;
+import com.badlogic.gdx.math.Rectangle;
+import com.badlogic.gdx.math.Vector2;
+import com.badlogic.gdx.physics.box2d.Body;
+import com.badlogic.gdx.physics.box2d.BodyDef;
+import com.badlogic.gdx.physics.box2d.Filter;
+import com.badlogic.gdx.physics.box2d.Fixture;
+import com.badlogic.gdx.physics.box2d.PolygonShape;
+import com.badlogic.gdx.physics.box2d.World;
+import com.badlogic.gdx.utils.Array;
+import com.badlogic.gdx.utils.PerformanceCounters;
+import java.lang.reflect.Field;
+import java.util.List;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.junit.runners.JUnit4;
+
+@RunWith(JUnit4.class)
+public class MissileZOrderTest {
+    private static final int TILE_PX = 20;
+    private static final int MAP_TILES = 64;
+    // World-space position (after Constants.UNIT_FOR_PIXEL scaling) of the objects and of the
+    // foreground tile above them. Matches the middle of the viewport set up below.
+    private static final float POSITION = 30f;
+
+    private static Texture texture() {
+        Texture texture = mock(Texture.class);
+        when(texture.getWidth()).thenReturn(64);
+        when(texture.getHeight()).thenReturn(64);
+        return texture;
+    }
+
+    /**
+     * A car carrying a rocket (picked up, not fired yet) drives under a foreground map element:
+     * within one rendered frame, every quad of the rocket must be drawn before the foreground
+     * layer, so the rocket ends up underneath it together with the car.
+     */
+    @Test(timeout = 60000)
+    public void missileIsDrawnBeforeForegroundLayer() {
+        GlContext.run(
+                () -> {
+                    Texture fgTexture = texture();
+                    Texture missileTexture = texture();
+                    World box2DWorld = new World(new Vector2(0, 0), true);
+                    Missile missile = buildCarriedMissile(box2DWorld, missileTexture);
+
+                    DrawRecorder batch = renderOneFrame(fgTexture, box2DWorld, missile);
+
+                    List<DrawRecorder.Quad> fg = batch.quadsOf(fgTexture);
+                    List<DrawRecorder.Quad> rocket = batch.quadsOf(missileTexture);
+                    assertFalse("the foreground layer should be drawn", fg.isEmpty());
+                    assertFalse("the carried rocket should be drawn", rocket.isEmpty());
+                    int firstFg = fg.get(0).index;
+                    for (DrawRecorder.Quad quad : rocket) {
+                        assertTrue(
+                                "The rocket (and its shadow) should be drawn before the foreground"
+                                        + " layer, so that it appears underneath it instead of"
+                                        + " over it: "
+                                        + quad
+                                        + " drawn after foreground quad #"
+                                        + firstFg,
+                                quad.index < firstFg);
+                    }
+                });
+    }
+
+    /**
+     * Guard: the rescue helicopter keeps flying *above* the foreground layer, as it does at the
+     * base commit. A fix that drew every flying object before the foreground layer would break it.
+     */
+    @Test(timeout = 60000)
+    public void helicopterIsDrawnAfterForegroundLayer() {
+        GlContext.run(
+                () -> {
+                    Texture fgTexture = texture();
+                    Texture helicopterTexture = texture();
+                    Helicopter helicopter = buildHelicopter(helicopterTexture);
+
+                    DrawRecorder batch =
+                            renderOneFrame(
+                                    fgTexture, new World(new Vector2(0, 0), true), helicopter);
+
+                    List<DrawRecorder.Quad> fg = batch.quadsOf(fgTexture);
+                    assertFalse("the foreground layer should be drawn", fg.isEmpty());
+                    int lastFg = fg.get(fg.size() - 1).index;
+                    boolean bodyDrawn = false;
+                    for (DrawRecorder.Quad quad : batch.quadsOf(helicopterTexture)) {
+                        if (quad.isShadowLike()) {
+                            continue;
+                        }
+                        bodyDrawn = true;
+                        assertTrue(
+                                "The rescue helicopter should keep being drawn over the"
+                                        + " foreground layer: "
+                                        + quad,
+                                quad.index > lastFg);
+                    }
+                    assertTrue("the helicopter should be drawn", bodyDrawn);
+                });
+    }
+
+    /**
+     * Guard: a vehicle lifted by the rescue helicopter keeps being drawn *above* the foreground
+     * layer, as it does at the base commit (it is carried in the air together with the helicopter).
+     */
+    @Test(timeout = 60000)
+    public void liftedVehicleIsDrawnAfterForegroundLayer() {
+        GlContext.run(
+                () -> {
+                    Texture fgTexture = texture();
+                    Texture vehicleTexture = texture();
+                    World box2DWorld = new World(new Vector2(0, 0), true);
+                    LiftedVehicle lifted = new LiftedVehicle(box2DWorld, vehicleTexture);
+
+                    DrawRecorder batch = renderOneFrame(fgTexture, box2DWorld, lifted);
+
+                    List<DrawRecorder.Quad> fg = batch.quadsOf(fgTexture);
+                    assertFalse("the foreground layer should be drawn", fg.isEmpty());
+                    int lastFg = fg.get(fg.size() - 1).index;
+                    boolean bodyDrawn = false;
+                    for (DrawRecorder.Quad quad : batch.quads()) {
+                        // On screen the vehicle is drawn from its pre-rendered cell: skip the
+                        // foreground tiles, the off-screen cell painting and the shadow.
+                        if (quad.texture == fgTexture
+                                || quad.texture == vehicleTexture
+                                || quad.isShadowLike()) {
+                            continue;
+                        }
+                        bodyDrawn = true;
+                        assertTrue(
+                                "A vehicle lifted by the helicopter should keep being drawn over"
+                                        + " the foreground layer: "
+                                        + quad,
+                                quad.index > lastFg);
+                    }
+                    assertTrue("the lifted vehicle should be drawn", bodyDrawn);
+                });
+    }
+
+    /** A vehicle in the air (lifted by the helicopter), rendered by the real VehicleRenderer. */
+    private static class LiftedVehicle extends GameObjectAdapter implements CellFrameBufferUser {
+        private final VehicleRenderer mRenderer;
+
+        LiftedVehicle(World world, Texture texture) {
+            BodyDef bodyDef = new BodyDef();
+            bodyDef.type = BodyDef.BodyType.DynamicBody;
+            bodyDef.position.set(POSITION, POSITION);
+            bodyDef.angle = 90 * MathUtils.degRad;
+            Body body = world.createBody(bodyDef);
+
+            Vehicle vehicle = mock(Vehicle.class);
+            when(vehicle.getBody()).thenReturn(body);
+            when(vehicle.getWheelInfos()).thenReturn(new Array<>());
+            when(vehicle.getRegion(anyFloat())).thenReturn(new TextureRegion(texture, 0, 0, 30, 52));
+            when(vehicle.getPosition()).thenReturn(new Vector2(POSITION, POSITION));
+            when(vehicle.getX()).thenReturn(POSITION);
+            when(vehicle.getY()).thenReturn(POSITION);
+            when(vehicle.getAngle()).thenReturn(90f);
+            when(vehicle.isFlying()).thenReturn(true);
+            when(vehicle.isFalling()).thenReturn(false);
+            when(vehicle.getZ()).thenReturn(0.5f);
+            when(vehicle.getTurboTime()).thenReturn(-1f);
+            mRenderer = new VehicleRenderer(mock(Assets.class), vehicle);
+        }
+
+        @Override
+        public void init(CellFrameBufferManager manager) {
+            mRenderer.init(manager);
+        }
+
+        @Override
+        public void drawToCell(Batch batch, Rectangle viewBounds) {
+            mRenderer.drawToCell(batch, viewBounds);
+        }
+
+        @Override
+        public void act(float delta) {}
+
+        @Override
+        public void draw(Batch batch, ZLevel zLevel, Rectangle viewBounds) {
+            mRenderer.draw(batch, zLevel, viewBounds);
+        }
+
+        @Override
+        public float getX() {
+            return POSITION;
+        }
+
+        @Override
+        public float getY() {
+            return POSITION;
+        }
+    }
+
+    private static DrawRecorder renderOneFrame(
+            Texture fgTexture, World box2DWorld, GameObject object) {
+        boolean oldFreeCamera = GamePlay.instance.freeCamera;
+        GamePlay.instance.freeCamera = true;
+        try {
+            return renderOneFrameWithFreeCamera(fgTexture, box2DWorld, object);
+        } finally {
+            GamePlay.instance.freeCamera = oldFreeCamera;
+        }
+    }
+
+    private static DrawRecorder renderOneFrameWithFreeCamera(
+            Texture fgTexture, World box2DWorld, GameObject object) {
+        FakeTrack track = new FakeTrack(buildMap(fgTexture));
+
+        GameWorld gameWorld = mock(GameWorld.class);
+        when(gameWorld.getTrack()).thenReturn(track);
+        when(gameWorld.getBox2DWorld()).thenReturn(box2DWorld);
+        Array<GameObject> gameObjects = new Array<>();
+        gameObjects.add(object);
+        when(gameWorld.getActiveGameObjects()).thenReturn(gameObjects);
+
+        DrawRecorder batch = new DrawRecorder();
+        GameRenderer renderer =
+                new GameRenderer(gameWorld, /* racer= */ null, batch, new PerformanceCounters());
+        renderer.setScreenRect(0, 0, 60, 60);
+        renderer.onAboutToStart();
+
+        // Render once so the free camera settles, then record exactly one frame: checking the
+        // order across several frames would let one frame's draws satisfy another frame's check.
+        renderer.render(0f);
+        batch.clear();
+        renderer.render(0f);
+        return batch;
+    }
+
+    private static Missile buildCarriedMissile(World world, Texture missileTexture)
+            throws Exception {
+        BodyDef bodyDef = new BodyDef();
+        bodyDef.type = BodyDef.BodyType.DynamicBody;
+        bodyDef.position.set(POSITION, POSITION);
+        bodyDef.angle = 90 * MathUtils.degRad;
+        Body carBody = world.createBody(bodyDef);
+        PolygonShape shape = new PolygonShape();
+        shape.setAsBox(1.4f, 0.75f);
+        Fixture fixture = carBody.createFixture(shape, 1f);
+        shape.dispose();
+        Filter filter = new Filter();
+        filter.categoryBits = 0x4000;
+        filter.maskBits = 0;
+        fixture.setFilterData(filter);
+
+        Vehicle vehicle = mock(Vehicle.class);
+        when(vehicle.getBody()).thenReturn(carBody);
+        when(vehicle.getX()).thenReturn(POSITION);
+        when(vehicle.getY()).thenReturn(POSITION);
+        when(vehicle.getPosition()).thenReturn(new Vector2(POSITION, POSITION));
+        when(vehicle.getAngle()).thenReturn(90f);
+        Racer racer = mock(Racer.class);
+        when(racer.getVehicle()).thenReturn(vehicle);
+        carBody.setUserData(racer);
+
+        GameWorld gameWorld = mock(GameWorld.class);
+        when(gameWorld.getBox2DWorld()).thenReturn(world);
+
+        Assets assets = mock(Assets.class);
+        setField(assets, Assets.class, "missile", new TextureRegion(missileTexture, 44, 13));
+        setField(assets, Assets.class, "target", new TextureRegion(missileTexture, 16, 16));
+        // A real Racer always has a VehicleRenderer; code drawing what it carries may use it.
+        when(racer.getVehicleRenderer()).thenReturn(new VehicleRenderer(assets, vehicle));
+        return Missile.create(assets, gameWorld, mock(AudioManager.class), racer);
+    }
+
+    private static Helicopter buildHelicopter(Texture frameBufferTexture) throws Exception {
+        Helicopter helicopter = Helicopter.class.getDeclaredConstructor().newInstance();
+
+        FrameBuffer frameBuffer = mock(FrameBuffer.class);
+        when(frameBuffer.getWidth()).thenReturn(TILE_PX);
+        when(frameBuffer.getHeight()).thenReturn(TILE_PX);
+        when(frameBuffer.getColorBufferTexture()).thenReturn(frameBufferTexture);
+        setField(helicopter, Helicopter.class, "mFrameBuffer", frameBuffer);
+
+        // mFrameBufferRadiusU is only used to cull off-screen helicopters; a few world units are
+        // plenty to keep it comfortably inside the viewBounds set up around POSITION.
+        setField(helicopter, Helicopter.class, "mFrameBufferRadiusU", 5f);
+
+        Field positionField = Helicopter.class.getDeclaredField("mPosition");
+        positionField.setAccessible(true);
+        ((Vector2) positionField.get(helicopter)).set(POSITION, POSITION);
+
+        return helicopter;
+    }
+
+    private static TiledMap buildMap(Texture fgTexture) {
+        TiledMap map = new TiledMap();
+
+        TiledMapTileLayer bgLayer = new TiledMapTileLayer(MAP_TILES, MAP_TILES, TILE_PX, TILE_PX);
+        bgLayer.setName("bg");
+        map.getLayers().add(bgLayer);
+
+        TiledMapTileLayer fgLayer = new TiledMapTileLayer(MAP_TILES, MAP_TILES, TILE_PX, TILE_PX);
+        fgLayer.setName("fg");
+        StaticTiledMapTile fgTile = new StaticTiledMapTile(new TextureRegion(fgTexture, TILE_PX, TILE_PX));
+        // TILE_PX pixels per tile, scaled by Constants.UNIT_FOR_PIXEL (1/20) gives exactly 1 world
+        // unit per tile, so the tile coordinate matching a world position is the position itself.
+        for (int dx = -2; dx <= 2; ++dx) {
+            for (int dy = -2; dy <= 2; ++dy) {
+                TiledMapTileLayer.Cell cell = new TiledMapTileLayer.Cell();
+                cell.setTile(fgTile);
+                fgLayer.setCell((int) POSITION + dx, (int) POSITION + dy, cell);
+            }
+        }
+        map.getLayers().add(fgLayer);
+
+        return map;
+    }
+
+    private static void setField(Object target, Class<?> declaringClass, String name, Object value)
+            throws Exception {
+        Field field = declaringClass.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(target, value);
+    }
+
+    /** A Track that doesn't load anything from disk: it is built entirely in memory. */
+    private static class FakeTrack extends Track {
+        private final TiledMap mMap;
+
+        FakeTrack(TiledMap map) {
+            super(null, "test-track", "Test track");
+            mMap = map;
+        }
+
+        @Override
+        public TiledMap getMap() {
+            return mMap;
+        }
+
+        @Override
+        public int[] getExtraBackgroundLayerIndexes() {
+            return new int[0];
+        }
+
+        @Override
+        public int[] getForegroundLayerIndexes() {
+            return new int[] {1};
+        }
+
+        @Override
+        public float getMapWidth() {
+            return 2000;
+        }
+
+        @Override
+        public float getMapHeight() {
+            return 2000;
+        }
+    }
+}
diff --git a/core-tests/src/com/agateau/pixelwheels/racescreen/RacerCameraTest.java b/core-tests/src/com/agateau/pixelwheels/racescreen/RacerCameraTest.java
new file mode 100755
index 0000000..bae7ba4
--- /dev/null
+++ b/core-tests/src/com/agateau/pixelwheels/racescreen/RacerCameraTest.java
@@ -0,0 +1,95 @@
+/*
+ * How the race view follows the player's car: it keeps the car on screen and leaves more room in
+ * front of the car than behind it, whichever way the car is heading.
+ *
+ * The camera updater used by the race screen is driven with a car standing still in the middle of
+ * a large track, facing various directions, and the resulting camera is inspected.
+ */
+package com.agateau.pixelwheels.racescreen;
+
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import com.agateau.pixelwheels.GameWorld;
+import com.agateau.pixelwheels.map.Track;
+import com.agateau.pixelwheels.racer.Racer;
+import com.agateau.pixelwheels.racer.Vehicle;
+import com.badlogic.gdx.graphics.OrthographicCamera;
+import com.badlogic.gdx.math.Vector2;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.junit.runners.JUnit4;
+
+@RunWith(JUnit4.class)
+public class RacerCameraTest {
+    private static final float[] HEADINGS = {0, 45, 90, 135, 180, 225, 270, 315};
+    private static final Vector2 CAR = new Vector2(500, 500);
+
+    /** Returns where the view is centered, relative to the car. */
+    private static Vector2 viewOffset(float heading) {
+        Track track = mock(Track.class);
+        when(track.getMapWidth()).thenReturn(1000f);
+        when(track.getMapHeight()).thenReturn(1000f);
+        GameWorld world = mock(GameWorld.class);
+        when(world.getTrack()).thenReturn(track);
+
+        Vehicle vehicle = mock(Vehicle.class);
+        when(vehicle.getPosition()).thenReturn(new Vector2(CAR));
+        when(vehicle.getX()).thenReturn(CAR.x);
+        when(vehicle.getY()).thenReturn(CAR.y);
+        when(vehicle.getAngle()).thenReturn(heading);
+        when(vehicle.getSpeed()).thenReturn(0f);
+        Racer racer = mock(Racer.class);
+        when(racer.getVehicle()).thenReturn(vehicle);
+        when(racer.getCameraAngle()).thenReturn(heading);
+        when(racer.getPosition()).thenReturn(new Vector2(CAR));
+        when(racer.getX()).thenReturn(CAR.x);
+        when(racer.getY()).thenReturn(CAR.y);
+
+        OrthographicCamera camera = new OrthographicCamera();
+        RacerCameraUpdater updater = new RacerCameraUpdater(world, racer);
+        updater.init(camera, 1920, 1080);
+        updater.update(CameraUpdater.IMMEDIATE);
+
+        float halfW = camera.viewportWidth * camera.zoom / 2;
+        float halfH = camera.viewportHeight * camera.zoom / 2;
+        Vector2 offset = new Vector2(camera.position.x, camera.position.y).sub(CAR);
+        assertTrue(
+                "heading " + heading + "°: the car is out of the view (view offset " + offset + ")",
+                Math.abs(offset.x) < halfW && Math.abs(offset.y) < halfH);
+        return offset;
+    }
+
+    private static float angleBetween(Vector2 direction, float angleDeg) {
+        float delta = (direction.angleDeg() - angleDeg) % 360;
+        if (delta < -180) {
+            delta += 360;
+        } else if (delta > 180) {
+            delta -= 360;
+        }
+        return Math.abs(delta);
+    }
+
+    @Test
+    public void viewLooksAheadOfTheCarWhicheverWayItHeads() {
+        for (float heading : HEADINGS) {
+            Vector2 offset = viewOffset(heading);
+            assertTrue(
+                    "heading " + heading + "°: the view should show more of the road ahead of the"
+                            + " car than behind it (view offset " + offset + ")",
+                    offset.len() > 1);
+            assertTrue(
+                    "heading " + heading + "°: the view is shifted towards " + offset.angleDeg()
+                            + "° instead of towards where the car is heading",
+                    angleBetween(offset, heading) < 5);
+        }
+    }
+
+    @Test
+    public void viewKeepsTheCarOnScreen() {
+        for (float heading : HEADINGS) {
+            viewOffset(heading);
+        }
+    }
+}
diff --git a/core-tests/src/com/agateau/pixelwheels/testutils/DrawRecorder.java b/core-tests/src/com/agateau/pixelwheels/testutils/DrawRecorder.java
new file mode 100755
index 0000000..e4fbe58
--- /dev/null
+++ b/core-tests/src/com/agateau/pixelwheels/testutils/DrawRecorder.java
@@ -0,0 +1,515 @@
+/*
+ * Test helper: a Batch that draws nothing but records, for every draw call, which texture was
+ * drawn, where its four corners ended up in world space, which texture coordinates they carry and
+ * with which color. Whatever Batch.draw() overload the game code uses, a draw is turned into the
+ * same quad that SpriteBatch would send to the GPU, so tests can reason about *what the player
+ * sees* (position, orientation, draw order, tint) instead of about which method was called.
+ */
+package com.agateau.pixelwheels.testutils;
+
+import com.badlogic.gdx.graphics.Color;
+import com.badlogic.gdx.graphics.Texture;
+import com.badlogic.gdx.graphics.g2d.Batch;
+import com.badlogic.gdx.graphics.g2d.TextureRegion;
+import com.badlogic.gdx.graphics.glutils.ShaderProgram;
+import com.badlogic.gdx.math.Affine2;
+import com.badlogic.gdx.math.MathUtils;
+import com.badlogic.gdx.math.Matrix4;
+import com.badlogic.gdx.math.Vector2;
+import java.util.ArrayList;
+import java.util.List;
+
+public class DrawRecorder implements Batch {
+    /** One textured quad, as it would reach the screen. */
+    public static class Quad {
+        public final Texture texture;
+        public final float[] x = new float[4];
+        public final float[] y = new float[4];
+        public final float[] u = new float[4];
+        public final float[] v = new float[4];
+        public final Color color = new Color();
+        public final int index;
+
+        Quad(Texture texture, int index) {
+            this.texture = texture;
+            this.index = index;
+        }
+
+        public Vector2 center() {
+            return new Vector2((x[0] + x[1] + x[2] + x[3]) / 4, (y[0] + y[1] + y[2] + y[3]) / 4);
+        }
+
+        /** World-space direction in which the texture's U coordinate grows (the image's +X). */
+        public Vector2 imageXAxis() {
+            return axis(true);
+        }
+
+        /** World-space direction in which the texture's V coordinate grows (the image's -Y). */
+        public Vector2 imageVAxis() {
+            return axis(false);
+        }
+
+        private Vector2 axis(boolean alongU) {
+            // Solve world = A * (u, v) + b with the first three corners.
+            float du1 = u[1] - u[0], dv1 = v[1] - v[0];
+            float du2 = u[2] - u[0], dv2 = v[2] - v[0];
+            float dx1 = x[1] - x[0], dy1 = y[1] - y[0];
+            float dx2 = x[2] - x[0], dy2 = y[2] - y[0];
+            float det = du1 * dv2 - du2 * dv1;
+            if (Math.abs(det) < 1e-12f) {
+                return new Vector2();
+            }
+            Vector2 axis;
+            if (alongU) {
+                axis = new Vector2((dx1 * dv2 - dx2 * dv1) / det, (dy1 * dv2 - dy2 * dv1) / det);
+            } else {
+                axis = new Vector2((du1 * dx2 - du2 * dx1) / det, (du1 * dy2 - du2 * dy1) / det);
+            }
+            return axis.nor();
+        }
+
+        /** Length of the quad side going along the image's X axis. */
+        public float imageWidth() {
+            float best = 0;
+            Vector2 axis = imageXAxis();
+            for (int i = 0; i < 4; ++i) {
+                int j = (i + 1) % 4;
+                Vector2 edge = new Vector2(x[j] - x[i], y[j] - y[i]);
+                if (Math.abs(edge.nor().dot(axis)) > 0.99f) {
+                    best = Math.max(best, new Vector2(x[j] - x[i], y[j] - y[i]).len());
+                }
+            }
+            return best;
+        }
+
+        /**
+         * True for a draw clearly tinted towards black (how the game draws shadows: the object's
+         * own image, darkened). Regular sprites are drawn untinted (white).
+         */
+        public boolean isShadowLike() {
+            return color.r + color.g + color.b < 1.5f;
+        }
+
+        @Override
+        public String toString() {
+            return "Quad#" + index + "(" + texture + " center=" + center() + " color=" + color + ")";
+        }
+    }
+
+    private final List<Quad> mQuads = new ArrayList<>();
+    private final Color mColor = new Color(1, 1, 1, 1);
+    private final Matrix4 mProjection = new Matrix4();
+    private final Matrix4 mTransform = new Matrix4();
+    private boolean mDrawing = false;
+    private boolean mBlending = true;
+    private int mSrc, mDst, mSrcA, mDstA;
+    private ShaderProgram mShader;
+
+    public List<Quad> quads() {
+        return mQuads;
+    }
+
+    public void clear() {
+        mQuads.clear();
+    }
+
+    public List<Quad> quadsOf(Texture texture) {
+        List<Quad> list = new ArrayList<>();
+        for (Quad quad : mQuads) {
+            if (quad.texture == texture) {
+                list.add(quad);
+            }
+        }
+        return list;
+    }
+
+    // Batch state ---------------------------------------------------------------------------
+    @Override
+    public void begin() {
+        mDrawing = true;
+    }
+
+    @Override
+    public void end() {
+        mDrawing = false;
+    }
+
+    @Override
+    public void setColor(Color tint) {
+        mColor.set(tint);
+    }
+
+    @Override
+    public void setColor(float r, float g, float b, float a) {
+        mColor.set(r, g, b, a);
+    }
+
+    @Override
+    public Color getColor() {
+        return mColor;
+    }
+
+    @Override
+    public void setPackedColor(float packedColor) {
+        Color.abgr8888ToColor(mColor, packedColor);
+    }
+
+    @Override
+    public float getPackedColor() {
+        return mColor.toFloatBits();
+    }
+
+    @Override
+    public void flush() {}
+
+    @Override
+    public void disableBlending() {
+        mBlending = false;
+    }
+
+    @Override
+    public void enableBlending() {
+        mBlending = true;
+    }
+
+    @Override
+    public void setBlendFunction(int srcFunc, int dstFunc) {
+        setBlendFunctionSeparate(srcFunc, dstFunc, srcFunc, dstFunc);
+    }
+
+    @Override
+    public void setBlendFunctionSeparate(int srcRGB, int dstRGB, int srcAlpha, int dstAlpha) {
+        mSrc = srcRGB;
+        mDst = dstRGB;
+        mSrcA = srcAlpha;
+        mDstA = dstAlpha;
+    }
+
+    @Override
+    public int getBlendSrcFunc() {
+        return mSrc;
+    }
+
+    @Override
+    public int getBlendDstFunc() {
+        return mDst;
+    }
+
+    @Override
+    public int getBlendSrcFuncAlpha() {
+        return mSrcA;
+    }
+
+    @Override
+    public int getBlendDstFuncAlpha() {
+        return mDstA;
+    }
+
+    @Override
+    public Matrix4 getProjectionMatrix() {
+        return mProjection;
+    }
+
+    @Override
+    public Matrix4 getTransformMatrix() {
+        return mTransform;
+    }
+
+    @Override
+    public void setProjectionMatrix(Matrix4 projection) {
+        mProjection.set(projection);
+    }
+
+    @Override
+    public void setTransformMatrix(Matrix4 transform) {
+        mTransform.set(transform);
+    }
+
+    @Override
+    public void setShader(ShaderProgram shader) {
+        mShader = shader;
+    }
+
+    @Override
+    public ShaderProgram getShader() {
+        return mShader;
+    }
+
+    @Override
+    public boolean isBlendingEnabled() {
+        return mBlending;
+    }
+
+    @Override
+    public boolean isDrawing() {
+        return mDrawing;
+    }
+
+    @Override
+    public void dispose() {}
+
+    // Recording -----------------------------------------------------------------------------
+    private Quad add(Texture texture) {
+        Quad quad = new Quad(texture, mQuads.size());
+        quad.color.set(mColor);
+        mQuads.add(quad);
+        return quad;
+    }
+
+    private static void corner(Quad q, int i, float x, float y, float u, float v) {
+        q.x[i] = x;
+        q.y[i] = y;
+        q.u[i] = u;
+        q.v[i] = v;
+    }
+
+    /** Same corner maths as SpriteBatch for the origin/scale/rotation overloads. */
+    private static float[] transformedCorners(
+            float x,
+            float y,
+            float originX,
+            float originY,
+            float width,
+            float height,
+            float scaleX,
+            float scaleY,
+            float rotation) {
+        float worldOriginX = x + originX;
+        float worldOriginY = y + originY;
+        float fx = -originX;
+        float fy = -originY;
+        float fx2 = width - originX;
+        float fy2 = height - originY;
+        if (scaleX != 1 || scaleY != 1) {
+            fx *= scaleX;
+            fy *= scaleY;
+            fx2 *= scaleX;
+            fy2 *= scaleY;
+        }
+        float cos = MathUtils.cosDeg(rotation);
+        float sin = MathUtils.sinDeg(rotation);
+        float x1 = cos * fx - sin * fy, y1 = sin * fx + cos * fy;
+        float x2 = cos * fx - sin * fy2, y2 = sin * fx + cos * fy2;
+        float x3 = cos * fx2 - sin * fy2, y3 = sin * fx2 + cos * fy2;
+        float x4 = x1 + (x3 - x2), y4 = y3 - (y2 - y1);
+        return new float[] {
+            x1 + worldOriginX, y1 + worldOriginY,
+            x2 + worldOriginX, y2 + worldOriginY,
+            x3 + worldOriginX, y3 + worldOriginY,
+            x4 + worldOriginX, y4 + worldOriginY
+        };
+    }
+
+    private static float invW(Texture texture) {
+        return texture.getWidth() == 0 ? 0 : 1f / texture.getWidth();
+    }
+
+    private static float invH(Texture texture) {
+        return texture.getHeight() == 0 ? 0 : 1f / texture.getHeight();
+    }
+
+    @Override
+    public void draw(
+            Texture texture,
+            float x,
+            float y,
+            float originX,
+            float originY,
+            float width,
+            float height,
+            float scaleX,
+            float scaleY,
+            float rotation,
+            int srcX,
+            int srcY,
+            int srcWidth,
+            int srcHeight,
+            boolean flipX,
+            boolean flipY) {
+        float[] c =
+                transformedCorners(x, y, originX, originY, width, height, scaleX, scaleY, rotation);
+        float u = srcX * invW(texture);
+        float v = (srcY + srcHeight) * invH(texture);
+        float u2 = (srcX + srcWidth) * invW(texture);
+        float v2 = srcY * invH(texture);
+        if (flipX) {
+            float tmp = u;
+            u = u2;
+            u2 = tmp;
+        }
+        if (flipY) {
+            float tmp = v;
+            v = v2;
+            v2 = tmp;
+        }
+        Quad q = add(texture);
+        corner(q, 0, c[0], c[1], u, v);
+        corner(q, 1, c[2], c[3], u, v2);
+        corner(q, 2, c[4], c[5], u2, v2);
+        corner(q, 3, c[6], c[7], u2, v);
+    }
+
+    @Override
+    public void draw(
+            Texture texture,
+            float x,
+            float y,
+            float width,
+            float height,
+            int srcX,
+            int srcY,
+            int srcWidth,
+            int srcHeight,
+            boolean flipX,
+            boolean flipY) {
+        draw(
+                texture, x, y, 0, 0, width, height, 1, 1, 0, srcX, srcY, srcWidth, srcHeight,
+                flipX, flipY);
+    }
+
+    @Override
+    public void draw(
+            Texture texture, float x, float y, int srcX, int srcY, int srcWidth, int srcHeight) {
+        draw(
+                texture, x, y, 0, 0, srcWidth, srcHeight, 1, 1, 0, srcX, srcY, srcWidth,
+                srcHeight, false, false);
+    }
+
+    @Override
+    public void draw(
+            Texture texture,
+            float x,
+            float y,
+            float width,
+            float height,
+            float u,
+            float v,
+            float u2,
+            float v2) {
+        Quad q = add(texture);
+        corner(q, 0, x, y, u, v);
+        corner(q, 1, x, y + height, u, v2);
+        corner(q, 2, x + width, y + height, u2, v2);
+        corner(q, 3, x + width, y, u2, v);
+    }
+
+    @Override
+    public void draw(Texture texture, float x, float y) {
+        draw(texture, x, y, texture.getWidth(), texture.getHeight());
+    }
+
+    @Override
+    public void draw(Texture texture, float x, float y, float width, float height) {
+        draw(texture, x, y, width, height, 0, 1, 1, 0);
+    }
+
+    @Override
+    public void draw(Texture texture, float[] spriteVertices, int offset, int count) {
+        for (int base = offset; base + 20 <= offset + count; base += 20) {
+            Quad q = add(texture);
+            Color.abgr8888ToColor(q.color, spriteVertices[base + 2]);
+            for (int i = 0; i < 4; ++i) {
+                int k = base + i * 5;
+                corner(
+                        q,
+                        i,
+                        spriteVertices[k],
+                        spriteVertices[k + 1],
+                        spriteVertices[k + 3],
+                        spriteVertices[k + 4]);
+            }
+        }
+    }
+
+    @Override
+    public void draw(TextureRegion region, float x, float y) {
+        draw(region, x, y, region.getRegionWidth(), region.getRegionHeight());
+    }
+
+    @Override
+    public void draw(TextureRegion region, float x, float y, float width, float height) {
+        Quad q = add(region.getTexture());
+        corner(q, 0, x, y, region.getU(), region.getV2());
+        corner(q, 1, x, y + height, region.getU(), region.getV());
+        corner(q, 2, x + width, y + height, region.getU2(), region.getV());
+        corner(q, 3, x + width, y, region.getU2(), region.getV2());
+    }
+
+    @Override
+    public void draw(
+            TextureRegion region,
+            float x,
+            float y,
+            float originX,
+            float originY,
+            float width,
+            float height,
+            float scaleX,
+            float scaleY,
+            float rotation) {
+        float[] c =
+                transformedCorners(x, y, originX, originY, width, height, scaleX, scaleY, rotation);
+        Quad q = add(region.getTexture());
+        corner(q, 0, c[0], c[1], region.getU(), region.getV2());
+        corner(q, 1, c[2], c[3], region.getU(), region.getV());
+        corner(q, 2, c[4], c[5], region.getU2(), region.getV());
+        corner(q, 3, c[6], c[7], region.getU2(), region.getV2());
+    }
+
+    @Override
+    public void draw(
+            TextureRegion region,
+            float x,
+            float y,
+            float originX,
+            float originY,
+            float width,
+            float height,
+            float scaleX,
+            float scaleY,
+            float rotation,
+            boolean clockwise) {
+        float[] c =
+                transformedCorners(x, y, originX, originY, width, height, scaleX, scaleY, rotation);
+        float u1, v1, u2, v2, u3, v3, u4, v4;
+        if (clockwise) {
+            u1 = region.getU2();
+            v1 = region.getV2();
+            u2 = region.getU();
+            v2 = region.getV2();
+            u3 = region.getU();
+            v3 = region.getV();
+            u4 = region.getU2();
+            v4 = region.getV();
+        } else {
+            u1 = region.getU();
+            v1 = region.getV();
+            u2 = region.getU2();
+            v2 = region.getV();
+            u3 = region.getU2();
+            v3 = region.getV2();
+            u4 = region.getU();
+            v4 = region.getV2();
+        }
+        Quad q = add(region.getTexture());
+        corner(q, 0, c[0], c[1], u1, v1);
+        corner(q, 1, c[2], c[3], u2, v2);
+        corner(q, 2, c[4], c[5], u3, v3);
+        corner(q, 3, c[6], c[7], u4, v4);
+    }
+
+    @Override
+    public void draw(TextureRegion region, float width, float height, Affine2 t) {
+        Quad q = add(region.getTexture());
+        corner(q, 0, t.m02, t.m12, region.getU(), region.getV2());
+        corner(q, 1, t.m01 * height + t.m02, t.m11 * height + t.m12, region.getU(), region.getV());
+        corner(
+                q,
+                2,
+                t.m00 * width + t.m01 * height + t.m02,
+                t.m10 * width + t.m11 * height + t.m12,
+                region.getU2(),
+                region.getV());
+        corner(q, 3, t.m00 * width + t.m02, t.m10 * width + t.m12, region.getU2(), region.getV2());
+    }
+}
