@@ -0,0 +1,110 @@
+/*
+ * A car on the ground casts its shadow the same way as every other object of the game: slightly
+ * down and to the right of it (the same side the rocket shadows, obstacle shadows and the map's
+ * buildings, trees and bridges cast theirs).
+ *
+ * The real VehicleRenderer is drawn, at every drawing level, through a Batch that records every
+ * textured quad (see DrawRecorder). The vehicle is pre-rendered in an off-screen cell, so the test
+ * runs inside a real hidden GL context (see GlContext).
+ */
+package com.agateau.pixelwheels.racer;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.ArgumentMatchers.anyFloat;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import com.agateau.pixelwheels.Assets;
+import com.agateau.pixelwheels.ZLevel;
+import com.agateau.pixelwheels.gameobject.CellFrameBufferManager;
+import com.agateau.pixelwheels.testutils.DrawRecorder;
+import com.agateau.pixelwheels.testutils.GlContext;
+import com.badlogic.gdx.graphics.Texture;
+import com.badlogic.gdx.graphics.g2d.TextureRegion;
+import com.badlogic.gdx.math.Rectangle;
+import com.badlogic.gdx.math.Vector2;
+import com.badlogic.gdx.utils.Array;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.junit.runners.JUnit4;
+
+@RunWith(JUnit4.class)
+public class VehicleShadowTest {
+    private static final Vector2 POS = new Vector2(30, 30);
+
+    @Test(timeout = 60000)
+    public void vehicleShadowFallsLikeEveryOtherShadow() {
+        GlContext.run(
+                () -> {
+                    // The light does not turn with the car: check several headings.
+                    for (float heading : new float[] {0, 90, 200, 315}) {
+                        checkShadow(heading);
+                    }
+                });
+    }
+
+    private static void checkShadow(float heading) {
+        Texture texture = mock(Texture.class);
+        when(texture.getWidth()).thenReturn(64);
+        when(texture.getHeight()).thenReturn(64);
+        TextureRegion region = new TextureRegion(texture, 0, 0, 30, 52);
+
+        Vehicle vehicle = mock(Vehicle.class);
+        when(vehicle.getWheelInfos()).thenReturn(new Array<>());
+        when(vehicle.getRegion(anyFloat())).thenReturn(region);
+        when(vehicle.getPosition()).thenReturn(new Vector2(POS));
+        when(vehicle.getX()).thenReturn(POS.x);
+        when(vehicle.getY()).thenReturn(POS.y);
+        when(vehicle.getAngle()).thenReturn(heading);
+        when(vehicle.getZ()).thenReturn(0f);
+        when(vehicle.isFlying()).thenReturn(false);
+        when(vehicle.isFalling()).thenReturn(false);
+        when(vehicle.getTurboTime()).thenReturn(-1f);
+
+        VehicleRenderer renderer = new VehicleRenderer(mock(Assets.class), vehicle);
+        renderer.init(new CellFrameBufferManager());
+
+        DrawRecorder batch = new DrawRecorder();
+        Rectangle view = new Rectangle(0, 0, 60, 60);
+        for (ZLevel zLevel : ZLevel.values()) {
+            renderer.draw(batch, zLevel, view);
+        }
+
+        String what = "heading " + heading + "°: ";
+        List<DrawRecorder.Quad> bodies = new ArrayList<>();
+        for (DrawRecorder.Quad quad : batch.quads()) {
+            if (!quad.isShadowLike()) {
+                bodies.add(quad);
+            }
+        }
+        assertFalse(what + "the car should be drawn", bodies.isEmpty());
+        DrawRecorder.Quad body = bodies.get(0);
+        assertTrue(
+                what + "the car should be drawn where it is (" + body.center() + ")",
+                body.center().dst(POS) < 0.01f);
+
+        // Shadows are darkened copies of the car image (same texture as the car itself).
+        List<DrawRecorder.Quad> shadows = new ArrayList<>();
+        for (DrawRecorder.Quad quad : batch.quadsOf(body.texture)) {
+            if (quad.isShadowLike()) {
+                shadows.add(quad);
+            }
+        }
+        assertFalse(what + "the car should cast a shadow", shadows.isEmpty());
+        for (DrawRecorder.Quad shadow : shadows) {
+            Vector2 offset = shadow.center().sub(body.center());
+            assertTrue(
+                    what
+                            + "the car shadow should fall down and to the right of the car, like"
+                            + " every other shadow; it is offset by "
+                            + offset,
+                    offset.x > 0.05f && offset.y < -0.05f);
+            assertTrue(
+                    what + "the shadow of a car on the ground should stay close to it: " + offset,
+                    offset.len() < 1);
+        }
+    }
+}
diff --git a/core-tests/src/com/agateau/pixelwheels/racescreen/MissileZOrderTest.java b/core-tests/src/com/agateau/pixelwheels/racescreen/MissileZOrderTest.java
