     @Override
     public void draw(Batch batch, ZLevel zLevel, Rectangle viewBounds) {
+        if (mStatus == Status.WAITING) {
+            // The missile is carried by its shooter: draw it like the vehicle carrying it, so
+            // that it is hidden with it, gets the same color effects and casts its shadow on the
+            // ground
+            Vehicle vehicle = mShooter.getVehicle();
+            if (zLevel == ZLevel.GROUND) {
+                if (!vehicle.isFalling()) {
+                    drawShadow(batch);
+                }
+                return;
+            }
+            ZLevel wantedZLevel = vehicle.isFlying() ? ZLevel.FLYING : ZLevel.VEHICLES;
+            if (zLevel == wantedZLevel) {
+                batch.setColor(mShooter.getVehicleRenderer().getBatchColor());
+                drawMissile(batch);
+                batch.setColor(Color.WHITE);
+                drawTarget(batch);
+            }
+            return;
+        }
         if (zLevel == ZLevel.FLYING) {
             // Draw the shadow at Z_FLYING so that the shadow is drawn *over* its vehicle
             drawShadow(batch);
             drawMissile(batch);
             drawTarget(batch);
-            if (mStatus != Status.WAITING) {
-                drawReactorFire(batch);
-            }
+            drawReactorFire(batch);
         }
     }
 
