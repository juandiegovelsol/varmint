+    /**
+     * Draws the missile while it is still attached to its shooter: it must be drawn at the same
+     * Z level as the vehicle (so that it gets hidden with it) and with the same effects.
+     */
+    private void drawAttached(Batch batch, ZLevel zLevel) {
+        if (zLevel == ZLevel.FLYING) {
+            drawTarget(batch);
+        }
+        Vehicle vehicle = mShooter.getVehicle();
+        ZLevel vehicleZLevel = vehicle.isFlying() ? ZLevel.FLYING : ZLevel.VEHICLES;
+        if (zLevel != vehicleZLevel) {
+            return;
+        }
+        // Draw the shadow at the vehicle level so that the shadow is drawn *over* its vehicle
+        if (!vehicle.isFalling()) {
+            mDrawer.setZ(vehicle.getZ());
+            drawShadow(batch);
+        }
+        batch.setColor(mShooter.getVehicleRenderer().getBatchColor());
+        drawMissile(batch);
+        batch.setColor(Color.WHITE);
+    }
