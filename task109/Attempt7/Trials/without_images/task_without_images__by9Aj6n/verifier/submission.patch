diff --git a/core/src/com/agateau/pixelwheels/bonus/Missile.java b/core/src/com/agateau/pixelwheels/bonus/Missile.java
index e6a94a5..6c97919 100644
--- a/core/src/com/agateau/pixelwheels/bonus/Missile.java
+++ b/core/src/com/agateau/pixelwheels/bonus/Missile.java
@@ -258,14 +258,30 @@ public class Missile extends GameObjectAdapter
 
     @Override
     public void draw(Batch batch, ZLevel zLevel, Rectangle viewBounds) {
+        if (mStatus == Status.WAITING) {
+            // The missile is still carried by its vehicle: draw it at the same level as the
+            // vehicle, so that it gets hidden with it, and apply the same effects
+            Vehicle vehicle = mShooter.getVehicle();
+            ZLevel vehicleZLevel = vehicle.isFlying() ? ZLevel.FLYING : ZLevel.VEHICLES;
+            if (zLevel == vehicleZLevel) {
+                if (!vehicle.isFalling()) {
+                    drawShadow(batch);
+                }
+                batch.setColor(mShooter.getVehicleRenderer().getBatchColor());
+                drawMissile(batch);
+                batch.setColor(Color.WHITE);
+            }
+            if (zLevel == ZLevel.FLYING) {
+                drawTarget(batch);
+            }
+            return;
+        }
         if (zLevel == ZLevel.FLYING) {
             // Draw the shadow at Z_FLYING so that the shadow is drawn *over* its vehicle
             drawShadow(batch);
             drawMissile(batch);
             drawTarget(batch);
-            if (mStatus != Status.WAITING) {
-                drawReactorFire(batch);
-            }
+            drawReactorFire(batch);
         }
     }
 
