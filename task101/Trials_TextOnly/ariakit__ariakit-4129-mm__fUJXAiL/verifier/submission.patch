index 0000000..bc3f927
--- /dev/null
+++ b/packages/ariakit-test/src/__tests__/press-tab-test.ts
@@ -0,0 +1,66 @@
+import { click } from "../click.ts";
+import { press } from "../press.ts";
+import { q } from "../query.ts";
+
+beforeEach(() => {
+  document.body.innerHTML = `
+    <div>
+      <button>1</button>
+      <button>2</button>
+      <button>3</button>
+      <button>4</button>
+    </div>
+  `;
+});
+
+afterEach(() => {
+  document.body.innerHTML = "";
+});
+
+test("skip disabled button with tabindex", async () => {
+  q.button("3")!.setAttribute("disabled", "");
+  q.button("3")!.setAttribute("tabindex", "0");
+  await click(q.button("2"));
+  await press.Tab();
+  expect(q.button("4")).toHaveFocus();
+  await press.ShiftTab();
+  expect(q.button("2")).toHaveFocus();
+});
+
+test("tab from button disabled while focused", async () => {
+  await click(q.button("2"));
+  q.button("2")!.setAttribute("disabled", "");
+  await press.Tab();
+  expect(q.button("3")).toHaveFocus();
+});
+
+test("shift+tab from button disabled while focused", async () => {
+  await click(q.button("2"));
+  q.button("2")!.setAttribute("disabled", "");
+  await press.ShiftTab();
+  expect(q.button("1")).toHaveFocus();
+});
+
+test("tab from button hidden while focused", async () => {
+  await click(q.button("2"));
+  q.button("2")!.hidden = true;
+  await press.Tab();
+  expect(q.button("3")).toHaveFocus();
+});
+
+test("tab from button removed while focused", async () => {
+  await click(q.button("2"));
+  q.button("2")!.remove();
+  expect(document.body).toHaveFocus();
+  await press.Tab();
+  expect(q.button("3")).toHaveFocus();
+  await press.Tab();
+  expect(q.button("4")).toHaveFocus();
+});
+
+test("shift+tab from button removed while focused", async () => {
+  await click(q.button("2"));
+  q.button("2")!.remove();
+  await press.ShiftTab();
+  expect(q.button("1")).toHaveFocus();
+});
