+/**
+ * Returns the index of the active element in the `elements` array. If the
+ * active element is not in the array (for example, a focused element that
+ * became disabled), returns the index of the last element that comes before it
+ * in the tab order so the navigation continues from the active element's
+ * position. The `elements` array is expected to be in the document order, or
+ * in reverse document order when `reversed` is `true`.
+ */
+function getActiveIndex(
+  elements: HTMLElement[],
+  container: HTMLElement,
+  activeElement: Element | null,
+  reversed = false,
+) {
+  const index = elements.indexOf(activeElement as HTMLElement);
+  if (index !== -1) return index;
+  if (!activeElement) return -1;
+  if (activeElement === container) return -1;
+  if (!contains(container, activeElement)) return -1;
+  const position = reversed
+    ? Node.DOCUMENT_POSITION_PRECEDING
+    : Node.DOCUMENT_POSITION_FOLLOWING;
+  const nextIndex = elements.findIndex(
+    (element) => !!(activeElement.compareDocumentPosition(element) & position),
+  );
+  return nextIndex === -1 ? elements.length - 1 : nextIndex - 1;
+}
