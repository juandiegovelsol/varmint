diff --git a/packages/ariakit-test/src/__tests__/press-tab-test.ts b/packages/ariakit-test/src/__tests__/press-tab-test.ts
new file mode 100644
index 0000000..cdaa34a
--- /dev/null
+++ b/packages/ariakit-test/src/__tests__/press-tab-test.ts
@@ -0,0 +1,70 @@
+import { click } from "../click.ts";
+import { press } from "../press.ts";
+
+function getButton(name: string) {
+  const buttons = Array.from(document.querySelectorAll("button"));
+  return buttons.find((button) => button.textContent === name)!;
+}
+
+afterEach(() => {
+  document.body.innerHTML = "";
+});
+
+test("tab after the focused button is disabled", async () => {
+  document.body.innerHTML =
+    "<button>1</button><button>2</button><button>3</button>";
+  await click(getButton("2"));
+  getButton("2").disabled = true;
+  await press.Tab();
+  expect(getButton("3")).toHaveFocus();
+  await press.ShiftTab();
+  expect(getButton("1")).toHaveFocus();
+});
+
+test("shift+tab after the focused button is disabled", async () => {
+  document.body.innerHTML =
+    "<button>1</button><button>2</button><button>3</button>";
+  await click(getButton("2"));
+  getButton("2").disabled = true;
+  await press.ShiftTab();
+  expect(getButton("1")).toHaveFocus();
+});
+
+test("tab skips buttons in a disabled fieldset", async () => {
+  document.body.innerHTML = `
+    <button>1</button>
+    <fieldset disabled>
+      <legend><button>legend</button></legend>
+      <button>2</button>
+    </fieldset>
+    <button>3</button>
+  `;
+  await click(getButton("1"));
+  await press.Tab();
+  expect(getButton("legend")).toHaveFocus();
+  await press.Tab();
+  expect(getButton("3")).toHaveFocus();
+  await press.ShiftTab();
+  expect(getButton("legend")).toHaveFocus();
+});
+
+test("tab follows positive tabindex order", async () => {
+  document.body.innerHTML = `
+    <button>1</button>
+    <button tabindex="2">2</button>
+    <button tabindex="1">3</button>
+    <button>4</button>
+  `;
+  await press.Tab();
+  expect(getButton("3")).toHaveFocus();
+  await press.Tab();
+  expect(getButton("2")).toHaveFocus();
+  await press.Tab();
+  expect(getButton("1")).toHaveFocus();
+  await press.Tab();
+  expect(getButton("4")).toHaveFocus();
+  await press.ShiftTab();
+  expect(getButton("1")).toHaveFocus();
+  await press.ShiftTab();
+  expect(getButton("2")).toHaveFocus();
+});
