+/**
+ * Checks whether `element` is a form control disabled by an ancestor fieldset
+ * element. Controls inside the first legend of the fieldset aren't disabled.
+ */
+function isDisabledByFieldset(element: Element) {
+  if (!element.matches(formControlSelector)) return false;
+  let fieldset = element.parentElement?.closest("fieldset[disabled]");
+  while (fieldset) {
+    const legend = Array.from(fieldset.children).find(
+      (child) => child.tagName === "LEGEND",
+    );
+    if (!legend?.contains(element)) return true;
+    fieldset = fieldset.parentElement?.closest("fieldset[disabled]");
+  }
+  return false;
+}
