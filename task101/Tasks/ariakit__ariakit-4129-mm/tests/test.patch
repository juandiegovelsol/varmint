@@ -0,0 +1,70 @@
+// https://github.com/ariakit/ariakit/issues/4129
+import { click, press, q } from "@ariakit/test";
+
+function setup() {
+  const before = document.createElement("button");
+  before.textContent = "Before";
+  document.body.prepend(before);
+  return () => {
+    before.remove();
+  };
+}
+
+// Moves to "Italic" with the keyboard, then removes it with the mouse.
+async function removeActiveItem() {
+  await press.Tab();
+  expect(q.button("Before")).toHaveFocus();
+  await press.Tab();
+  expect(q.button("Bold")).toHaveFocus();
+  await press.ArrowRight();
+  expect(q.button("Italic")).toHaveFocus();
+  await click(q.button("Toggle Italic"));
+  expect(q.button("Italic")).not.toBeInTheDocument();
+}
+
+// Tabbing backward enters the toolbar on one of its remaining buttons.
+// Returns the button that received focus.
+async function shiftTabIntoToolbar() {
+  await press.ShiftTab();
+  const entered = document.activeElement as HTMLElement;
+  expect([q.button("Bold"), q.button("Underline")]).toContain(entered);
+  return entered;
+}
+
+test("toolbar is still accessible with stale activeId", async () => {
+  onTestFinished(setup());
+
+  await removeActiveItem();
+  const entered = await shiftTabIntoToolbar();
+  await press.ShiftTab();
+  expect(q.button("Before")).toHaveFocus();
+  await press.Tab();
+  expect(entered).toHaveFocus();
+});
+
+test("arrow keys continue from the button focus returned to", async () => {
+  onTestFinished(setup());
+
+  await removeActiveItem();
+  const entered = await shiftTabIntoToolbar();
+  await press.ShiftTab();
+  expect(q.button("Before")).toHaveFocus();
+  await press.Tab();
+  expect(entered).toHaveFocus();
+  // The right arrow moves to the other remaining button, wrapping around when
+  // needed, and never back to the removed one.
+  const other =
+    entered === q.button("Bold") ? q.button("Underline") : q.button("Bold");
+  await press.ArrowRight();
+  expect(other).toHaveFocus();
+});
+
+test("focus returned to the toolbar is visible", async () => {
+  onTestFinished(setup());
+
+  await removeActiveItem();
+  // The button clicked with the mouse is not drawn as focused.
+  expect(q.button("Toggle Italic")).not.toHaveAttribute("data-focus-visible");
+  const entered = await shiftTabIntoToolbar();
+  expect(entered).toHaveAttribute("data-focus-visible");
+});
