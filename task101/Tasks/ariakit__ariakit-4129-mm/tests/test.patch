+// https://github.com/ariakit/ariakit/issues/3232
+import { press, q } from "@ariakit/test";
+
+function setup() {
+  const before = document.createElement("button");
+  before.textContent = "Before";
+  const after = before.cloneNode() as HTMLButtonElement;
+  after.textContent = "After";
+  document.body.prepend(before);
+  document.body.append(after);
+  return () => {
+    before.remove();
+    after.remove();
+  };
+}
+
+// Tabs into the toolbar, out of it and back into it. Returns the toolbar
+// button that received focus.
+async function enterLeaveAndReenter() {
+  await press.Tab();
+  expect(q.button("Before")).toHaveFocus();
+  await press.Tab();
+  // Tabbing forward enters the toolbar on one of its enabled buttons.
+  const entered = document.activeElement as HTMLElement;
+  expect([q.button("Italic"), q.button("Underline")]).toContain(entered);
+  await press.Tab();
+  expect(q.button("After")).toHaveFocus();
+  await press.ShiftTab();
+  expect(entered).toHaveFocus();
+  return entered;
+}
+
+test("toolbar is still accessible with disabled activeId", async () => {
+  onTestFinished(setup());
+
+  await enterLeaveAndReenter();
+});
+
+test("arrow keys skip the disabled button when wrapping around", async () => {
+  onTestFinished(setup());
+
+  const entered = await enterLeaveAndReenter();
+  // The arrow keys cycle through the enabled buttons, wrapping around past the
+  // disabled first button in both directions.
+  const other =
+    entered === q.button("Italic") ? q.button("Underline") : q.button("Italic");
+  await press.ArrowRight();
+  expect(other).toHaveFocus();
+  await press.ArrowRight();
+  expect(entered).toHaveFocus();
+  await press.ArrowLeft();
+  expect(other).toHaveFocus();
+});
