+/**
+ * Jest configuration — synthetic test only, added by test.patch.
+ * Not used in production builds (vue-cli-service is the build tool).
+ *
+ * Stack: jest@27 + custom vue-script-transformer + babel-jest + jsdom
+ *
+ * Key choices:
+ *  - moduleFileExtensions: must include 'vue' so @/foo/Bar resolves to Bar.vue
+ *    when no explicit extension is given (jest's default list omits 'vue').
+ *  - Custom .vue transformer: extracts <script> + compiles <template> to a
+ *    render function via vue-template-compiler (already in node_modules).
+ *    Avoids the vue-jest@4/jest@27 getCacheKey API incompatibility.
+ *  - moduleNameMapper: maps @/ to <rootDir>/src/ (matching webpack alias).
+ *  - transformIgnorePatterns: only exclude node_modules, so /javascripts/
+ *    is transformed by babel-jest (wordShift.js uses ES module syntax).
+ *  - testMatch: scoped to exactly the synthetic reactivity spec.
+ */
+module.exports = {
+  testEnvironment: "jsdom",
+  // 'vue' must appear here or @/components/CustomizeableTooltip won't resolve to .vue
+  moduleFileExtensions: ["js", "jsx", "json", "vue"],
+  transform: {
+    "^.+\\.vue$":
+      "<rootDir>/src/components/tabs/celestial-pelle/__tests__/vue-script-transformer.js",
+    "^.+\\.js$": [
+      "babel-jest",
+      {
+        presets: [["@babel/preset-env", { targets: { node: "current" } }]],
+        configFile: false,
+        babelrc: false,
+      },
+    ],
+  },
+  moduleNameMapper: {
+    "^@/(.*)$": "<rootDir>/src/$1",
+  },
+  transformIgnorePatterns: ["/node_modules/"],
+  testMatch: [
+    "**/src/components/tabs/celestial-pelle/__tests__/PelleRiftBar.reactivity.spec.js",
+  ],
+};
diff --git a/src/components/tabs/celestial-pelle/__tests__/PelleRiftBar.reactivity.spec.js b/src/components/tabs/celestial-pelle/__tests__/PelleRiftBar.reactivity.spec.js
