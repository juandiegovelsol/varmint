index 0000000..29a85a0
--- /dev/null
+++ b/src/components/tabs/celestial-pelle/__tests__/vue-script-transformer.js
@@ -0,0 +1,71 @@
+/**
+ * Minimal Vue SFC transformer for jest@27.
+ * - Parses the SFC with vue-template-compiler's parseComponent (handles nested
+ *   <template> blocks correctly, e.g. named slots).
+ * - Transpiles the <script> block via @babel/core (already in devDeps).
+ * - Compiles the <template> block to render/staticRenderFns and attaches them
+ *   to the exported component options, so components can be truly mounted in
+ *   jsdom and their rendered output asserted (behavioral testing).
+ * Avoids the vue-jest@4/jest@27 getCacheKey API incompatibility.
+ */
+"use strict";
+
+const babel = require("@babel/core");
+const crypto = require("crypto");
+const compiler = require("vue-template-compiler");
+
+const CACHE_SALT = "v3-template-newfn";
+
+module.exports = {
+  process(sourceText, sourcePath) {
+    const parsed = compiler.parseComponent(sourceText, { pad: false });
+    const scriptContent =
+      parsed.script && parsed.script.content
+        ? parsed.script.content.trim()
+        : "export default {}";
+
+    const result = babel.transformSync(scriptContent, {
+      filename: sourcePath.replace(/\.vue$/, ".js"),
+      presets: [
+        ["@babel/preset-env", { targets: { node: "current" }, modules: "commonjs" }],
+      ],
+      configFile: false,
+      babelrc: false,
+    });
+
+    let code = result ? result.code : scriptContent;
+
+    if (parsed.template && parsed.template.content) {
+      const compiled = compiler.compile(parsed.template.content, {
+        whitespace: "condense",
+      });
+      if (!compiled.errors || compiled.errors.length === 0) {
+        // Render code uses with(this){...}; forbidden in strict mode (babel
+        // emits "use strict"). new Function bodies are sloppy-mode, so build
+        // the render functions at runtime from the compiled source strings.
+        const staticFns = compiled.staticRenderFns
+          .map(fn => `new Function(${JSON.stringify(fn)})`)
+          .join(",");
+        code +=
+          "\n;(function () {" +
+          "var __opts = module.exports && module.exports.__esModule" +
+          " ? module.exports.default : module.exports;" +
+          "if (__opts) {" +
+          `__opts.render = new Function(${JSON.stringify(compiled.render)});` +
+          `__opts.staticRenderFns = [${staticFns}];` +
+          "__opts._compiled = true;" +
+          "}" +
+          "})();";
+      }
+    }
+
+    return { code };
+  },
+
+  getCacheKey(sourceText, sourcePath) {
+    return crypto
+      .createHash("md5")
+      .update(CACHE_SALT + "|" + sourceText + "|" + sourcePath)
+      .digest("hex");
+  },
+};
