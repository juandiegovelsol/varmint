+"""Behavioural tests for unsetting/setting an adoptive parent.
+
+The Clan family tree is rebuilt from scratch every time an adoption is added or
+removed.  These tests drive only the public entry points a player reaches from
+the "choose adoptive parent" screen -- ``Cat.unset_adoptive_parent`` and
+``Cat.set_adoptive_parent`` -- and assert on the resulting family tree through
+``Inheritance``'s public dictionaries and ``get_cat_info``.  No private helper
+is named and no source text is inspected, so any implementation that satisfies
+the contract passes.
+"""
+
+import os
+import random
+import unittest
+
+os.environ["SDL_VIDEODRIVER"] = "dummy"
+os.environ["SDL_AUDIODRIVER"] = "dummy"
+
+from scripts.cat.cats import Cat
+from scripts.cat_relations.inheritance import Inheritance
+
+SEED = 48374837
+
+
+class _FamilyTreeTestCase(unittest.TestCase):
+    """Shared fixture helpers.  Every test builds its own isolated Clan."""
+
+    def setUp(self):
+        random.seed(SEED)
+        # Cat and Inheritance both keep process-wide registries; a stale entry
+        # from another test would silently change the family tree under test.
+        Cat.all_cats.clear()
+        Cat.all_cats_list.clear()
+        Cat.outside_cats.clear()
+        Inheritance.all_inheritances.clear()
+
+    # ---------------------------------------------------------------- helpers
+    def make_cat(self, prefix, suffix, moons, **kwargs):
+        """A cat with a deterministic, human-readable name."""
+        cat = Cat(moons=moons, disable_random=True, **kwargs)
+        cat.name.prefix = prefix
+        cat.name.suffix = suffix
+        return cat
+
+    @staticmethod
+    def build_tree(cats):
+        """Give every cat its inheritance, the way the game does on load."""
+        for cat in cats:
+            cat.create_inheritance_new_cat()
+
+    def unset_parent(self, child, parent):
+        """Unset an adoptive parent, failing loudly instead of erroring out."""
+        try:
+            child.unset_adoptive_parent(parent)
+        except Exception as exc:  # noqa: BLE001 - the defect under test
+            self.fail(
+                "unsetting {} as an adoptive parent of {} raised {}: {}".format(
+                    parent.name, child.name, type(exc).__name__, exc
+                )
+            )
+
+    def set_parent(self, child, parent):
+        """Set an adoptive parent, failing loudly instead of erroring out."""
+        try:
+            child.set_adoptive_parent(parent)
+        except Exception as exc:  # noqa: BLE001 - the defect under test
+            self.fail(
+                "setting {} as an adoptive parent of {} raised {}: {}".format(
+                    parent.name, child.name, type(exc).__name__, exc
+                )
+            )
+
+    @staticmethod
+    def notes_about(cat, other):
+        """Everything the family tree of ``cat`` says about ``other``."""
+        info = cat.inheritance.get_cat_info(other.ID)
+        return " | ".join(info["additional"])
+
+    # ------------------------------------------------------- shared scenarios
+    def two_route_grandparent(self, names):
+        """A cat who is a grandparent of the same kit by two different routes.
+
+        ``elder`` is the adoptive parent of ``adopted`` and the blood parent of
+        ``born``; ``grandkit`` is the kit of both, so ``elder`` reaches the
+        grandkit through an adoption *and* through blood.
+        """
+        elder = self.make_cat(names[0][0], names[0][1], 100)
+        adopted = self.make_cat(names[1][0], names[1][1], 40)
+        adopted.adoptive_parents.append(elder.ID)
+        born = self.make_cat(names[2][0], names[2][1], 40, parent1=elder.ID)
+        grandkit = self.make_cat(
+            names[3][0], names[3][1], 4, parent1=adopted.ID, parent2=born.ID
+        )
+        self.build_tree([elder, adopted, born, grandkit])
+        # sanity: the fixture really is the shape the test needs
+        self.assertIn(grandkit.ID, elder.inheritance.grand_kits)
+        self.assertIn(elder.ID, grandkit.inheritance.grand_parents)
+        return elder, adopted, born, grandkit
+
+    def assert_adoption_is_gone(self, child, ex_parent):
+        """The contract every unset must satisfy, whatever route it takes."""
+        self.assertNotIn(
+            ex_parent.ID,
+            child.adoptive_parents,
+            "the ex-parent is still recorded on the kit",
+        )
+        self.assertNotIn(
+            ex_parent.ID,
+            child.inheritance.parents,
+            "the kit's family tree still lists the ex-parent as a parent",
+        )
+        self.assertNotIn(
+            child.ID,
+            ex_parent.inheritance.kits,
+            "the ex-parent's family tree still lists the kit as their kit",
+        )
+
+
+class UnsetAdoptiveParentOfAGrandparent(_FamilyTreeTestCase):
+    """f2p — the reported crash and the bookkeeping it was supposed to do."""
+
+    PALETTE_A = [("Sand", "buzz"), ("Warm", "shadow"), ("Snowy", "speckle"), ("Cress", "kit")]
+    PALETTE_B = [("Ivy", "storm"), ("Dusk", "pelt"), ("Ember", "roar"), ("Moss", "kit")]
+
+    def test_unsetting_the_adoption_of_a_grandparents_kit_survives(self):
+        elder, adopted, born, grandkit = self.two_route_grandparent(self.PALETTE_A)
+        self.unset_parent(adopted, elder)
+        self.assert_adoption_is_gone(adopted, elder)
+        # the untouched half of the family is still intact
+        self.assertIn(born.ID, elder.inheritance.kits)
+        self.assertIn(grandkit.ID, elder.inheritance.grand_kits)
+
+    def test_the_grandkit_tree_forgets_the_route_through_the_adoption(self):
+        elder, adopted, born, grandkit = self.two_route_grandparent(self.PALETTE_A)
+        before = self.notes_about(grandkit, elder)
+        self.assertIn(str(adopted.name), before)
+
+        self.unset_parent(adopted, elder)
+
+        notes = self.notes_about(grandkit, elder)
+        self.assertIn(
+            elder.ID,
+            grandkit.inheritance.grand_parents,
+            "the elder is still a blood grandparent and must stay in the tree",
+        )
+        self.assertIn(
+            str(born.name),
+            notes,
+            "the surviving blood route to the grandkit was lost",
+        )
+        self.assertNotIn(
+            str(adopted.name),
+            notes,
+            "the grandkit's tree still claims the elder is a grandparent "
+            "through an adoption that was removed",
+        )
+
+    def test_a_second_family_palette_unsets_the_same_way(self):
+        elder, adopted, born, grandkit = self.two_route_grandparent(self.PALETTE_B)
+        self.unset_parent(adopted, elder)
+        self.assert_adoption_is_gone(adopted, elder)
+        notes = self.notes_about(grandkit, elder)
+        self.assertIn(str(born.name), notes)
+        self.assertNotIn(str(adopted.name), notes)
+
+
+class AdoptionChangesOnCatsWithGrandkits(_FamilyTreeTestCase):
+    """f2p — the second, independent scenario: the cat losing/gaining the
+    adoptive parent is itself a grandparent."""
+
+    def build_elder_with_grandkits(self, adopted=False):
+        other = self.make_cat("Frost", "gaze", 130)
+        elder = self.make_cat("Birch", "fang", 80)
+        if adopted:
+            elder.adoptive_parents.append(other.ID)
+        elder_mate = self.make_cat("Reed", "whisker", 80)
+        elder.mate.append(elder_mate.ID)
+        elder_mate.mate.append(elder.ID)
+        kit = self.make_cat("Hazel", "leap", 30, parent1=elder.ID, parent2=elder_mate.ID)
+        grandkit = self.make_cat("Pebble", "kit", 3, parent1=kit.ID)
+        # the elder's tree is built before the grandkit's, exactly as the game
+        # does on load, so the fixture itself never walks the defective branch
+        self.build_tree([other, elder, elder_mate, kit, grandkit])
+        self.assertIn(grandkit.ID, elder.inheritance.grand_kits)
+        return other, elder, kit, grandkit
+
+    def test_an_elder_with_grandkits_can_lose_an_adoptive_parent(self):
+        old_parent, elder, kit, grandkit = self.build_elder_with_grandkits(adopted=True)
+        self.assertIn(old_parent.ID, elder.inheritance.parents)
+
+        self.unset_parent(elder, old_parent)
+
+        self.assert_adoption_is_gone(elder, old_parent)
+        # the elder's own descendants are untouched by the change
+        self.assertIn(kit.ID, elder.inheritance.kits)
+        self.assertIn(grandkit.ID, elder.inheritance.grand_kits)
+        self.assertIn(elder.ID, grandkit.inheritance.grand_parents)
+        self.assertIn(str(kit.name), self.notes_about(grandkit, elder))
+
+    def test_an_elder_with_grandkits_can_gain_an_adoptive_parent(self):
+        new_parent, elder, kit, grandkit = self.build_elder_with_grandkits()
+
+        self.set_parent(elder, new_parent)
+
+        self.assertIn(new_parent.ID, elder.adoptive_parents)
+        self.assertIn(new_parent.ID, elder.inheritance.parents)
+        self.assertIn(kit.ID, elder.inheritance.kits)
+        self.assertIn(grandkit.ID, elder.inheritance.grand_kits)
+
+
+class AdoptionNeighbourhood(_FamilyTreeTestCase):
+    """p2p — the family-tree paths around the fix, which must not change."""
+
+    def build_plain_family(self):
+        """No grandkits anywhere: the ordinary adoption the game does daily."""
+        bio = self.make_cat("Fern", "song", 60)
+        adopter = self.make_cat("Stone", "claw", 60)
+        second_adopter = self.make_cat("Rain", "flight", 60)
+        kit = self.make_cat("Thistle", "kit", 3, parent1=bio.ID)
+        kit.adoptive_parents.extend([adopter.ID, second_adopter.ID])
+        self.build_tree([bio, adopter, second_adopter, kit])
+        return bio, adopter, second_adopter, kit
+
+    def test_a_plain_adoption_can_be_unset(self):
+        bio, adopter, second_adopter, kit = self.build_plain_family()
+        self.unset_parent(kit, adopter)
+        self.assert_adoption_is_gone(kit, adopter)
+
+    def test_the_blood_parent_survives_an_unset(self):
+        bio, adopter, second_adopter, kit = self.build_plain_family()
+        self.unset_parent(kit, adopter)
+        self.assertIn(bio.ID, kit.inheritance.parents)
+        self.assertIn(kit.ID, bio.inheritance.kits)
+
+    def test_the_other_adoptive_parent_survives_an_unset(self):
+        bio, adopter, second_adopter, kit = self.build_plain_family()
+        self.unset_parent(kit, adopter)
+        self.assertIn(second_adopter.ID, kit.adoptive_parents)
+        self.assertIn(second_adopter.ID, kit.inheritance.parents)
+        self.assertIn(kit.ID, second_adopter.inheritance.kits)
+
+    def test_a_plain_adoption_can_be_set(self):
+        bio, adopter, second_adopter, kit = self.build_plain_family()
+        newcomer = self.make_cat("Lark", "step", 60)
+        newcomer.create_inheritance_new_cat()
+        self.set_parent(kit, newcomer)
+        self.assertIn(newcomer.ID, kit.adoptive_parents)
+        self.assertIn(newcomer.ID, kit.inheritance.parents)
+        self.assertIn(kit.ID, newcomer.inheritance.kits)
+
+    def test_grandparents_of_a_bystander_kit_are_not_duplicated(self):
+        """An unset elsewhere in the family must not rewrite this kit's
+        grandparent entries -- neither dropping nor duplicating them."""
+        gran = self.make_cat("Willow", "breeze", 120)
+        grandsire = self.make_cat("Oak", "heart", 120)
+        bio = self.make_cat("Cloud", "dapple", 55, parent1=gran.ID, parent2=grandsire.ID)
+        adopter = self.make_cat("Silver", "nose", 55)
+        kit = self.make_cat("Bramble", "kit", 2, parent1=bio.ID)
+        kit.adoptive_parents.append(adopter.ID)
+        self.build_tree([gran, grandsire, bio, adopter, kit])
+
+        self.unset_parent(kit, adopter)
+
+        grand_parents = kit.inheritance.grand_parents
+        self.assertEqual({gran.ID, grandsire.ID}, set(grand_parents))
+        for grand in (gran, grandsire):
+            self.assertEqual(
+                1,
+                len(grand_parents[grand.ID]["additional"]),
+                "the grandparent entry was rebuilt more than once",
+            )
+            self.assertIn(str(bio.name), grand_parents[grand.ID]["additional"][0])
+
+    def test_a_blood_family_tree_spans_three_generations(self):
+        gran = self.make_cat("Aspen", "tail", 120)
+        grandsire = self.make_cat("Flint", "stripe", 120)
+        parent = self.make_cat("Wish", "drizzle", 50, parent1=gran.ID, parent2=grandsire.ID)
+        grandkit = self.make_cat("Poppy", "kit", 4, parent1=parent.ID)
+        self.build_tree([gran, grandsire, parent, grandkit])
+
+        self.assertEqual({gran.ID, grandsire.ID}, set(grandkit.inheritance.grand_parents))
+        self.assertIn(grandkit.ID, gran.inheritance.grand_kits)
+        self.assertIn(grandkit.ID, grandsire.inheritance.grand_kits)
+        self.assertIn(str(parent.name), self.notes_about(grandkit, gran))
+
+    def test_mate_bookkeeping_survives_the_birth_of_a_kit(self):
+        one = self.make_cat("Nettle", "wing", 50)
+        two = self.make_cat("Alder", "bloom", 50)
+        one.mate.append(two.ID)
+        two.mate.append(one.ID)
+        firstborn = self.make_cat("Minnow", "paw", 8, parent1=one.ID, parent2=two.ID)
+        self.build_tree([one, two, firstborn])
+
+        newborn = self.make_cat("Dawn", "kit", 0, parent1=one.ID, parent2=two.ID)
+        newborn.create_inheritance_new_cat()
+
+        self.assertIn(two.ID, one.inheritance.mates)
+        self.assertIn(one.ID, two.inheritance.mates)
+        self.assertEqual({firstborn.ID, newborn.ID}, set(one.inheritance.kits))
+        self.assertEqual({firstborn.ID, newborn.ID}, set(two.inheritance.kits))
+        self.assertIn(firstborn.ID, newborn.inheritance.siblings)
+
+    def test_a_cat_with_no_parents_has_an_empty_family_tree(self):
+        loner = self.make_cat("Sky", "wander", 30)
+        self.build_tree([loner])
+        tree = loner.inheritance
+        self.assertEqual({}, tree.parents)
+        self.assertEqual({}, tree.grand_parents)
+        self.assertEqual({}, tree.kits)
+        self.assertEqual({}, tree.grand_kits)
+        self.assertEqual([], tree.all_involved)
+        try:
+            tree.update_all_related_inheritance()
+        except Exception as exc:  # noqa: BLE001
+            self.fail(
+                "updating the family tree of a parentless cat raised {}: {}".format(
+                    type(exc).__name__, exc
+                )
+            )
+
+    def test_removing_a_parent_who_was_never_set_is_a_no_op(self):
+        loner = self.make_cat("Juniper", "gale", 30)
+        stranger = self.make_cat("Quiet", "fall", 30)
+        self.build_tree([loner, stranger])
+        try:
+            loner.inheritance.remove_parent(stranger)
+        except Exception as exc:  # noqa: BLE001
+            self.fail(
+                "removing a parent that was never set raised {}: {}".format(
+                    type(exc).__name__, exc
+                )
+            )
+        self.assertEqual({}, loner.inheritance.parents)
+        self.assertEqual({"additional": [], "type": []}, loner.inheritance.get_cat_info(stranger.ID))
+
+
+if __name__ == "__main__":
+    unittest.main()
