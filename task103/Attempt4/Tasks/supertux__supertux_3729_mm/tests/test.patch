+(supertux-level
+  (version 3)
+  (name (_ "Harvest HeavyCoin Burst Test"))
+  (author "harvest-step3")
+  (license "CC0")
+  (suppress-pause-menu #t)
+  (sector
+    (name "main")
+    (init-script "local X0 = 2256;\nlocal LIMIT = 4432;\nfunction park() { Tux.set_pos(64, 64); }\nfunction sweep(name, a, b) {\n  local before = Tux.get_coins();\n  for (local cx = a; cx <= b; cx += 16) {\n    Tux.set_pos(cx - 16, 440);\n    wait(0.02);\n  }\n  park();\n  wait(0.05);\n  print(\"ZONE \" + name + \" \" + (Tux.get_coins() - before) + \"\\n\");\n}\nsector.settings.add_object(\"bonusblock\", \"burstblock\", 2240.0, 352.0, \"auto\", \"(contents \\\"explode\\\")\");\nwait(0.3);\nTux.do_jump(-800);\nwait(0.3);\npark();\nprint(\"BURST_PARKED \" + Tux.get_coins() + \"\\n\");\nwait(8.0);\nsweep(\"center\", X0 - 64, X0 + 64);\nsweep(\"left_in\", X0 - 1000, X0 - 80);\nsweep(\"right_in\", X0 + 80, X0 + 1000);\nsweep(\"left_out\", 48, X0 - 1016);\nsweep(\"right_out\", X0 + 1016, LIMIT);\nprint(\"BURST_DONE\\n\");\n")
+    (ambient-light (color 1 1 1))
+    (gradient (top_color 0.5 0.6 0.9)(bottom_color 0.3 0.3 0.7))
+    (spawnpoint (name "main")(x 2240)(y 448))
+    (tilemap (solid #t)(z-pos 0)(width 140)(height 20)(tiles -141 48 -4 0 48 -133 0 -2 48 -4 0 48 -133 0 -2 48 -4 0 48 -133 0 -7 48 -133 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -701 48))
+  )
+)
