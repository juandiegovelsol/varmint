+namespace {
+
+// Maximum speed at which a heavy coin sinks through water (pixels/second).
+const float WATER_SINK_SPEED = 100.0f;
+// Gravity is weaker under water, so coins accelerate gently up to the sink speed.
+const float WATER_GRAVITY_MODIFIER = 0.3f;
+// Exponential drag applied to motion that isn't sinking (per second).
+const float WATER_DRAG = 4.0f;
+
+} // namespace
+
 void
 HeavyCoin::update(float dt_sec)
 {
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  m_physic.set_gravity_modifier(in_water ? WATER_GRAVITY_MODIFIER : 1.0f);
+
   // Enable physics.
-  m_col.set_movement(m_physic.get_movement(dt_sec));
+  Vector movement = m_physic.get_movement(dt_sec);
+
+  if (in_water)
+  {
+    // Water slows the coin down, however fast it entered: horizontal motion and
+    // motion against gravity are damped, and sinking is capped to a slow drift.
+    const float gravity = Sector::get().get_gravity();
+    const float down = (gravity < 0.0f) ? -1.0f : 1.0f;
+    const float damping = std::exp(-WATER_DRAG * dt_sec);
+
+    float vx = m_physic.get_velocity_x() * damping;
+    float vy_down = m_physic.get_velocity_y() * down;
+    if (vy_down < 0.0f)
+      vy_down *= damping;
+    else if (vy_down > WATER_SINK_SPEED)
+      vy_down = WATER_SINK_SPEED;
+
+    m_physic.set_velocity(vx, vy_down * down);
+    movement = m_physic.get_velocity() * dt_sec;
+  }
+
+  m_col.set_movement(movement);
 }
 
