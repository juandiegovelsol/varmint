 void
 HeavyCoin::update(float dt_sec)
 {
+  // Coins are slowed down by water: they lose most of their momentum and
+  // drift down slowly, no matter how fast they entered it.
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  if (in_water)
+  {
+    m_physic.set_gravity_modifier(WATER_GRAVITY_MODIFIER);
+    m_physic.set_velocity_x(math::clamp(m_physic.get_velocity_x(), -WATER_MAX_SPEED_X, WATER_MAX_SPEED_X));
+    m_physic.set_velocity_y(math::clamp(m_physic.get_velocity_y(), -WATER_MAX_SINK_SPEED, WATER_MAX_SINK_SPEED));
+  }
+  else
+  {
+    m_physic.set_gravity_modifier(1.0f);
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
+
+  if (in_water)
+  {
+    // Keep the velocity capped after gravity has been applied as well.
+    m_physic.set_velocity_y(math::clamp(m_physic.get_velocity_y(), -WATER_MAX_SINK_SPEED, WATER_MAX_SINK_SPEED));
+  }
 }
 
