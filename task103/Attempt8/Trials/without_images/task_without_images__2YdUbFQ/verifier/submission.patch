+  // Coins sink slowly through water instead of falling at full speed.
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  m_physic.set_gravity_modifier(in_water ? 0.2f : 1.f);
+  if (in_water && m_physic.get_velocity_y() > 100.f)
+    m_physic.set_velocity_y(100.f);
