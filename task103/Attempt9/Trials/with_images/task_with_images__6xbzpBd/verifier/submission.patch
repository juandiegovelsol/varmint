@@ -23,6 +23,7 @@
 #include "object/camera.hpp"
 #include "object/player.hpp"
 #include "object/tilemap.hpp"
+#include "supertux/tile.hpp"
 #include "supertux/flip_level_transformer.hpp"
 #include "supertux/level.hpp"
 #include "supertux/sector.hpp"
@@ -273,13 +274,23 @@ HeavyCoin::HeavyCoin(const ReaderMapping& reader, bool count_stats) :
 void
 HeavyCoin::update(float dt_sec)
 {
-  // A coin that has dropped out of sight below the playfield is lost.
-  if (get_bbox().get_top() > Sector::get().get_camera().get_rect().get_bottom())
+  // A coin that has fallen out of the sector is lost.
+  if (get_bbox().get_top() > Sector::get().get_height())
   {
     remove_me();
     return;
   }
 
+  // Coins drift down slowly in water.
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  m_physic.set_gravity_modifier(in_water ? 0.2f : 1.f);
+  if (in_water)
+  {
+    const float max_sink_speed = 80.f;
+    if (m_physic.get_velocity_y() > max_sink_speed)
+      m_physic.set_velocity_y(max_sink_speed);
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
 }
