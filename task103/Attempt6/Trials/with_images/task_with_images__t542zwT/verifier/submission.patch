@@ -272,6 +275,22 @@ HeavyCoin::HeavyCoin(const ReaderMapping& reader, bool count_stats) :
 void
 HeavyCoin::update(float dt_sec)
 {
+  // Coins in water sink slowly instead of falling at full speed.
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  if (in_water)
+  {
+    // Water slows the coin down and makes it sink gently.
+    const float drag = std::max(0.f, 1.f - 3.f * dt_sec);
+    m_physic.set_gravity_modifier(0.2f);
+    m_physic.set_velocity(m_physic.get_velocity() * drag);
+    if (m_physic.get_velocity_y() > 60.f)
+      m_physic.set_velocity_y(60.f);
+  }
+  else
+  {
+    m_physic.set_gravity_modifier(1.f);
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
 }
