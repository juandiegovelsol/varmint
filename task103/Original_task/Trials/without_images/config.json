{
    "job_name": "without_images",
    "jobs_dir": "/app/build/trials/nv_c3",
    "n_attempts": 3,
    "n_concurrent_trials": 3,
    "quiet": true,
    "retry": {
        "max_retries": 2,
        "exclude_exceptions": [
            "OutputTokenExceededError",
            "AgentTimeoutError",
            "ContextWindowExceededError"
        ]
    },
    "environment": {
        "type": "docker",
        "extra_docker_compose": [
            "/app/build/trials/nv_c3/egress_hosts.yaml"
        ]
    },
    "agents": [
        {
            "name": "claude-code",
            "model_name": "claude-opus-5-5",
            "skip_model_parsing": true,
            "extra_allowed_hosts": [
                "litellm-proxy.ml.scale.com"
            ],
            "kwargs": {
                "disallowed_tools": "WebFetch,WebSearch"
            },
            "env": {
                "API_FORCE_IDLE_TIMEOUT": "0",
                "CLAUDE_ENABLE_STREAM_WATCHDOG": "0",
                "CLAUDE_ENABLE_BYTE_WATCHDOG": "0",
                "CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS": "5400000"
            }
        }
    ],
    "tasks": [
        {
            "path": "/app/build/trials/nv_c3/task_without_images"
        }
    ]
}