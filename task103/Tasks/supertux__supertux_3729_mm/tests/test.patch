diff --git a/tests/integration/heavycoin_repeat_test.stl b/tests/integration/heavycoin_repeat_test.stl
new file mode 100644
index 000000000..e6251e9a0
--- /dev/null
+++ b/tests/integration/heavycoin_repeat_test.stl
@@ -0,0 +1,40 @@
+(supertux-level
+  (version 3)
+  (name (_ "Harvest HeavyCoin Repeat Burst Test"))
+  (author "harvest-step3")
+  (license "CC0")
+  (suppress-pause-menu #t)
+  (sector
+    (name "main")
+    (init-script "local XA = 1024;
+local XB = 3200;
+function park() { Tux.set_pos(64, 64); }
+function bump(x) { Tux.set_pos(x, 448); wait(0.3); Tux.do_jump(-800); wait(0.3); park(); }
+function sweep(name, a, b) {
+  local before = Tux.get_coins();
+  for (local cx = a; cx <= b; cx += 16) {
+    Tux.set_pos(cx - 16, 440);
+    wait(0.02);
+  }
+  park();
+  wait(0.05);
+  print(\"RZONE \" + name + \" \" + (Tux.get_coins() - before) + \"\\n\");
+}
+sector.settings.add_object(\"bonusblock\", \"blocka\", XA, 352.0, \"auto\", \"(contents \\\"explode\\\")\");
+sector.settings.add_object(\"bonusblock\", \"blockb\", XB, 352.0, \"auto\", \"(contents \\\"explode\\\")\");
+wait(0.3);
+bump(XA);
+wait(3.0);
+bump(XB);
+print(\"REPEAT_PARKED \" + Tux.get_coins() + \"\\n\");
+wait(8.0);
+sweep(\"first\", XA + 16 - 1000, XA + 16 + 1000);
+sweep(\"second\", XB + 16 - 1000, XB + 16 + 1000);
+print(\"REPEAT_DONE\\n\");
+")
+    (ambient-light (color 1 1 1))
+    (gradient (top_color 0.5 0.6 0.9)(bottom_color 0.3 0.3 0.7))
+    (spawnpoint (name "main")(x 1024)(y 448))
+    (tilemap (solid #t)(z-pos 0)(width 140)(height 20)(tiles -6 48 -133 0 -2 48 -4 0 48 -133 0 -2 48 -4 0 48 -133 0 -2 48 -4 0 48 -133 0 -7 48 -133 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -2 48 -138 0 -701 48))
+  )
+)
