 #include "audio/sound_manager.hpp"
 #include "audio/sound_source.hpp"
 #include "editor/editor.hpp"
@@ -272,6 +275,23 @@ HeavyCoin::HeavyCoin(const ReaderMapping& reader, bool count_stats) :
 void
 HeavyCoin::update(float dt_sec)
 {
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  m_physic.set_gravity_modifier(in_water ? 0.2f : 1.f);
+
+  if (in_water)
+  {
+    // Water slows the coin down: it drifts down slowly no matter how fast it
+    // entered the water.
+    const float max_sink_speed = 60.f;
+    const float drag = std::exp(-4.f * dt_sec);
+
+    m_physic.set_velocity_x(m_physic.get_velocity_x() * drag);
+    float vy = m_physic.get_velocity_y();
+    if (vy < 0.f)
+      vy *= drag;
+    m_physic.set_velocity_y(std::min(vy, max_sink_speed));
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
 }
