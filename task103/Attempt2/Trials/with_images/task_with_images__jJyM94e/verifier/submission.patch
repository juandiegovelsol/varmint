@@ -272,6 +274,21 @@ HeavyCoin::HeavyCoin(const ReaderMapping& reader, bool count_stats) :
 void
 HeavyCoin::update(float dt_sec)
 {
+  // Coins in water sink slowly, regardless of how fast they entered it.
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  if (in_water)
+  {
+    const float max_sink_speed = 50.0f;
+    const float max_horizontal_speed = 30.0f;
+    m_physic.set_gravity_modifier(0.1f);
+    m_physic.set_velocity_x(math::clamp(m_physic.get_velocity_x(), -max_horizontal_speed, max_horizontal_speed));
+    m_physic.set_velocity_y(math::clamp(m_physic.get_velocity_y(), -max_sink_speed, max_sink_speed));
+  }
+  else
+  {
+    m_physic.set_gravity_modifier(1.0f);
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
 }
