 #include "editor/editor.hpp"
@@ -25,6 +27,7 @@
 #include "supertux/flip_level_transformer.hpp"
 #include "supertux/level.hpp"
 #include "supertux/sector.hpp"
+#include "supertux/tile.hpp"
 #include "util/reader_mapping.hpp"
 #include "util/writer.hpp"
 
@@ -272,6 +275,25 @@ HeavyCoin::HeavyCoin(const ReaderMapping& reader, bool count_stats) :
 void
 HeavyCoin::update(float dt_sec)
 {
+  // Coins in water sink slowly: reduced gravity, drag, and a capped sinking
+  // speed, so they drift down no matter how fast they entered the water.
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  if (in_water)
+  {
+    static const float WATER_DRAG = 3.0f;       // Velocity damping per second.
+    static const float MAX_SINK_SPEED = 60.0f;  // Max downward speed in water.
+
+    m_physic.set_gravity_modifier(0.2f);
+    const float damping = std::exp(-WATER_DRAG * dt_sec);
+    m_physic.set_velocity(m_physic.get_velocity() * damping);
+    if (m_physic.get_velocity_y() > MAX_SINK_SPEED)
+      m_physic.set_velocity_y(MAX_SINK_SPEED);
+  }
+  else
+  {
+    m_physic.set_gravity_modifier(1.0f);
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
 }
