@@ -272,6 +275,32 @@ HeavyCoin::HeavyCoin(const ReaderMapping& reader, bool count_stats) :
 void
 HeavyCoin::update(float dt_sec)
 {
+  // In water, coins are slowed down and sink slowly, regardless of
+  // how fast they were moving when they entered the water.
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  if (in_water)
+  {
+    static const float WATER_GRAVITY_MODIFIER = 0.2f;
+    static const float WATER_DRAG = 3.f;           // Per-second exponential damping.
+    static const float WATER_MAX_SINK_SPEED = 60.f; // Max downward speed in water.
+
+    m_physic.set_gravity_modifier(WATER_GRAVITY_MODIFIER);
+
+    const float damping = std::max(0.f, 1.f - WATER_DRAG * dt_sec);
+    m_physic.set_velocity(m_physic.get_velocity() * damping);
+
+    const float gravity = Sector::get().get_gravity();
+    const float vy = m_physic.get_velocity_y();
+    if (gravity >= 0.f && vy > WATER_MAX_SINK_SPEED)
+      m_physic.set_velocity_y(WATER_MAX_SINK_SPEED);
+    else if (gravity < 0.f && vy < -WATER_MAX_SINK_SPEED)
+      m_physic.set_velocity_y(-WATER_MAX_SINK_SPEED);
+  }
+  else
+  {
+    m_physic.set_gravity_modifier(1.f);
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
 }
