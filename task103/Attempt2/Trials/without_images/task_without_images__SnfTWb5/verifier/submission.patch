@@ -272,6 +275,31 @@ HeavyCoin::HeavyCoin(const ReaderMapping& reader, bool count_stats) :
 void
 HeavyCoin::update(float dt_sec)
 {
+  // Coins that are in water slowly drift down, regardless of how fast
+  // they were moving when they entered the water.
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  if (in_water)
+  {
+    constexpr float WATER_SINK_SPEED = 40.0f;
+    constexpr float WATER_DRAG = 6.0f; // Fraction of excess velocity lost per second.
+
+    const float drag = std::min(1.0f, WATER_DRAG * dt_sec);
+
+    m_physic.enable_gravity(false);
+    m_physic.set_velocity_x(m_physic.get_velocity_x() * (1.0f - drag));
+
+    float vy = m_physic.get_velocity_y();
+    if (vy > WATER_SINK_SPEED)
+      vy = WATER_SINK_SPEED;
+    else
+      vy += (WATER_SINK_SPEED - vy) * drag;
+    m_physic.set_velocity_y(vy);
+  }
+  else
+  {
+    m_physic.enable_gravity(true);
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
 }
