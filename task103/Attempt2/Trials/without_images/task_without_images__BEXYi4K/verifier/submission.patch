 void
 HeavyCoin::update(float dt_sec)
 {
+  // In water, coins sink slowly regardless of how fast they entered it.
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  m_physic.set_gravity_modifier(in_water ? WATER_GRAVITY_MODIFIER : 1.f);
+  if (in_water)
+  {
+    if (m_physic.get_velocity_y() > WATER_MAX_SINK_SPEED)
+      m_physic.set_velocity_y(WATER_MAX_SINK_SPEED);
+    else if (m_physic.get_velocity_y() < -WATER_MAX_SINK_SPEED)
+      m_physic.set_velocity_y(m_physic.get_velocity_y() * (1.f - std::min(1.f, WATER_DRAG * dt_sec)));
+
+    m_physic.set_velocity_x(m_physic.get_velocity_x() * (1.f - std::min(1.f, WATER_DRAG * dt_sec)));
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
 }
