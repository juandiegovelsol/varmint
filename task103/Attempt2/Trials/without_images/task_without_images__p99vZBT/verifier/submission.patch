@@ -272,6 +274,23 @@ HeavyCoin::HeavyCoin(const ReaderMapping& reader, bool count_stats) :
 void
 HeavyCoin::update(float dt_sec)
 {
+  // In water, coins sink slowly regardless of how fast they entered it.
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  if (in_water)
+  {
+    static const float WATER_MAX_SINK_SPEED = 50.0f;
+    static const float WATER_MAX_RISE_SPEED = 50.0f;
+    static const float WATER_MAX_DRIFT_SPEED = 30.0f;
+
+    m_physic.set_gravity_modifier(0.2f);
+    m_physic.set_velocity_x(math::clamp(m_physic.get_velocity_x(), -WATER_MAX_DRIFT_SPEED, WATER_MAX_DRIFT_SPEED));
+    m_physic.set_velocity_y(math::clamp(m_physic.get_velocity_y(), -WATER_MAX_RISE_SPEED, WATER_MAX_SINK_SPEED));
+  }
+  else
+  {
+    m_physic.set_gravity_modifier(1.0f);
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
 }
