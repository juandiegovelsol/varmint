 void
 HeavyCoin::update(float dt_sec)
 {
-  // Enable physics.
-  m_col.set_movement(m_physic.get_movement(dt_sec));
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  if (!in_water)
+  {
+    // Enable physics.
+    m_col.set_movement(m_physic.get_movement(dt_sec));
+    return;
+  }
+
+  // In water, coins drift down slowly at a fixed sinking speed, no matter
+  // how fast they entered the water.
+  const float gravity = Sector::get().get_gravity() * 100.0f * WATER_GRAVITY_MODIFIER;
+  float vy = std::min(m_physic.get_velocity_y() + gravity * dt_sec, WATER_SINK_SPEED);
+  float vx = m_physic.get_velocity_x() * std::exp(-WATER_DRAG * dt_sec);
+  m_physic.set_velocity(vx, vy);
+  m_col.set_movement(Vector(vx, vy) * dt_sec);
 }
 
