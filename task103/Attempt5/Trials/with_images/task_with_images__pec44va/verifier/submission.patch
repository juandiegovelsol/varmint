 /* The following defines a coin subject to gravity. */
+namespace {
+// Maximum downward speed of a coin in water (pixels per second).
+// A coin sinks about 7 tiles (the tallest seaweed) in roughly three seconds.
+const float WATER_SINK_SPEED = 75.0f;
+// Fraction of normal gravity applied to a coin in water.
+const float WATER_GRAVITY_MODIFIER = 0.2f;
+// Exponential damping rate of horizontal velocity in water (1/s).
+const float WATER_DRAG = 2.0f;
+} // namespace
+
