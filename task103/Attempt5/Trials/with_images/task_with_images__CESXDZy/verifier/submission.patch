 HeavyCoin::update(float dt_sec)
 {
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  if (in_water)
+  {
+    m_physic.set_gravity_modifier(WATER_GRAVITY_MODIFIER);
+
+    // Water drag: slow down horizontal and upward motion.
+    const float drag = std::exp(-WATER_DRAG * dt_sec);
+    m_physic.set_velocity_x(m_physic.get_velocity_x() * drag);
+    if (m_physic.get_velocity_y() < 0.0f)
+      m_physic.set_velocity_y(m_physic.get_velocity_y() * drag);
+  }
+  else
+  {
+    m_physic.set_gravity_modifier(1.0f);
+  }
+
