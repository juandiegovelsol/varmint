+
+  // In water, coins always sink slowly, no matter how fast they entered it.
+  if (in_water && m_physic.get_velocity_y() > WATER_SINK_SPEED)
+  {
+    m_physic.set_velocity_y(WATER_SINK_SPEED);
+    movement.y = WATER_SINK_SPEED * dt_sec;
+  }
+
+  m_col.set_movement(movement);
