+namespace {
+
+// Underwater, heavy coins drift down at a constant, slow speed, no matter how
+// fast they entered the water: about 3 seconds to sink past the tallest
+// seaweed (4 tiles = 128px).
+const float WATER_SINK_SPEED = 128.0f / 3.0f;
+// How quickly horizontal motion is damped underwater (per second).
+const float WATER_HORIZONTAL_DRAG = 4.0f;
+
+} // namespace
+
 void
 HeavyCoin::update(float dt_sec)
 {
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+
+  if (in_water)
+  {
+    m_physic.enable_gravity(false);
+    const float gravity = Sector::get().get_gravity();
+    m_physic.set_velocity_y(gravity < 0.0f ? -WATER_SINK_SPEED : WATER_SINK_SPEED);
+    m_physic.set_velocity_x(m_physic.get_velocity_x() *
+                            std::max(0.0f, 1.0f - WATER_HORIZONTAL_DRAG * dt_sec));
+  }
+  else
+  {
+    m_physic.enable_gravity(true);
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
 }
@@ -288,7 +316,9 @@ HeavyCoin::collision_solid(const CollisionHit& hit)
     if (m_physic.get_velocity_y() > 200) {// lets some coins bounce
       m_physic.set_velocity_y(-99);
     } else {
+      // The coin has come to rest on the ground; stop it from sliding.
       m_physic.set_velocity_y(0);
+      m_physic.set_velocity_x(0);
     }
   }
   if (hit.right || hit.left) {
