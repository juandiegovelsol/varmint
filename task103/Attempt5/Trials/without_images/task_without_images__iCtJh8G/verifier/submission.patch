 #include "audio/sound_manager.hpp"
 #include "audio/sound_source.hpp"
 #include "editor/editor.hpp"
@@ -25,6 +27,7 @@
 #include "supertux/flip_level_transformer.hpp"
 #include "supertux/level.hpp"
 #include "supertux/sector.hpp"
+#include "supertux/tile.hpp"
 #include "util/reader_mapping.hpp"
 #include "util/writer.hpp"
 
@@ -272,6 +275,36 @@ HeavyCoin::HeavyCoin(const ReaderMapping& reader, bool count_stats) :
 void
 HeavyCoin::update(float dt_sec)
 {
+  // Coins sink slowly through water, no matter how fast they hit it. The sink
+  // speed is chosen so a coin takes ~3 seconds to sink past a fully grown
+  // seaweed plant (4 tiles = 128px).
+  static const float WATER_SINK_SPEED = 128.0f / 3.0f;
+  // How quickly the water slows down any other motion (1/s).
+  static const float WATER_DRAG = 6.0f;
+
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  if (in_water)
+  {
+    m_physic.enable_gravity(false);
+
+    const float dir = Sector::get().get_gravity() < 0.0f ? -1.0f : 1.0f;
+    const float sink_velocity = WATER_SINK_SPEED * dir;
+    const float k = std::min(1.0f, WATER_DRAG * dt_sec);
+
+    float vx = m_physic.get_velocity_x();
+    float vy = m_physic.get_velocity_y();
+    vx -= vx * k;
+    vy += (sink_velocity - vy) * k;
+    // Never sink faster than the sink speed (e.g. right after hitting the surface).
+    if (vy * dir > WATER_SINK_SPEED)
+      vy = sink_velocity;
+    m_physic.set_velocity(vx, vy);
+  }
+  else
+  {
+    m_physic.enable_gravity(true);
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
 }
