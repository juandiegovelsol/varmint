@@ -272,8 +275,31 @@ HeavyCoin::HeavyCoin(const ReaderMapping& reader, bool count_stats) :
 void
 HeavyCoin::update(float dt_sec)
 {
+  // Coins in water sink slowly: about 3 seconds to sink the height of a
+  // full seaweed plant (4 tiles), regardless of how fast they entered.
+  static const float WATER_SINK_SPEED = 128.0f / 3.0f;
+  static const float WATER_GRAVITY_MODIFIER = 0.2f;
+  static const float WATER_HORIZONTAL_DRAG = 4.0f;
+
+  const bool in_water = !Sector::get().is_free_of_tiles(get_bbox(), true, Tile::WATER);
+  m_physic.set_gravity_modifier(in_water ? WATER_GRAVITY_MODIFIER : 1.0f);
+
+  if (in_water)
+  {
+    // Cap the downward speed so the coin drifts down slowly.
+    if (m_physic.get_velocity_y() > WATER_SINK_SPEED)
+      m_physic.set_velocity_y(WATER_SINK_SPEED);
+
+    // Water resistance slows down horizontal movement.
+    m_physic.set_velocity_x(m_physic.get_velocity_x() *
+                            std::max(0.0f, 1.0f - WATER_HORIZONTAL_DRAG * dt_sec));
+  }
+
   // Enable physics.
   m_col.set_movement(m_physic.get_movement(dt_sec));
+
+  if (in_water && m_physic.get_velocity_y() > WATER_SINK_SPEED)
+    m_physic.set_velocity_y(WATER_SINK_SPEED);
 }
 
