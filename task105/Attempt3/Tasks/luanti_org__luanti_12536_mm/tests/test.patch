+
+// An "allfaces" node (the drawtype leaves use) with visual_scale = 2, deep
+// inside its map block: it must stay centred on its own node, twice as big.
+void TestMapblockMeshGenerator::testScaledAllfacesNodeOffset()
+{
+	const v3s16 p(13, 6, 11);
+	MeshGenScene scene;
+	scene.place(p, "test:leaves_scaled");
+	Extent e = scene.generate(TEX_LEAVES_SCALED);
+	const v3f expected = intToFloat(p, BS);
+
+	UTEST(e.count > 0 &&
+			approx(e.center().X, expected.X) && approx(e.center().Y, expected.Y) &&
+			approx(e.center().Z, expected.Z) &&
+			approx(e.half().X, BS) && approx(e.half().Y, BS) && approx(e.half().Z, BS),
+			"scaled allfaces node at (%d, %d, %d) is not centred on itself at "
+			"twice its size: %s", p.X, p.Y, p.Z, describe(e).c_str());
+}
+
+// At the block's own corner scaling about any point coincides, so this passes
+// with or without the defect; it only shows the drift needs distance.
+void TestMapblockMeshGenerator::testScaledAllfacesNodeAtOrigin()
+{
+	MeshGenScene scene;
+	scene.place(v3s16(0, 0, 0), "test:leaves_scaled");
+	Extent e = scene.generate(TEX_LEAVES_SCALED);
+
+	UTEST(sameBox(e, scaled(-1.f, -1.f, -1.f, 1.f, 1.f, 1.f)),
+			"scaled allfaces node at the block corner: %s", describe(e).c_str());
+}
+
+// Without visual_scale an allfaces node is exactly its own cube.
+void TestMapblockMeshGenerator::testUnscaledAllfacesNodeUnaffected()
+{
+	const v3s16 p(13, 6, 11);
+	MeshGenScene scene;
+	scene.place(p, "test:leaves_plain");
+	Extent e = scene.generate(TEX_LEAVES_PLAIN);
+
+	UTEST(sameBox(e, cellOf(p, scaled(-0.5f, -0.5f, -0.5f, 0.5f, 0.5f, 0.5f))),
+			"unscaled allfaces node: %s", describe(e).c_str());
+}
+
+// A fence joins tree trunks (as it joins any full block it lists), whichever
+// way the trunk was turned when placed: the rails reach both trunks.
+void TestMapblockMeshGenerator::testFenceConnectsToTreeTrunk()
+{
+	const v3s16 p(8, 4, 8);
+	MeshGenScene scene;
+	scene.place(p, "test:fence");
+	scene.place(p + v3s16(-1, 0, 0), "test:trunk", 0);
+	scene.place(p + v3s16(1, 0, 0), "test:trunk", 3);
+	Extent e = scene.generate(TEX_FENCE);
+	const aabb3f want = cellOf(p, scaled(-0.5f, -0.5f, -1/8.f, 0.5f, 0.5f, 1/8.f));
+
+	UTEST(sameBox(e, want),
+			"fence between two tree trunks does not reach both of them: %s",
+			describe(e).c_str());
+}
+
+// Rails grow towards the neighbour a fence joins, never away from it.
+void TestMapblockMeshGenerator::testFenceRailsPointAtNeighborsAlongZ()
+{
+	const v3s16 p(8, 4, 8);
+	{
+		MeshGenScene scene;
+		scene.place(p, "test:fence");
+		scene.place(p + v3s16(0, 0, 1), "test:fence_other");
+		Extent e = scene.generate(TEX_FENCE);
+		UTEST(sameBox(e, cellOf(p, scaled(-1/8.f, -0.5f, -1/8.f, 1/8.f, 0.5f, 0.5f))),
+				"fence with its only neighbour on +Z: %s", describe(e).c_str());
+	}
+	{
+		MeshGenScene scene;
+		scene.place(p, "test:fence");
+		scene.place(p + v3s16(0, 0, -1), "test:fence_other");
+		Extent e = scene.generate(TEX_FENCE);
+		UTEST(sameBox(e, cellOf(p, scaled(-1/8.f, -0.5f, -0.5f, 1/8.f, 0.5f, 1/8.f))),
+				"fence with its only neighbour on -Z: %s", describe(e).c_str());
+	}
+}
