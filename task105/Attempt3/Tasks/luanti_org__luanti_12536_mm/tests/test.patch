+// The sides a node declares turn with the node: a block that accepts
+// connections only on its left and right, turned a quarter turn (facedir 1),
+// accepts them on its (world) front and back instead.
+void TestMapblockMeshGenerator::testFenceRespectsConnectSidesOfTurnedNode()
+{
+	const v3s16 p(8, 4, 8);
+	{
+		MeshGenScene scene;
+		scene.place(p, "test:fence");
+		scene.place(p + v3s16(-1, 0, 0), "test:panel_left_right", 1);
+		scene.place(p + v3s16(1, 0, 0), "test:panel_left_right", 1);
+		Extent e = scene.generate(TEX_FENCE);
+		UTEST(sameBox(e, cellOf(p, scaled(-1/8.f, -0.5f, -1/8.f, 1/8.f, 0.5f, 1/8.f))),
+				"fence must not join a turned node on sides it no longer declares: %s",
+				describe(e).c_str());
+	}
+	{
+		MeshGenScene scene;
+		scene.place(p, "test:fence");
+		scene.place(p + v3s16(0, 0, -1), "test:panel_left_right", 1);
+		scene.place(p + v3s16(0, 0, 1), "test:panel_left_right", 1);
+		Extent e = scene.generate(TEX_FENCE);
+		UTEST(sameBox(e, cellOf(p, scaled(-1/8.f, -0.5f, -0.5f, 1/8.f, 0.5f, 0.5f))),
+				"fence must join a turned node on the sides it now declares: %s",
+				describe(e).c_str());
+	}
+}
+
+// A plain plantlike node stands on the floor of its node, the top of its
+// texture at the top.
+void TestMapblockMeshGenerator::testPlantlikeNodeStandsUpright()
+{
+	const v3s16 p(5, 3, 5);
+	MeshGenScene scene;
+	scene.place(p, "test:plant");
+	std::vector<video::S3DVertex> verts;
+	Extent e = scene.generate(TEX_PLANT, &verts);
+	const float mid = p.Y * BS;
+
+	bool upright = !verts.empty();
+	for (const video::S3DVertex &v : verts) {
+		if (v.TCoords.Y < 0.5f && v.Pos.Y <= mid)
+			upright = false; // top of the picture drawn in the lower half
+		if (v.TCoords.Y > 0.5f && v.Pos.Y >= mid)
+			upright = false; // bottom of the picture drawn in the upper half
+	}
+	UTEST(upright && approx(e.min_v.Y, mid - BS / 2) && approx(e.max_v.Y, mid + BS / 2),
+			"plantlike node is not drawn upright on its node: %s", describe(e).c_str());
+}
+
+// A plantlike node that is explicitly mounted on the ceiling hangs down.
+void TestMapblockMeshGenerator::testWallmountedPlantlikeHangsFromCeiling()
+{
+	const v3s16 p(5, 3, 5);
+	MeshGenScene scene;
+	scene.place(p, "test:plant_hanging", 0); // wallmounted 0: ceiling
+	std::vector<video::S3DVertex> verts;
+	Extent e = scene.generate(TEX_PLANT_HANGING, &verts);
+	const float mid = p.Y * BS;
+
+	bool hanging = !verts.empty();
+	for (const video::S3DVertex &v : verts) {
+		if (v.TCoords.Y < 0.5f && v.Pos.Y >= mid)
+			hanging = false;
+		if (v.TCoords.Y > 0.5f && v.Pos.Y <= mid)
+			hanging = false;
+	}
+	UTEST(hanging, "ceiling-mounted plantlike node is not hanging: %s",
+			describe(e).c_str());
+}
+
+// A turned mesh node is drawn turned exactly like the node itself is turned,
+// i.e. it covers the same space as its own (equally turned) node box -- for
+// turns about the vertical axis as well as tilted and upside-down placements.
+void TestMapblockMeshGenerator::testRotatedMeshNodeFollowsFacedir()
+{
+	const v3s16 p(6, 5, 9);
+	for (u8 facedir = 1; facedir < 24; facedir++) {
+		MeshGenScene scene;
+		scene.place(p, "test:mesh_slab", facedir);
+		Extent e = scene.generate(TEX_MESH);
+
+		std::vector<aabb3f> boxes;
+		MapNode(scene.id("test:mesh_slab"), 0, facedir).getNodeBoxes(scene.ndef(), &boxes);
+		UASSERT(boxes.size() == 1);
+		UTEST(sameBox(e, cellOf(p, boxes[0])),
+				"mesh node turned with facedir %d is drawn turned differently from "
+				"the node: %s", facedir, describe(e).c_str());
+	}
+}
+
+// Without any rotation a mesh node is drawn exactly as modelled.
+void TestMapblockMeshGenerator::testUnrotatedMeshNodeKeepsItsShape()
+{
+	const v3s16 p(6, 5, 9);
+	MeshGenScene scene;
+	scene.place(p, "test:mesh_slab", 0);
+	Extent e = scene.generate(TEX_MESH);
+
+	UTEST(sameBox(e, cellOf(p, MESH_BOUNDS)),
+			"unrotated mesh node: %s", describe(e).c_str());
+}
