+// Headless behavioral tests for the map block mesh generator.
+//
+// Every test builds a small piece of world (one map block plus its 26
+// neighbours, all air in full daylight), places a few nodes into it, runs the
+// engine's own MapblockMeshGenerator::generate() over the centre block exactly
+// like MapBlockMesh does, and then only looks at the geometry that comes out:
+// where the vertices of a given node ended up and which way its texture faces.
+// Nothing here depends on how the generator is organised internally.
+
+#include "test.h"
+
+#include <cmath>
+#include <limits>
+#include <SMesh.h>
+#include <SMeshBuffer.h>
+
+#include "client/client.h"
+#include "client/content_mapblock.h"
+#include "client/mapblock_mesh.h"
+#include "client/meshgen/collector.h"
+#include "client/tile.h"
+#include "constants.h"
+#include "content/mods.h"
+#include "gamedef.h"
+#include "mapnode.h"
+#include "nodedef.h"
+#include "util/numeric.h"
+
+namespace {
+
+// Texture ids identify which node a generated vertex belongs to.
+enum : u32 {
+	TEX_LEAVES_SCALED = 11,
+	TEX_LEAVES_PLAIN,
+	TEX_FENCE,
+	TEX_FENCE_OTHER,
+	TEX_PLANT,
+	TEX_PLANT_HANGING,
+	TEX_MESH,
+};
+
+const float EPS = 0.05f; // in world units; one node is BS = 10 units
+
+// The mesh generator only needs the node definitions from the game.
+class MeshGenGameDef : public IGameDef {
+public:
+	explicit MeshGenGameDef(const NodeDefManager *ndef) : m_ndef(ndef) {}
+
+	IItemDefManager *getItemDefManager() override { return nullptr; }
+	const NodeDefManager *getNodeDefManager() override { return m_ndef; }
+	ICraftDefManager *getCraftDefManager() override { return nullptr; }
+	u16 allocateUnknownNodeId(const std::string &name) override { return CONTENT_IGNORE; }
+	const std::vector<ModSpec> &getMods() const override
+	{
+		static std::vector<ModSpec> mods;
+		return mods;
+	}
+	const ModSpec *getModSpec(const std::string &modname) const override { return nullptr; }
+	bool registerModStorage(ModMetadata *storage) override { return true; }
+	void unregisterModStorage(const std::string &name) override {}
+	ModMetadataDatabase *getModStorageDatabase() override { return nullptr; }
+	bool joinModChannel(const std::string &channel) override { return false; }
+	bool leaveModChannel(const std::string &channel) override { return false; }
+	bool sendModChannelMessage(const std::string &channel,
+			const std::string &message) override { return false; }
+	ModChannel *getModChannel(const std::string &channel) override { return nullptr; }
+
+private:
+	const NodeDefManager *m_ndef;
+};
+
+// MeshMakeData reaches the game through a Client pointer, and the mesh
+// generator only ever calls ndef() on it: an inline, non-virtual IGameDef
+// helper that forwards to the virtual getNodeDefManager(). A Client cannot be
+// built headlessly at this point in the codebase's history, so this returns a
+// pointer that resolves -- through the very same Client -> IGameDef base
+// conversion the generator performs -- to the IGameDef above. No other part of
+// Client is ever touched.
+Client *clientFor(IGameDef *gamedef)
+{
+	alignas(Client) static unsigned char probe_storage[sizeof(Client)];
+	Client *probe = reinterpret_cast<Client *>(probe_storage);
+	ptrdiff_t offset = reinterpret_cast<char *>(static_cast<IGameDef *>(probe)) -
+			reinterpret_cast<char *>(probe);
+	return reinterpret_cast<Client *>(reinterpret_cast<char *>(gamedef) - offset);
+}
+
+// Mesh nodes may need their normals recalculated after rotation; normals play
+// no part in these tests, so this manipulator leaves them alone.
+class NoopMeshManipulator : public scene::IMeshManipulator {
+public:
+	void recalculateNormals(scene::IMesh *mesh, bool smooth = false,
+			bool angleWeighted = false) const override {}
+	void recalculateNormals(scene::IMeshBuffer *buffer, bool smooth = false,
+			bool angleWeighted = false) const override {}
+	scene::SMesh *createMeshCopy(scene::IMesh *mesh) const override { return nullptr; }
+	s32 getPolyCount(scene::IMesh *mesh) const override { return 0; }
+	s32 getPolyCount(scene::IAnimatedMesh *mesh) const override { return 0; }
+	scene::IAnimatedMesh *createAnimatedMesh(scene::IMesh *mesh,
+			scene::E_ANIMATED_MESH_TYPE type) const override { return nullptr; }
+};
+
+void setAllTiles(ContentFeatures &f, u32 texture_id)
+{
+	for (TileSpec &tile : f.tiles)
+		tile.layers[0].texture_id = texture_id;
+}
+
+aabb3f scaled(float x1, float y1, float z1, float x2, float y2, float z2)
+{
+	return aabb3f(x1 * BS, y1 * BS, z1 * BS, x2 * BS, y2 * BS, z2 * BS);
+}
+
+// A wooden-fence-like connected node box: a post plus two rails per side.
+void makeFenceBox(NodeBox &box)
+{
+	box.type = NODEBOX_CONNECTED;
+	box.fixed = {scaled(-1/8.f, -1/2.f, -1/8.f, 1/8.f, 1/2.f, 1/8.f)};
+	NodeBoxConnected &c = box.getConnected();
+	for (float y : {3/16.f, -5/16.f}) {
+		c.connect_front.push_back(scaled(-1/16.f, y, -1/2.f, 1/16.f, y + 1/8.f, -1/8.f));
+		c.connect_left.push_back(scaled(-1/2.f, y, -1/16.f, -1/8.f, y + 1/8.f, 1/16.f));
+		c.connect_back.push_back(scaled(-1/16.f, y, 1/8.f, 1/16.f, y + 1/8.f, 1/2.f));
+		c.connect_right.push_back(scaled(1/8.f, y, -1/16.f, 1/2.f, y + 1/8.f, 1/16.f));
+	}
+}
+
+// The mesh used for the "mesh" drawtype node: an off-centre slab that only
+// covers the +X half of the node, so that every quarter turn is distinguishable.
+const aabb3f MESH_BOUNDS = scaled(0.f, -1/2.f, -1/16.f, 1/2.f, 1/2.f, 1/16.f);
+
+scene::SMesh *makeSlabMesh()
+{
+	const v3f a = MESH_BOUNDS.MinEdge, b = MESH_BOUNDS.MaxEdge;
+	const video::SColor white(255, 255, 255, 255);
+	video::S3DVertex v[8] = {
+		video::S3DVertex(a.X, a.Y, a.Z, 0, 0, -1, white, 0, 1),
+		video::S3DVertex(b.X, a.Y, a.Z, 0, 0, -1, white, 1, 1),
+		video::S3DVertex(b.X, b.Y, a.Z, 0, 0, -1, white, 1, 0),
+		video::S3DVertex(a.X, b.Y, a.Z, 0, 0, -1, white, 0, 0),
+		video::S3DVertex(a.X, a.Y, b.Z, 0, 0, 1, white, 1, 1),
+		video::S3DVertex(b.X, a.Y, b.Z, 0, 0, 1, white, 0, 1),
+		video::S3DVertex(b.X, b.Y, b.Z, 0, 0, 1, white, 0, 0),
+		video::S3DVertex(a.X, b.Y, b.Z, 0, 0, 1, white, 1, 0),
+	};
+	const u16 idx[36] = {
+		0, 2, 1, 0, 3, 2,  4, 5, 6, 4, 6, 7,  0, 1, 5, 0, 5, 4,
+		3, 6, 2, 3, 7, 6,  0, 4, 7, 0, 7, 3,  1, 2, 6, 1, 6, 5,
+	};
+	scene::SMeshBuffer *buf = new scene::SMeshBuffer();
+	buf->append(v, 8, idx, 36);
+	scene::SMesh *mesh = new scene::SMesh();
+	mesh->addMeshBuffer(buf);
+	buf->drop();
+	mesh->recalculateBoundingBox();
+	return mesh;
+}
+
+struct Extent {
+	v3f min_v, max_v;
+	size_t count = 0;
+
+	v3f center() const { return (min_v + max_v) * 0.5f; }
+	v3f half() const { return (max_v - min_v) * 0.5f; }
+};
+
+bool approx(float a, float b) { return std::fabs(a - b) < EPS; }
+
+bool sameBox(const Extent &e, const aabb3f &box)
+{
+	return e.count > 0 &&
+		approx(e.min_v.X, box.MinEdge.X) && approx(e.min_v.Y, box.MinEdge.Y) &&
+		approx(e.min_v.Z, box.MinEdge.Z) && approx(e.max_v.X, box.MaxEdge.X) &&
+		approx(e.max_v.Y, box.MaxEdge.Y) && approx(e.max_v.Z, box.MaxEdge.Z);
+}
+
+// A tiny world: one map block (block position 0,0,0) and all its neighbours.
+class MeshGenScene {
+public:
+	MeshGenScene() :
+		m_ndef(createNodeDefManager()),
+		m_gamedef(m_ndef)
+	{
+		m_slab_mesh = makeSlabMesh();
+
+		ContentFeatures f;
+
+		f = ContentFeatures();
+		f.name = "test:leaves_scaled";
+		f.drawtype = NDT_ALLFACES;
+		f.param_type = CPT_LIGHT;
+		f.solidness = 0;
+		f.visual_scale = 2.0f;
+		setAllTiles(f, TEX_LEAVES_SCALED);
+		m_ndef->set(f.name, f);
+
+		f = ContentFeatures();
+		f.name = "test:leaves_plain";
+		f.drawtype = NDT_ALLFACES;
+		f.param_type = CPT_LIGHT;
+		f.solidness = 0;
+		setAllTiles(f, TEX_LEAVES_PLAIN);
+		m_ndef->set(f.name, f);
+
+		// A tree trunk: a plain cube that can be placed turned (facedir).
+		f = ContentFeatures();
+		f.name = "test:trunk";
+		f.drawtype = NDT_NORMAL;
+		f.param_type_2 = CPT2_FACEDIR;
+		m_ndef->set(f.name, f);
+
+		f = ContentFeatures();
+		f.name = "test:stone";
+		f.drawtype = NDT_NORMAL;
+		m_ndef->set(f.name, f);
+
+		// A turnable block that only allows connections on the sides it names.
+		f = ContentFeatures();
+		f.name = "test:panel_vertical_only";
+		f.drawtype = NDT_NORMAL;
+		f.param_type_2 = CPT2_FACEDIR;
+		f.connect_sides = 1 | 2; // top, bottom
+		m_ndef->set(f.name, f);
+
+		f = ContentFeatures();
+		f.name = "test:panel_left_right";
+		f.drawtype = NDT_NORMAL;
+		f.param_type_2 = CPT2_FACEDIR;
+		f.connect_sides = 8 | 32; // left, right
+		m_ndef->set(f.name, f);
+
+		f = ContentFeatures();
+		f.name = "test:plant";
+		f.drawtype = NDT_PLANTLIKE;
+		f.param_type = CPT_LIGHT;
+		f.solidness = 0;
+		f.walkable = false;
+		setAllTiles(f, TEX_PLANT);
+		m_ndef->set(f.name, f);
+
+		f = ContentFeatures();
+		f.name = "test:plant_hanging";
+		f.drawtype = NDT_PLANTLIKE;
+		f.param_type = CPT_LIGHT;
+		f.param_type_2 = CPT2_WALLMOUNTED;
+		f.solidness = 0;
+		f.walkable = false;
+		setAllTiles(f, TEX_PLANT_HANGING);
+		m_ndef->set(f.name, f);
+
+		f = ContentFeatures();
+		f.name = "test:mesh_slab";
+		f.drawtype = NDT_MESH;
+		f.param_type = CPT_LIGHT;
+		f.param_type_2 = CPT2_FACEDIR;
+		f.solidness = 0;
+		f.mesh_ptr[0] = m_slab_mesh;
+		f.node_box.type = NODEBOX_FIXED;
+		f.node_box.fixed = {MESH_BOUNDS};
+		setAllTiles(f, TEX_MESH);
+		m_ndef->set(f.name, f);
+
+		// Two kinds of fence that join each other, tree trunks and plain
+		// panels -- but not stone.
+		content_t c_fence = registerFence("test:fence", TEX_FENCE, {});
+		content_t c_fence_other = registerFence("test:fence_other", TEX_FENCE_OTHER, {});
+		std::vector<content_t> joins = {c_fence, c_fence_other, id("test:trunk"),
+			id("test:panel_vertical_only"), id("test:panel_left_right")};
+		registerFence("test:fence", TEX_FENCE, joins);
+		registerFence("test:fence_other", TEX_FENCE_OTHER, joins);
+	}
+
+	~MeshGenScene()
+	{
+		// the node definition manager owns (and drops) the slab mesh
+		delete m_ndef;
+	}
+
+	content_t id(const std::string &name) const { return m_ndef->getId(name); }
+
+	void place(v3s16 p, const std::string &name, u8 param2 = 0)
+	{
+		m_nodes.emplace_back(p, MapNode(id(name), 0, param2));
+	}
+
+	const NodeDefManager *ndef() const { return m_ndef; }
+
+	// Runs the generator over block (0,0,0) and returns the extent of every
+	// vertex generated with the given texture, plus the vertices themselves.
+	Extent generate(u32 texture_id, std::vector<video::S3DVertex> *out = nullptr,
+			bool smooth_lighting = true)
+	{
+		MeshMakeData data(clientFor(&m_gamedef), false);
+		data.fillBlockDataBegin(v3s16(0, 0, 0));
+		std::vector<MapNode> air(MAP_BLOCKSIZE * MAP_BLOCKSIZE * MAP_BLOCKSIZE,
+				MapNode(CONTENT_AIR, LIGHT_SUN, 0));
+		for (s16 z = -1; z <= 1; z++)
+		for (s16 y = -1; y <= 1; y++)
+		for (s16 x = -1; x <= 1; x++)
+			data.fillBlockData(v3s16(x, y, z), air.data());
+		for (const auto &node : m_nodes)
+			data.m_vmanip.setNode(node.first, node.second);
+		data.setSmoothLighting(smooth_lighting);
+
+		MeshCollector collector;
+		NoopMeshManipulator meshmanip;
+		MapblockMeshGenerator(&data, &collector, &meshmanip).generate();
+
+		Extent e;
+		e.min_v = v3f(std::numeric_limits<float>::max());
+		e.max_v = v3f(-std::numeric_limits<float>::max());
+		for (const auto &buffers : collector.prebuffers)
+		for (const PreMeshBuffer &buf : buffers) {
+			if (buf.layer.texture_id != texture_id)
+				continue;
+			for (const video::S3DVertex &v : buf.vertices) {
+				e.min_v.X = std::min(e.min_v.X, v.Pos.X);
+				e.min_v.Y = std::min(e.min_v.Y, v.Pos.Y);
+				e.min_v.Z = std::min(e.min_v.Z, v.Pos.Z);
+				e.max_v.X = std::max(e.max_v.X, v.Pos.X);
+				e.max_v.Y = std::max(e.max_v.Y, v.Pos.Y);
+				e.max_v.Z = std::max(e.max_v.Z, v.Pos.Z);
+				e.count++;
+				if (out)
+					out->push_back(v);
+			}
+		}
+		return e;
+	}
+
+private:
+	content_t registerFence(const std::string &name, u32 texture_id,
+			const std::vector<content_t> &joins)
+	{
+		ContentFeatures f;
+		f.name = name;
+		f.drawtype = NDT_NODEBOX;
+		f.param_type = CPT_LIGHT;
+		f.solidness = 0;
+		makeFenceBox(f.node_box);
+		f.connects_to_ids = joins;
+		setAllTiles(f, texture_id);
+		return m_ndef->set(f.name, f);
+	}
+
+	NodeDefManager *m_ndef;
+	MeshGenGameDef m_gamedef;
+	scene::SMesh *m_slab_mesh;
+	std::vector<std::pair<v3s16, MapNode>> m_nodes;
+};
+
+std::string describe(const Extent &e)
+{
+	char buf[200];
+	snprintf(buf, sizeof(buf), "%zu vertices, min (%.3f, %.3f, %.3f) max (%.3f, %.3f, %.3f)",
+			e.count, e.min_v.X, e.min_v.Y, e.min_v.Z, e.max_v.X, e.max_v.Y, e.max_v.Z);
+	return buf;
+}
+
+// The region a node occupies in the generated (block-relative) mesh.
+aabb3f cellOf(v3s16 p, const aabb3f &local)
+{
+	v3f o = intToFloat(p, BS);
+	return aabb3f(local.MinEdge + o, local.MaxEdge + o);
+}
+
