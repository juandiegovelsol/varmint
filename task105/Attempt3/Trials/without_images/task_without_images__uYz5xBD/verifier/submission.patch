+namespace {
+	// Connect face bits and the directions they denote
+	const struct { u8 bit; v3s16 dir; } connect_face_dirs[6] = {
+		{ 1, v3s16( 0,  1,  0)}, // top
+		{ 2, v3s16( 0, -1,  0)}, // bottom
+		{ 4, v3s16( 0,  0, -1)}, // front
+		{ 8, v3s16(-1,  0,  0)}, // left
+		{16, v3s16( 0,  0,  1)}, // back
+		{32, v3s16( 1,  0,  0)}, // right
+	};
+
+	// Exact 90 degree steps of v3f::rotate??By, for integer vectors
+	// (rotate the (u, v) plane by quarter turns)
+	inline void rotateQuarter(s16 &u, s16 &v, int quarters)
+	{
+		for (quarters &= 3; quarters > 0; quarters--) {
+			s16 t = u;
+			u = -v;
+			v = t;
+		}
+	}
+
+	// Rotates a direction the same way a node with the given facedir is
+	// rotated (see rotateMeshBy6dFacedir and transformNodeBox).
+	v3s16 rotateDirByFacedir(v3s16 d, u8 facedir)
+	{
+		u8 axisdir = facedir >> 2;
+		switch (facedir & 3) {
+			case 1: rotateQuarter(d.X, d.Z, -1); break;
+			case 2: rotateQuarter(d.X, d.Z,  2); break;
+			case 3: rotateQuarter(d.X, d.Z,  1); break;
+		}
+		switch (axisdir) {
+			case 1: rotateQuarter(d.Y, d.Z,  1); break; // z+
+			case 2: rotateQuarter(d.Y, d.Z, -1); break; // z-
+			case 3: rotateQuarter(d.X, d.Y, -1); break; // x+
+			case 4: rotateQuarter(d.X, d.Y,  1); break; // x-
+			case 5: rotateQuarter(d.X, d.Y,  2); break; // y-
+		}
+		return d;
+	}
+
+	// Converts a connect face (in world space) to the corresponding face in
+	// the frame of a node rotated by facedir.
+	u8 facedirConnectFaceToLocal(u8 connect_face, u8 facedir)
+	{
+		v3s16 world_dir;
+		bool found = false;
+		for (const auto &cfd : connect_face_dirs) {
+			if (cfd.bit == connect_face) {
+				world_dir = cfd.dir;
+				found = true;
+				break;
+			}
+		}
+		if (!found)
+			return 0;
+		for (const auto &cfd : connect_face_dirs) {
+			if (rotateDirByFacedir(cfd.dir, facedir) == world_dir)
+				return cfd.bit;
+		}
+		return 0;
+	}
+}
