+namespace {
+
+// A channel of flowing liquid running from a source in direction `flow`
+// (one of +-X, +-Z): the source, then flowing nodes with falling levels,
+// walled in by stone on both sides, below and at both ends.
+struct LiquidChannel {
+	v3s16 source;
+	v3s16 flow;
+	std::vector<v3s16> cells; // the flowing nodes, downstream order
+};
+
+LiquidChannel buildChannel(MeshGenScene &scene, v3s16 start, v3s16 flow,
+		const std::vector<u8> &levels)
+{
+	LiquidChannel ch;
+	ch.source = start;
+	ch.flow = flow;
+	const v3s16 side(flow.Z, 0, flow.X); // horizontal, perpendicular to flow
+	scene.place(start, "test:liquid_source");
+	for (size_t i = 0; i < levels.size(); i++) {
+		v3s16 c = start + flow * (s16)(i + 1);
+		scene.place(c, "test:liquid_flowing", levels[i]);
+		ch.cells.push_back(c);
+	}
+	for (s16 i = -1; i <= (s16)levels.size() + 1; i++) {
+		v3s16 c = start + flow * i;
+		scene.place(c + side, "test:stone");
+		scene.place(c - side, "test:stone");
+		scene.place(c - v3s16(0, 1, 0), "test:stone");
+	}
+	scene.place(start - flow, "test:stone");
+	scene.place(start + flow * (s16)(levels.size() + 1), "test:stone");
+	return ch;
+}
+
+// Heights of the liquid surface at the four upper corners of one cell, keyed
+// by which (horizontal) corner they belong to. Returns false if the surface
+// of that cell is not exactly four corners.
+bool surfaceCorners(const std::vector<Triangle> &tris, v3s16 cell,
+		std::vector<std::pair<v3f, float>> *corners)
+{
+	const v3f o = intToFloat(cell, BS);
+	corners->clear();
+	for (const Triangle &t : tris) {
+		// only the surface drawn by this cell (its triangles lie above it)
+		v3f centre = (t.v[0].Pos + t.v[1].Pos + t.v[2].Pos) / 3.0f - o;
+		if (std::fabs(centre.X) >= BS / 2 || std::fabs(centre.Z) >= BS / 2)
+			continue;
+		for (const video::S3DVertex &v : t.v) {
+		v3f d = v.Pos - o;
+		if (std::fabs(std::fabs(d.X) - BS / 2) > EPS || std::fabs(std::fabs(d.Z) - BS / 2) > EPS)
+			continue;
+		bool known = false;
+		for (auto &c : *corners)
+			if (approx(c.first.X, d.X) && approx(c.first.Z, d.Z))
+				known = true;
+		if (!known)
+			corners->emplace_back(v3f(d.X, 0, d.Z), d.Y);
+		}
+	}
+	return corners->size() == 4;
+}
+
+} // namespace
+
+// Flowing liquid runs downhill: along a channel fed from one end, the surface
+// of every flowing node is lower on its downstream side than on its upstream
+// side, level across the channel, and joins its neighbours' surfaces without
+// steps -- whichever way the channel runs.
+void TestMapblockMeshGenerator::testFlowingLiquidSurfaceFollowsTheFlow()
+{
+	const v3s16 flows[4] = {v3s16(1, 0, 0), v3s16(-1, 0, 0), v3s16(0, 0, 1), v3s16(0, 0, -1)};
+	for (const v3s16 &flow : flows) {
+		MeshGenScene scene;
+		LiquidChannel ch = buildChannel(scene, v3s16(8, 5, 8) - flow * 3, flow,
+				{6, 5, 4, 3, 2});
+		std::vector<Triangle> tris = scene.triangles(TEX_LIQUID_TOP);
+
+		float prev_downstream = 0;
+		for (size_t i = 0; i < ch.cells.size(); i++) {
+			std::vector<std::pair<v3f, float>> corners;
+			bool ok = surfaceCorners(tris, ch.cells[i], &corners);
+			UTEST(ok, "flowing node %s of a channel flowing %s has no proper surface",
+					describe(ch.cells[i]).c_str(), describe(flow).c_str());
+			float up[2], down[2];
+			int nup = 0, ndown = 0;
+			for (auto &c : corners) {
+				float along = c.first.X * flow.X + c.first.Z * flow.Z;
+				if (along < 0 && nup < 2)
+					up[nup++] = c.second;
+				else if (along > 0 && ndown < 2)
+					down[ndown++] = c.second;
+			}
+			UASSERT(nup == 2 && ndown == 2);
+			UTEST(approx(up[0], up[1]) && approx(down[0], down[1]),
+					"surface of flowing node %s (channel flowing %s) is not level across "
+					"the channel: upstream %.2f/%.2f, downstream %.2f/%.2f",
+					describe(ch.cells[i]).c_str(), describe(flow).c_str(),
+					up[0], up[1], down[0], down[1]);
+			UTEST(up[0] > down[0] + EPS,
+					"surface of flowing node %s does not fall in the direction of the "
+					"flow %s: upstream %.2f, downstream %.2f",
+					describe(ch.cells[i]).c_str(), describe(flow).c_str(), up[0], down[0]);
+			if (i > 0)
+				UTEST(approx(up[0], prev_downstream),
+						"surface steps between flowing nodes at %s (flow %s): %.2f vs %.2f",
+						describe(ch.cells[i]).c_str(), describe(flow).c_str(),
+						prev_downstream, up[0]);
+			prev_downstream = down[0];
+		}
+	}
+}
+
+// Flowing liquid with the same level all around has a flat surface.
+void TestMapblockMeshGenerator::testEvenFlowingLiquidStaysLevel()
+{
+	const v3s16 p(8, 5, 8);
+	MeshGenScene scene;
+	for (s16 dx = -1; dx <= 1; dx++)
+	for (s16 dz = -1; dz <= 1; dz++) {
+		scene.place(p + v3s16(dx, 0, dz), "test:liquid_flowing", 4);
+		scene.place(p + v3s16(dx, -1, dz), "test:stone");
+	}
+	std::vector<Triangle> tris = scene.triangles(TEX_LIQUID_TOP);
+	std::vector<std::pair<v3f, float>> corners;
+	UTEST(surfaceCorners(tris, p, &corners),
+			"evenly flowing liquid at %s has no proper surface", describe(p).c_str());
+	for (auto &c : corners)
+		UTEST(approx(c.second, corners[0].second),
+				"evenly flowing liquid is not level: %.2f vs %.2f",
+				c.second, corners[0].second);
+}
