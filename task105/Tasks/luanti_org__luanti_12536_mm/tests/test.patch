+namespace {
+
+// One face of a plant: where its middle is and how it lies.
+struct PlantFace {
+	v3f centre;      // node-relative
+	v3f top_centre;  // middle of its upper edge, node-relative
+	v3f bottom_centre;
+	bool along_x;    // runs along X (else along Z)
+	float length;    // horizontal length
+};
+
+std::vector<PlantFace> plantFaces(MeshGenScene &scene, v3s16 p, u32 tex)
+{
+	std::vector<video::S3DVertex> verts;
+	scene.generate(tex, &verts);
+	std::vector<PlantFace> faces;
+	const v3f o = intToFloat(p, BS);
+	for (size_t i = 0; i + 4 <= verts.size(); i += 4) {
+		PlantFace face;
+		v3f lo(0, 0, 0), hi(0, 0, 0), sum(0, 0, 0);
+		float min_y = std::numeric_limits<float>::max();
+		for (size_t k = 0; k < 4; k++)
+			min_y = std::min(min_y, verts[i + k].Pos.Y);
+		int nlo = 0, nhi = 0;
+		aabb3f box(verts[i].Pos - o);
+		for (size_t k = 0; k < 4; k++) {
+			v3f v = verts[i + k].Pos - o;
+			box.addInternalPoint(v);
+			sum += v;
+			if (verts[i + k].Pos.Y < min_y + EPS) {
+				lo += v;
+				nlo++;
+			} else {
+				hi += v;
+				nhi++;
+			}
+		}
+		face.centre = sum / 4.0f;
+		face.bottom_centre = nlo ? lo / (float)nlo : v3f(0, 0, 0);
+		face.top_centre = nhi ? hi / (float)nhi : v3f(0, 0, 0);
+		v3f ext = box.getExtent();
+		face.along_x = ext.X >= ext.Z;
+		face.length = std::max(ext.X, ext.Z);
+		faces.push_back(face);
+	}
+	return faces;
+}
+
+const float PLANT_TOL = 0.03f * BS;
+
+bool nearly(float a, float b) { return std::fabs(a - b) < PLANT_TOL; }
+
+} // namespace
+
+// A plant laid out as a hash (#, param2 3: four faces, two along each axis,
+// each a quarter node away from the middle) keeps all four faces inside its
+// own node around its middle, one face on each side of it.
+void TestMapblockMeshGenerator::testHashStylePlantFacesSurroundItsCentre()
+{
+	const v3s16 p(5, 3, 5);
+	{
+		MeshGenScene scene;
+		scene.place(p, "test:plant_options", 3);
+		std::vector<PlantFace> faces = plantFaces(scene, p, TEX_PLANT_OPTIONS);
+		UTEST(faces.size() == 4, "hash-style plant has %zu faces", faces.size());
+		int seen[4] = {0, 0, 0, 0}; // along X at -z, +z; along Z at -x, +x
+		for (const PlantFace &f : faces) {
+			bool ok = f.length > 0.9f * BS && f.length < 1.1f * BS;
+			if (f.along_x && nearly(f.centre.X, 0) && nearly(std::fabs(f.centre.Z), BS / 4))
+				seen[f.centre.Z > 0 ? 1 : 0] += ok;
+			else if (!f.along_x && nearly(f.centre.Z, 0) && nearly(std::fabs(f.centre.X), BS / 4))
+				seen[f.centre.X > 0 ? 3 : 2] += ok;
+			UTEST(ok && std::fabs(f.centre.X) <= BS / 2 && std::fabs(f.centre.Z) <= BS / 2,
+					"hash-style plant face centred at (%.2f, %.2f) with length %.2f",
+					f.centre.X / BS, f.centre.Z / BS, f.length / BS);
+		}
+		UTEST(seen[0] == 1 && seen[1] == 1 && seen[2] == 1 && seen[3] == 1,
+				"hash-style plant faces are not one on each side of its middle: "
+				"%d %d %d %d", seen[0], seen[1], seen[2], seen[3]);
+	}
+}
+
+// Plants laid out as a cross (param2 0: x, param2 1: +) have all their faces
+// meeting in the middle of the node.
+void TestMapblockMeshGenerator::testCrossStylePlantFacesMeetAtItsCentre()
+{
+	const v3s16 p(5, 3, 5);
+	for (u8 style : {0, 1}) {
+		MeshGenScene scene;
+		scene.place(p, "test:plant_options", style);
+		std::vector<PlantFace> faces = plantFaces(scene, p, TEX_PLANT_OPTIONS);
+		UTEST(faces.size() == 2, "cross-style plant %d has %zu faces", style, faces.size());
+		for (const PlantFace &f : faces)
+			UTEST(nearly(f.centre.X, 0) && nearly(f.centre.Z, 0),
+					"cross-style plant %d face centred at (%.2f, %.2f)", style,
+					f.centre.X / BS, f.centre.Z / BS);
+	}
+}
+
+namespace {
+
+v3s16 axisVector(int axis, s16 sign)
+{
+	v3s16 v(0, 0, 0);
+	if (axis == 0) v.X = sign;
+	if (axis == 1) v.Y = sign;
+	if (axis == 2) v.Z = sign;
+	return v;
+}
+
+// How a turned node is turned, read off its own node box: the box of
+// "test:pointer" sits at (0.1, 0.2, 0.3) nodes from the middle, so where each
+// of those three distances ends up gives the turn as a signed permutation.
+struct Turn {
+	bool ok = true;
+	s16 m[3][3] = {{0, 0, 0}, {0, 0, 0}, {0, 0, 0}};
+
+	v3s16 apply(v3s16 v) const
+	{
+		s16 in[3] = {v.X, v.Y, v.Z};
+		s16 out[3] = {0, 0, 0};
+		for (int i = 0; i < 3; i++)
+			for (int k = 0; k < 3; k++)
+				out[i] += m[i][k] * in[k];
+		return v3s16(out[0], out[1], out[2]);
+	}
+};
+
+Turn turnOf(const MeshGenScene &scene, u8 facedir)
+{
+	Turn turn;
+	std::vector<aabb3f> boxes;
+	MapNode(scene.id("test:pointer"), 0, facedir).getNodeBoxes(scene.ndef(), &boxes);
+	if (boxes.size() != 1) {
+		turn.ok = false;
+		return turn;
+	}
+	v3f c = boxes[0].getCenter() / BS;
+	float comp[3] = {c.X, c.Y, c.Z};
+	for (int i = 0; i < 3; i++) {
+		int k = (int)std::lround(std::fabs(comp[i]) * 10) - 1;
+		if (k < 0 || k > 2) {
+			turn.ok = false;
+			continue;
+		}
+		turn.m[i][k] = comp[i] > 0 ? 1 : -1;
+	}
+	return turn;
+}
+
+// One face of a block as drawn: which way it looks, and the directions in
+// which its texture's U (left to right) and V (top to bottom) grow.
+struct DrawnFace {
+	bool found = false;
+	v3s16 normal, u_dir, v_dir;
+};
+
+DrawnFace drawnFace(const std::vector<Triangle> &tris, v3f o)
+{
+	DrawnFace face;
+	std::vector<video::S3DVertex> verts;
+	for (const Triangle &t : tris)
+		for (const video::S3DVertex &v : t.v)
+			verts.push_back(v);
+	if (verts.empty())
+		return face;
+	int normal_axis = -1;
+	for (int ax = 0; ax < 3; ax++) {
+		float first = verts[0].Pos[ax] - o[ax];
+		bool flat = std::fabs(std::fabs(first) - BS / 2) < EPS;
+		for (const video::S3DVertex &v : verts)
+			flat = flat && std::fabs(v.Pos[ax] - o[ax] - first) < EPS;
+		if (flat)
+			normal_axis = ax;
+	}
+	if (normal_axis < 0)
+		return face;
+	face.normal = axisVector(normal_axis, verts[0].Pos[normal_axis] > o[normal_axis] ? 1 : -1);
+	for (int which = 0; which < 2; which++) {
+		s16 g[3] = {0, 0, 0};
+		for (int ax = 0; ax < 3; ax++) {
+			if (ax == normal_axis)
+				continue;
+			for (const video::S3DVertex &a : verts)
+			for (const video::S3DVertex &b : verts) {
+				float d = b.Pos[ax] - a.Pos[ax];
+				if (std::fabs(d) < BS / 2)
+					continue;
+				bool only_along = true;
+				for (int k = 0; k < 3; k++)
+					if (k != ax && std::fabs(b.Pos[k] - a.Pos[k]) > EPS)
+						only_along = false;
+				if (!only_along)
+					continue;
+				float dt = which == 0 ? b.TCoords.X - a.TCoords.X : b.TCoords.Y - a.TCoords.Y;
+				float rate = dt / d * BS;
+				if (rate > 0.5f)
+					g[ax] = 1;
+				else if (rate < -0.5f)
+					g[ax] = -1;
+			}
+		}
+		(which == 0 ? face.u_dir : face.v_dir) = v3s16(g[0], g[1], g[2]);
+	}
+	face.found = true;
+	return face;
+}
+
+} // namespace
+
+// A turned block shows each of its faces turned with it: the face that is on
+// top of the unturned block, with its texture the same way round, ends up
+// exactly where the turn takes the block's top -- and likewise for the other
+// five faces, for all 24 ways a block can be turned (facedir), the same turn
+// its node box makes.
+void TestMapblockMeshGenerator::testTurnedNodeTexturesTurnWithIt()
+{
+	const v3s16 p(6, 5, 9);
+	const v3f o = intToFloat(p, BS);
+	DrawnFace ref[6];
+	{
+		MeshGenScene scene;
+		scene.place(p, "test:cube", 0);
+		auto tris = scene.trianglesByTexture();
+		for (int t = 0; t < 6; t++)
+			ref[t] = drawnFace(tris[TEX_CUBE + t], o);
+	}
+	for (u8 facedir = 1; facedir < 24; facedir++) {
+		MeshGenScene scene;
+		scene.place(p, "test:cube", facedir);
+		Turn turn = turnOf(scene, facedir);
+		UASSERT(turn.ok);
+		auto tris = scene.trianglesByTexture();
+		for (int t = 0; t < 6; t++) {
+			DrawnFace got = drawnFace(tris[TEX_CUBE + t], o);
+			v3s16 want_n = turn.apply(ref[t].normal);
+			v3s16 want_u = turn.apply(ref[t].u_dir);
+			v3s16 want_v = turn.apply(ref[t].v_dir);
+			UTEST(ref[t].found && got.found && got.normal == want_n &&
+					got.u_dir == want_u && got.v_dir == want_v,
+					"block turned with facedir %d: face %d looks towards %s (texture U %s, "
+					"V %s), its node box turns it towards %s (U %s, V %s)", facedir, t,
+					describe(got.normal).c_str(), describe(got.u_dir).c_str(),
+					describe(got.v_dir).c_str(), describe(want_n).c_str(),
+					describe(want_u).c_str(), describe(want_v).c_str());
+		}
+	}
+}
+
+// An unturned block shows its six faces where they were defined: top, bottom,
+// right (+X), left (-X), back (+Z) and front (-Z).
+void TestMapblockMeshGenerator::testUnturnedNodeTexturesKeepTheirFaces()
+{
+	const v3s16 p(6, 5, 9);
+	const v3s16 normals[6] = {v3s16(0, 1, 0), v3s16(0, -1, 0), v3s16(1, 0, 0),
+		v3s16(-1, 0, 0), v3s16(0, 0, 1), v3s16(0, 0, -1)};
+	MeshGenScene scene;
+	scene.place(p, "test:cube", 0);
+	auto tris = scene.trianglesByTexture();
+	for (int t = 0; t < 6; t++) {
+		DrawnFace got = drawnFace(tris[TEX_CUBE + t], intToFloat(p, BS));
+		UTEST(got.found && got.normal == normals[t], "unturned block: face %d looks towards %s",
+				t, describe(got.normal).c_str());
+	}
+}
+
+// The way the node box of a turned node is turned (facedir 0..23) stays as it
+// is: this pins down which turn each facedir means.
+void TestMapblockMeshGenerator::testTurnedNodeBoxKeepsItsFacedir()
+{
+	static const float want[24][3] = {
+		{ 0.1f,  0.2f,  0.3f}, { 0.3f,  0.2f, -0.1f}, {-0.1f,  0.2f, -0.3f}, {-0.3f,  0.2f,  0.1f},
+		{ 0.1f, -0.3f,  0.2f}, { 0.3f,  0.1f,  0.2f}, {-0.1f,  0.3f,  0.2f}, {-0.3f, -0.1f,  0.2f},
+		{ 0.1f,  0.3f, -0.2f}, { 0.3f, -0.1f, -0.2f}, {-0.1f, -0.3f, -0.2f}, {-0.3f,  0.1f, -0.2f},
+		{ 0.2f, -0.1f,  0.3f}, { 0.2f, -0.3f, -0.1f}, { 0.2f,  0.1f, -0.3f}, { 0.2f,  0.3f,  0.1f},
+		{-0.2f,  0.1f,  0.3f}, {-0.2f,  0.3f, -0.1f}, {-0.2f, -0.1f, -0.3f}, {-0.2f, -0.3f,  0.1f},
+		{-0.1f, -0.2f,  0.3f}, {-0.3f, -0.2f, -0.1f}, { 0.1f, -0.2f, -0.3f}, { 0.3f, -0.2f,  0.1f},
+	};
+	MeshGenScene scene;
+	for (u8 facedir = 0; facedir < 24; facedir++) {
+		std::vector<aabb3f> boxes;
+		MapNode(scene.id("test:pointer"), 0, facedir).getNodeBoxes(scene.ndef(), &boxes);
+		UASSERT(boxes.size() == 1);
+		v3f c = boxes[0].getCenter() / BS;
+		UTEST(std::fabs(c.X - want[facedir][0]) < 0.01f && std::fabs(c.Y - want[facedir][1]) < 0.01f &&
+				std::fabs(c.Z - want[facedir][2]) < 0.01f,
+				"node box turned with facedir %d sits at (%.2f, %.2f, %.2f)", facedir,
+				c.X, c.Y, c.Z);
+	}
+}
