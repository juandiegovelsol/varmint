+	TEX_LEAVES_SCALED = 11,
+	TEX_LEAVES_PLAIN,
+	TEX_FENCE,
+	TEX_FENCE_OTHER,
+	TEX_PLANT,
+	TEX_PLANT_HANGING,
+	TEX_MESH,
+	TEX_MESH_WALL,
+	TEX_LIQUID_TOP,
+	TEX_LIQUID_SIDE,
+	TEX_RAIL_STRAIGHT,
+	TEX_RAIL_CURVED,
