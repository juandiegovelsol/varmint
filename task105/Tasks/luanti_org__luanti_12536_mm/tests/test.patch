+// A fence joins tree trunks (as it joins any full block it lists), whichever
+// way the trunk was turned when placed: the rails reach both trunks.
+void TestMapblockMeshGenerator::testFenceConnectsToTreeTrunk()
+{
+	const v3s16 p(8, 4, 8);
