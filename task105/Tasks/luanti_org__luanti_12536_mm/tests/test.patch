+namespace {
+
+// A channel of flowing liquid running from a source in direction `flow`
+// (one of +-X, +-Z): the source, then flowing nodes with falling levels,
+// walled in by stone on both sides, below and at both ends.
+struct LiquidChannel {
+	v3s16 source;
+	v3s16 flow;
+	std::vector<v3s16> cells; // the flowing nodes, downstream order
+};
+
+LiquidChannel buildChannel(MeshGenScene &scene, v3s16 start, v3s16 flow,
+		const std::vector<u8> &levels, const char *outer_wall = "test:stone")
+{
+	LiquidChannel ch;
+	ch.source = start;
+	ch.flow = flow;
+	const v3s16 side(flow.Z, 0, flow.X); // horizontal, perpendicular to flow
+	scene.place(start, "test:liquid_source");
+	for (size_t i = 0; i < levels.size(); i++) {
+		v3s16 c = start + flow * (s16)(i + 1);
+		scene.place(c, "test:liquid_flowing", levels[i]);
+		ch.cells.push_back(c);
+	}
+	for (s16 i = -1; i <= (s16)levels.size() + 1; i++) {
+		v3s16 c = start + flow * i;
+		scene.place(c + side, outer_wall);
+		scene.place(c - side, "test:stone");
+		scene.place(c - v3s16(0, 1, 0), "test:stone");
+	}
+	scene.place(start - flow, "test:stone");
+	scene.place(start + flow * (s16)(levels.size() + 1), "test:stone");
+	return ch;
+}
+
+// Heights of the liquid surface at the four upper corners of one cell, keyed
+// by which (horizontal) corner they belong to. Returns false if the surface
+// of that cell is not exactly four corners.
+bool surfaceCorners(const std::vector<Triangle> &tris, v3s16 cell,
+		std::vector<std::pair<v3f, float>> *corners)
+{
+	const v3f o = intToFloat(cell, BS);
+	corners->clear();
+	for (const Triangle &t : tris) {
+		// only the surface drawn by this cell (its triangles lie above it)
+		v3f centre = (t.v[0].Pos + t.v[1].Pos + t.v[2].Pos) / 3.0f - o;
+		if (std::fabs(centre.X) >= BS / 2 || std::fabs(centre.Z) >= BS / 2)
+			continue;
+		for (const video::S3DVertex &v : t.v) {
+		v3f d = v.Pos - o;
+		if (std::fabs(std::fabs(d.X) - BS / 2) > EPS || std::fabs(std::fabs(d.Z) - BS / 2) > EPS)
+			continue;
+		bool known = false;
+		for (auto &c : *corners)
+			if (approx(c.first.X, d.X) && approx(c.first.Z, d.Z))
+				known = true;
+		if (!known)
+			corners->emplace_back(v3f(d.X, 0, d.Z), d.Y);
+		}
+	}
+	return corners->size() == 4;
+}
+
+} // namespace
+
+// Flowing liquid runs downhill: along a channel fed from one end, the surface
+// of every flowing node is lower on its downstream side than on its upstream
+// side, level across the channel, and joins its neighbours' surfaces without
+// steps -- whichever way the channel runs.
+void TestMapblockMeshGenerator::testFlowingLiquidSurfaceFollowsTheFlow()
+{
+	const v3s16 flows[4] = {v3s16(1, 0, 0), v3s16(-1, 0, 0), v3s16(0, 0, 1), v3s16(0, 0, -1)};
+	for (const v3s16 &flow : flows) {
+		MeshGenScene scene;
+		LiquidChannel ch = buildChannel(scene, v3s16(8, 5, 8) - flow * 3, flow,
+				{6, 5, 4, 3, 2});
+		std::vector<Triangle> tris = scene.triangles(TEX_LIQUID_TOP);
+
+		float prev_downstream = 0;
+		for (size_t i = 0; i < ch.cells.size(); i++) {
+			std::vector<std::pair<v3f, float>> corners;
+			bool ok = surfaceCorners(tris, ch.cells[i], &corners);
+			UTEST(ok, "flowing node %s of a channel flowing %s has no proper surface",
+					describe(ch.cells[i]).c_str(), describe(flow).c_str());
+			float up[2], down[2];
+			int nup = 0, ndown = 0;
+			for (auto &c : corners) {
+				float along = c.first.X * flow.X + c.first.Z * flow.Z;
+				if (along < 0 && nup < 2)
+					up[nup++] = c.second;
+				else if (along > 0 && ndown < 2)
+					down[ndown++] = c.second;
+			}
+			UASSERT(nup == 2 && ndown == 2);
+			UTEST(approx(up[0], up[1]) && approx(down[0], down[1]),
+					"surface of flowing node %s (channel flowing %s) is not level across "
+					"the channel: upstream %.2f/%.2f, downstream %.2f/%.2f",
+					describe(ch.cells[i]).c_str(), describe(flow).c_str(),
+					up[0], up[1], down[0], down[1]);
+			UTEST(up[0] > down[0] + EPS,
+					"surface of flowing node %s does not fall in the direction of the "
+					"flow %s: upstream %.2f, downstream %.2f",
+					describe(ch.cells[i]).c_str(), describe(flow).c_str(), up[0], down[0]);
+			if (i > 0)
+				UTEST(approx(up[0], prev_downstream),
+						"surface steps between flowing nodes at %s (flow %s): %.2f vs %.2f",
+						describe(ch.cells[i]).c_str(), describe(flow).c_str(),
+						prev_downstream, up[0]);
+			prev_downstream = down[0];
+		}
+	}
+}
+
+// Flowing liquid with the same level all around has a flat surface.
+void TestMapblockMeshGenerator::testEvenFlowingLiquidStaysLevel()
+{
+	const v3s16 p(8, 5, 8);
+	MeshGenScene scene;
+	for (s16 dx = -1; dx <= 1; dx++)
+	for (s16 dz = -1; dz <= 1; dz++) {
+		scene.place(p + v3s16(dx, 0, dz), "test:liquid_flowing", 4);
+		scene.place(p + v3s16(dx, -1, dz), "test:stone");
+	}
+	std::vector<Triangle> tris = scene.triangles(TEX_LIQUID_TOP);
+	std::vector<std::pair<v3f, float>> corners;
+	UTEST(surfaceCorners(tris, p, &corners),
+			"evenly flowing liquid at %s has no proper surface", describe(p).c_str());
+	for (auto &c : corners)
+		UTEST(approx(c.second, corners[0].second),
+				"evenly flowing liquid is not level: %.2f vs %.2f",
+				c.second, corners[0].second);
+}
+
+namespace {
+
+// Which texture a lone rail cell was drawn with, and how it lies.
+struct RailLook {
+	u32 tile = 0;
+	TextureFrame frame;
+	std::vector<Triangle> tris;
+};
+
+RailLook lookAtRail(MeshGenScene &scene, v3s16 p)
+{
+	RailLook look;
+	const aabb3f cell = cellOf(p, scaled(-0.55f, -0.55f, -0.55f, 0.55f, 0.55f, 0.55f));
+	for (u32 tex : {TEX_RAIL_STRAIGHT, TEX_RAIL_CURVED, TEX_RAIL_JUNCTION, TEX_RAIL_CROSS}) {
+		std::vector<Triangle> mine;
+		for (const Triangle &t : scene.triangles(tex)) {
+			bool inside = true;
+			for (const video::S3DVertex &v : t.v)
+				inside = inside && cell.isPointInside(v.Pos);
+			if (inside)
+				mine.push_back(t);
+		}
+		if (!mine.empty()) {
+			look.tile = tex;
+			look.tris = mine;
+		}
+	}
+	look.frame = textureFrame(look.tris);
+	return look;
+}
+
+std::set<std::pair<int, int>> dirSet(std::initializer_list<v3s16> dirs)
+{
+	std::set<std::pair<int, int>> s;
+	for (const v3s16 &d : dirs)
+		s.insert(std::make_pair(d.X, d.Z));
+	return s;
+}
+
+const v3s16 RAIL_DIRS[4] = {v3s16(1, 0, 0), v3s16(0, 0, 1), v3s16(-1, 0, 0), v3s16(0, 0, -1)};
+
+} // namespace
+
+// The rail textures are drawn the way rail packs paint them: the straight
+// piece runs from the texture's top edge to its bottom edge, the curve joins
+// its right and bottom edges, and the t-junction joins top, bottom and right.
+// A rail with two neighbours at a right angle is a curve whose two ends face
+// those neighbours; one with three neighbours is a junction that reaches all
+// three -- for every way round.
+void TestMapblockMeshGenerator::testRailCurvesAndJunctionsJoinTheirNeighbors()
+{
+	const v3s16 p(8, 4, 8);
+	for (int i = 0; i < 4; i++) {
+		const v3s16 a = RAIL_DIRS[i], b = RAIL_DIRS[(i + 1) % 4];
+		MeshGenScene scene;
+		scene.place(p, "test:rail");
+		scene.place(p + a, "test:rail");
+		scene.place(p + b, "test:rail");
+		RailLook look = lookAtRail(scene, p);
+		UTEST(look.tile == TEX_RAIL_CURVED && look.frame.ok,
+				"rail with neighbours %s and %s is not drawn as a curve",
+				describe(a).c_str(), describe(b).c_str());
+		UTEST(dirSet({look.frame.right, look.frame.bottom}) == dirSet({a, b}),
+				"curve with neighbours %s and %s has its ends towards %s and %s",
+				describe(a).c_str(), describe(b).c_str(),
+				describe(look.frame.right).c_str(), describe(look.frame.bottom).c_str());
+	}
+	for (int i = 0; i < 4; i++) {
+		const v3s16 stem = RAIL_DIRS[i];
+		const v3s16 a = RAIL_DIRS[(i + 1) % 4], b = RAIL_DIRS[(i + 3) % 4];
+		MeshGenScene scene;
+		scene.place(p, "test:rail");
+		scene.place(p + stem, "test:rail");
+		scene.place(p + a, "test:rail");
+		scene.place(p + b, "test:rail");
+		RailLook look = lookAtRail(scene, p);
+		UTEST(look.tile == TEX_RAIL_JUNCTION && look.frame.ok,
+				"rail with three neighbours (branch %s) is not drawn as a junction",
+				describe(stem).c_str());
+		v3s16 top = look.frame.bottom * -1;
+		UTEST(look.frame.right == stem &&
+				dirSet({look.frame.bottom, top}) == dirSet({a, b}),
+				"junction branching towards %s reaches %s, %s and %s instead",
+				describe(stem).c_str(), describe(look.frame.right).c_str(),
+				describe(look.frame.bottom).c_str(), describe(top).c_str());
+	}
+}
+
+// A rail next to a rail one node higher is drawn as a ramp that rises
+// towards that higher rail, in each of the four directions.
+void TestMapblockMeshGenerator::testSlopedRailRisesTowardsTheRailAbove()
+{
+	const v3s16 p(8, 4, 8);
+	for (const v3s16 &d : RAIL_DIRS) {
+		MeshGenScene scene;
+		scene.place(p, "test:rail");
+		scene.place(p + d + v3s16(0, 1, 0), "test:rail");
+		scene.place(p + d, "test:stone");
+		RailLook look = lookAtRail(scene, p);
+		UTEST(!look.tris.empty(), "ramp towards %s is not drawn", describe(d).c_str());
+		const v3f o = intToFloat(p, BS);
+		bool rises = !look.tris.empty();
+		for (const Triangle &t : look.tris)
+		for (const video::S3DVertex &v : t.v) {
+			v3f rel = v.Pos - o;
+			float along = rel.X * d.X + rel.Z * d.Z;
+			if (along > 0 && rel.Y < BS / 4)
+				rises = false; // the end towards the higher rail is low
+			if (along < 0 && rel.Y > -BS / 4)
+				rises = false; // the end away from it is high
+		}
+		UTEST(rises, "rail next to a higher rail at %s does not rise towards it",
+				describe(d).c_str());
+	}
+}
+
+// Straight runs: the straight texture lies along the line of rails.
+void TestMapblockMeshGenerator::testStraightRailsFollowTheirNeighbors()
+{
+	const v3s16 p(8, 4, 8);
+	for (int axis = 0; axis < 2; axis++) {
+		const v3s16 d = RAIL_DIRS[axis];
+		MeshGenScene scene;
+		scene.place(p - d, "test:rail");
+		scene.place(p, "test:rail");
+		scene.place(p + d, "test:rail");
+		RailLook look = lookAtRail(scene, p);
+		UTEST(look.tile == TEX_RAIL_STRAIGHT && look.frame.ok &&
+				dirSet({look.frame.bottom, look.frame.bottom * -1}) == dirSet({d, d * -1}),
+				"straight rail along %s is not drawn along its neighbours",
+				describe(d).c_str());
+	}
+	{
+		MeshGenScene scene;
+		scene.place(p, "test:rail");
+		for (const v3s16 &d : RAIL_DIRS)
+			scene.place(p + d, "test:rail");
+		RailLook look = lookAtRail(scene, p);
+		UTEST(look.tile == TEX_RAIL_CROSS, "rail at %s with four neighbours is not a crossing",
+				describe(p).c_str());
+	}
+}
+
+namespace {
+
+// The 12 edges of a cube, as (axis the edge runs along, the side it is on
+// along each of the two other axes).
+struct CubeEdge {
+	int axis;
+	int other[2];
+	s16 sign[2];
+};
+
+std::vector<CubeEdge> cubeEdges()
+{
+	std::vector<CubeEdge> edges;
+	for (int axis = 0; axis < 3; axis++) {
+		int o1 = (axis + 1) % 3, o2 = (axis + 2) % 3;
+		for (s16 s1 : {-1, 1})
+		for (s16 s2 : {-1, 1}) {
+			CubeEdge e;
+			e.axis = axis;
+			e.other[0] = o1;
+			e.other[1] = o2;
+			e.sign[0] = s1;
+			e.sign[1] = s2;
+			edges.push_back(e);
+		}
+	}
+	return edges;
+}
+
+v3s16 unit(int axis, s16 sign)
+{
+	v3s16 v(0, 0, 0);
+	if (axis == 0) v.X = sign;
+	if (axis == 1) v.Y = sign;
+	if (axis == 2) v.Z = sign;
+	return v;
+}
+
+std::string describe(const CubeEdge &e)
+{
+	static const char names[3] = {'X', 'Y', 'Z'};
+	char buf[64];
+	snprintf(buf, sizeof(buf), "edge along %c at %c%c %c%c", names[e.axis],
+			e.sign[0] > 0 ? '+' : '-', names[e.other[0]],
+			e.sign[1] > 0 ? '+' : '-', names[e.other[1]]);
+	return buf;
+}
+
+// A frame line belongs along a cube edge exactly where the glass surface
+// folds there: look at the four cells around the edge line (this one, its
+// two face neighbours across the edge and the diagonal one). The line is
+// hidden inside a solid block of glass (all four are glass) and across a flat
+// stretch (only this cell and one face neighbour are glass); everywhere else
+// -- outer corners, inner corners, cells touching only along the edge -- it
+// is drawn.
+bool frameExpected(const std::set<std::pair<int, std::pair<int, int>>> &glass,
+		v3s16 p, const CubeEdge &e)
+{
+	auto has = [&glass](v3s16 c) {
+		return glass.count(std::make_pair(c.X, std::make_pair(c.Y, c.Z))) > 0;
+	};
+	v3s16 n1 = p + unit(e.other[0], e.sign[0]);
+	v3s16 n2 = p + unit(e.other[1], e.sign[1]);
+	v3s16 diag = n1 + unit(e.other[1], e.sign[1]);
+	bool a = has(n1), b = has(n2), d = has(diag);
+	int count = 1 + a + b + d;
+	if (count == 4)
+		return false;
+	if (count == 2 && (a || b))
+		return false;
+	return true;
+}
+
+// Is any frame geometry running along the middle of this edge of cell p?
+bool frameDrawn(const std::vector<Triangle> &frame, v3s16 p, const CubeEdge &e)
+{
+	v3f lo(0, 0, 0), hi(0, 0, 0);
+	// stay just inside the cell, so a neighbour's frame never counts
+	const float in = 0.40f * BS, out = 0.5f * BS - 0.01f, mid = 0.1f * BS;
+	for (int k = 0; k < 2; k++) {
+		int ax = e.other[k];
+		float a = e.sign[k] > 0 ? in : -out;
+		float b = e.sign[k] > 0 ? out : -in;
+		if (ax == 0) { lo.X = a; hi.X = b; }
+		if (ax == 1) { lo.Y = a; hi.Y = b; }
+		if (ax == 2) { lo.Z = a; hi.Z = b; }
+	}
+	if (e.axis == 0) { lo.X = -mid; hi.X = mid; }
+	if (e.axis == 1) { lo.Y = -mid; hi.Y = mid; }
+	if (e.axis == 2) { lo.Z = -mid; hi.Z = mid; }
+	const aabb3f box = cellOf(p, aabb3f(lo, hi));
+	for (const Triangle &t : frame)
+		if (touches(t, box))
+			return true;
+	return false;
+}
+
+} // namespace
+
+// Connected glass merges with neighbouring glass of its own kind: the frame
+// outlines the merged shape -- along its outer and inner corners -- and never
+// runs across a flat stretch of glass or inside it. Checked on rows, columns,
+// walls, an L and a solid block of glass.
+void TestMapblockMeshGenerator::testFramedGlassMergesWithItsNeighbors()
+{
+	const v3s16 base(6, 6, 6);
+	const std::vector<std::vector<v3s16>> shapes = {
+		{v3s16(0, 0, 0), v3s16(1, 0, 0)},
+		{v3s16(0, 0, 0), v3s16(0, 1, 0)},
+		{v3s16(0, 0, 0), v3s16(0, 0, 1)},
+		{v3s16(0, 0, 0), v3s16(1, 0, 0), v3s16(2, 0, 0), v3s16(0, 1, 0), v3s16(1, 1, 0),
+			v3s16(2, 1, 0)},
+		{v3s16(0, 0, 0), v3s16(0, 0, 1), v3s16(0, 0, 2), v3s16(0, 1, 0), v3s16(0, 1, 1),
+			v3s16(0, 1, 2)},
+		{v3s16(0, 0, 0), v3s16(1, 0, 0), v3s16(0, 0, 1), v3s16(0, 1, 0)},
+		{v3s16(0, 0, 0), v3s16(1, 0, 0), v3s16(0, 1, 0), v3s16(1, 1, 0), v3s16(0, 0, 1),
+			v3s16(1, 0, 1), v3s16(0, 1, 1), v3s16(1, 1, 1)},
+	};
+	const std::vector<CubeEdge> edges = cubeEdges();
+	for (size_t s = 0; s < shapes.size(); s++) {
+		MeshGenScene scene;
+		std::set<std::pair<int, std::pair<int, int>>> glass;
+		for (const v3s16 &d : shapes[s]) {
+			v3s16 c = base + d;
+			scene.place(c, "test:glass");
+			glass.insert(std::make_pair(c.X, std::make_pair(c.Y, c.Z)));
+		}
+		std::vector<Triangle> frame = scene.triangles(TEX_GLASS_FRAME);
+		for (const v3s16 &d : shapes[s]) {
+			v3s16 c = base + d;
+			for (const CubeEdge &e : edges) {
+				bool want = frameExpected(glass, c, e);
+				bool got = frameDrawn(frame, c, e);
+				UTEST(want == got, "glass shape %zu, cell %s: frame %s %s", s,
+						describe(d).c_str(), want ? "missing on" : "drawn on",
+						describe(e).c_str());
+			}
+		}
+	}
+}
+
+// A lone glass node (or one next to a different kind of glass) has its whole
+// frame: all 12 edges.
+void TestMapblockMeshGenerator::testLoneFramedGlassKeepsItsWholeFrame()
+{
+	const v3s16 p(6, 6, 6);
+	MeshGenScene scene;
+	scene.place(p, "test:glass");
+	scene.place(p + v3s16(1, 0, 0), "test:other_glass");
+	scene.place(p + v3s16(0, 1, 0), "test:other_glass");
+	std::vector<Triangle> frame = scene.triangles(TEX_GLASS_FRAME);
+	for (const CubeEdge &e : cubeEdges())
+		UTEST(frameDrawn(frame, p, e), "lone glass node has no frame on its %s",
+				describe(e).c_str());
+}
+
+namespace {
+
+// The heights of a flowing cell's surface, keyed by its horizontal corners.
+float cornerHeight(const std::vector<std::pair<v3f, float>> &corners, float x, float z,
+		bool *found)
+{
+	for (const auto &c : corners)
+		if (approx(c.first.X, x) && approx(c.first.Z, z)) {
+			*found = true;
+			return c.second;
+		}
+	*found = false;
+	return 0;
+}
+
+// The horizontal direction in which the texture of one cell's liquid surface
+// runs (the direction in which its V coordinate grows), or (0,0,0).
+v3s16 surfaceTextureDirection(const std::vector<Triangle> &tris, v3s16 cell)
+{
+	const v3f o = intToFloat(cell, BS);
+	std::vector<std::pair<v3f, float>> corners;
+	for (const Triangle &t : tris) {
+		v3f centre = (t.v[0].Pos + t.v[1].Pos + t.v[2].Pos) / 3.0f - o;
+		if (std::fabs(centre.X) >= BS / 2 || std::fabs(centre.Z) >= BS / 2)
+			continue;
+		for (const video::S3DVertex &v : t.v) {
+			v3f d = v.Pos - o;
+			if (std::fabs(std::fabs(d.X) - BS / 2) > EPS || std::fabs(std::fabs(d.Z) - BS / 2) > EPS)
+				continue;
+			bool known = false;
+			for (auto &c : corners)
+				if (approx(c.first.X, d.X) && approx(c.first.Z, d.Z))
+					known = true;
+			if (!known)
+				corners.emplace_back(v3f(d.X, 0, d.Z), v.TCoords.Y);
+		}
+	}
+	if (corners.size() != 4)
+		return v3s16(0, 0, 0);
+	float gx = 0, gz = 0;
+	for (const auto &c : corners) {
+		gx += (c.first.X > 0 ? 0.5f : -0.5f) * c.second;
+		gz += (c.first.Z > 0 ? 0.5f : -0.5f) * c.second;
+	}
+	if (std::fabs(gx) < 0.25f && std::fabs(gz) < 0.25f)
+		return v3s16(0, 0, 0);
+	return horizontalAxis(v3f(gx, 0, gz));
+}
+
+} // namespace
+
+// The texture of flowing liquid runs with the flow: along a channel fed from
+// one end, the surface texture of every flowing node runs downstream --
+// whichever way the channel runs.
+void TestMapblockMeshGenerator::testFlowingLiquidTextureRunsDownstream()
+{
+	const v3s16 flows[4] = {v3s16(1, 0, 0), v3s16(-1, 0, 0), v3s16(0, 0, 1), v3s16(0, 0, -1)};
+	for (const v3s16 &flow : flows) {
+		MeshGenScene scene;
+		LiquidChannel ch = buildChannel(scene, v3s16(8, 5, 8) - flow * 3, flow,
+				{6, 5, 4, 3, 2});
+		std::vector<Triangle> tris = scene.triangles(TEX_LIQUID_TOP);
+		for (const v3s16 &cell : ch.cells) {
+			v3s16 runs = surfaceTextureDirection(tris, cell);
+			UTEST(runs == flow,
+					"texture of flowing node %s runs towards %s, the channel flows towards %s",
+					describe(cell).c_str(), describe(runs).c_str(), describe(flow).c_str());
+		}
+	}
+}
+
+// Where flowing liquid shows its side (here through a glass wall), that side
+// reaches exactly up to the liquid's surface at both of its upper corners:
+// no gap and nothing sticking out above it -- whichever way the liquid flows.
+void TestMapblockMeshGenerator::testFlowingLiquidSideMeetsItsSurface()
+{
+	const v3s16 flows[4] = {v3s16(1, 0, 0), v3s16(-1, 0, 0), v3s16(0, 0, 1), v3s16(0, 0, -1)};
+	for (const v3s16 &flow : flows) {
+		MeshGenScene scene;
+		LiquidChannel ch = buildChannel(scene, v3s16(8, 5, 8) - flow * 3, flow,
+				{6, 5, 4, 3, 2}, "test:glass");
+		const v3s16 side(flow.Z, 0, flow.X); // the glass is on this side
+		std::vector<Triangle> top = scene.triangles(TEX_LIQUID_TOP);
+		std::vector<Triangle> sides = scene.triangles(TEX_LIQUID_SIDE);
+		for (const v3s16 &cell : ch.cells) {
+			const v3f o = intToFloat(cell, BS);
+			std::vector<std::pair<v3f, float>> corners;
+			UTEST(surfaceCorners(top, cell, &corners),
+					"flowing node %s has no proper surface", describe(cell).c_str());
+			int checked = 0;
+			for (const Triangle &t : sides) {
+				v3f centre = (t.v[0].Pos + t.v[1].Pos + t.v[2].Pos) / 3.0f - o;
+				float out = centre.X * side.X + centre.Z * side.Z;
+				float along = centre.X * flow.X + centre.Z * flow.Z;
+				if (std::fabs(out - BS / 2) > EPS || std::fabs(along) >= BS / 2)
+					continue;
+				for (const video::S3DVertex &v : t.v) {
+					v3f d = v.Pos - o;
+					if (d.Y < -BS / 2 + EPS)
+						continue; // the lower edge
+					bool found;
+					float h = cornerHeight(corners, d.X, d.Z, &found);
+					checked++;
+					UTEST(found && approx(d.Y, h),
+							"side of flowing node %s (flow %s) ends at height %.2f at corner "
+							"(%.1f, %.1f), its surface is at %.2f there",
+							describe(cell).c_str(), describe(flow).c_str(), d.Y / BS,
+							d.X / BS, d.Z / BS, h / BS);
+				}
+			}
+			UTEST(checked >= 2, "flowing node %s (flow %s) shows no side towards the glass",
+					describe(cell).c_str(), describe(flow).c_str());
+		}
+	}
+}
+
+namespace {
+
+// Is a face of node p drawn on the plane through `at` (node-relative) that is
+// perpendicular to `axis`, covering the point `at`?
+bool faceDrawnAt(const std::vector<Triangle> &tris, v3s16 p, v3f at, int axis)
+{
+	const v3f a = intToFloat(p, BS) + at;
+	for (const Triangle &t : tris) {
+		bool on_plane = true;
+		for (const video::S3DVertex &v : t.v)
+			on_plane = on_plane && std::fabs(v.Pos[axis] - a[axis]) < EPS;
+		if (!on_plane)
+			continue;
+		aabb3f tb(t.v[0].Pos);
+		tb.addInternalPoint(t.v[1].Pos);
+		tb.addInternalPoint(t.v[2].Pos);
+		bool inside = true;
+		for (int k = 0; k < 3; k++)
+			if (k != axis)
+				inside = inside && a[k] >= tb.MinEdge[k] - EPS && a[k] <= tb.MaxEdge[k] + EPS;
+		if (inside)
+			return true;
+	}
+	return false;
+}
+
+struct SlabFace {
+	const char *name;
+	v3s16 towards; // where the face looks
+	v3f centre;    // node-relative, in nodes
+	int axis;
+};
+
+const SlabFace SLAB_FACES[6] = {
+	{"top",    v3s16( 0,  1,  0), v3f( 0.0f,  0.00f,  0.0f), 1},
+	{"bottom", v3s16( 0, -1,  0), v3f( 0.0f, -0.50f,  0.0f), 1},
+	{"+X",     v3s16( 1,  0,  0), v3f( 0.5f, -0.25f,  0.0f), 0},
+	{"-X",     v3s16(-1,  0,  0), v3f(-0.5f, -0.25f,  0.0f), 0},
+	{"+Z",     v3s16( 0,  0,  1), v3f( 0.0f, -0.25f,  0.5f), 2},
+	{"-Z",     v3s16( 0,  0, -1), v3f( 0.0f, -0.25f, -0.5f), 2},
+};
+
+} // namespace
+
+// The surface of a node box is drawn wherever it is open to the air: a slab
+// next to a full block, and rows of slabs and of stairs along either axis,
+// show every face that looks into the open (faces against a neighbour may be
+// left out, faces open to the air may not).
+void TestMapblockMeshGenerator::testNodeboxFacesTowardsAirAreDrawn()
+{
+	const v3s16 p(8, 4, 8);
+	const v3s16 dirs[4] = {v3s16(1, 0, 0), v3s16(-1, 0, 0), v3s16(0, 0, 1), v3s16(0, 0, -1)};
+	for (const v3s16 &d : dirs) {
+		MeshGenScene scene;
+		scene.place(p, "test:slab");
+		scene.place(p + d, "test:stone");
+		std::vector<Triangle> tris = scene.triangles(TEX_SLAB);
+		for (const SlabFace &face : SLAB_FACES) {
+			if (face.towards == d)
+				continue;
+			UTEST(faceDrawnAt(tris, p, face.centre * BS, face.axis),
+					"slab with a full block on its %s side has no %s face",
+					describe(d).c_str(), face.name);
+		}
+	}
+	for (const v3s16 &d : {v3s16(1, 0, 0), v3s16(0, 0, 1)}) {
+		MeshGenScene scene;
+		for (s16 i = -1; i <= 1; i++)
+			scene.place(p + d * i, "test:slab");
+		std::vector<Triangle> tris = scene.triangles(TEX_SLAB);
+		for (s16 i = -1; i <= 1; i++) {
+			const v3s16 c = p + d * i;
+			for (const SlabFace &face : SLAB_FACES) {
+				bool towards_row = (face.towards == d && i < 1) ||
+						(face.towards == d * -1 && i > -1);
+				if (towards_row)
+					continue;
+				UTEST(faceDrawnAt(tris, c, face.centre * BS, face.axis),
+						"slab %d of a row along %s has no %s face", i + 1,
+						describe(d).c_str(), face.name);
+			}
+		}
+	}
+	for (u8 facedir : {0, 1, 2, 3}) {
+		// a flight of three stairs side by side, turned with facedir
+		MeshGenScene scene;
+		std::vector<aabb3f> boxes;
+		MapNode(scene.id("test:stair"), 0, facedir).getNodeBoxes(scene.ndef(), &boxes);
+		UASSERT(boxes.size() == 2);
+		// the lower step's front looks away from the upper step
+		v3f up = boxes[1].getCenter();
+		v3s16 front = horizontalAxis(up) * -1;
+		v3s16 along(front.Z, 0, front.X);
+		for (s16 i = -1; i <= 1; i++)
+			scene.place(p + along * i, "test:stair", facedir);
+		std::vector<Triangle> tris = scene.triangles(TEX_STAIR);
+		const int axis = front.X != 0 ? 0 : 2;
+		const v3f lower_front = v3f(front.X * 0.5f, -0.25f, front.Z * 0.5f) * BS;
+		const v3f riser = v3f(0.f, 0.25f, 0.f) * BS;
+		for (s16 i = -1; i <= 1; i++) {
+			const v3s16 c = p + along * i;
+			UTEST(faceDrawnAt(tris, c, lower_front, axis),
+					"stair %d of a flight turned with facedir %d has no front on its lower step",
+					i + 1, facedir);
+			UTEST(faceDrawnAt(tris, c, riser, axis),
+					"stair %d of a flight turned with facedir %d has no riser", i + 1, facedir);
+		}
+	}
+}
