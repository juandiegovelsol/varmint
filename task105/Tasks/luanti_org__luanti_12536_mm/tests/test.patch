+
+	// Runs the generator over block (0,0,0) and returns the extent of every
+	// vertex generated with the given texture, plus the vertices themselves.
+	Extent generate(u32 texture_id, std::vector<video::S3DVertex> *out = nullptr,
+			bool smooth_lighting = true)
+	{
+		MeshCollector collector;
+		run(collector, smooth_lighting);
+
+		Extent e;
+		e.min_v = v3f(std::numeric_limits<float>::max());
+		e.max_v = v3f(-std::numeric_limits<float>::max());
+		for (const auto &buffers : collector.prebuffers)
+		for (const PreMeshBuffer &buf : buffers) {
+			if (buf.layer.texture_id != texture_id)
+				continue;
+			for (const video::S3DVertex &v : buf.vertices) {
+				e.min_v.X = std::min(e.min_v.X, v.Pos.X);
+				e.min_v.Y = std::min(e.min_v.Y, v.Pos.Y);
+				e.min_v.Z = std::min(e.min_v.Z, v.Pos.Z);
+				e.max_v.X = std::max(e.max_v.X, v.Pos.X);
+				e.max_v.Y = std::max(e.max_v.Y, v.Pos.Y);
+				e.max_v.Z = std::max(e.max_v.Z, v.Pos.Z);
+				e.count++;
+				if (out)
+					out->push_back(v);
+			}
+		}
+		return e;
+	}
+
+	// Runs the generator once and returns every triangle, by texture.
+	std::map<u32, std::vector<Triangle>> trianglesByTexture(bool smooth_lighting = true)
+	{
+		MeshCollector collector;
+		run(collector, smooth_lighting);
+
+		std::map<u32, std::vector<Triangle>> result;
+		for (const auto &buffers : collector.prebuffers)
+		for (const PreMeshBuffer &buf : buffers) {
+			for (size_t i = 0; i + 2 < buf.indices.size(); i += 3) {
+				Triangle t;
+				for (int k = 0; k < 3; k++)
+					t.v[k] = buf.vertices.at(buf.indices[i + k]);
+				result[buf.layer.texture_id].push_back(t);
+			}
+		}
+		return result;
+	}
+
+	// Runs the generator and returns every triangle drawn with the texture.
+	std::vector<Triangle> triangles(u32 texture_id, bool smooth_lighting = true)
+	{
+		MeshCollector collector;
+		run(collector, smooth_lighting);
+
+		std::vector<Triangle> result;
+		for (const auto &buffers : collector.prebuffers)
+		for (const PreMeshBuffer &buf : buffers) {
+			if (buf.layer.texture_id != texture_id)
+				continue;
+			for (size_t i = 0; i + 2 < buf.indices.size(); i += 3) {
+				Triangle t;
+				for (int k = 0; k < 3; k++)
+					t.v[k] = buf.vertices.at(buf.indices[i + k]);
+				result.push_back(t);
+			}
+		}
+		return result;
+	}
+
+private:
+	void run(MeshCollector &collector, bool smooth_lighting)
+	{
+		MeshMakeData data(clientFor(&m_gamedef), false);
+		data.fillBlockDataBegin(v3s16(0, 0, 0));
+		std::vector<MapNode> air(MAP_BLOCKSIZE * MAP_BLOCKSIZE * MAP_BLOCKSIZE,
+				MapNode(CONTENT_AIR, LIGHT_SUN, 0));
+		for (s16 z = -1; z <= 1; z++)
+		for (s16 y = -1; y <= 1; y++)
+		for (s16 x = -1; x <= 1; x++)
+			data.fillBlockData(v3s16(x, y, z), air.data());
+		for (const auto &node : m_nodes)
+			data.m_vmanip.setNode(node.first, node.second);
+		data.setSmoothLighting(smooth_lighting);
+
+		NoopMeshManipulator meshmanip;
+		MapblockMeshGenerator(&data, &collector, &meshmanip).generate();
+	}
+
+	void registerMeshNode(const std::string &name, ContentParamType2 param_type_2,
+			u32 texture_id)
+	{
+		ContentFeatures f;
+		f.name = name;
+		f.drawtype = NDT_MESH;
+		f.param_type = CPT_LIGHT;
+		f.param_type_2 = param_type_2;
+		f.solidness = 0;
+		f.mesh_ptr[0] = makeBlockMesh();
+		f.node_box.type = NODEBOX_FIXED;
+		f.node_box.fixed = {MESH_BOUNDS};
+		setAllTiles(f, texture_id);
+		m_ndef->set(f.name, f);
+	}
+
+	content_t registerFence(const std::string &name, u32 texture_id,
+			const std::vector<content_t> &joins)
+	{
+		ContentFeatures f;
+		f.name = name;
+		f.drawtype = NDT_NODEBOX;
+		f.param_type = CPT_LIGHT;
+		f.solidness = 0;
+		makeFenceBox(f.node_box);
+		f.connects_to_ids = joins;
+		setAllTiles(f, texture_id);
+		return m_ndef->set(f.name, f);
+	}
+
+	NodeDefManager *m_ndef;
+	MeshGenGameDef m_gamedef;
+	std::vector<std::pair<v3s16, MapNode>> m_nodes;
+};
+
+std::string describe(const Extent &e)
+{
+	char buf[200];
+	snprintf(buf, sizeof(buf), "%zu vertices, min (%.3f, %.3f, %.3f) max (%.3f, %.3f, %.3f)",
+			e.count, e.min_v.X, e.min_v.Y, e.min_v.Z, e.max_v.X, e.max_v.Y, e.max_v.Z);
+	return buf;
+}
+
+std::string describe(v3s16 v)
+{
+	char buf[64];
+	snprintf(buf, sizeof(buf), "(%d, %d, %d)", v.X, v.Y, v.Z);
+	return buf;
+}
+
+// The region a node occupies in the generated (block-relative) mesh.
+aabb3f cellOf(v3s16 p, const aabb3f &local)
+{
+	v3f o = intToFloat(p, BS);
+	return aabb3f(local.MinEdge + o, local.MaxEdge + o);
+}
+
+// Does a triangle lie (even partly) inside the box?
+bool touches(const Triangle &t, const aabb3f &box)
+{
+	aabb3f tb(t.v[0].Pos);
+	tb.addInternalPoint(t.v[1].Pos);
+	tb.addInternalPoint(t.v[2].Pos);
+	return tb.intersectsWithBox(box);
+}
+
+// The horizontal direction (one of +-X, +-Z) closest to a vector.
+v3s16 horizontalAxis(const v3f &d)
+{
+	if (std::fabs(d.X) >= std::fabs(d.Z))
+		return v3s16(d.X > 0 ? 1 : -1, 0, 0);
+	return v3s16(0, 0, d.Z > 0 ? 1 : -1);
+}
+
+// How a flat (rail-like) texture lies on the ground: the world direction its
+// right edge (u = 1) faces and the one its bottom edge (v = 1) faces.
+struct TextureFrame {
+	bool ok = false;
+	v3s16 right, bottom;
+};
+
+TextureFrame textureFrame(const std::vector<Triangle> &tris)
+{
+	TextureFrame frame;
+	const video::S3DVertex *corner[3] = {nullptr, nullptr, nullptr}; // (0,0) (1,0) (0,1)
+	const v2f want[3] = {v2f(0, 0), v2f(1, 0), v2f(0, 1)};
+	for (const Triangle &t : tris)
+	for (const video::S3DVertex &v : t.v)
+	for (int k = 0; k < 3; k++)
+		if (approx(v.TCoords.X, want[k].X) && approx(v.TCoords.Y, want[k].Y))
+			corner[k] = &v;
+	if (!corner[0] || !corner[1] || !corner[2])
+		return frame;
+	frame.right = horizontalAxis(corner[1]->Pos - corner[0]->Pos);
+	frame.bottom = horizontalAxis(corner[2]->Pos - corner[0]->Pos);
+	frame.ok = true;
+	return frame;
+}
