+float GenericCAO::getSpriteYaw() const
+{
+	// Unattached sprites are not rotated in the scene graph, use the
+	// object's own yaw directly.
+	if (!getParent() || !m_matrixnode)
+		return m_rotation.Y;
+
+	// Attached: take the world-space orientation, which includes the
+	// rotation of the parent (and bone) as well as the attachment rotation.
+	// The object's facing direction corresponds to local +X (see
+	// updateNodePos(): yaw is applied as a negated Irrlicht rotation).
+	v3f front(1.0f, 0.0f, 0.0f);
+	m_matrixnode->getAbsoluteTransformation().rotateVect(front);
+	if (std::fabs(front.X) < 1e-6f && std::fabs(front.Z) < 1e-6f)
+		return m_rotation.Y;
+	return atan2(front.Z, front.X) * core::RADTODEG;
+}
